# =============================================================================
# Dockerfile.lite - runtime image: the binaries, without the source trees
# =============================================================================
#
# Purpose: derive osmocom-nitb:lite from the osmocom-nitb image by removing the
# build trees under /opt/GSM (gnuradio, gr-gsm, libosmocore, qemu, osmo-*...)
# and the rest of the build toolchain, while keeping everything the stack
# launches at runtime.
#
# Build:    ./build.sh --lite      (or: docker build -f Dockerfile.lite .)
# ISO:      ./build-iso.sh --role=operator --lite
# Args:     BASE   image to prune (default: osmocom-nitb)
#
# Why two stages and a flatten: deleting files in an extra layer frees nothing
# (the image is the sum of its layers). The prune stage trims the tree, then
# FROM scratch + COPY writes only the pruned root as a single layer.
# Starting from the complete root, rather than reinstalling a hand-written
# package list, keeps every runtime library the /usr/local binaries depend on.
#
# Kept in /opt/GSM (what the stack actually launches):
#   qosmo/                              whole tree (run.sh, run_modules/,
#                                       environnement/, cfgs/, scripts/, .git),
#                                       build/ reduced to qemu-system-arm and
#                                       qemu-bundle/
#   osmocom-bb/src/host/osmocon/osmocon the loader
#   osmocom-bb/src/target/trx_toolkit   fake_trx.py and friends
#   c54x_exe/, grgsm_exe/               layer-1 implementations outside QEMU
#   calypso_dsp.*.bin                   DSP ROMs
#   firmware/, qemu-install/, osmo-operator/, pont/
#
# The repositories keep their .git: "osmo-update" runs git fetch in place on
# the running machine instead of deleting and recloning.
# =============================================================================

ARG BASE=osmocom-nitb

# ── Stage 1: prune ──────────────────────────────────────────────────────────
FROM ${BASE} AS prune

# Implicit set -e (default SHELL): a failed prune does not produce a half-cut
# image. Everything happens in ONE layer; only its final state is copied.
RUN set -eux; \
    cd /opt/GSM; \
    mkdir -p /keep/qosmo/build /keep/osmocom-bb/src/host/osmocon \
             /keep/osmocom-bb/src/target; \
    # qosmo: the whole tree except build/. The binary is set aside BEFORE the
    # copy, and --exclude=./build keeps the tar from overwriting it.
    cp -a qosmo/build/qemu-system-arm  /keep/qosmo/build/ 2>/dev/null || true; \
    # qemu-bundle must follow the binary: QEMU relocates its data directory
    # relative to the binary location, and in a build tree that goes through
    # build/qemu-bundle/. Without it qemu-system-arm cannot read its keymap
    # ("could not read keymap file: 'en-us'") and dies before allocating PTYs.
    cp -a qosmo/build/qemu-bundle      /keep/qosmo/build/ 2>/dev/null || true; \
    tar -C qosmo --exclude=./build -cf - . | tar -C /keep/qosmo -xf -; \
    # c54x_exe (--dsp) and grgsm_exe: small trees (binary + run.sh + rom/),
    # kept whole, .git included (osmo-update). Their C sources live in qosmo.
    for d in c54x_exe grgsm_exe; do \
        [ -d "$d" ] && cp -a "$d" /keep/ || true; \
    done; \
    cp -a osmocom-bb/src/host/osmocon/osmocon \
          /keep/osmocom-bb/src/host/osmocon/ 2>/dev/null || true; \
    cp -a osmocom-bb/src/target/trx_toolkit \
          /keep/osmocom-bb/src/target/ 2>/dev/null || true; \
    cp -a *.bin /keep/ 2>/dev/null || true; \
    for d in firmware qemu-install osmo-operator pont; do \
        [ -e "$d" ] && cp -a "$d" /keep/ || true; \
    done; \
    # The cut: all of /opt/GSM goes, only the kept artefacts come back.
    cd /; rm -rf /opt/GSM; mkdir -p /opt/GSM; \
    cp -a /keep/. /opt/GSM/; rm -rf /keep; \
    # Rest of the toolchain: headers, static libraries, objects, caches.
    # /var/cache/osmo-debs (packaging/osmo-deb.sh) is a BUILD cache that lives
    # on the host; it has no place in the pruned runtime image.
    rm -rf /usr/local/include /root/.cache /root/.cargo /root/.rustup \
           /usr/share/doc /usr/share/man /usr/share/locale \
           /var/lib/apt/lists/* /var/cache/apt/archives/*.deb \
           /var/cache/osmo-debs /var/cache/apt/apt-fast \
           /tmp/* /var/tmp/*; \
    find /usr/local/lib -name '*.a' -delete 2>/dev/null || true; \
    # The .o sweep SKIPS /opt/GSM: some .o there are tracked by git, and
    # deleting them would leave a modified tree that "osmo-update" refuses
    # to fast-forward.
    find / -xdev -path /opt/GSM -prune -o -name '*.o' -exec rm -f {} + 2>/dev/null || true; \
    du -sh /opt/GSM /usr/local/bin /usr/local/lib

# ── Stage 2: flatten ────────────────────────────────────────────────────────
# FROM scratch + COPY of the root: a single layer holding only the pruned
# state. This is what actually reduces the image size.
FROM scratch
COPY --from=prune / /

# Configuration does not survive FROM scratch: redeclare it identically to the
# original image, otherwise the lite image does not start the same way.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    container=docker \
    OSMO_IMAGE=1 \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig \
    LD_LIBRARY_PATH=/usr/local/lib \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /etc/osmocom
ENTRYPOINT ["/etc/osmocom/entrypoint.sh"]
CMD ["/bin/bash"]
