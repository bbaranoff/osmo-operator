diff -r 9394305d4ff5 src/ui3/mfw/mfw_sms.c
--- a/src/ui3/mfw/mfw_sms.c	Mon Oct 31 00:14:44 2022 +0000
+++ b/src/ui3/mfw/mfw_sms.c	Thu Oct 22 16:08:11 2026 +0200
@@ -241,6 +241,8 @@
 
 //May 27, 2005    MMI-FIX-29869 x0018858 - Added a Checking variable.
 static int Counter_first = 0;
+/* [banc 2026-10-22] sms_read_msg_info() appele avant l'allocation de msg_info (voir Check_max_sms_allowed) */
+static int liste_avant_alloc = 0;
 #else
 static T_MFW_SMS_MSG msg_info[MAX_MESSAGES]; /* message table */
 #endif
@@ -348,8 +350,30 @@
 				{
 					msg_info = (T_MFW_SMS_MSG*)ALLOC_MEMORY(g_max_messages*sizeof(T_MFW_SMS_MSG));
 
+					/* [banc 2026-10-22] Le tableau sortait de ALLOC_MEMORY NON initialise. rAT_sms_ready() ->
+					   sms_read_msg_info() passe souvent AVANT cette allocation (premier evenement SMS de l'ecran de
+					   veille) : sa remise a index -1 tombait sur msg_info NULL et le tableau alloue ensuite gardait
+					   des dechets. Index != -1 = entrees fantomes « [P] » dans Messages > Read ; en ouvrir une lancait
+					   sms_read sur un index bidon, sans reponse : « Please wait » infini. */
+					for (i=0; i<g_max_messages; i++)
+					{
+						memset(&msg_info[i], 0, sizeof(T_MFW_SMS_MSG));
+						msg_info[i].index = -1;
+						msg_info[i].first_index = -1;
+						msg_info[i].addr.ton = MFW_TON_UNKNOWN;
+						msg_info[i].addr.npi = MFW_NPI_UNKNOWN;
+						msg_info[i].concat_status = MFW_SMS_NO_CONC;
+						msg_info[i].mem = MFW_MEM_NOTPRESENT;
+						msg_info[i].first_mem = MFW_MEM_NOTPRESENT;
+					}
 				}
 			Counter_first ++;
+			/* la liste lue avant l'allocation est perdue : la relire maintenant */
+			if (liste_avant_alloc)
+			{
+				liste_avant_alloc = 0;
+				sms_read_msg_info();
+			}
 		}
 
 }
@@ -853,6 +877,15 @@
     TRACE_FUNCTION("sms_read_msg_info()");
 
 #ifdef FF_MMI_SMS_DYNAMIC
+    if (msg_info == NULL)
+    {
+        /* [banc 2026-10-22] trop tot : Check_max_sms_allowed() relira la liste apres l'allocation */
+        liste_avant_alloc = 1;
+        return;
+    }
+#endif
+
+#ifdef FF_MMI_SMS_DYNAMIC
     for (i=0; i<g_max_messages; i++)
 #else
     for (i=0; i<MAX_MESSAGES; i++)
