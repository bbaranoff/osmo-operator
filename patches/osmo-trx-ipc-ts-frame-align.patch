diff --git a/Transceiver52M/device/ipc/IPCDevice.cpp b/Transceiver52M/device/ipc/IPCDevice.cpp
index 1d2b89a..871075a 100644
--- a/Transceiver52M/device/ipc/IPCDevice.cpp
+++ b/Transceiver52M/device/ipc/IPCDevice.cpp
@@ -1073,6 +1073,24 @@ bool IPCDevice::flush_recv(size_t num_pkts)
 			read = ipc_shm_read(shm_io_rx_streams[i], (uint16_t *)&tmp.front(), 4096 / 2, &tmps, 3);
 	}
 	ts_initial = tmps + read;
+	/* FIX LU 2026-06-05 : aligner ts_initial sur une frontiere de TRAME TDMA
+	 * (8 slots * 625 samples @ 4 SPS = 5000). Le device IPC commit des buffers a
+	 * des timestamps multiples de 2500 (CALYPSO_SHM_BUFSIZE), donc ts_initial%5000
+	 * valait 0 OU 2500 -> quand 2500, device-TN0 mappe sur osmo-TN4 et la RACH
+	 * (placee a l'offset 0 = device-TN0) ratait le slot TS0/RACH -> NOPE/-110.
+	 * Arrondir a la trame met les deux grilles en phase. (5000 = 8*625 @ rx-sps 4) */
+	ts_initial -= ts_initial % 5000;
+	/* FIX SDCCH RUN-INVARIANCE 2026-06-09 : aligner ts_initial sur une frontiere de
+	 * MULTITRAME 102 (couvre CCCH+SDCCH/4) en plus de la trame. mClock demarre a FN 0
+	 * (CALYPSO_START_FN=0) MAIS l'echantillon a ts_initial est etiquete FN 0 -> Q =
+	 * osmo_trx_fn - internal_fn = -(ts_initial/5000). Le drain SHM au handshake
+	 * OPEN->START est une course de demarrage -> ts_initial/5000 (donc Q mod 102)
+	 * variait run-a-run -> le bloc SDCCH/4 SS0 UL tombait a un %51 different chaque run
+	 * -> SABM decodee seulement parfois. En forcant ts_initial%(102*5000)==0 -> Q==0
+	 * mod 102 a chaque run -> osmo_trx_fn==internal_fn (mod 102) -> gate fixe cote
+	 * qemu_wrap (CALYPSO_UL_SDCCH_OFS=15) run-invariant. 102*5000=510000 ; gHyperframe
+	 * en echantillons est multiple exact de 510000 -> wrap d'hypertrame non perturbe. */
+	ts_initial -= ts_initial % (102 * 5000);
 
 	LOGC(DDEV, INFO) << "Initial timestamp " << ts_initial << std::endl;
 	return true;
