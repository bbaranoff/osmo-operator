+					snd_pcm_sw_params_set_avail_min(state->pcm_handle,
+									sw, period);
+					if (snd_pcm_sw_params(state->pcm_handle, sw) < 0)
+						LOGPGAPK(LOGL_ERROR, "ALSA '%s': sw_params refuses, "
+							 "on garde les defauts (start_threshold=1)\n",
