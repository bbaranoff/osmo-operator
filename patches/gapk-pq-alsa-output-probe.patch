+/* SONDE GAPK_ALSA_PROBE — le PCM qui part vers ALSA est-il muet ?
+ *
+ * Pourquoi elle existe (mesures du 2026-08-09, Calypso emule sous QEMU) : le
+ * mobile recoit a sa porte 300/300 trames FR DISTINCTES, cadrage 49 o et
+ * signature 0xd correctes (releve dans osmocon.log, hdlc_recv dlci=5), la meme
+ * libosmogapk decode ces memes trames en audio reel quand on l'appelle par le
+ * binaire osmo-gapk autonome (RMS 391, 98,2 % d'echantillons non nuls), et
+ * pourtant la sortie ALSA du mobile est du ZERO NUMERIQUE EXACT (crete 0 sur
+ * 48000 echantillons). Aucune erreur n'est journalisee, car
+ * osmo_gapk_pq_execute ne se plaint que d'un retour negatif.
+ *
+ * Cette sonde tranche en un appel : le PCM remis a snd_pcm_writei est-il nul
+ * (le defaut est en amont, dans la chaine) ou non nul (le defaut est en aval,
+ * dans ALSA/PulseAudio) ?
+ *
+ * Compteurs CUMULATIFS, jamais un taux : un taux tire d'un journal bufferise a
+ * deja produit deux chiffres faux dans cette enquete. La sonde s'annonce au
+ * premier passage dans les deux cas — une sonde muette rend le silence
+ * indecidable. Diagnostic pur : aucun effet sur le flux quand elle est eteinte.
+ */
+static void pq_alsa_out_probe(void *_state, const uint8_t *in, unsigned int in_len,
+			      int rv, int rv_avant_reprise)
+{
+	struct pq_state_alsa *state = _state;
+	static int on = -1;
+	static unsigned long long n, muettes, ecrites_court, epipe, autres_err;
+	static unsigned long long pic_max;
+	unsigned int i;
+	unsigned long long pic = 0;
+	snd_pcm_state_t st;
+	snd_pcm_sframes_t dispo, retard = 0;
+
+	if (on < 0) {
+		const char *e = getenv("GAPK_ALSA_PROBE");
+		on = (e && *e == '1') ? 1 : 0;
+		LOGPGAPK(LOGL_NOTICE, "SONDE GAPK_ALSA_PROBE %s\n",
+			 on ? "ACTIVE" : "inactive");
+	}
+	if (!on)
+		return;
+
+	for (i = 0; i + 1 < in_len; i += 2) {
+		int16_t s = (int16_t)(in[i] | (in[i + 1] << 8));
+		unsigned long long a = (s < 0) ? (unsigned long long)-(long long)s : (unsigned long long)s;
+		if (a > pic)
+			pic = a;
+	}
+	n++;
+	if (pic == 0)
+		muettes++;
+	if (pic > pic_max)
+		pic_max = pic;
+	if (rv >= 0 && (unsigned int)rv != in_len / 2)
+		ecrites_court++;
+	/* L'ECHEC EST RECUPERE EN SILENCE par pq_cb_alsa_output : sur -EPIPE il
+	 * fait snd_pcm_prepare() puis reecrit, et ne renvoie que le rv d'apres.
+	 * Un flux qui sous-alimente en permanence boucle donc XRUN -> prepare ->
+	 * write sans que rien ne le dise, et PulseAudio n'a jamais rien en file
+	 * (symptome observe : « Buffer Latency: 0 usec » constant). C'est ce que
+	 * ce compteur rend visible. */
+	if (rv_avant_reprise == -EPIPE)
+		epipe++;
+	else if (rv_avant_reprise < 0)
+		autres_err++;
+
+	st = snd_pcm_state(state->pcm_handle);
+	dispo = snd_pcm_avail_update(state->pcm_handle);
+	if (snd_pcm_delay(state->pcm_handle, &retard) < 0)
+		retard = -1;
+
+	if (n <= 3 || (n % 250) == 0)
+		LOGPGAPK(LOGL_NOTICE, "GAPK-ALSA-PROBE : %llu blocs, in_len=%u "
+			 "(%u ech), rendus par ALSA=%d -- blocs MUETS : %llu, "
+			 "ecritures courtes : %llu, XRUN recuperes : %llu, "
+			 "autres erreurs : %llu, crete max vue : %llu, "
+			 "etat=%s avail=%ld delay=%ld\n",
+			 n, in_len, in_len / 2, rv, muettes, ecrites_court,
+			 epipe, autres_err, pic_max,
+			 snd_pcm_state_name(st), (long)dispo, (long)retard);
+}
