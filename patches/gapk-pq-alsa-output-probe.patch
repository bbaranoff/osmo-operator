+			rc = snd_pcm_hw_params_set_buffer_size_near(state->pcm_handle,
+								   hw_params, &buffer);
+			if (rc < 0)
+				goto out_free_par;
+		}
+	}
+
 	rc = snd_pcm_hw_params(state->pcm_handle, hw_params);
 	if (rc < 0)
 		goto out_free_par;
 
 	snd_pcm_hw_params_free(hw_params);
 
+	/* SW params : demarrer seulement quand la moitie du tampon est remplie, pour
