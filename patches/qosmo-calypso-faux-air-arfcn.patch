@@ -2,6 +2,37 @@
 #include "qemu/osdep.h"
 #include "hw/arm/calypso/calypso_trf6151.h"
 #include "hw/arm/calypso/calypso_tsp.h"
+#include "hw/arm/calypso/calypso_rf_arfcn.h"
+#include <sys/mman.h>
