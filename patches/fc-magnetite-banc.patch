+/* [2026-10-21] banc osmo-operator : enregistrement robuste aux touches.
+ * - BANC_REG_AUTO (defaut 1) : nm_registration() part toujours en automatique. Le mode manuel
+ *   memorise en FFS (/mmi/mmidata) sans operateur connu (LOCI vierge) laissait le MM sans
+ *   recherche (+CREG 0) et le MMI affichait "Network Forbidden".
+ * - nm_nrg_robuste() : si l'ACI repond AT_BUSY (une commande MM en cours, liste PLMN lancee au
+ *   clavier, +COPS d'un autre canal...), on l'abandonne et on relance une fois. */
+#ifndef BANC_REG_AUTO
+#define BANC_REG_AUTO 1
+#endif
+static U8 nm_reg_attente;   /* nm_registration() refusee faute de SIM active : a relancer */
+void nm_reg_en_attente (void)
+{
+    if (!nm_reg_attente)
+        return;
+    nm_reg_attente = 0;
+    TRACE_EVENT("nm_reg_en_attente: SIM active, enregistrement relance");
+    nm_registration(NM_AUTOMATIC, 0, 0);
+}
+
+static T_ACI_RETURN nm_nrg_robuste (T_ACI_NRG_RGMD rm, char *opr)
+{
+    T_ACI_RETURN r = sAT_PercentNRG(CMD_SRC_LCL, rm, NRG_SVMD_Full, NRG_FRMT_Numeric, opr);
+    if (r == AT_BUSY)
+    {
+        TRACE_EVENT("nm_nrg_robuste: AT_BUSY, abandon COPS/NRG et relance");
+        sAT_Abort(CMD_SRC_LCL, AT_CMD_COPS);
+        sAT_Abort(CMD_SRC_LCL, AT_CMD_NRG);
+        r = sAT_PercentNRG(CMD_SRC_LCL, rm, NRG_SVMD_Full, NRG_FRMT_Numeric, opr);
+    }
+    if (r != AT_EXCT && r != AT_CMPL)
+        TRACE_EVENT_P1("nm_nrg_robuste: sAT_PercentNRG -> %d", r);
+    return r;
+}
+
