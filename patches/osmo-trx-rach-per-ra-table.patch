@@ -35,6 +35,8 @@
 
 extern "C" {
 #include <osmocom/core/panic.h>
+#include <osmocom/core/bits.h>
+#include <osmocom/coding/gsm0503_coding.h>
 #include "convolve.h"
 #include "scale.h"
 #include "mult.h"
@@ -2148,6 +2150,96 @@ bool sigProcLibSetup()
   generateRACHSequence(&gRACHSequences[1], gRACHSynchSequenceTS1, 1);
   generateRACHSequence(&gRACHSequences[2], gRACHSynchSequenceTS2, 1);
 
+  /* DUMP RACH ref 2026-06-05 (OUTIL DE PREUVE, PAS LE FINAL) : access-burst
+   * [8 tail][41 sync TS0][36 data][3 tail] module par le modulateur EXACT d'osmo-trx
+   * (Laurent, sps=4) -> /root/rach_ref.cs16, rejoue par le device (sa modulation maison
+   * ne correle pas). data : ZERO si CALYPSO_UL_RA non defini (PORTE 1 = rc>0, la sync
+   * seule suffit) ; sinon gsm0503_rach_ext_encode(RA,BSIC) (PORTE 2 = CHAN RQD). RA/BSIC
+   * viennent de l'ENV (config, PAS de hardcode). Le FINAL = device encode+modulate le
+   * RA REEL (plombe du BSP) + BSIC reel, dynamiquement. */
+  {
+    static const char SYNC[] = "01001011011111111001100110101010001111000";
+    char bs[89];
+    for (int i = 0; i < 88; i++) bs[i] = '0';
+    for (int i = 0; i < 41; i++) bs[8 + i] = SYNC[i];
+    const char *era = getenv("CALYPSO_UL_RA");
+    if (era && *era) {
+      const char *ebs = getenv("CALYPSO_UL_BSIC");
+      uint16_t ra = (uint16_t) strtol(era, NULL, 0);
+      uint8_t bsic = (uint8_t)(ebs && *ebs ? atoi(ebs) : 0);
+      ubit_t coded[40]; memset(coded, 0, sizeof(coded));
+      gsm0503_rach_ext_encode(coded, ra, bsic, false);   /* 36 bits codes (RA + parite BSIC) */
+      for (int i = 0; i < 36; i++) bs[49 + i] = coded[i] ? '1' : '0';
+      LOG(NOTICE) << "[rach-ref] RA=" << (int) ra << " BSIC=" << (int) bsic << " (PORTE 2, env)";
+    } else {
+      LOG(NOTICE) << "[rach-ref] sync seule, data=0 (PORTE 1 ; set CALYPSO_UL_RA pour PORTE 2)";
+    }
+    bs[88] = 0;
+    BitVector ab(bs);
+    signalVector *rb = modulateBurst(ab, 68, 4, false);
+    if (rb) {
+      FILE *f = fopen("/root/rach_ref.cs16", "wb");
+      if (f) {
+        float *p = (float *) rb->begin();
+        for (size_t i = 0; i < rb->size(); i++) {
+          float I = p[2 * i] * 20000.0f, Q = p[2 * i + 1] * 20000.0f;
+          if (I > 32767.0f) I = 32767.0f; else if (I < -32768.0f) I = -32768.0f;
+          if (Q > 32767.0f) Q = 32767.0f; else if (Q < -32768.0f) Q = -32768.0f;
+          int16_t s[2] = { (int16_t) I, (int16_t) Q };
+          fwrite(s, sizeof(int16_t), 2, f);
+        }
+        fclose(f);
+        LOG(NOTICE) << "[rach-ref] dumped " << rb->size() << " IQ -> /root/rach_ref.cs16";
+      }
+      delete rb;
+    }
+  }
+
+  /* TABLE per-RA 2026-06-05 (NO-HARDCODE) : la vraie RA du mobile (d_rach@0x0474,
+   * plombee via /dev/shm/calypso_rach) varie a chaque burst. On pre-genere ICI la
+   * modulation EXACTE d'osmo-trx (Laurent sps=4, la seule qui correle son propre
+   * detecteur) pour chaque RA 0x00..0x0f a BSIC reel -> /root/rach_ref_RA<nn>.cs16.
+   * Le device (ul_drain) selectionne le ref de la vraie RA recue. BSIC = celui du
+   * BTS (env CALYPSO_UL_BSIC, defaut 7 ; colore la parite). Pas de RA hardcodee :
+   * c'est un codebook, la vraie RA en selectionne l'entree. */
+  {
+    static const char SYNC[] = "01001011011111111001100110101010001111000";
+    const char *ebs = getenv("CALYPSO_UL_BSIC");
+    uint8_t bsic = (uint8_t)(ebs && *ebs ? atoi(ebs) : 7);
+    int ntab = 0;
+    for (int ra = 0; ra < 16; ra++) {
+      char bs[89];
+      for (int i = 0; i < 88; i++) bs[i] = '0';
+      for (int i = 0; i < 41; i++) bs[8 + i] = SYNC[i];
+      ubit_t coded[40]; memset(coded, 0, sizeof(coded));
+      gsm0503_rach_ext_encode(coded, (uint16_t) ra, bsic, false);
+      for (int i = 0; i < 36; i++) bs[49 + i] = coded[i] ? '1' : '0';
+      bs[88] = 0;
+      BitVector ab(bs);
+      signalVector *rb = modulateBurst(ab, 68, 4, false);
+      if (!rb) continue;
+      char path[64];
+      snprintf(path, sizeof(path), "/root/rach_ref_RA%02x.cs16", ra);
+      FILE *f = fopen(path, "wb");
+      if (f) {
+        float *p = (float *) rb->begin();
+        for (size_t i = 0; i < rb->size(); i++) {
+          float I = p[2 * i] * 20000.0f, Q = p[2 * i + 1] * 20000.0f;
+          if (I > 32767.0f) I = 32767.0f; else if (I < -32768.0f) I = -32768.0f;
+          if (Q > 32767.0f) Q = 32767.0f; else if (Q < -32768.0f) Q = -32768.0f;
+          int16_t s[2] = { (int16_t) I, (int16_t) Q };
+          fwrite(s, sizeof(int16_t), 2, f);
+        }
+        fclose(f);
+        ntab++;
+      }
+      delete rb;
+    }
+    LOG(NOTICE) << "[rach-ref] table per-RA : " << ntab
+                << " refs (RA 0x00..0x0f, BSIC=" << (int) bsic
+                << ") -> /root/rach_ref_RA*.cs16";
+  }
+
   generateSCHSequence(1);
   generateDummyMidamble(1);
 
