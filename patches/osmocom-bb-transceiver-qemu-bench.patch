 static int
 _trx_ctrl_cmd_settsc(struct trx *trx, const char *cmd, const char *args)
 {
-	LOGP(DTRX, LOGL_ERROR,
-		"TRX received SETTSC command ! "
-		"OpenBTS should be configured to send SETBSIC command !\n");
+	/* [2026-10-19] osmo-bts-trx envoie SETTSC (critique) puis SETBSIC ; le TSC
+	 * est le BCC du BSIC, le firmware le derive lui-meme : on acquiesce. */
+	int tsc = atoi(args);
 
-	return _trx_ctrl_send_resp(trx, cmd, "%d", -1);
+	if (tsc < 0 || tsc > 7)
+		return _trx_ctrl_send_resp(trx, cmd, "%d", -1);
+
+	/* osmo-bts-trx n'envoie SETBSIC qu'en mode legacy : sans --bsic, on prend
+	 * NCC 0 et BCC = TSC, sinon on verifie que le BCC donne suit le TSC. */
+	if (trx->bsic == BSIC_INVAL) {
+		trx->bsic = tsc;
+		LOGP(DTRX, LOGL_NOTICE, "SETTSC %d: no BSIC known, assuming NCC 0 -> BSIC %d (use --bsic)\n", tsc, trx->bsic);
+	} else if ((trx->bsic & 7) != tsc) {
+		LOGP(DTRX, LOGL_ERROR, "SETTSC %d does not match BCC of BSIC %d\n", tsc, trx->bsic);
+		return _trx_ctrl_send_resp(trx, cmd, "%d", -1);
+	} else
+		LOGP(DTRX, LOGL_INFO, "SETTSC %d accepted (BSIC %d)\n", tsc, trx->bsic);
+	return _trx_ctrl_send_resp(trx, cmd, "%d", 0);
+}
+
+/* [2026-10-19] Deux commandes d'osmo-bts-trx (>= 1.3) inconnues d'OpenBTS 2013 :
+ *  - SETFORMAT <ver> : negociation du format TRXD. Nous ne parlons que la v0 ;
+ *    reponse « RSP SETFORMAT 0 <ver> » (statut = version retenue, params =
+ *    la requete, ce que cmd_matches_rsp() d'osmo-bts compare) ;
+ *  - NOMTXPOWER (critique) : puissance nominale, « RSP NOMTXPOWER 0 <dBm> ». */
+#define TRX_NOM_TX_POWER_DBM	23
+
+static int
+_trx_ctrl_cmd_setformat(struct trx *trx, const char *cmd, const char *args)
+{
+	LOGP(DTRX, LOGL_INFO, "SETFORMAT %s requested, answering TRXD version 0\n", args);
+	return _trx_ctrl_send_resp(trx, cmd, "%d %s", 0, args);
+}
+
+static int
+_trx_ctrl_cmd_nomtxpower(struct trx *trx, const char *cmd, const char *args)
+{
+	return _trx_ctrl_send_resp(trx, cmd, "%d %d", 0, TRX_NOM_TX_POWER_DBM);
+}
+
+static int
+_trx_ctrl_cmd_rfmute(struct trx *trx, const char *cmd, const char *args)
+{
+	/* RFMUTE 0|1 (non critique) : rien a couper dans QEMU, on acquiesce */
+	return _trx_ctrl_send_resp(trx, cmd, "%d", 0);
 }
 
