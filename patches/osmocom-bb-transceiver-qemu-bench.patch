 }
 
+/* [2026-10-21] mesure de D = fn1 - fn2 (voir app.h). idx 0 : telephone 1, 1 : telephone 2. */
+static void
+_fn_delta_write(struct app_state *as)
+{
+	char tmp[256];
+	FILE *f;
+
+	if (!as->fn_delta_file)
+		return;
+	snprintf(tmp, sizeof(tmp), "%s.tmp", as->fn_delta_file);
+	f = fopen(tmp, "w");
+	if (!f)
+		return;
+	fprintf(f, "%d\n", as->fn_delta);
+	fclose(f);
+	rename(tmp, as->fn_delta_file);
+}
+
+int
+app_fn_delta_sample(struct app_state *as, int idx, uint32_t fn)
+{
+	struct timespec now;
+	int64_t d, el_ns, fn1;
+	unsigned i, best = 0, best_n = 0;
+
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	as->clk[idx].fn = fn;
+	as->clk[idx].t = now;
+	as->clk[idx].valid = 1;
+	if (idx != 1 || !as->clk[0].valid)
+		return 0;
+
+	/* fn du telephone 1 a cet instant : son dernier fn + les trames ecoulees depuis */
+	el_ns = (int64_t)(now.tv_sec - as->clk[0].t.tv_sec) * 1000000000LL + (now.tv_nsec - as->clk[0].t.tv_nsec);
+	if (el_ns < 0 || el_ns > 2000000000LL)
+		return 0;
+	fn1 = (int64_t)as->clk[0].fn + (el_ns + 2307692) / 4615385;
+	d = ((fn1 - (int64_t)fn) % TRX_GSM_MAX_FN + TRX_GSM_MAX_FN) % TRX_GSM_MAX_FN;
+	if (d > TRX_GSM_MAX_FN / 2)
+		d -= TRX_GSM_MAX_FN;
+	as->fn_samples[as->fn_n_samples++] = (int)d;
+	as->fn_n_total++;
+	if (as->fn_n_samples < (as->fn_delta_valid ? 64u : 16u))
+		return 0;
+
+	/* le mode des echantillons */
+	for (i = 0; i < as->fn_n_samples; i++) {
+		unsigned j, n = 0;
+		for (j = 0; j < as->fn_n_samples; j++)
+			if (as->fn_samples[j] == as->fn_samples[i])
+				n++;
+		if (n > best_n) { best_n = n; best = i; }
+	}
+	d = as->fn_samples[best];
+	as->fn_n_samples = 0;
+
+	if (!as->fn_delta_valid) {
+		as->fn_delta = (int)d; as->fn_delta_valid = 1;
+		LOGP(DL1C, LOGL_NOTICE, "Phone 2 frame offset: fn1 - fn2 = %d (%u/%u samples) -> written to %s\n",
+		     as->fn_delta, best_n, 16, as->fn_delta_file ? as->fn_delta_file : "(nowhere)");
+		_fn_delta_write(as);
+	} else if (d - as->fn_delta >= 2 || as->fn_delta - d >= 2) {
+		LOGP(DL1C, LOGL_NOTICE, "Phone 2 frame offset drifted: %d -> %d (%u/64 samples)\n", as->fn_delta, (int)d, best_n);
+		as->fn_delta = (int)d;
+		_fn_delta_write(as);
+	}
+	return 0;
+}
