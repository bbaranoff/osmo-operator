 	/* Options */
 	uint16_t arfcn_sync;
+	int no_sync;	/* [2026-10-19] mode BTS sans synchro sur une cellule (QEMU, pas d'air) */
+
+	/* [2026-10-21] telephone 2 (TS1, -2) : son compteur de trames est independant de celui du
+	 * telephone 1 (chacun part de 0 a son boot). On mesure D = fn1 - fn2 sur les DATA_IND des deux
+	 * (fn1 extrapole a l'instant du DATA_IND du 2 par le temps ecoule, 4.615 ms par trame), et on
+	 * renumerote : BURST_REQ vers le 2 avec fn - D, indications du 2 avec fn + D. D est publie dans
+	 * fn_delta_file pour l'air (pont/air.py) qui tague de meme les bursts du telephone 2. */
+	struct { uint32_t fn; struct timespec t; int valid; } clk[2];
+	int fn_delta, fn_delta_valid;
+	int fn_samples[64]; unsigned fn_n_samples, fn_n_total;
+	const char *fn_delta_file;
 };
 
+#define TRX_GSM_MAX_FN 2715648u
+/* fn du telephone 2 -> numerotation du telephone 1 (la BTS), et retour */
+#define TRX_FN_P2_TO_BTS(as, fn) ((uint32_t)(((int64_t)(fn) + (as)->fn_delta + TRX_GSM_MAX_FN) % TRX_GSM_MAX_FN))
+#define TRX_FN_BTS_TO_P2(as, fn) ((uint32_t)(((int64_t)(fn) - (as)->fn_delta + 2 * (int64_t)TRX_GSM_MAX_FN) % TRX_GSM_MAX_FN))
+int app_fn_delta_sample(struct app_state *as, int idx, uint32_t fn);
+
 
 #endif /* __TRX_APP_H__ */
