+def _host_gpu_vendors() -> set[str]:
+    """PCI vendor ids of the host's DRM cards ("0x1002" = AMD, "0x10de" = NVIDIA)."""
+    vendors: set[str] = set()
+    drm = "/sys/class/drm"
+    try:
+        for card in os.listdir(drm):
+            vp = os.path.join(drm, card, "device", "vendor")
+            if card.startswith("card") and os.path.isfile(vp):
+                with open(vp) as fh:
+                    vendors.add(fh.read().strip().lower())
+    except OSError:
+        pass
+    return vendors
+
+
+def _host_cpu_has_virt() -> bool:
+    """True when the CPU exposes VT-x (vmx) or AMD-V (svm) - i.e. it is enabled in the firmware."""
+    try:
+        with open("/proc/cpuinfo") as fh:
+            for line in fh:
+                if line.startswith("flags"):
+                    flags = line.split(":", 1)[1].split()
+                    return "vmx" in flags or "svm" in flags
+    except OSError:
+        pass
+    return False
+
