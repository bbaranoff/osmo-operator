+def osmo_bench_args(qemu_audio: str | None) -> list[str]:
+    """Extra devices that put the VM on the osmocom bench: the modem, and the
+    voice bridge.
+
+    The modem (tools/osmo-phonesim-banc.py) is a PCI serial port, not ISA and
+    not USB. The UEFI firmware treats an ISA serial port as a console and
+    mistakes the modem's replies for keypresses, so it never boots; usb-serial
+    would need ftdi_sio, which this kernel doesn't have. 8250_pci is built in,
+    so the port shows up on its own as /dev/ttyS1, which is what ModemManager
+    probes. QEMU only listens here - the modem connects afterwards, once the
+    firmware is done booting (see osmo-pmos-setup).
+
+    There are TWO sound cards, because QEMU cannot push audio into a guest's
+    speaker: of an emulated card, playback goes out to a host sink and capture
+    comes in from a host source. The call's downlink lives on the host, so it
+    can only enter through the guest's capture side - never through its
+    speaker. One card alone therefore gives the guest the network's point of
+    view (it hears the far end on its microphone), not a handset's.
+
+    So: the "bridge" card is wired to the bench's voice path - gsm_audio
+    carries the downlink (RTP from osmo-mgw), so its monitor feeds that card's
+    capture; gsm_mic carries the uplink, so it takes what that card plays. The
+    "handset" card stays on the host's default devices, the real speakers and
+    microphone. Crossing the two inside the guest (see osmo-pmos-setup) puts
+    the VM in the middle of the voice path for real.
+
+    The slots are pinned so the guest can tell them apart by name alone:
+    0000:00:12.0 is the bridge, 0000:00:13.0 the handset.
+
+    Beware the pa backend: it looks for PulseAudio's pidfile, which doesn't
+    exist when PipeWire provides the service - there is only the socket, so we
+    name it explicitly. And an unknown backend doesn't error out, it segfaults;
+    this qemu only knows none, alsa, pa, sdl and wav.
+    """
+    port = os.environ.get("OSMO_PMOS_AT_PORT", "12346")
+    args: list[str] = [
+        "-chardev",
+        f"socket,id=gsmchr,host=127.0.0.1,port={port},server=on,wait=off",
+    ]
+    # [2026-09-08] virtio-serial, not a 16550. QEMU paces its emulated 16550
+    # at the programmed baud rate (115200 -> ~11 KB/s each way), so PPP data
+    # over the modem port crawled and every page filled a minute of queue.
+    # A virtconsole port has no baud rate: it shows up as /dev/hvc0 in the
+    # guest, a tty like any other, and ModemManager probes it thanks to the
+    # udev rule osmo-pmos-setup installs. OSMO_PMOS_SERIAL=pci brings the
+    # 16550 (ttyS1) back.
+    if os.environ.get("OSMO_PMOS_SERIAL", "virtio") == "pci":
+        args += ["-device", "pci-serial,chardev=gsmchr"]
+    else:
+        # Two ports, like a real modem: hvc0 is the command port (AT, URCs,
+        # calls, SMS), hvc1 the data port where ModemManager dials ATD*99 and
+        # runs PPP - so the phone keeps an AT channel while data is up. The
+        # data port listens on OSMO_PMOS_AT_PORT + 1 (12347 by default).
+        port_data = int(port) + 1
+        args += [
+            "-chardev",
+            f"socket,id=gsmdata,host=127.0.0.1,port={port_data},server=on,wait=off",
+            "-device",
+            "virtio-serial-pci,id=osmovser",
+            "-device",
+            "virtconsole,chardev=gsmchr,name=osmo.modem",
+            "-device",
+            "virtconsole,chardev=gsmdata,name=osmo.data",
+        ]
+
+    # --audio wins if it was asked for explicitly: it adds a card of its own.
+    if qemu_audio:
+        return args
+
+    sock = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "pulse/native"
+    if not sock.is_socket():
+        logging.warning(f"WARNING: no PulseAudio socket ({sock}), VM without sound")
+        return args
+
+    out = os.environ.get("OSMO_PMOS_SINK", "gsm_mic")
+    src = os.environ.get("OSMO_PMOS_SOURCE", "gsm_audio.monitor")
+    # [2026-09-09] The handset card is NAMED too, when the launcher says so:
+    # left to "the host's defaults", it landed on whatever was default when
+    # QEMU connected - the raw card, since the echo canceller (osmo_hp_ec /
+    # osmo_mic_ec) only came later with osmo-pmos-setup - and then had to be
+    # moved. osmo-pmos-qemu now loads the canceller first and passes its
+    # names here (OSMO_PMOS_HP / OSMO_PMOS_MIC); unset, the defaults apply.
+    combine = f"pa,id=combine,server={sock}"
+    hp = os.environ.get("OSMO_PMOS_HP", "")
+    mic = os.environ.get("OSMO_PMOS_MIC", "")
+    if hp:
+        combine += f",out.name={hp}"
+    if mic:
+        combine += f",in.name={mic}"
+    args += [
+        # The bridge: the call itself.
+        "-audiodev",
+        f"pa,id=gsm,server={sock},out.name={out},in.name={src}",
+        "-device",
+        "intel-hda,id=hdagsm,addr=0x12",
+        "-device",
+        "hda-duplex,bus=hdagsm.0,audiodev=gsm",
+        # The handset: the host's own speakers and microphone.
+        "-audiodev",
+        combine,
+        "-device",
+        "intel-hda,id=hdacombine,addr=0x13",
+        "-device",
+        "hda-duplex,bus=hdacombine.0,audiodev=combine",
+    ]
+    return args
+
