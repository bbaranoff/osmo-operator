[Unit]
# Runs install-web-service.sh at container boot, not at image build.
#
# Why not a `RUN` in the Dockerfile. Two reasons, each sufficient:
#   1. the script ends with `systemctl daemon-reload` + `systemctl restart`;
#      during `docker build` there is no systemd (« System has not been
#      booted with systemd »), and the script runs under `set -eu`: the build
#      would fail;
#   2. it generates a self-signed TLS certificate. A private key created at
#      build time would be identical for everyone pulling the image — anyone
#      could impersonate the console. It is therefore generated once per
#      container, at first boot.
#
# No `Before=osmo-egprs-web.service` — deliberate. The script ends with
# `systemctl restart osmo-egprs-web`: ordering this unit before the service
# would create a cycle (systemctl would wait on a job waiting on this unit).
# Accepted consequence, visible in the journal: at the very first boot the
# dashboard starts once without TLS (« HTTPS non arme : certificat absent »),
# then this unit installs the certificate and restarts it with TLS. At later
# boots the certificate is already there (the script is idempotent, 30-day
# guard) and there is no second start.
#
# ⚠️ The certificate lives in /opt/GSM/osmo-egprs-web/tls, inside the container:
# it does not survive a `docker rm` (containers are started with --rm). This is
# intended — it is regenerated at the next boot, with the current IPs in the SAN.
Description=Installe/rafraichit le dashboard osmo-egprs-web (runtime, unit, certificat TLS)
Documentation=file:/opt/GSM/osmo-egprs-web/install-web-service.sh
After=network.target local-fs.target
ConditionPathIsDirectory=/opt/GSM/osmo-egprs-web

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/GSM/osmo-egprs-web/install-web-service.sh
# The script may run an `npm install`: generous, but bounded.
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-egprs-web-install

[Install]
WantedBy=multi-user.target
