[Unit]
Description=osmo-operator - les supplements choisis dans l installeur (premier demarrage)
Documentation=file:/opt/GSM/osmo-operator/tools/osmo-supplements-firstboot.sh
# Enabled by the Calamares job osmosupplements when a box of the « Supplements »
# page is ticked; disables itself once the supplements are installed.
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/osmo-supplements

[Service]
# simple, not oneshot: a oneshot in multi-user.target would hold the boot (and
# the login screen) until the end - one hour for the operator image.
Type=simple
Environment=HOME=/root
ExecStart=/bin/bash /opt/GSM/osmo-operator/tools/osmo-supplements-firstboot.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-supplements

[Install]
WantedBy=multi-user.target
