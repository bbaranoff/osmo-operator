[Unit]
Description=osmo-operator - les supplements choisis dans l installeur (premier demarrage)
Documentation=file:/opt/GSM/osmo-operator/tools/osmo-supplements-firstboot.sh
# [2026-10-24] Activee par le job Calamares osmosupplements quand une case de la page
# « Supplements » est cochee ; se desactive d elle-meme une fois les supplements poses.
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/osmo-supplements

[Service]
# simple, PAS oneshot : un oneshot de multi-user.target retiendrait le demarrage (et
# l ecran de connexion) jusqu a la fin - une heure pour l image operateur.
Type=simple
Environment=HOME=/root
ExecStart=/bin/bash /opt/GSM/osmo-operator/tools/osmo-supplements-firstboot.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-supplements

[Install]
WantedBy=multi-user.target
