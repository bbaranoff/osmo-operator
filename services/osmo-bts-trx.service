[Unit]
Description=Osmocom GSM Base Transceiver Station (BTS)
# Network and loopback interface must be ready.
# network.target only, not network-online.target: the latter can cost up to
# 2 min at boot (systemd-networkd-wait-online) on a bench whose interfaces
# (apn0, the tun/veth of the packet core) are never "online" in that sense and
# which often boots without a cable. The interfaces are configured; the default
# route may arrive later.
After=network.target
# When osmo-bsc runs on the same machine, uncomment the next line
# After=osmo-bsc.service

[Service]
Type=simple
# Adjust the user (e.g. root or the current user 'nirvana')
User=root
Group=root

# Path to the executable (check with 'which osmo-bts-trx')
# -c selects the configuration file
# -r 1 enables real-time priority when the kernel allows it
ExecStart=/usr/bin/osmo-bts-trx -c /etc/osmocom/osmo-bts-trx.cfg -r 1

# Automatic restart on crash (radio stability)
Restart=always
RestartSec=5

# Resource limits to avoid system "hangs"
LimitNOFILE=65535
CPUSchedulingPolicy=rr
CPUSchedulingPriority=1

[Install]
WantedBy=multi-user.target
