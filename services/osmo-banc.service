[Unit]
Description=osmo-operator - banc GSM autonome (start.sh, session tmux « calypso »)
Documentation=file:/opt/GSM/osmo-operator/README.md
# The bench needs the system sound (osmo-pulse), the node's private addresses
# and the dashboard (the bridge pushes the FFT to it). No Requires=: a missing
# service must not prevent the radio from coming up.
# network.target only, not network-online.target: the latter can cost up to
# 2 min at boot (systemd-networkd-wait-online) on a bench whose interfaces
# (apn0, the tun/veth of the packet core) are never "online" in that sense and
# which often boots without a cable. The interfaces are configured; the default
# route may arrive later.
After=network.target osmo-pulse.service osmo-ip-plan.service osmo-egprs-web.service osmo-qemu-link.service
# osmo-egprs-web is pulled in by the bench (Wants=): a stop/start cycle must
# not leave the dashboard down.
Wants=osmo-pulse.service osmo-egprs-web.service
ConditionPathExists=/opt/GSM/osmo-operator/start.sh
# One native bench at a time: the multi-operator bench depends on this one
# (Requires= in osmo-multi.service), it does not replace it.
#
# Installed, not enabled: a fresh machine must not bring up QEMU/Calypso and
# the whole core before the session opens, on a configuration (node, --dsp,
# topology) nobody has chosen.
#   systemctl start osmo-banc           for one session (or the desktop icon)
#   systemctl enable --now osmo-banc    to start it at every boot
# At build time: OSMO_ISO_BANC=1 (or --banc) enables the unit in the image.

[Service]
# ── Oneshot + RemainAfterExit: the bench lives in tmux, not in ExecStart ──
# start.sh hands over to run.sh (qosmo-grgsm), which brings everything up in a
# tmux session and then exits without attaching (no tty). With Type=simple,
# systemd would take that exit for the end of the service and kill the cgroup,
# hence the whole stack. With oneshot + RemainAfterExit the unit stays
# « active (exited) » and the cgroup processes (tmux, daemons, qemu, bridge)
# live until ExecStop.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/GSM/osmo-operator
# ── The same environment as a root terminal ──────────────────────────────
# HOME: mobile.cfg lives in /root/.osmocom/bb. PATH: the python venv
# (/root/.env) that ~/.bashrc activates; gr-gsm and the bridges depend on it and
# systemd does not read ~/.bashrc. /etc/osmocom/coeur.env (N_MS) is loaded by
# start.sh itself.
Environment=HOME=/root USER=root LOGNAME=root
Environment=VIRTUAL_ENV=/root/.env
Environment=PATH=/root/.env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PULSE_SERVER=unix:/var/run/pulse/native
# No menu, no tmux attach, no colours: nobody is in front of it.
Environment=NO_MENU=1 CALYPSO_NO_ATTACH=1 NO_COLOR=1 OSMO_NO_TERM=1 OSMO_LAUNCH_APPS=0
# Launch options (--grgsm, --op 2, --node 3, --regen...); the DSP is the
# default of start.sh, --grgsm the gr-gsm chain:
#   - persistent: OSMO_BANC_ARGS="--grgsm" in /etc/default/osmo-banc
#   - one-off: launch.sh sets them through systemctl set-environment
EnvironmentFile=-/etc/default/osmo-banc
# --no-attach: the start.sh option (same effect as CALYPSO_NO_ATTACH=1 above).
# It goes here, on the command line - not on ConditionPathExists, which only
# takes a path: « path --no-attach » does not exist, and the unit would be
# skipped without ever starting.
ExecStart=/bin/bash /opt/GSM/osmo-operator/start.sh --no-attach $OSMO_BANC_ARGS
ExecStop=/bin/bash /opt/GSM/osmo-operator/start.sh --stop
# The core follows the bench. osmo-hlr is a separate unit started by run.sh;
# it is stopped here so that it does not keep its subscribers after the bench
# is gone. Leading `-`: an already stopped or missing unit must not fail the
# stop. osmo-egprs-web is not named here: the dashboard stays online by
# default, bench stopped included (see osmo-egprs-web.service).
ExecStop=-/usr/bin/systemctl stop osmo-hlr.service
# The desktop widget follows the bench. osmo-fft-snap.py reads /psd and the
# mobile.log of the run: a new bench means new paths under /run/user/0 and a
# new log. It is restarted with the bench, never required - leading `-` and
# --no-block: the widget is an ornament, it must neither fail nor delay the
# start. try-restart does nothing if the unit is absent (image without desktop).
ExecStartPost=-/usr/bin/systemctl --no-block try-restart osmo-fft-snap.service
# osmo-wallpaper is not restarted here: the background stays the raw
# illustration (/usr/share/backgrounds/gsm-lab-wallpaper.jpg).
# QEMU + Calypso + mobile attach: several minutes on a VM.
TimeoutStartSec=900
# At machine shutdown systemd waits this long before killing what is left. The
# stack stops in a few seconds; past 30 s it is stuck and SIGKILL is the right
# answer.
TimeoutStopSec=30
# At stop, whatever start.sh --stop did not tear down is terminated by systemd
# (SIGTERM then SIGKILL on the cgroup): nothing left from a previous run.
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-banc

# ── Taking over ─────────────────────────────────────────────────────────────
#   tmux attach -t calypso        (root; Ctrl-b d to detach)
#   journalctl -u osmo-banc -f    (the output of start.sh / run.sh)
# The tmux socket is root's default one (/tmp/tmux-0/default): PrivateTmp is
# NOT enabled here, otherwise the session would be invisible outside the service.

[Install]
WantedBy=multi-user.target
