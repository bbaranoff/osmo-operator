[Unit]
Description=osmo-nitb-for-calypso Operations Console (web dashboard)
Documentation=https://github.com/bbaranoff/osmo-egprs-web
After=network.target
# ── The dashboard stays up independently of the bench ───────────────────────
# No PartOf=osmo-banc.service: the dashboard stays online by default, bench
# stopped included. To stop it with the bench: CALYPSO_DASHBOARD_SUIT_BANC=1
# (startup_scripts/10-identite-noeud.sh); for systemd, add
# PartOf=osmo-banc.service (osmo-banc already has Wants= and After= towards
# this unit, so do not add After=osmo-banc.service here: it would be a cycle).

[Service]
Type=simple
WorkingDirectory=/opt/GSM/osmo-egprs-web
# TLS takes port 80. Plain HTTP goes to 8080: the two listeners cannot share a
# port, and removing plain HTTP would deprive `curl http://localhost` of any
# diagnostic entry point.
Environment=HTTP_PORT=8080
Environment=OSMO_NATIVE=1
Environment=OSMO_OP_IDS=1
# ⚠️ Do not remove: capture interface of the dashboard (GSMTAP/SCTP). Since
# install-web-service.sh reinstalls the unit from this file (the Dockerfile
# copies it to /opt/GSM/osmo-egprs-web/, see Dockerfile.run), this is the single
# source. Without CAP_IFACE the capture falls back to a default and the traffic
# tab stays silent — no error message.
Environment=CAP_IFACE=any
Environment=PULSE_SERVER=unix:/var/run/pulse/native
Environment=AUDIO_SOURCE=gsm_audio.monitor
# --- TLS -------------------------------------------------------------------
# server.js only arms the HTTPS listener if both files below exist; otherwise it
# logs « HTTPS non arme : certificat absent » and stays in plain HTTP.
# They are installed by install-web-service.sh (self-signed, never in the image:
# a private key in an image would be shared by everyone pulling it).
# The same request handler and the same WebSocket instance serve both ports --
# one entry is added, nothing is moved: http:// keeps working.
# ⚠️ TLS on port 80, not 443: the URL must be written `https://<ip>:80`
# explicitly (a browser reading `https://<ip>` would go to 443, closed), and
# `http://<ip>` no longer answers in plain HTTP — TLS listens there.
Environment=HTTPS_PORT=80
# ⚠️ /etc/osmo-web-tls, not /opt/GSM/osmo-egprs-web/tls. This is where
# install-web-service.sh writes the certificate (TLS_DIR), and it is also the
# default of server.js. Another path would leave the HTTPS listener unarmed and
# the dashboard in plain HTTP; a direct consequence is that the microphone
# button is then refused by the browser (navigator.mediaDevices does not exist
# outside a secure context).
Environment=TLS_CERT=/etc/osmo-web-tls/cert.pem
Environment=TLS_KEY=/etc/osmo-web-tls/key.pem
# ── The node path is not the same everywhere ────────────────────────────────
# On the host node comes from the nodesource package (/usr/bin/node; build-iso.sh
# removes the /usr/local/bin/node,npm,npx links, which would dangle). In the
# osmo-operator-* containers it comes from install-web-service.sh, which unpacks
# /opt/node and links it into /usr/local/bin. A hard-coded path fails on one
# side with status=203/EXEC (restart loop).
#
# /usr/bin/env resolves node through the PATH, so at either location. The PATH
# is set explicitly just above: systemd's own PATH does not always contain
# /usr/local/bin.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env node /opt/GSM/osmo-egprs-web/server.js --verbose
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-egprs-web

[Install]
WantedBy=multi-user.target
