[Unit]
Description=osmo-nitb-for-calypso Operations Console (web dashboard)
Documentation=https://github.com/bbaranoff/osmo-egprs-web
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/GSM/osmo-egprs-web
# Le TLS prend le 80 (demande explicite du 12/08). Le clair descend sur 8080 :
# les deux listeners ne peuvent pas partager un port, et supprimer le clair
# priverait `curl http://localhost` de tout point d'entree de diagnostic.
Environment=HTTP_PORT=8080
Environment=OSMO_NATIVE=1
Environment=OSMO_OP_IDS=1
# ⚠️ NE PAS RETIRER : interface de capture du dashboard (GSMTAP/SCTP). La copie
# de ce unit qui vit dans le depot osmo-egprs-web l'avait perdue ; comme
# install-web-service.sh reinstalle le unit depuis CE fichier (le Dockerfile le
# recopie dans /opt/GSM/osmo-egprs-web/, cf. Dockerfile.run), la source unique est
# ici. Sans CAP_IFACE la capture se rabat sur un defaut et l'onglet trafic se
# tait — panne silencieuse, aucun message d'erreur.
Environment=CAP_IFACE=any
Environment=PULSE_SERVER=unix:/var/run/pulse/native
Environment=AUDIO_SOURCE=gsm_audio.monitor
# --- TLS (12/08/2026) ---------------------------------------------------------
# server.js:1161-1183 n'arme le listener HTTPS que si CES DEUX fichiers existent ;
# sinon il journalise « HTTPS non arme : certificat absent » et reste en clair.
# Ils sont poses par install-web-service.sh (auto-signe, jamais dans l'image :
# une cle privee dans une image serait partagee par tous ceux qui la tirent).
# Le meme gestionnaire de requetes et la MEME instance WebSocket servent les deux
# portes -- on ajoute une entree, on ne deplace rien : http:// continue de marcher.
# ⚠️ TLS sur le 80, pas sur le 443 : l'URL doit donc s'ecrire `https://<ip>:80`
# explicitement (un navigateur qui lit `https://<ip>` irait sur 443, ferme), et
# `http://<ip>` ne repond plus en clair — c'est du TLS qui ecoute la.
Environment=HTTPS_PORT=80
# ⚠️ /etc/osmo-web-tls, PAS /opt/GSM/osmo-egprs-web/tls. C'est LA que
# install-web-service.sh ecrit le certificat (son § 3, variable TLS_DIR), et
# c'est aussi le defaut de server.js:1805. Ce unit nommait un troisieme
# chemin, que personne n'ecrit jamais : le certificat existait, le listener
# HTTPS ne s'armait pas, le journal disait « HTTPS non arme : certificat
# absent » en citant un repertoire absent, et le dashboard restait en clair.
# Consequence directe et sans rapport apparent : depuis une IP, le bouton
# micro etait REFUSE PAR LE NAVIGATEUR - navigator.mediaDevices n'existe pas
# hors contexte securise. Le diagnostic partait invariablement sur Firefox.
Environment=TLS_CERT=/etc/osmo-web-tls/cert.pem
Environment=TLS_KEY=/etc/osmo-web-tls/key.pem
# ⚠️ /usr/bin/node, PAS /usr/local/bin/node. Dans le conteneur, node vient de
# install-web-service.sh, qui deballe /opt/node et pose les liens dans
# /usr/local/bin. Dans l'ISO il vient du paquet nodesource, donc de
# /usr/bin/node, et build-iso.sh SUPPRIME les liens /usr/local/bin/node,npm,npx
# parce qu'ils y pendent dans le vide. Cette unite nommait l'autre chemin :
# apres installation sur disque, le service sortait en 203/EXEC a chaque
# demarrage, osmo-egprs-web-install echouait dans la foulee, et le dashboard
# n'avait ni TLS ni micro. /usr/bin/node existe des DEUX cotes (le paquet
# nodesource s'y installe aussi) : c'est le seul chemin qui vaut partout.
# ── LE CHEMIN DE NODE N EST PAS LE MEME PARTOUT ──────────────────────────────
# [2026-08-31] Cette ligne portait /usr/bin/node en dur. C est vrai sur l HOTE,
# faux dans les conteneurs osmo-operator-*, ou node vit en /usr/local/bin/node
# (lien vers /opt/node/bin/node, celui qu install-web-service.sh depose quand
# node manque). systemd sortait alors en
#     status=203/EXEC
# et relançait en boucle (Restart=on-failure). 203/EXEC ne dit pas « fichier
# introuvable » mais « je n ai pas pu executer » : on cherche des droits ou du
# SELinux, jamais un chemin.
#
# /usr/bin/env resout node dans le PATH, donc a l un OU l autre emplacement.
# Le PATH est pose explicitement juste au-dessus : celui de systemd ne contient
# pas toujours /usr/local/bin, et un env sans PATH sur mesure retomberait
# exactement sur le probleme qu on corrige.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env node /opt/GSM/osmo-egprs-web/server.js --verbose
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-egprs-web

[Install]
WantedBy=multi-user.target
