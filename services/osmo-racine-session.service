[Unit]
Description=osmo-operator - session root (systeme live de la partition osmo-racine)
Documentation=file:/usr/local/sbin/osmo-grub-esp
# Only on root's system, booted by the first GRUB menu with « osmo.racine »:
# the installer is hidden, the black box partition is mounted, and at
# shutdown what this session wrote is recorded in it (encrypted).
ConditionKernelCommandLine=osmo.racine
After=local-fs.target systemd-udev-settle.service network-online.target
Wants=systemd-udev-settle.service network-online.target
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# platform hierarchy off (root could otherwise clear the TPM) - the porte did
# it already when the session comes through it
ExecStart=-/bin/sh -c 'command -v tpm2_hierarchycontrol >/dev/null && TPM2TOOLS_TCTI=device:/dev/tpmrm0 tpm2_hierarchycontrol -C p phEnable clear'
ExecStart=/bin/sh -c 'rm -f /usr/share/applications/osmo-install.desktop /usr/share/applications/calamares.desktop /root/Desktop/osmo-install.desktop /root/Bureau/osmo-install.desktop /etc/skel/Desktop/osmo-install.desktop /etc/skel/Bureau/osmo-install.desktop; mkdir -p /var/lib/osmo-diffs; mountpoint -q /var/lib/osmo-diffs || mount /dev/disk/by-partlabel/osmo-diffs /var/lib/osmo-diffs || true'
ExecStop=-/usr/local/sbin/osmo-diffs enregistrer
TimeoutStopSec=600

[Install]
WantedBy=multi-user.target
