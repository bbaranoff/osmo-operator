[Unit]
Description=osmo-operator - boite noire : diffs texte du systeme (enregistres a l arret)
Documentation=file:/usr/local/sbin/osmo-diffs
# The record runs at SHUTDOWN (ExecStop): the whole boot's changes, encrypted
# for the box's public key. Stop order is the reverse of After=: it runs while
# /home (the session account's reference copy), the box partition and the
# overlay of a root session are still mounted.
RequiresMountsFor=/var/lib/osmo-diffs
After=local-fs.target home.mount unlock-home.service network-online.target osmo-diffs-init.service
# the remote copy (osmo-diffs copie-poser) is sent at shutdown: the network
# must still be up - stopped before it, since started after it
Wants=network-online.target
ConditionPathExists=/var/lib/osmo-diffs/cle.pub

[Service]
Type=oneshot
RemainAfterExit=yes
# at boot: the box still holds what nirvana saw last (truncation check)
ExecStart=-/usr/local/sbin/osmo-diffs verifier
# the network is up: the records that could not be copied at shutdown
ExecStart=-/usr/local/sbin/osmo-diffs envoyer
# /home is open by now: the fingerprint on the box is the one this machine sealed
ExecStart=-/usr/local/sbin/osmo-empreinte sceau
# read-only for everybody: only osmo-diffs writes, one record at a time
ExecStart=-/usr/local/sbin/osmo-diffs fermer
ExecStop=/usr/local/sbin/osmo-diffs enregistrer
TimeoutStopSec=600

[Install]
WantedBy=multi-user.target
