[Unit]
Description=osmo-operator - la 4G du banc (Open5GS + srsENB + srsUE ZeroMQ, via osmo-lte)
Documentation=file:/opt/GSM/osmo-operator/tools/osmo-lte.sh
# The 4G as a unit, like osmo-banc: a state, a journal, a clean stop, and a
# desktop icon (data/desktop/osmo-lte.desktop -> « osmo-lte toggle ») that
# toggles it.
# ExecStart = osmo-lte start: the Open5GS core (osmo-epc, subscribers restored
# when needed), then srsENB, then srsUE in the ue1 netns - the PPP of the pmOS
# phone ends up there (osmo-pmos-setup).
# The core needs MongoDB (subscribers): pulled in, not required.
After=network.target mongod.service
Wants=mongod.service
ConditionPathExists=/opt/GSM/osmo-operator/tools/osmo-lte.sh
# No srsRAN (interstp hub, arm64): the unit is skipped, not failed.
ConditionPathExists=/usr/local/bin/srsenb
# Installed, not enabled (same rule as osmo-banc):
#   systemctl start osmo-lte            for one session (or the icon)
#   systemctl enable --now osmo-lte     at every boot
# At build time: OSMO_ISO_LTE=1 enables the unit in the image.

[Service]
# oneshot + RemainAfterExit: osmo-lte start launches eNB/UE with setsid and the
# Open5GS daemons with -D, then exits. With Type=simple systemd would take that
# exit for the end of the service and kill the cgroup - the whole 4G.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/GSM/osmo-operator
Environment=HOME=/root USER=root LOGNAME=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Persistent settings (OSMO_LTE_SRATE, OSMO_LTE_NETNS, SRS_WAN...):
EnvironmentFile=-/etc/default/osmo-lte
ExecStart=/bin/bash /opt/GSM/osmo-operator/tools/osmo-lte.sh start
# Stop takes everything down: eNB and UE (osmo-lte stop), then the core
# (osmo-epc stop) - by hand, « osmo-lte stop » leaves the core running.
ExecStop=-/bin/bash /opt/GSM/osmo-operator/tools/osmo-lte.sh stop
ExecStop=-/bin/bash /opt/GSM/osmo-operator/tools/osmo-epc.sh stop
# osmo-lte start waits up to 30 s for the UE attach; the core comes before.
TimeoutStartSec=120
TimeoutStopSec=30
# Whatever the two stops did not tear down is terminated by systemd.
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-lte

[Install]
WantedBy=multi-user.target
