[Unit]
Description=osmo-operator - banc multi-operateur (start-multi.sh : natif + conteneurs + inter-STP)
Documentation=file:/opt/GSM/osmo-operator/README.md
# The multi-operator bench connects to the native one, it does not start it:
# osmo-banc holds it.
# Wants=, not Requires=: start-multi.sh applies « one click = a fresh bench »
# and runs `systemctl stop osmo-banc` at every launch (tout_arreter), then
# restarts it (lancer_natif_si_absent). Requires= would propagate that explicit
# stop to this unit, in the middle of its own ExecStart. Wants= pulls the native
# bench in at boot in the same order (After= below) without propagating the
# stop. The guarantee « no native bench = one ASP out of three » is held by
# start-multi.sh, which restarts osmo-banc when needed.
Wants=osmo-banc.service
# network.target only, not network-online.target: the latter can cost up to
# 2 min at boot (systemd-networkd-wait-online) on a bench whose interfaces
# (apn0, the tun/veth of the packet core) are never "online" in that sense and
# which often boots without a cable. The interfaces are configured; the default
# route may arrive later.
After=osmo-banc.service docker.service network.target
Wants=docker.service
ConditionPathExists=/opt/GSM/osmo-operator/launch/start-multi.sh
# ── And the topology must exist ─────────────────────────────────────────────
# On a fresh ISO neither docker nor the osmocom-run image are in the squashfs:
# they come with the SS7 supplement (addition.sh), which also writes this file.
# An unmet condition is not a failure for systemd: the unit is skipped silently
# and `systemctl --failed` stays empty (the Conky names it). The condition holds
# at boot as for a manual `systemctl start`: without the topology there is
# nothing to bring up.
ConditionPathExists=/etc/osmocom/osmo-multi.conf
# Neither this unit nor osmo-banc is enabled by default. Both are installed by
# the ISO (iso_modules/82-services.sh) and by addition.sh; the operator starts
# the bench - not the boot, on a configuration not yet chosen.
#   systemctl start osmo-multi          for one session
#   systemctl enable --now osmo-multi   to start it at every boot
# At build time: OSMO_ISO_MULTI=1 (or --multi) enables the unit in the image.

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/GSM/osmo-operator
Environment=HOME=/root USER=root LOGNAME=root
Environment=VIRTUAL_ENV=/root/.env
Environment=PATH=/root/.env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# OSMO_NO_TERM: start-multi.sh must neither open a terminal emulator nor hold a
# window. OSMO_BANC_SERVICE: the native bench is a systemd unit, start-multi.sh
# (re)starts it through systemctl and not through the desktop shortcut.
Environment=NO_COLOR=1 OSMO_NO_TERM=1 OSMO_BANC_SERVICE=osmo-banc.service
EnvironmentFile=-/etc/default/osmo-multi
ExecStart=/bin/bash /opt/GSM/osmo-operator/launch/start-multi.sh $OSMO_MULTI_ARGS
# --stop only stops the containers and the hub: the native bench stays with
# osmo-banc.
ExecStop=/bin/bash /opt/GSM/osmo-operator/launch/start-multi.sh --stop
TimeoutStartSec=1200
# At machine shutdown systemd waits this long before killing what is left. The
# stack stops in a few seconds; past 30 s it is stuck and SIGKILL is the right
# answer.
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=osmo-multi

# Taking over: tmux attach -t calypso (native); docker logs -f osmo-op2
# (containers); journalctl -u osmo-multi -f.

[Install]
WantedBy=multi-user.target
