[Unit]
# =============================================================================
#  open5gs-webui.service - the 4G subscriber console (Open5GS WebUI), on :9999
# =============================================================================
#  The Open5GS WebUI lives in the sources (webui/ of the open5gs repository)
#  and is a Next.js application: node server/index.js. It is the console used
#  to provision LTE subscribers (the alternative is MongoDB by hand, or
#  « osmo-epc subscribers », which replays the repository JSON).
#
#  It does not talk to the daemons, it reads MongoDB - the same database as the
#  HSS and the PCRF (DB_URI). Hence After=mongod: without the database the WebUI
#  starts and serves empty pages. It does not depend on Open5GS itself:
#  subscribers are usually provisioned with the core stopped.
#
#  Condition, not dependency. The unit is enabled by default (ISO and native),
#  but the WebUI is not always built: the bench .deb packages
#  (osmo-build-open5gs) only ship the install prefix, not the sources nor
#  node_modules. Without server/index.js, systemd skips the unit instead of
#  marking it failed (a red service on a healthy bench would be a false alarm,
#  and the Conky counts them). « osmo-lte-install --webui » builds it.
Description=Open5GS WebUI - console des abonnes 4G (:9999)
Documentation=https://open5gs.org/open5gs/docs/
After=network.target mongod.service
Wants=mongod.service
ConditionPathExists=/opt/LTE/open5gs/webui/server/index.js

[Service]
Type=simple
WorkingDirectory=/opt/LTE/open5gs/webui
Environment=NODE_ENV=production
# 0.0.0.0: the console is used from the operator's workstation, not only from
# the bench machine.
Environment=HOSTNAME=0.0.0.0
Environment=PORT=9999
# The same database as hss.yaml and pcrf.yaml (configs/open5gs/): a console
# writing elsewhere would provision subscribers the HSS never sees.
Environment=DB_URI=mongodb://localhost/open5gs
# node lives in /usr/local/bin on the bench (image) and in /usr/bin on an apt
# system: env finds it in both cases, ExecStart requires an absolute path.
ExecStart=/usr/bin/env node server/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=open5gs-webui

[Install]
WantedBy=multi-user.target
