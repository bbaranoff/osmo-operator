# 80-osmo-operator.preset - default policy: no telecom service at boot
#
# A mobile network is started on purpose (icon, start.sh, systemctl start): it
# is not a side effect of the machine booting. This systemd preset (installed in
# /usr/lib/systemd/system-preset/, read before 90-systemd.preset) says
# « disable » for everything that runs a network element: the bench and its
# variants, the Osmocom core, the BTSs, Asterisk, oFono, Open5GS, srsRAN.
# It touches nothing else: the web consoles (osmo-egprs-web, osmo-reglages,
# open5gs-webui), the sound (osmo-pulse), the address plan (osmo-ip-plan), the
# purge, the updates and the desktop keep their state.
#
# Applied by tools/osmo-telecom-boot.sh (ISO: iso_modules/82-services.sh;
# already installed machines: update.sh, once). A service enabled by hand
# afterwards (systemctl enable osmo-banc) stays enabled: this file is only used
# at install time and by `systemctl preset`, never in the background.

# the benches
disable osmo-banc.service
disable osmo-multi.service
disable osmo-lte.service
disable osmo-egprs-dsp.service
disable osmo-dsp-rom-max.service
disable osmo-interstp.service
# the Osmocom core and the base stations
disable osmo-msc.service
disable osmo-bsc.service
disable osmo-hlr.service
disable osmo-mgw.service
disable osmo-stp.service
disable osmo-sgsn.service
disable osmo-ggsn.service
disable osmo-gtphub.service
disable osmo-gbproxy.service
disable osmo-pcu.service
disable osmo-sip-connector.service
disable osmo-cbc.service
disable osmo-smlc.service
disable osmo-hnbgw.service
disable osmo-hnodeb.service
disable osmo-bts-*.service
disable osmo-trx-*.service
disable osmo-nitb.service
# voice and modems
disable asterisk.service
disable ofono.service
disable kamailio.service
disable yate.service
# 4G / 5G (the open5gs-webui web console is not a network element)
disable open5gs-*d.service
disable srsenb.service
disable srsepc.service
disable srsue.service
disable srsran*.service
