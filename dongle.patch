diff --git a/tools/huawei_at.py b/tools/huawei_at.py
new file mode 100644
index 0000000..0d28e62
--- /dev/null
+++ b/tools/huawei_at.py
@@ -0,0 +1,208 @@
+"""
+huawei_at.py — couche AT commune pour dongles Huawei (E1550 / E173 / E169 / E1750...)
+utilisés comme UE boîte noire face au banc Osmocom.
+
+- un thread lecteur sépare les réponses de commande et les URC (RING, +CMTI, ^CONN, ^CEND...)
+- gestion du prompt '>' pour AT+CMGS
+- helpers : init, PIN, forçage 2G, enregistrement manuel sur une PLMN de test
+
+Dépendance : pyserial (pip install pyserial)
+"""
+import queue
+import re
+import threading
+import time
+
+import serial
+
+URC_PREFIXES = (
+    "RING", "+CRING", "+CLIP", "+CMTI", "+CMT:", "+CDS", "+CBM",
+    "^ORIG", "^CONF", "^CONN", "^CEND", "^RSSI", "^HCSQ", "^BOOT", "^MODE",
+    "^SRVST", "^SIMST", "^SYSINFOEX", "^NWTIME", "+CREG", "+CGREG",
+    "NO CARRIER", "BUSY", "NO ANSWER",
+)
+FINAL = re.compile(r"^(OK|ERROR|\+CME ERROR:.*|\+CMS ERROR:.*)$")
+
+
+class ATError(Exception):
+    def __init__(self, cmd, final, lines):
+        super().__init__(f"{cmd!r} -> {final}")
+        self.cmd, self.final, self.lines = cmd, final, lines
+
+
+def _prefix(cmd):
+    m = re.match(r"AT([+^][A-Z0-9]+)", cmd, re.I)
+    return m.group(1).upper() if m else None
+
+
+class Modem:
+    def __init__(self, port, baud=115200, verbose=True):
+        self.ser = serial.Serial(port, baud, timeout=0.1)
+        self.verbose = verbose
+        self.resp = queue.Queue()
+        self.urc = queue.Queue()
+        self._pending = None
+        self._cmt_header = None
+        self._lock = threading.Lock()
+        self._stop = False
+        self._buf = b""
+        threading.Thread(target=self._reader, daemon=True).start()
+
+    # ---------- lecture ----------
+    def _log(self, direction, s):
+        if self.verbose:
+            print(f"{time.strftime('%H:%M:%S')} {direction} {s}")
+
+    def _reader(self):
+        while not self._stop:
+            data = self.ser.read(512)
+            if not data:
+                continue
+            self._buf += data
+            *lines, self._buf = re.split(rb"\r\n|\r|\n", self._buf)
+            for raw in lines:
+                line = raw.decode(errors="replace").strip()
+                if line:
+                    self._route(line)
+            # prompt de saisie SMS : "> " sans fin de ligne
+            if self._buf.strip() == b">":
+                self._buf = b""
+                self._log("<<", ">")
+                self.resp.put(">")
+
+    def _route(self, line):
+        self._log("<<", line)
+        if self._cmt_header is not None:  # 2e ligne d'un +CMT: (texte du SMS)
+            self.urc.put(self._cmt_header + "\n" + line)
+            self._cmt_header = None
+            return
+        if line.startswith("+CMT:"):
+            self._cmt_header = line
+            return
+        if self._pending and line.upper().startswith(self._pending):
+            self.resp.put(line)
+        elif line.startswith(URC_PREFIXES):
+            self.urc.put(line)
+        else:
+            self.resp.put(line)
+
+    # ---------- commandes ----------
+    def _drain(self):
+        while not self.resp.empty():
+            self.resp.get_nowait()
+
+    def _collect(self, cmd, timeout):
+        lines, deadline = [], time.time() + timeout
+        while True:
+            try:
+                l = self.resp.get(timeout=max(0.01, deadline - time.time()))
+            except queue.Empty:
+                self._pending = None
+                raise TimeoutError(f"pas de réponse à {cmd!r}")
+            if l == cmd:  # écho
+                continue
+            if FINAL.match(l):
+                self._pending = None
+                if l != "OK":
+                    raise ATError(cmd, l, lines)
+                return lines
+            lines.append(l)
+
+    def cmd(self, c, timeout=5):
+        with self._lock:
+            self._drain()
+            self._pending = _prefix(c)
+            self._log(">>", c)
+            self.ser.write((c + "\r").encode())
+            return self._collect(c, timeout)
+
+    def cmd_prompt(self, c, payload, timeout=60):
+        """Commande avec prompt '>' (AT+CMGS) : payload terminé par Ctrl-Z."""
+        with self._lock:
+            self._drain()
+            self._pending = _prefix(c)
+            self._log(">>", c)
+            self.ser.write((c + "\r").encode())
+            deadline = time.time() + 10
+            while True:
+                try:
+                    l = self.resp.get(timeout=max(0.01, deadline - time.time()))
+                except queue.Empty:
+                    self.ser.write(b"\x1b")  # ESC = annule
+                    raise TimeoutError("pas de prompt '>'")
+                if l == ">":
+                    break
+                if FINAL.match(l):
+                    raise ATError(c, l, [])
+            self._log(">>", payload + " <Ctrl-Z>")
+            self.ser.write(payload.encode() + b"\x1a")
+            return self._collect(c, timeout)
+
+    def try_cmd(self, c, timeout=5):
+        try:
+            return self.cmd(c, timeout)
+        except (ATError, TimeoutError) as e:
+            self._log("!!", str(e))
+            return None
+
+    def close(self):
+        self._stop = True
+        self.ser.close()
+
+    # ---------- helpers réseau ----------
+    def init(self, pin=None, force_2g=False):
+        self.cmd("ATE0")
+        self.cmd("AT+CMEE=2")
+        self.try_cmd("ATI")
+        self.try_cmd("AT+CGSN")      # IMEI
+        st = " ".join(self.cmd("AT+CPIN?", timeout=10))
+        if "SIM PIN" in st:
+            if not pin:
+                raise RuntimeError("la SIM demande un PIN (--pin)")
+            self.cmd(f'AT+CPIN="{pin}"', timeout=10)
+            time.sleep(3)
+        self.try_cmd("AT+CIMI")      # IMSI
+        if force_2g:
+            # dongles 3G : 13 = GSM only ; dongles LTE : SYSCFGEX "01"
+            if self.try_cmd("AT^SYSCFG=13,1,3FFFFFFF,2,4", timeout=10) is None:
+                self.try_cmd('AT^SYSCFGEX="01",3FFFFFFF,2,4,7FFFFFFFFFFFFFFF,,', timeout=10)
+
+    def register(self, plmn=None, timeout=120):
+        if plmn:
+            self.cmd(f'AT+COPS=1,2,"{plmn}"', timeout=timeout)
+        else:
+            self.try_cmd("AT+COPS=0", timeout=timeout)
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            r = self.try_cmd("AT+CREG?")
+            m = re.search(r"\+CREG:\s*\d+,(\d)", " ".join(r or []))
+            if m and m.group(1) in ("1", "5"):
+                self.try_cmd("AT+COPS?")
+                self.try_cmd("AT+CSQ")
+                return True
+            time.sleep(2)
+        raise TimeoutError("pas d'enregistrement réseau (CREG ≠ 1/5)")
+
+    def wait_urc(self, timeout=None):
+        try:
+            return self.urc.get(timeout=timeout)
+        except queue.Empty:
+            return None
+
+
+def common_args(p):
+    p.add_argument("--port", default="/dev/ttyUSB2", help="port AT (PCUI) du dongle")
+    p.add_argument("--pin")
+    p.add_argument("--plmn", help='PLMN du banc, ex. "00101" (sélection manuelle)')
+    p.add_argument("--force-2g", action="store_true",
+                   help="forcer GSM only (pour s'accrocher à un BTS Osmocom) ; "
+                        "par défaut : mode auto (ex. Free, pas de 2G)")
+    p.add_argument("-q", "--quiet", action="store_true")
+    return p
+
+
+def open_modem(args):
+    m = Modem(args.port, verbose=not args.quiet)
+    m.init(pin=args.pin, force_2g=args.force_2g)
+    m.register(args.plmn)
+    return m
diff --git a/tools/osmo-dongle-call.py b/tools/osmo-dongle-call.py
new file mode 100755
index 0000000..56f2456
--- /dev/null
+++ b/tools/osmo-dongle-call.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""
+osmo-dongle-call.py — appels voix par un dongle Huawei (test du dongle seul).
+
+  tools/osmo-dongle-call.py dial 0612345678 --duration 20
+  tools/osmo-dongle-call.py dial 0612345678 --play test_8k.wav --record out.raw
+  tools/osmo-dongle-call.py answer --auto --record in.raw
+
+Signalisation : ^ORIG (setup), ^CONF (alerting), ^CONN (connect), ^CEND (release + cause CC).
+Audio : AT^DDSETEX=2 bascule la voix sur le port audio série du dongle,
+PCM brut s16le 8 kHz mono, trames de 320 octets / 20 ms.
+Lecture d'un enregistrement : aplay -f S16_LE -r 8000 -c 1 out.raw
+"""
+import argparse
+import re
+import sys
+import threading
+import time
+import wave
+
+import serial
+
+from huawei_at import ATError, common_args, open_modem
+
+FRAME = 320  # 20 ms @ 8 kHz s16
+
+
+class Audio:
+    def __init__(self, port, play=None, record=None):
+        self.ser = serial.Serial(port, 115200, timeout=0.05)
+        self.play, self.record = play, record
+        self.stop = threading.Event()
+        self.threads = []
+
+    def start(self):
+        if self.play:
+            self.threads.append(threading.Thread(target=self._tx, daemon=True))
+        if self.record:
+            self.threads.append(threading.Thread(target=self._rx, daemon=True))
+        for t in self.threads:
+            t.start()
+
+    def _tx(self):
+        with wave.open(self.play, "rb") as w:
+            if (w.getframerate(), w.getnchannels(), w.getsampwidth()) != (8000, 1, 2):
+                print("[AUDIO] le wav doit être 8 kHz mono 16 bits "
+                      "(sox in.wav -r 8000 -c 1 -b 16 out.wav)", file=sys.stderr)
+                return
+            nxt = time.monotonic()
+            while not self.stop.is_set():
+                chunk = w.readframes(FRAME // 2)
+                if not chunk:
+                    break
+                self.ser.write(chunk.ljust(FRAME, b"\0"))
+                nxt += 0.020
+                time.sleep(max(0, nxt - time.monotonic()))
+        print("[AUDIO] fin de lecture")
+
+    def _rx(self):
+        with open(self.record, "wb") as f:
+            while not self.stop.is_set():
+                d = self.ser.read(FRAME)
+                if d:
+                    f.write(d)
+
+    def close(self):
+        self.stop.set()
+        for t in self.threads:
+            t.join(timeout=1)
+        self.ser.close()
+
+
+def setup_voice(m):
+    m.cmd("AT+CLIP=1")
+    m.try_cmd("AT+CRC=0")
+    r = m.try_cmd("AT^CVOICE?")
+    if r is None:
+        print("[WARN] AT^CVOICE refusé : voix probablement désactivée dans ce firmware",
+              file=sys.stderr)
+    elif not any(re.search(r"\^CVOICE:\s*0", l) for l in r):
+        m.try_cmd("AT^CVOICE=0")
+
+
+def in_call(m, args, t_setup):
+    """Boucle d'appel jusqu'à ^CEND, --duration ou Ctrl-C."""
+    audio, t_conn = None, None
+    try:
+        while True:
+            u = m.wait_urc(timeout=0.5)
+            if t_conn and args.duration and time.time() - t_conn >= args.duration:
+                print(f"[CALL] durée {args.duration}s atteinte, raccroche")
+                m.try_cmd("AT+CHUP")
+                args.duration = None
+                continue
+            if not u:
+                continue
+            if u.startswith("^ORIG"):
+                print(f"[CALL] setup  ({u})")
+            elif u.startswith("^CONF"):
+                print(f"[CALL] alerting +{time.time() - t_setup:.2f}s")
+            elif u.startswith("^CONN"):
+                t_conn = time.time()
+                print(f"[CALL] connecté +{t_conn - t_setup:.2f}s")
+                if args.play or args.record:
+                    m.try_cmd("AT^DDSETEX=2")
+                    audio = Audio(args.audio_port, args.play, args.record)
+                    audio.start()
+            elif u.startswith("^CEND"):
+                # ^CEND: call_id, durée, end_status, cc_cause
+                f = [x.strip() for x in u.split(":", 1)[1].split(",")]
+                cause = f[3] if len(f) > 3 else "?"
+                print(f"[CALL] fin : durée={f[1] if len(f) > 1 else '?'}s "
+                      f"end_status={f[2] if len(f) > 2 else '?'} cause_CC={cause}")
+                return
+            elif u in ("NO CARRIER", "BUSY", "NO ANSWER"):
+                print(f"[CALL] {u}")
+                return
+    except KeyboardInterrupt:
+        m.try_cmd("AT+CHUP")
+    finally:
+        if audio:
+            audio.close()
+
+
+def dial(m, args):
+    t = time.time()
+    m.cmd(f"ATD{args.number};", timeout=30)
+    in_call(m, args, t)
+
+
+def answer(m, args):
+    print("[..] attente d'appel entrant, Ctrl-C pour arrêter")
+    while True:
+        u = m.wait_urc(timeout=1)
+        if not u:
+            continue
+        if u.startswith("+CLIP"):
+            mm = re.match(r'\+CLIP:\s*"([^"]*)"', u)
+            print(f"[CALL] appelant : {mm.group(1) if mm else u}")
+        elif u in ("RING", "+CRING: VOICE"):
+            if args.auto:
+                time.sleep(args.delay)
+                t = time.time()
+                m.cmd("ATA", timeout=15)
+                in_call(m, args, t)
+                if not args.loop:
+                    return
+            else:
+                print("[CALL] ça sonne (--auto pour décrocher)")
+
+
+def main():
+    p = common_args(argparse.ArgumentParser(description=__doc__,
+                                            formatter_class=argparse.RawDescriptionHelpFormatter))
+    p.add_argument("--audio-port", default="/dev/ttyUSB1", help="port voix PCM du dongle")
+    sub = p.add_subparsers(dest="action", required=True)
+    d = sub.add_parser("dial")
+    d.add_argument("number")
+    a = sub.add_parser("answer")
+    a.add_argument("--auto", action="store_true")
+    a.add_argument("--delay", type=float, default=2.0, help="secondes avant ATA")
+    a.add_argument("--loop", action="store_true", help="décrocher en boucle")
+    for sp in (d, a):
+        sp.add_argument("--duration", type=float, help="raccrocher après N s connectés")
+        sp.add_argument("--play", help="wav 8 kHz mono 16 bits à injecter")
+        sp.add_argument("--record", help="fichier PCM brut à enregistrer")
+    args = p.parse_args()
+
+    m = open_modem(args)
+    try:
+        setup_voice(m)
+        dial(m, args) if args.action == "dial" else answer(m, args)
+    except ATError as e:
+        print(f"[ERR] {e}", file=sys.stderr)
+        sys.exit(1)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        m.close()
+
+
+if __name__ == "__main__":
+    main()
