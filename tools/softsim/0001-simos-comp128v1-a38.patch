diff --git a/src/simos_server.rb b/src/simos_server.rb
index 3c7a52a..80f6691 100644
--- a/src/simos_server.rb
+++ b/src/simos_server.rb
@@ -165,6 +165,31 @@ class SIMServer < Server
           sw = [0x90,0x00]
         end
       end
+    when 0xb2 # READ RECORD
+      # P1 = numero d enregistrement, P2 = 0x04 (absolu, P1 valide), P3 = longueur
+      # (Le) de l enregistrement, pour un EF lineaire fixe (ou cyclique) seulement.
+      type = file_info
+      if type[:type]!="EF" then
+        # no EF selected
+        sw = [0x94,0x00]
+      elsif !["linear fixed","cyclic"].include?(type[:structure]) then
+        # file is inconsitent with the command
+        sw = [0x94,0x08]
+      elsif request[3]!=0x04 then
+        # incorrect parameter P2 (seul le mode absolu est gere)
+        sw = [0x6b,0x00]
+      else
+        body = @selected.find_first("./body").content.hex2arr
+        record = request[2]
+        length = request[4]
+        if length==0 or record==0 or (record-1)*length+length>body.length then
+          # record not found / out of range
+          sw = [0x94,0x02]
+        else
+          data = body[(record-1)*length,length]
+          sw = [0x90,0x00]
+        end
+      end
     when 0xd6 # UPDATE BINARY
       # is an transparent ef selected ?
       type = file_info
@@ -205,6 +230,14 @@ class SIMServer < Server
         if tuple then
           @response = tuple["sres"].hex2arr+tuple["kc"].hex2arr
           sw = [0x9f,@response.length]
+        elsif ENV["SOFTSIM_KI"] && ENV["SOFTSIM_KI"].length == 32
+          # COMP128v1 avec le Ki de la SIM (patch local, lib/comp128.rb) : repond a
+          # n importe quel RAND du HLR, pas seulement aux triplets enregistres.
+          require_relative 'lib/comp128'
+          ki = [ENV["SOFTSIM_KI"]].pack("H*")
+          sres, kc = Comp128.v1(ki, request[5,16].pack("C*"))
+          @response = sres.unpack("C*") + kc.unpack("C*")
+          sw = [0x9f,@response.length]
         else
           # memory problem
           sw = [0x92,0x40]
