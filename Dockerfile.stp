# =============================================================================
# Dockerfile.stp - inter-STP image: the SS7/M3UA hub of the WAN, nothing else
# =============================================================================
#
# osmocom-run carries the whole mock-up (HLR, MSC, BSC, PCU, BTS, Asterisk,
# QEMU, gr-gsm...). The hub uses none of it: it receives M3UA, looks up its
# routing table and forwards to the right linkset. This image contains only
# that. osmo-stp has no repository of its own; it is built by libosmo-sigtran,
# hence three sources (libosmocore, libosmo-netif, libosmo-sigtran).
#
# Versions are aligned with Dockerfile: a hub built against a newer
# libosmo-sigtran than the nodes would negotiate M3UA extensions they ignore,
# which only shows up as "ASP DOWN".
#
# Two ways to build it:
#
#   standalone (default): compiles the three libraries from ubuntu:24.04
#   (noble, the same base as Dockerfile), through the .deb cache of
#   packaging/osmo-deb.sh (the second build compiles nothing).
#     docker build -f Dockerfile.stp -t osmocom-stp .
#     docker compose build stp          (build.sh / build-iso.sh --role=interstp)
#
#   on the existing stack: osmocom-nitb (the base of Dockerfile.run) already
#   carries these libraries and osmo-stp; they are reused instead of being
#   recompiled, so hub and nodes share the SAME code.
#     docker build -f Dockerfile.stp --build-arg BASE_IMAGE=osmocom-nitb -t osmocom-stp .
#
# Args:  BASE_IMAGE            ubuntu:24.04 (default) or osmocom-nitb
#        LIBOSMOCORE_VERSION, LIBOSMO_NETIF_VERSION, LIBOSMO_SIGTRAN_VERSION
#        OSMO_UBUNTU_MIRROR    apt mirror for apt-fast-install
#        OSMO_DEB_REFRESH      1 forces a rebuild past the .deb cache
#        HUB_NODES, HUB_OPS    size of the default point-code plan
#
# Run:
#   docker run --rm -p 2908:2908 -p 4239:4239 osmocom-stp
#   docker run --rm -v ./hub.cfg:/etc/osmocom/osmo-stp-interop.cfg osmocom-stp
# =============================================================================

# ── Base shared by both stages ───────────────────────────────────────────────
# The package list is the one from Dockerfile, taken as is. Deliberately wider
# than what these three libraries seem to need: libosmocore's configure enables
# or drops components according to what it finds (python3 is needed by its code
# generators). Declared once so it cannot diverge between the stage that
# compiles and the one that runs.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE} AS base
ARG DEBIAN_FRONTEND=noninteractive
# apt-fast: the same installer as Dockerfile (packaging/apt-fast-install.sh).
# BuildKit apt cache, the same as Dockerfile (id osmo-apt-archives).
ARG OSMO_UBUNTU_MIRROR=
COPY packaging/apt-fast-install.sh /usr/local/sbin/apt-fast-install
# One apt step for the whole stage: installer, then the package list. apt is
# idempotent, so on osmocom-nitb (everything already installed) it only confirms.
# libasound2t64: noble name of libasound2 (64-bit time_t transition).
RUN --mount=type=cache,id=osmo-apt-archives,target=/var/cache/apt/archives,sharing=locked \
    chmod 755 /usr/local/sbin/apt-fast-install && apt-fast-install \
    && apt-fast update && apt-fast install -y --no-install-recommends \
    build-essential git gcc g++ make cmake autoconf automake libtool pkg-config wget curl \
    libtalloc-dev libpcsclite-dev libsctp-dev libmnl-dev liburing-dev \
    libdbi-dev libdbd-sqlite3 libsqlite3-dev sqlite3 libc-ares-dev libgnutls28-dev \
    libortp-dev libfftw3-dev libusb-1.0-0-dev libsofia-sip-ua-dev libsofia-sip-ua-glib-dev \
    python3 python3-dev python3-scapy ca-certificates \
    libasound2-dev libasound2t64 libgsm1-dev libgsm1 libpcap0.8-dev libsystemd-dev \
    && rm -rf /var/lib/apt/lists/*
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig \
    LD_LIBRARY_PATH=/usr/local/lib

# ── Build stage ──────────────────────────────────────────────────────────────
FROM base AS builder
ARG LIBOSMOCORE_VERSION=1.12.1
ARG LIBOSMO_NETIF_VERSION=1.7.0
ARG LIBOSMO_SIGTRAN_VERSION=2.2.1

WORKDIR /build

# ── .deb cache (packaging/osmo-deb.sh): the same packages as the nitb image ──
# .deb-cache/ mirrors the host cache (/var/cache/osmo-debs). A package
# osmo-build-libosmocore_1.12.1~noble already present = no compilation.
ARG OSMO_DEB_REFRESH=0
COPY packaging/osmo-deb.sh /usr/local/sbin/osmo-deb
COPY .deb-cache/ /var/cache/osmo-debs/
RUN chmod 755 /usr/local/sbin/osmo-deb

# Fixed order: each library builds against the previous one.
# libosmocore from github (official mirror), the other two from gitea, the
# same origins as Dockerfile so both images see the same code.
#
# If the base already provides osmo-stp (BASE_IMAGE=osmocom-nitb), nothing is
# recompiled: a second copy of the same libraries could diverge from the nodes'.
RUN set -eux; \
    if command -v osmo-stp >/dev/null 2>&1; then \
        echo "osmo-stp fourni par l'image de base — compilation inutile"; \
        osmo-stp --version; \
        exit 0; \
    fi; \
    for repo in \
        "libosmocore:${LIBOSMOCORE_VERSION}:https://github.com/osmocom/libosmocore" \
        "libosmo-netif:${LIBOSMO_NETIF_VERSION}:https://gitea.osmocom.org/osmocom/libosmo-netif" \
        "libosmo-sigtran:${LIBOSMO_SIGTRAN_VERSION}:https://gitea.osmocom.org/osmocom/libosmo-sigtran" \
    ; do \
        name="${repo%%:*}"; rest="${repo#*:}"; \
        version="${rest%%:*}"; url="${rest#*:}"; \
        if osmo-deb install "$name" "$version"; then continue; fi; \
        git clone "$url" "$name"; \
        cd "/build/$name"; \
        git checkout "$version"; \
        autoreconf -fi; \
        ./configure --prefix=/usr/local --disable-static; \
        make -j"$(nproc)"; \
        osmo-deb pack "$name" "$version" make install; \
        ldconfig; \
        cd /build; \
    done

# Default hub config, generated by the repository script: a single source of
# truth for the point-code plan 1.<node><op>.<role>, shared with the ISO and
# start-docker.sh. Can be replaced by a volume mount at run time.
ARG HUB_NODES=3
ARG HUB_OPS=1
COPY helpers/create_interop.sh /build/create_interop.sh
RUN mkdir -p /etc/osmocom \
    && bash /build/create_interop.sh --wan "${HUB_NODES}" "${HUB_OPS}" \
         /etc/osmocom/osmo-stp-interop.cfg

# ── Final image ──────────────────────────────────────────────────────────────
# Same base, hence same libraries: nothing the build may have enabled can be
# missing. Left out: the source trees and build objects, most of the volume.
FROM base
LABEL org.opencontainers.image.title="osmocom-stp" \
      org.opencontainers.image.description="Inter-STP osmo-operator — hub SS7/M3UA, PC 0.0.0"

# groupadd and useradd fail (code 9) if the account already exists, which is
# the case with BASE_IMAGE=osmocom-nitb (the main Dockerfile creates it).
RUN getent group osmocom >/dev/null || groupadd -r osmocom \
    && id -u osmocom >/dev/null 2>&1 \
       || useradd -r -g osmocom -s /usr/sbin/nologin -d /var/lib/osmocom osmocom \
    && mkdir -p /var/lib/osmocom /var/log/osmocom \
    && chown osmocom:osmocom /var/lib/osmocom /var/log/osmocom

# /usr/local is where both paths put their result: the compiling one
# (--prefix=/usr/local) and osmocom-nitb (same prefix in Dockerfile). One copy
# covers both cases.
COPY --from=builder /usr/local/bin/osmo-stp /usr/local/bin/osmo-stp
COPY --from=builder /usr/local/lib/         /usr/local/lib/
COPY --from=builder /etc/osmocom/osmo-stp-interop.cfg /etc/osmocom/osmo-stp-interop.cfg
# The produced packages travel in the final image: build.sh brings them back
# into the host cache (docker cp), and build-iso.sh --role=interstp installs
# them into the hub rootfs with dpkg.
COPY --from=builder /var/cache/osmo-debs/ /var/cache/osmo-debs/

# Dependency closure checked on the SHIPPED image, binary and libraries: a
# missing .so would otherwise only show at first start, inside a VM.
RUN set -eux; \
    ldconfig; \
    fail=0; \
    for f in /usr/local/bin/osmo-stp /usr/local/lib/*.so*; do \
        [ -f "$f" ] || continue; \
        if ldd "$f" 2>/dev/null | grep 'not found'; then \
            echo "DÉPENDANCE MANQUANTE : $f" >&2; fail=1; \
        fi; \
    done; \
    [ "$fail" = "0" ]; \
    osmo-stp --version

# 2908: M3UA over SCTP, which EXPOSE cannot declare (tcp/udp only).
# 4239: VTY.
EXPOSE 2908/tcp 4239/tcp

ENTRYPOINT ["/usr/local/bin/osmo-stp"]
CMD ["-c", "/etc/osmocom/osmo-stp-interop.cfg"]
