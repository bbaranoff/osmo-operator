From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 15:31:14 +0100
Subject: [PATCH] osmo-reglages : /api/trunk, la sortie publique
 (zadarma|dongle) choisie a distance

GET /api/trunk lit TRUNK_EXT dans le dialplan Asterisk, POST {"trunk": ...}
le change a chaud et dans extensions.conf. Pour l'appli telephone
(bbaranoff/network_monitoring), page Compte.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FofwGaanqQqi7Sbh3B3dF8
---
 tools/osmo-reglages.py | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/tools/osmo-reglages.py b/tools/osmo-reglages.py
index 5346d95..f607f14 100755
--- a/tools/osmo-reglages.py
+++ b/tools/osmo-reglages.py
@@ -16,6 +16,8 @@
 #   Etat      : osmo-* processes, ports, useful counters
 # Nothing is restarted: VTY changes are immediate, globals.conf and the files are
 # used by the next run. Listens on 127.0.0.1 only: the VTY console executes anything.
+# The phone app (bbaranoff/network_monitoring) uses /api/etat, /api/console and
+# /api/trunk: for it, --bind <LAN or WireGuard address of the node>, never a public one.
 # Standard library only.
 
 import argparse, glob, html, json, os, re, shutil, socket, subprocess, time
@@ -398,6 +400,39 @@ def etat():
     return {"procs": procs, "vty": demons_vty()}
 
 
+# ── Sortie vers le reseau public ───────────────────────────
+# TRUNK_EXT of the Asterisk dialplan (configs/extensions.conf, [sub-sortie-ext]):
+# "zadarma" (SIP trunk) or "dongle" (chan_dongle). Changed live, and written in
+# the installed extensions.conf so that a "dialplan reload" keeps the choice.
+TRUNKS = ("zadarma", "dongle")
+EXTENSIONS = os.environ.get("OSMO_EXTENSIONS_CONF", "/etc/asterisk/extensions.conf")
+
+
+def trunk(choix=None):
+    def rx(cmd):
+        r = subprocess.run(["asterisk", "-rx", cmd], capture_output=True, text=True, timeout=8)
+        if r.returncode:
+            raise RuntimeError((r.stderr or r.stdout).strip() or "asterisk injoignable")
+        return r.stdout
+    if choix is not None:
+        if choix not in TRUNKS:
+            raise ValueError("trunk inconnu : %r" % (choix,))
+        rx("dialplan set global TRUNK_EXT " + choix)
+        try:
+            with open(EXTENSIONS, encoding="utf-8") as f:
+                avant = f.read()
+            apres = re.sub(r"(?m)^TRUNK_EXT=.*$", "TRUNK_EXT=" + choix, avant)
+            if apres != avant:
+                with open(EXTENSIONS, "w", encoding="utf-8") as f:
+                    f.write(apres)
+        except OSError:
+            pass                     # live change done; the file is someone else's
+    m = re.search(r"(?m)^\s*TRUNK_EXT=(\S+)", rx("dialplan show globals"))
+    if not m:
+        raise RuntimeError("TRUNK_EXT absent du dialplan (extensions.conf sans [sub-sortie-ext])")
+    return {"trunk": m.group(1), "choix": list(TRUNKS)}
+
+
 # ── HTTP ───────────────────────────────────────────────────
 
 class H(BaseHTTPRequestHandler):
@@ -458,6 +493,8 @@ class H(BaseHTTPRequestHandler):
                     return self.envoyer(200, {"texte": f.read()})
             if u.path == "/api/etat":
                 return self.envoyer(200, etat())
+            if u.path == "/api/trunk":
+                return self.envoyer(200, trunk())
             self.envoyer(404, {"err": "?"})
         except Exception as e:
             self.envoyer(500, {"err": "%s: %s" % (type(e).__name__, e)})
@@ -476,6 +513,8 @@ class H(BaseHTTPRequestHandler):
                 return self.envoyer(200, appliquer(j["hote"], int(j["port"]), j["chemin"], j["lignes"]))
             if u.path == "/api/console":
                 return self.envoyer(200, {"sortie": console(j["hote"], int(j["port"]), j["lignes"])})
+            if u.path == "/api/trunk":
+                return self.envoyer(200, trunk(j.get("trunk")))
             if u.path == "/api/fichier":
                 if not fichier_autorise(j["p"]):
                     return self.envoyer(403, {"err": "fichier hors liste"})
