# Cache des .deb compiles (voir packaging/osmo-deb.sh) : recopie depuis
# /var/cache/osmo-debs par build.sh avant chaque build, jamais versionne.
.deb-cache/*.deb
# Configs generees pour docker compose (compose.sh up)
data/compose/
packaging/dist/
__pycache__/
*.pyc
*.iso
vty-debug-dump-*.txt

# depot git a part (github.com/bbaranoff/dino), deploye par wrangler
dino/
*.bak-*
vty-debug-dump.txt
navigation/logs/
mynode*.conf
.claude/

# Jupyter
.ipynb_checkpoints/
*-[0-9]*.pdf
osmo-operator-qmd/
bundle-qmd/

# notebook scratch output (wiki/)
wiki/sms.db*
wiki/Untitled*.ipynb

# FreeCalypso: local cache of the official downloads (tools/freecalypso-fetch.sh,
# freecalypso.org + hg.themyscira.org). NEVER versioned: the TI TMS470 environment
# (installed-env.tar.xz), the DSP ROM dumps and the Magnetite source are not
# redistributable. Only .gitkeep is kept (the Docker build bind-mounts the folder).
.cache/*
!.cache/freecalypso/
.cache/freecalypso/*
!.cache/freecalypso/.gitkeep
installed-env.tar.xz
dsp-rom-*-dump.txt
calypso_dsp.txt
compal-flash-boot-for-fc.bin
sms-coding-utils-*.tar.bz2
fc-magnetite/
freecalypso-env/
freecalypso-tools/
