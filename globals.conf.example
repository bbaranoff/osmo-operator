# ═══════════════════════════════════════════════════════════════
#  globals.conf — la configuration du réseau, en un seul endroit.
# ═══════════════════════════════════════════════════════════════
#
#  Édite ce fichier à la main : il ne sera JAMAIS réécrit par un run.
#  Seul « ./generate_configs.sh --force » le régénère.
#
#  CE FICHIER FAIT AUTORITÉ — SUR LES VARIABLES QU'IL DÉCLARE, ET SUR
#  ELLES SEULES. Il est lu en dernier : les 26 réglages ci-dessous
#  écrasent leur homonyme dans l'environnement. Tout le reste (CALYPSO_*,
#  LOG_DIR, MODE…) passe au travers, intact. Deux façons de le modifier :
#      vim globals.conf
#      ./generate_configs.sh ARFCN=520
#
#  Un champ VIDE = valeur calculée automatiquement. Les champs notés
#  [auto/opérateur] se déduisent du numéro d'opérateur : ne les fige
#  que si N_OPERATORS=1, sinon tous les opérateurs se marchent dessus.
# ═══════════════════════════════════════════════════════════════

# ── Identité du réseau ──────────────────────────────────────

# Mobile Country Code (3 chiffres)
MCC="001"
# Mobile Network Code (2 chiffres)
MNC="01"
# Nom court et long du réseau
OP_NAME="OsmoQEMU"

# ── Sécurité et carte SIM ───────────────────────────────────

# Chiffrement : « a5 0 » (aucun), « a5 1 », « a5 0 1 3 »…
# choix : a5 0 | a5 1 | a5 3 | a5 0 1 | a5 0 1 3
ENCRYPTION="a5 1"
# Algorithme d'authentification (comp128, xor…)
# choix : comp128 | comp128v2 | comp128v3 | xor | milenage
SIM_ALGO="comp128"
# Ki de la SIM, 16 octets hexa espacés  [auto/opérateur]
KI=""
# IMSI du mobile  [auto/opérateur]
IMSI=""
# IMEI du mobile  [auto/opérateur]
IMEI=""

# ── Radio ───────────────────────────────────────────────────

# Canal radio (à accorder avec BAND)  [auto/opérateur]
ARFCN="1"
# Bande de la BTS n°1 SEULEMENT (la BTS 0 est en GSM900 dans osmo-bsc.cfg) : GSM900, DCS1800, PCS1900, GSM850
# Doit correspondre a l ARFCN de la BTS n°1 (614 par defaut, DCS1800) sinon le BSC refuse son OML.
# choix : GSM900 | DCS1800 | PCS1900 | GSM850
BAND="DCS1800"
# Base Station Identity Code, 0..63  [auto/opérateur]
BSIC=""
# Location Area Code  [auto/opérateur]
LAC=""
# Cell identity  [auto/opérateur]
CELL_ID=""
# Identifiant IPA du BTS  [auto/opérateur]
IPA_UNIT_ID=""
# Puissance max autorisée au mobile (0..15)
MS_MAX_POWER="15"
# Niveau reçu minimal pour accéder à la cellule
RXLEV_ACCESS_MIN="0"
# Hystérésis de resélection de cellule (dB)
CELL_RESEL_HYST="4"
# Timer T3109 du BSC (s) — libération de canal
T3109="5"

# ── GPRS ────────────────────────────────────────────────────

# BSSGP Virtual Connection Id  [auto/opérateur]
BVCI=""
# Network Service Entity Id  [auto/opérateur]
NSEI=""
# NS Virtual Connection Id  [auto/opérateur]
NSVCI=""
# Nom du point d'accès
APN="internet"

# ── Services ────────────────────────────────────────────────

# Numéro du centre SMS  [auto/opérateur]
SMS_SC=""

# ── Dimensionnement ─────────────────────────────────────────

# Nombre de mobiles simulés
MS_COUNT="2"
# Nombre d'opérateurs (mode « virtual »)
N_OPERATORS="1"
# Adresse de l'hôte vue par la pile
HOST_IP="127.0.0.1"

# >>> VARIABLES DU LANCEUR : bloc genere par tools/globals-complet.py (ne pas editer les marqueurs) >>>
