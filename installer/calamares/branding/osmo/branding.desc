# branding.desc - Calamares branding of the osmo-operator ISO (names, images, slideshow, colours).
---
componentName: osmo

# The empty strings are INTENTIONAL: they remove the links (support, release
# notes) that the welcome screen would otherwise show, pointing to pages that
# do not exist for this project.
strings:
    productName:         osmo-operator
    shortProductName:    osmo-operator
    version:             0.1-9
    shortVersion:        0.1-9
    versionedName:       osmo-operator v0.1-9 - banc GSM/EGPRS
    shortVersionedName:  osmo-operator v0.1-9
    bootloaderEntryName: osmo-operator
    productUrl:          ""
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""

images:
    productLogo:   "logo.png"
    productIcon:   "logo.png"
    productWelcome: "welcome.jpg"

slideshow: "show.qml"
# show.qml is written for slideshow API 1 (a Timer running from start to
# end). Without this key, Calamares logs "Invalid or missing *slideshowAPI*"
# and guesses.
slideshowAPI: 1

# ── SIDEBAR COLOURS ────────────────────────────────────────────────────────
# Calamares 3.3 accepts only these four names (initial capital, as read in
# libcalamaresui); any other name is rejected with "Unknown branding *style*
# entry" and the sidebar falls back to the Qt palette. "Current" = the step
# in progress.
style:
    SidebarBackground:         "#0d1b2a"
    SidebarText:               "#ffffff"
    SidebarBackgroundCurrent:  "#1b98e0"
    SidebarTextCurrent:        "#13293d"
