---
componentName: osmo

# Les chaines vides sont VOLONTAIRES : elles retirent les liens (support, notes
# de version) que l'ecran d'accueil afficherait sinon vers des pages qui
# n'existent pas pour ce projet.
strings:
    productName:         osmo-operator
    shortProductName:    osmo-operator
    version:             0.1
    shortVersion:        0.1
    versionedName:       osmo-operator 0.1 - banc GSM/EGPRS
    shortVersionedName:  osmo-operator 0.1
    bootloaderEntryName: osmo-operator
    productUrl:          ""
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""

images:
    productLogo:   "logo.png"
    productIcon:   "logo.png"
    productWelcome: "welcome.png"

slideshow: "show.qml"
# show.qml est ecrit pour l API 1 du diaporama (un Timer qui tourne du debut a
# la fin). Sans cette cle, Calamares journalise "Invalid or missing
# *slideshowAPI*" et devine.
slideshowAPI: 1

# ── LES COULEURS DE LA BARRE LATERALE ──────────────────────────────────────
# [2026-09-04] CES QUATRE NOMS ONT CHANGE EN CALAMARES 3.3. Les anciens
# (sidebarBackground, sidebarText, sidebarTextSelect, sidebarTextHighlight)
# etaient refuses un par un - "Unknown branding *style* entry" dans
# ~/.cache/calamares/session.log - et la barre retombait sur la palette Qt du
# bureau sombre : noir sur noir, les etapes INVISIBLES, seule l etape courante
# se voyait. Les seuls noms que 3.3 accepte sont ceux-ci, majuscule initiale
# (lus dans libcalamaresui : SidebarBackground, SidebarText,
# SidebarTextCurrent, SidebarBackgroundCurrent). "Current" = l etape en cours,
# ce que les anciens noms appelaient "Select"/"Highlight".
style:
    SidebarBackground:         "#0d1b2a"
    SidebarText:               "#ffffff"
    SidebarBackgroundCurrent:  "#1b98e0"
    SidebarTextCurrent:        "#13293d"
