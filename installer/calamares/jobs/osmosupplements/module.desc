---
# module.desc - Calamares job osmosupplements: writes the choices of the
# "Supplements" and "Image operateur" pages to /etc/osmo-supplements in the
# target and enables osmo-supplements.service (first boot).
# Installed by iso_modules/85-installeur-bureau.sh in the system modules directory.
type: "job"
name: "osmosupplements"
interface: "python"
script: "main.py"
