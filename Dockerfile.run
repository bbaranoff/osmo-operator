# Dockerfile.run - update layer on top of osmocom-nitb (runtime image osmocom-run)
# ─────────────────────────────────────────────────────────────────────────────
# This file builds nothing from scratch. It starts from the osmocom-nitb base
# image (Dockerfile) and refreshes only what changes between lab iterations:
#   - the repository's scripts and configs (COPY, a few seconds);
#   - the git trees qosmo, c54x_exe, grgsm_exe and osmo-operator (fetch + rebuild).
# Everything else (apt packages, Node/web dashboard, Calypso firmware,
# PulseAudio config, prompt, systemd units...) lives in Dockerfile; there is
# no apt call here.
#
# Build:  docker build -f Dockerfile.run .      (or via build.sh / start-docker.sh)
# Args:   BASE             base image (default: osmocom-nitb; the CI passes its
#                          GHCR reference osmocom-nitb:base-<context fingerprint>)
#         QEMU_CACHE_BUST  any changing value (e.g. $(date +%s)) to force the
#                          git refresh RUNs past the build cache
#
# The COPYs below overlap with Dockerfile on purpose: that overlap is what lets
# a config change be rebuilt in seconds instead of rebuilding the base image.
# Dockerfile keeps the same COPYs because osmocom-nitb must stay self-contained.
ARG BASE=osmocom-nitb
FROM ${BASE} AS osmocom-run

# ── Scripts ───────────────────────────────────────────────────────────────────
# Two destinations, two uses:
#   /scripts      -> entrypoint.sh (the ENTRYPOINT below) and the tools that
#                    scripts/run.sh calls through this path (pulse-gsm-setup.sh);
#   /etc/osmocom  -> what the modules consume ($OSMOCOM_CFG/...). The base
#                    image already has them, but at the state of ITS build;
#                    this COPY refreshes osmo-start.sh / status.sh / check.sh /
#                    audio-chain.sh too.
# The repository tracks these files as 644: the +x bit is set AFTER all COPYs,
# in the RUN further down. A COPY placed after that chmod would reset the mode.
COPY scripts/* /etc/osmocom/
COPY scripts/entrypoint.sh /scripts/

# ── Osmocom configs (templates with __XXX__ placeholders) ─────────────────────
# All configs are copied; the real values are injected at start-up by
# start-docker.sh (apply_config_templates) and mounted as volumes.
COPY configs/*.conf /etc/asterisk/
COPY configs/*.cfg configs/sms-routing.conf /etc/osmocom/
COPY configs/mobile.cfg /root/.osmocom/bb/mobile.cfg
COPY configs/asound.conf /etc/

# ── Burst-level TRX bridge (CALYPSO_BRIDGE=pont) ──────────────────────────────
# pont.py is NOT copied and no PONT_PY is exported: the repository tree under
# /opt/GSM/osmo-operator is the single source. start-native.sh resolves
# $NITB_ROOT/pont/pont.py and c54x_exe/run.sh (MODE=dsp) picks pont_dsp.py;
# each launcher has its own default.

# Execute bits. MUST stay AFTER all the COPYs above.
RUN chmod +x /etc/osmocom/*.sh

# ── Disclaimer at container login (counterpart of the ISO's 01-osmo-disclaimer.sh)
# `docker exec -ti <ct> bash` opens an interactive NON-login shell, which reads
# ~/.bashrc (not /etc/profile.d). The text lives in scripts/osmo-disclaimer.sh
# (already in /etc/osmocom/ from the COPY above) and is sourced from .bashrc,
# guarded by:
#   - [ -t 1 ]                : only when a human has a terminal;
#   - OSMO_DISCLAIMER_SHOWN   : once per session, not in every sub-shell.
# The non-interactive `bash -c` of start-docker.sh never reads .bashrc, so the
# stack start-up output is not polluted. No heredoc here: the classic docker
# builder (no BuildKit) does not support RUN heredocs; a repository file plus a
# symlink works with both builders. `grep -q` keeps the append idempotent.
RUN ln -sf /etc/osmocom/osmo-disclaimer.sh /etc/osmo-disclaimer.sh && \
    { grep -q '### osmo-disclaimer ###' /root/.bashrc || \
      printf '%s\n' '' \
        '### osmo-disclaimer ###' \
        '[ -z "${OSMO_DISCLAIMER_SHOWN:-}" ] && [ -t 1 ] && . /etc/osmo-disclaimer.sh' \
        '### end osmo-disclaimer ###' >> /root/.bashrc; }

# ── Git tree refresh ──────────────────────────────────────────────────────────
# start-docker.sh passes --build-arg QEMU_CACHE_BUST=$(date +%s). An ARG
# invalidates the cache at its FIRST USE, not at its declaration: hence the
# `: "${QEMU_CACHE_BUST:-}"` at the head of each RUN below, which consumes it.
ARG QEMU_CACHE_BUST

# The base image clone leaves HEAD on the default branch: a plain pull is
# enough. The pull must never kill the build: the build network may fail
# (git then prints a misleading "could not read Username" although the
# repository is public). GIT_TERMINAL_PROMPT=0 fails immediately instead of
# blocking on an invisible prompt, and `|| echo` keeps the base clone's tree,
# with a message saying which of the two we got.
RUN : "${QEMU_CACHE_BUST:-}" && cd /opt/GSM/osmo-operator \
    && (GIT_TERMINAL_PROMPT=0 git pull --ff-only \
        || echo "[warn] git pull osmo-operator impossible (reseau du build) - on garde l arbre du clone de base")

# ── Rebuild qosmo + c54x_exe + grgsm_exe (fetch + rebuild) ───────────────────
# One QEMU tree (/opt/GSM/qosmo) and two layer-1 implementations outside QEMU,
# c54x_exe and grgsm_exe, which compile sources from /opt/GSM/qosmo
# (hw/arm/calypso, contrib/hors-qemu). All three are refreshed in the SAME RUN:
# a c54x_exe rebuilt against a stale qosmo (or the reverse) would give a DSP
# and an ARM speaking different bridge protocols with nothing reporting it.
# Do not split.
# fetch + reset --hard rather than `pull --ff-only`: the base trees carry
# modified tracked files (__pycache__/*.pyc in qosmo, the versioned c54x_exe
# binary) that a pull refuses to merge. These trees are sources, not a
# workspace: align them on origin.
# gcc-13 for ninja: qosmo's build/ was configured with gcc-13 (meson recorded
# -ftrivial-auto-var-init, unknown to gcc-11, the image's default cc). A local
# PATH is enough (update-alternatives does not know gcc-13); the default stays gcc-11.
# c54x_exe: CFLAGS without -march=native, as in the base Dockerfile.
RUN : "${QEMU_CACHE_BUST:-}" && \
    for d in qosmo c54x_exe grgsm_exe; do \
        (cd /opt/GSM/$d && GIT_TERMINAL_PROMPT=0 git fetch origin \
            && git reset --hard "origin/$(git rev-parse --abbrev-ref HEAD)") \
            || echo "[warn] mise a jour de $d impossible (reseau ?) - on rebatit sur l arbre present"; \
    done && \
    mkdir -p /tmp/cc13 && ln -sf /usr/bin/gcc-13 /tmp/cc13/cc && ln -sf /usr/bin/gcc-13 /tmp/cc13/gcc \
    && ln -sf /usr/bin/g++-13 /tmp/cc13/c++ && ln -sf /usr/bin/g++-13 /tmp/cc13/g++ && \
    (cd /opt/GSM/qosmo/build && PATH=/tmp/cc13:$PATH ninja) && rm -rf /tmp/cc13 && \
    make -C /opt/GSM/c54x_exe QOSMO=/opt/GSM/qosmo \
        CFLAGS="-O3 -g -Wall -Werror=format -Werror=format-extra-args -Wno-unused-function -Wno-unused-variable -Wno-unused-but-set-variable -Wno-sign-compare" && \
    cp /opt/GSM/c54x_exe/rom/calypso_dsp.*.bin /opt/GSM/ && \
    make -C /opt/GSM/grgsm_exe QOSMO=/opt/GSM/qosmo clean all

# ── Entrypoint ────────────────────────────────────────────────────────────────
ENTRYPOINT ["/scripts/entrypoint.sh"]
CMD ["bash"]
