#!/bin/bash
# osmo-racine-copier CIBLE - fills ROOT's system partition at installation.
#
# Run by Calamares OUTSIDE the target (shellprocess-racine.conf, dontChroot),
# from the live session: the target's osmo-racine partition is mounted on
# CIBLE/var/lib/osmo-racine. It receives what the ISO itself boots:
#   live/filesystem.squashfs   the image Calamares unpacks (osmo-install binds
#                              it on /run/osmo-install-src)
#   vmlinuz, initrd.img        the kernel and the LIVE initrd (live-boot) of
#                              that image, from its /boot
# GRUB (osmo-grub-esp) boots it with « boot=live live-media=<this partition>
# osmo.racine »: root's sessions run live, in RAM, on this image - never on
# nirvana's encrypted system.
set -u
CIBLE="${1:?usage : osmo-racine-copier CIBLE}"
A="$CIBLE/var/lib/osmo-racine"
SQ=/run/osmo-install-src/live/filesystem.squashfs
log() { echo "osmo-racine-copier : $*"; }

mountpoint -q "$A" || { log "$A n est pas une partition montee - pas de systeme root separe"; exit 0; }
[ -s "$SQ" ] || { log "$SQ absent"; exit 1; }

# kernel + initrd: those of the squashfs, read from the running live system
# (its / IS that squashfs); the newest version if there are several
k="$(ls -1 /boot/vmlinuz-* 2>/dev/null | sort -V | tail -1)"
v="${k#/boot/vmlinuz-}"
i="/boot/initrd.img-$v"
[ -f "$k" ] && [ -f "$i" ] || { log "noyau ou initrd live absent de /boot ($k)"; exit 1; }

install -d "$A/live"
log "copie de l image ($(du -h "$SQ" | cut -f1))..."
cp "$SQ" "$A/live/filesystem.squashfs.part" && mv "$A/live/filesystem.squashfs.part" "$A/live/filesystem.squashfs" \
    || { log "copie impossible (place ?)"; exit 1; }
cp "$k" "$A/vmlinuz"
cp "$i" "$A/initrd.img"
# the porte (TPM code, then nirvana's passphrase): same kernel, its own initrd
# (iso_modules/85-porte-tpm.sh)
if [ -f /boot/osmo-porte.img ]; then cp /boot/osmo-porte.img "$A/osmo-porte.img"
else rm -f "$A/osmo-porte.img"; log "pas d initrd de porte dans l image - GRUB demandera la phrase"; fi
printf 'osmo-operator : systeme de root (live) - noyau %s, copie le %s\n' "$v" "$(date '+%F %T')" > "$A/LISEZMOI"
sync
log "systeme de root pret : $(du -sh "$A" | cut -f1)"
