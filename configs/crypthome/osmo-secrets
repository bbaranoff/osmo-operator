#!/bin/bash
# osmo-secrets - DE NOUVEAUX SECRETS pour ce poste (icone « Nouveaux secrets »).
# Fait pour quelqu un qui ne connait pas la machine : un menu, des phrases
# simples, et chaque choix fait TOUT ce qui va avec.
#
#   1  la preuve que la puce (TPM) donne au demarrage : phrase secrete + PIN,
#      ou code sur le telephone - sans rien changer au demarrage lui-meme ;
#   2  la phrase de /home : le volume chiffre, la cle qui signe le disque, le
#      secret du proprietaire du TPM et le coffre du demarrage mesure suivent ;
#   3  la phrase de la boite noire ;
#   4  Claude et GitHub : ce qu il faut taper.
#
# Lance en root (la fenetre le demande). Les phrases ne sont tenues en memoire
# que le temps de l operation ; rien n en est ecrit.
set -u
rouge() { printf '\033[1;31m%s\033[0m\n' "$*"; }
vert()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
titre() { printf '\n\033[1m== %s ==\033[0m\n' "$*"; }
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
UUID="$(. /etc/default/crypthome 2>/dev/null; echo "${CRYPTHOME_UUID:-}")"
DEV="${OSMO_SECRETS_DEV:-/dev/disk/by-uuid/$UUID}"
masquee() { local v; read -r -s -p "$1" v < /dev/tty || v=""; echo > /dev/tty; printf '%s' "$v"; }

preuve_tpm() {
    titre "La preuve que la puce de securite donne au demarrage"
    if [ ! -e /etc/osmo-tpm/actif ]; then
        rouge "La puce de securite ne surveille pas encore ce poste : rien a changer ici."; return
    fi
    echo "Au demarrage, la puce (TPM) prouve que la machine n a pas ete modifiee :"
    echo "  1. par une PHRASE A TOI, affichee apres ton PIN (aucun autre appareil) ;"
    echo "  2. par DEUX FACTEURS : un PIN, puis un CODE a 6 chiffres, le meme que sur ton telephone (plus sur)."
    echo "Je remplace l ancienne preuve par une nouvelle. La machine ne redemarre pas."
    read -r -p "Ton choix [1 ou 2, Entree = garder le meme genre] : " c < /dev/tty || c=""
    case "$c" in 1) set -- --secret ;; 2) set -- --telephone ;; *) set -- ;; esac
    echo "Ta phrase de /home va etre demandee (rien ne s affiche pendant que tu tapes)."
    /usr/local/sbin/osmo-tpm changer "$@" || rouge "Rien n a ete change."
}

phrase_home() {
    titre "Une nouvelle phrase de /home"
    echo "C est la phrase que tu tapes a chaque demarrage et a chaque extinction."
    echo "Ne la perds pas : sans elle, /home est perdu pour toujours."
    anc="$(masquee "Ta phrase de /home ACTUELLE : ")"
    if [ -z "$anc" ] || ! printf '%s' "$anc" | cryptsetup open --test-passphrase --key-file=- "$DEV" >/dev/null 2>&1; then
        anc=""; rouge "Ce n est pas la phrase actuelle. Rien n a ete change."; return
    fi
    nou="$(masquee "La NOUVELLE phrase : ")"; nou2="$(masquee "Encore une fois : ")"
    if [ -z "$nou" ] || [ "$nou" != "$nou2" ]; then anc=""; nou=""; nou2=""; rouge "Les deux saisies sont vides ou differentes. Rien n a ete change."; return; fi
    if [ "$nou" = "$anc" ]; then anc=""; nou=""; nou2=""; rouge "C est la meme phrase. Rien n a ete change."; return; fi
    nou2=""
    echo "Je change la phrase du volume chiffre (quelques secondes)..."
    if ! printf '%s\n%s\n' "$anc" "$nou" | cryptsetup luksChangeKey "$DEV" >/dev/null 2>&1; then
        anc=""; nou=""; rouge "Le volume a refuse le changement. Rien n a ete change."; return
    fi
    vert "La phrase du volume est changee. Je mets le reste a jour..."
    ok=1
    printf '%s\n%s\n' "$anc" "$nou" | /usr/local/sbin/osmo-empreinte phrase-changee --stdin || ok=0
    if [ -e /etc/osmo-tpm/actif ]; then
        printf '%s\n%s\n' "$anc" "$nou" | /usr/local/sbin/osmo-tpm phrase-changee --stdin || ok=0
    fi
    echo "Je reprends l empreinte du disque (une vingtaine de secondes)..."
    printf '%s\n' "$nou" | /usr/local/sbin/osmo-empreinte prendre --phrase-stdin 2>&1 | tail -n 1
    anc=""; nou=""
    if [ "$ok" = 1 ]; then
        vert "C est fait : ta NOUVELLE phrase sert des maintenant (extinction, demarrage)."
    else
        rouge "La phrase de /home EST changee, mais une suite a echoue (voir au-dessus)."
        rouge "Utilise la NOUVELLE phrase, et demande de l aide avant de redemarrer."
    fi
}

phrase_boite() {
    titre "Une nouvelle phrase de la boite noire"
    echo "La boite noire garde le journal de chaque session. Sa phrase n est PAS celle de /home."
    echo "On va te demander la phrase actuelle de la boite, puis la nouvelle deux fois."
    /usr/local/sbin/osmo-diffs phrase || rouge "Rien n a ete change."
}

jetons() {
    titre "Claude et GitHub"
    echo "Leurs anciens acces ont ete lisibles sur le disque : il faut les refaire."
    echo "Ouvre un terminal (pas celui-ci) et tape, l un apres l autre :"
    echo
    echo "    claude          puis, une fois dedans :  /logout   puis   /login"
    echo "    gh auth login"
    echo
    echo "Suis ce qui s affiche : un navigateur s ouvre pour te reconnecter."
}

while :; do
    titre "Nouveaux secrets : que veux-tu changer ?"
    echo "  1. La preuve de la puce de securite au demarrage (phrase secrete + PIN, ou telephone)"
    echo "  2. Ma phrase de /home"
    echo "  3. La phrase de la boite noire"
    echo "  4. Mes acces a Claude et a GitHub"
    echo "  q. Rien, fermer"
    read -r -p "Ton choix : " c < /dev/tty || c=q
    case "$c" in
        1) preuve_tpm ;; 2) phrase_home ;; 3) phrase_boite ;; 4) jetons ;;
        q|Q|"") echo "A bientot."; exit 0 ;;
        *) echo "Tape 1, 2, 3, 4 ou q." ;;
    esac
done
