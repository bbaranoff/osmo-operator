#!/bin/bash
# osmo-racine-live - the system disk of an INSTALLED bench is read-only; a
# session's changes are written at shutdown only with the /home passphrase.
#
# THE DISK (installer/calamares/modules/partition.conf):
#   EFI          clear   Ubuntu's GRUB (Secure Boot: shim + grub signed)
#   /            clear   READ-ONLY: overlayroot puts a RAM layer over it
#   osmo-diffs   clear   the black box (each record encrypted, own passphrase)
#   /home        LUKS2   nirvana's home (unlock-home asks at boot)
#
# EVERY SESSION RUNS IN RAM. Everything written to / - /root, /opt/GSM, /etc,
# /var... - goes to the overlay's tmpfs. At SHUTDOWN (osmo-fin-session.service
# -> « fin »):
#   the /home passphrase given at shutdown:
#       the session is written to the disk, atomically (see « appliquer »);
#   no passphrase (Enter, timeout, wrong three times):
#       the RAM is dropped - and a RED warning says so on the console.
# DURING the session, « valider » writes THE MOMENT: the session as it is at
# that instant. What follows is not covered: without a new validation it is
# what the shutdown drops (the validated moment stays on the disk).
# Either way the black box records what the session changed, marked
# « valide » or « efface ». /home goes through the same validation: unlock-home
# mounts the LUKS2 volume read-only on /media/home-ro and a RAM layer over it
# on /home (/media/home-rw), written back with the rest. TWO PASSPHRASES:
# the /home one opens /home AND validates; the black box has its own,
# different one (osmo-diffs phrase), only to read it back - never asked at
# shutdown.
#
#   osmo-racine-live poser        enable (Calamares, shellprocess-osmo.conf)
#   osmo-racine-live etat         this boot: RAM or disk, validated or not
#   osmo-racine-live changements  the session's changes (paths)
#   osmo-racine-live valider      give the /home passphrase now: THE MOMENT is
#                                 written to the disk - the session as it is
#                                 now, not what follows (--stdin: read one
#                                 line, for osmo-valider-session). What comes
#                                 after is validated again, or wiped
#   osmo-racine-live ecrire       the same gesture, its former name
#                                 (only what changed since the last write
#                                 is written: that moment, not the session)
#   osmo-racine-live retours      the commits that can be undone
#   osmo-racine-live defaire      undo the LAST commit on the disk; again for
#                                 the one before... The black box keeps
#                                 everything and records what was removed
#   osmo-racine-live sessions     the SESSIONS that can be undone, newest first
#                                 (a session = every commit of one boot: its
#                                 validations and its shutdown)
#   osmo-racine-live remonter [N] go back N sessions (1 by default): every
#                                 commit of the last N sessions is undone, on
#                                 / and on /home, newest first; the black box
#                                 records each one (« defait »). /home
#                                 passphrase. From GRUB: « remonter session »
#                                 is a menu of the sessions WITH THEIR DATES
#                                 (arrows); the one chosen is undone at boot,
#                                 once /home is open (osmo.retour=N), and the
#                                 machine restarts on the older disk
#   osmo-racine-live attente      the sessions that were NOT validated: their
#                                 content is kept in the black box (red)
#   osmo-racine-live fusionner NAME [--session|--disque]
#                                 validate one AFTERWARDS, as a merge: written
#                                 where the disk has not changed since;
#                                 conflicts are listed and refused, or settled
#                                 for the session / for the disk
#   osmo-racine-live journal-home refresh /home/<owner>/sessions.log, the
#                                 owner's copy of the session log (every
#                                 validation, write, undo, end of session)
#   osmo-racine-live annuler      forget the validation: wiped at shutdown
#   osmo-racine-live oublier      « Tout oublier ? » Yes: wiped, white screen,
#                                 no question at shutdown
#   osmo-racine-live fin          at shutdown (osmo-fin-session.service)
#   osmo-racine-live actualiser   rebuild the initramfs and GRUB ON THE DISK
#                                 after an update of these scripts: a write
#                                 to the disk, hence the /home passphrase
#                                 (--stdin: one line), recorded in the box
#   osmo-racine-live retirer      back to an ordinary read-write / (from
#                                 « sudo overlayroot-chroot osmo-racine-live retirer »)
#
# ATOMIC WRITE. The RAM layer is first COPIED next to the root, on the same
# disk (/.osmo-valider/files), with the list of deletions; then a PRET mark
# is synced: that is the commit point. Only then are the files moved into
# place, one rename each (osmo-valider-appliquer). A cut before PRET leaves
# the disk as it was (the staging is thrown away at the next boot); a cut
# after PRET is finished by the initramfs at the next boot, before anything
# reads the root.
#
# LIMITS: root can always remount /media/root-ro read-write, or write the
# block device: this is about sessions leaving nothing behind without the
# passphrase, not a barrier against a hostile root with the machine in hand.
# The encrypted /home stays out of reach as long as nobody types its
# passphrase into a system root has modified.
set -u
CONF=/etc/overlayroot.conf
REGLAGE='tmpfs:swap=1,recurse=0'
HAUT=/media/root-rw/overlay
BAS=/media/root-ro
ETAT=/run/osmo-racine
MARQUE="$ETAT/valide"
APPLIQUER=/usr/local/sbin/osmo-valider-appliquer
HOOK=/etc/initramfs-tools/hooks/osmo-boite
SCRIPT=/etc/initramfs-tools/scripts/local-bottom/osmo-boite
GRUB_BOITE=/etc/grub.d/43_osmo-boite
# left by previous versions: removed by poser and retirer
ANCIENS="/etc/osmo-racine-rw.hash /etc/grub.d/42_osmo-maintenance
         /etc/initramfs-tools/conf.d/overlayroot
         /etc/initramfs-tools/hooks/osmo-racine-rw
         /etc/initramfs-tools/scripts/local-bottom/osmo-racine-rw
         /etc/apt/apt.conf.d/99osmo-grub-esp"
CONSOLE=/dev/console
[ -c "$CONSOLE" ] || CONSOLE=/dev/tty1

CRYPTHOME_UUID=""; CRYPTHOME_TRIES=3; CRYPTHOME_TIMEOUT=60; CRYPTHOME_ROOT_LINKS=".local/share/keyrings"
# shellcheck disable=SC1091
[ -r /etc/default/crypthome ] && . /etc/default/crypthome
TIMEOUT="${CRYPTHOME_TIMEOUT:-60}"

# Never written to the disk: the RAM itself, and what overlayroot or a root
# session rewrites on purpose (fstab of the overlay, root's keyring replaced
# by a directory in RAM when /home is closed - unlock-home).
EXCLUS="/tmp /var/tmp /etc/fstab /var/log/osmo-session.log /.osmo-valider /.osmo-retour /home/.osmo-valider /home/.osmo-retour"
for _l in $CRYPTHOME_ROOT_LINKS; do EXCLUS="$EXCLUS /root/$_l"; done

log()   { echo "osmo-racine-live : $*"; }
rouge() { printf '\033[1;31m%s\033[0m\n' "$*"; }
vert()  { printf '\033[1;32m%s\033[0m\n' "$*"; }

live() { [ "$(findmnt -no FSTYPE / 2>/dev/null)" = overlay ] && mountpoint -q "$BAS" 2>/dev/null; }
root_requis() { [ "$(id -u)" = 0 ] || { log "root requis" >&2; exit 1; }; }

# phrase_home_ok < passphrase : the /home LUKS2 volume accepts it
phrase_home_ok() {
    [ -n "$CRYPTHOME_UUID" ] && [ -e "/dev/disk/by-uuid/$CRYPTHOME_UUID" ] || return 1
    # (cryptsetup warns « keyslot operation could fail as it requires more
    # than available memory » as soon as FREE memory is under the passphrase's
    # cost - 1 GiB here - although the page cache is reclaimable: not shown.
    # When the check really fails for lack of memory, that is said.)
    cryptsetup open --test-passphrase --key-file=- "/dev/disk/by-uuid/$CRYPTHOME_UUID" >/dev/null 2>&1 && return 0
    if [ "$(awk '/^MemAvailable:/ {print int($2 / 1024)}' /proc/meminfo 2>/dev/null)" -lt 1200 ] 2>/dev/null; then
        rouge "memoire insuffisante pour verifier la phrase (1 Go requis, la session en RAM en occupe trop) : fermer des applications" >&2
    fi
    return 1
}

exclu() {
    local e
    for e in $EXCLUS; do case "$1" in "$e"|"$e"/*) return 0 ;; esac; done
    return 1
}
whiteout() { [ -c "$1" ] && [ "$(stat -c '%t:%T' "$1")" = 0:0 ]; }
opaque() {
    command -v getfattr >/dev/null 2>&1 || return 1
    [ "$(getfattr --only-values -n trusted.overlay.opaque "$1" 2>/dev/null)" = y ]
}

# The RAM layers of this boot, one line each: UPPER LOWER PREFIX.
#   /     overlayroot (initramfs)
#   /home unlock-home: the LUKS2 volume read-only on /media/home-ro, a RAM
#         layer over it on /home - /home goes through the validation too
# The directories are read from the mounted overlay itself. An overlay keeps
# working when the mounts under it are unmounted: the paths are then gone
# and the layer CANNOT be written - said loudly (couches_manquantes), never
# skipped in silence.
HOME_HAUT=/media/home-rw/overlay
HOME_BAS=/media/home-ro
option_montage() {   # option_montage MOUNTPOINT KEY
    findmnt -no OPTIONS "$1" 2>/dev/null | tr ',' '\n' | sed -n "s#^$2=##p" | head -1
}
home_overlay() { [ "$(findmnt -no FSTYPE /home 2>/dev/null)" = overlay ]; }
couches() {
    local h b
    echo "$HAUT $BAS /"
    if home_overlay; then
        h="$(option_montage /home upperdir)"; b="$(option_montage /home lowerdir)"
        h="${h%/}"; b="${b%/}"
        [ -n "$h" ] && [ -n "$b" ] && [ -d "$h" ] && mountpoint -q "$b" 2>/dev/null && echo "$h $b /home"
    fi
}
# /home is a RAM layer but its directories are out of reach
couches_manquantes() {
    home_overlay || return 1
    [ "$(couches | wc -l)" -lt 2 ]
}
plein() { [ "$1" = / ] && printf '%s' "$2" || printf '%s%s' "$1" "$2"; }

# changements_couche UPPER PREFIX : the paths of one layer, minus the exclusions
changements_couche() {
    local h="$1" pre="$2" r p
    [ -d "$h" ] || return 0
    ( cd "$h" && find . -mindepth 1 -print0 2>/dev/null ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        case "$p" in *$'\n'*) continue ;; esac
        exclu "$(plein "$pre" "$p")" || printf '%s\n' "$(plein "$pre" "$p")"
    done
}
changements() {
    local h b pre
    couches | while read -r h b pre; do changements_couche "$h" "$pre"; done
}

# changements_depuis : the paths changed SINCE THE LAST WRITE of this session
# ($ETAT/ecrit, set by « valider »); without one, the whole session. By ctime:
# a rename, a chmod or a deletion (its whiteout) counts.
changements_depuis() {
    local h b pre r p
    if [ ! -f "$ETAT/ecrit" ]; then changements; return; fi
    couches | while read -r h b pre; do
        [ -d "$h" ] || continue
        ( cd "$h" && find . -mindepth 1 -cnewer "$ETAT/ecrit" ! -type d -print0 2>/dev/null ) | while IFS= read -r -d '' r; do
            p="${r#.}"
            case "$p" in *$'\n'*) continue ;; esac
            exclu "$(plein "$pre" "$p")" || printf '%s\n' "$(plein "$pre" "$p")"
        done
    done
}

# ── progress of a write ──────────────────────────────────────────────────────
# One small file, « PERCENT text », that every step of a write updates
# (the black box record, then for each layer its copy and its application):
# readable by all, it is what the REC screen of the shutdown (osmo-rec: red
# bar, centred at the bottom of the cmatrix), the terminal of « valider » and
# the desktop dialog (osmo-valider-session) show.
PROGRES=/run/osmo-progres
REC=/usr/local/sbin/osmo-rec
progres() {
    printf '%s %s\n' "$1" "$2" > "$PROGRES.nouv" 2>/dev/null && chmod 644 "$PROGRES.nouv" 2>/dev/null \
        && mv -f "$PROGRES.nouv" "$PROGRES" 2>/dev/null
}
# the bar in a terminal (stderr), until the progress file goes
progres_terminal() {
    local p t n
    while [ -e "$PROGRES" ]; do
        if read -r p t < "$PROGRES" 2>/dev/null; then
            case "$p" in ''|*[!0-9]*) p=0 ;; esac
            n=$((p * 30 / 100))
            printf '\r\033[1;31m  REC [%s%s] %3d %%\033[0m  %-28.28s' "$(printf '%*s' "$n" '' | tr ' ' '#')" \
                "$(printf '%*s' "$((30 - n))" '' | tr ' ' '-')" "$p" "$t" >&2
        fi
        sleep 0.3
    done
    printf '\r\033[K' >&2
}
# Shares of the bar, from a real write (2026-11-26, 15 600 files in RAM, 251 s):
# the black box record 120 s, then the layers - 130 s, of which a fifth is the
# copy and the rest the application (one rename per file). The time of a layer
# follows its NUMBER OF FILES, not its size.
PROGRES_BOITE=45
PROGRES_COPIE=22                 # percent of a layer's share spent copying

# ── the session's own journal ────────────────────────────────────────────────
# journald is volatile on an installed bench: what a shutdown did would be
# gone at the next boot. Every step is kept in /run, then appended to
# /var/log/osmo-session.log ON THE DISK (journal_disque), whatever the outcome.
TRACE="$ETAT/journal"
JOURNAL_DISQUE=/var/log/osmo-session.log
trace() {
    install -d -m 0700 "$ETAT" 2>/dev/null
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$TRACE" 2>/dev/null
    echo "osmo-racine-live : $*"
}
journal_disque() {
    [ -s "$TRACE" ] || { journal_home; return 0; }
    local f="$BAS$JOURNAL_DISQUE"
    if [ -z "$PHRASE" ]; then
        # NO PASSPHRASE IN THIS RUN: nothing goes to the disk, not even these
        # lines. They are kept in the black box (always written) and reach the
        # disk's log with the next validated write.
        [ -x /usr/local/sbin/osmo-diffs ] && /usr/local/sbin/osmo-diffs journal-poser < "$TRACE" >/dev/null 2>&1 && : > "$TRACE"
        journal_home
        return 0
    fi
    if mount -o remount,rw "$BAS" 2>/dev/null; then
        [ -x /usr/local/sbin/osmo-diffs ] && /usr/local/sbin/osmo-diffs journal-prendre >> "$f" 2>/dev/null
        cat "$TRACE" >> "$f" 2>/dev/null && : > "$TRACE"
        # the last 2000 lines are enough
        if [ "$(wc -l < "$f" 2>/dev/null || echo 0)" -gt 4000 ]; then
            tail -n 2000 "$f" > "$f.nouv" 2>/dev/null && mv -f "$f.nouv" "$f"
        fi
        sync
        remonter_ro "$BAS"
    fi
    journal_home
}
# journal_home : THE SAME LOG IN THE OWNER'S HOME - /home/<owner>/sessions.log,
# every validation, write, undo and end of session (what is on the disk in
# /var/log/osmo-session.log, plus the lines not yet put there). Written
# through /home like any file of the session: it is refreshed at every boot
# (unlock-home), before every write and after it, so it is complete whenever
# it is read; a write keeps it on the volume up to its own first lines.
journal_home() {
    local o="${CRYPTHOME_OWNER:-}" f
    [ -n "$o" ] && mountpoint -q /home 2>/dev/null && [ -d "/home/$o" ] || return 0
    f="/home/$o/sessions.log"
    # RED: not validated, wiped, failed. GREEN: validated, written. (less -R, cat)
    { cat "$BAS$JOURNAL_DISQUE" 2>/dev/null; cat /var/lib/osmo-diffs/session.log 2>/dev/null; cat "$TRACE" 2>/dev/null; } | sed -E \
        -e '/decision (efface|oublie)|NON VALIDEE|N EST PAS|n a PAS|NON |ECHEC|CONFLIT|conflit\(s\), rien|annule|incomplete|hors d atteinte|trop grosse|refusee/{s/^/\x1b[1;31m/;s/$/\x1b[0m/;b}' \
        -e '/decision valide|ecrit\(s\)|ecriture du moment|ecriture de la session|changements ecrits|fusionnee|fusionner .* : commit|defait|empreinte prise/{s/^/\x1b[1;32m/;s/$/\x1b[0m/}' \
        > "$f.nouv" 2>/dev/null || { rm -f "$f.nouv"; return 0; }
    chown "$o": "$f.nouv" 2>/dev/null; chmod 640 "$f.nouv" 2>/dev/null
    mv -f "$f.nouv" "$f" 2>/dev/null
}

# ── at shutdown, on the text console ─────────────────────────────────────────
console_texte() {
    if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then
        plymouth quit 2>/dev/null || true
    fi
    command -v chvt >/dev/null 2>&1 && chvt 1 2>/dev/null
    printf '\033[2J\033[H' > "$CONSOLE" 2>/dev/null
}
# the console's « forget everything »: the stick's red light blinks, faster
# and faster, then the white flash (reverse video)
flash_console() {
    local i d
    printf '\033[?25l' > "$CONSOLE" 2>/dev/null
    for d in 0.30 0.26 0.22 0.18 0.14 0.11 0.08 0.06 0.05 0.04 0.04 0.03; do
        printf '\033[2J\033[6;1H\033[1;31m%s\n%s\n%s\033[0m\n%s\n%s\n%s\n%s\n\n   regardez la lumiere' \
            '        ###' '       #####' '        ###' '        | |' '        | |' '        |=|' '        |_|' > "$CONSOLE" 2>/dev/null
        sleep "$d"
        printf '\033[2J\033[6;1H\n\n\n%s\n%s\n%s\n%s\n\n   regardez la lumiere' \
            '        | |' '        | |' '        |=|' '        |_|' > "$CONSOLE" 2>/dev/null
        sleep "$d"
    done
    printf '\033[2J' > "$CONSOLE" 2>/dev/null
    for i in 1 2 3; do
        printf '\033[?5h' > "$CONSOLE" 2>/dev/null; sleep 0.15
        printf '\033[?5l' > "$CONSOLE" 2>/dev/null; sleep 0.1
    done
    printf '\033[?25h' > "$CONSOLE" 2>/dev/null
}
dire() { printf '%s\n' "$*" > "$CONSOLE" 2>/dev/null; echo "$*"; }
dire_rouge() { rouge "$*" > "$CONSOLE" 2>/dev/null; echo "$*"; }
dire_vert()  { vert "$*" > "$CONSOLE" 2>/dev/null; echo "$*"; }

lire_console() {   # lire_console VAR PROMPT : one * per key, timeout = Enter
    local _v="$1" _c _s="" _rc
    printf '%s' "$2" > "$CONSOLE"
    while :; do
        IFS= read -r -s -n1 -t "$TIMEOUT" _c < "$CONSOLE"; _rc=$?
        [ "$_rc" -gt 128 ] && { _s=""; break; }
        [ "$_rc" -ne 0 ] && break
        [ -z "$_c" ] && break
        if [ "$_c" = $'\x7f' ] || [ "$_c" = $'\b' ]; then
            [ -n "$_s" ] && { _s="${_s%?}"; printf '\b \b' > "$CONSOLE"; }
            continue
        fi
        _s+="$_c"; printf '*' > "$CONSOLE"
    done
    echo > "$CONSOLE"
    printf -v "$_v" '%s' "$_s"
}

# ── the commit: stage, mark, apply ───────────────────────────────────────────
# appliquer_couche UPPER LOWER PREFIX ID : one layer onto its own file system.
# The journal lives on that file system, so the final moves are renames.
#
# ONLY WHAT CHANGED SINCE THE LAST WRITE is staged: the RAM layer is compared
# with the disk under it (rsync --compare-dest), so « ecrire » during a
# session writes that moment, and the next write - a second « ecrire », or
# the shutdown - only what came after. What a commit replaces or deletes is
# kept on the disk (.osmo-retour/ID): commits can be undone, the last first.
RETOUR_MAX="${OSMO_RETOUR_MAX:-20}"
NB_ECRITS=0
ID_ECRIT=""
# Ctrl-C DURING « valider » CANCELS THE WRITE (ANNULE=1, set by its trap). The
# copy of a layer is simply stopped (nothing has changed yet); the steps that
# must not be cut - the box record, the application of a layer, its undo, the
# fingerprint - run with SIGINT ignored and the cancel is taken after them: a
# layer already applied by this write is UNDONE (the way back of its commit),
# so that the disk is as it was before. At shutdown there is no Ctrl-C.
ANNULE=0
# THE /home PASSPHRASE OF THIS RUN, kept in this process for the time of the
# write it authorises: it unlocks the key that signs the disk's fingerprint
# (osmo-empreinte) - no signature without it, hence no accepted write. Empty:
# nothing of this run may touch the disk, not even its log.
PHRASE=""
sans_int() { ( trap '' INT; exec "$@" ); }
existe() { [ -e "$1" ] || [ -L "$1" ]; }
remonter_rw() {
    local b="$1" src i
    src="$(findmnt -no SOURCE "$b")"
    for i in 1 2 3; do
        [ -n "$src" ] && blockdev --setrw "$src" 2>/dev/null
        mount -o remount,rw "$b" 2>>"$TRACE" && return 0
        sleep 1
    done
    return 1
}
# remonter_ro DISK : read-only again. A file REPLACED on the disk (update-grub,
# update-initramfs in « actualiser ») that the session has read through its
# overlay stays referenced by the kernel's cache: the disk then holds an
# unlinked inode and refuses to go read-only (« mount point is busy », seen
# 2026-11-26 - the disk stayed WRITABLE). The cache is dropped and it is tried
# again; a disk that stays writable is said in the log.
remonter_ro() {
    mount -o remount,ro "$1" 2>/dev/null && return 0
    sync; echo 2 > /proc/sys/vm/drop_caches 2>/dev/null
    mount -o remount,ro "$1" 2>/dev/null && return 0
    sleep 1; sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
    mount -o remount,ro "$1" 2>/dev/null && return 0
    trace "$1 RESTE EN ECRITURE : remontage en lecture seule impossible (fichier remplace encore ouvert ?)"
    return 1
}
appliquer_couche() {
    local h="$1" b="$2" pre="$3" id="$4" de="${5:-0}" a="${6:-100}" libre besoin j="$2/.osmo-valider" r p q rc nf ns mi l pc
    mi=$((de + (a - de) * PROGRES_COPIE / 100))   # the copy, then the application
    progres "$de" "$pre : preparation"
    if [ ! -d "$h" ]; then trace "$pre : couche RAM $h introuvable - RIEN n est ecrit pour $pre"; return 1; fi
    [ -n "$(ls -A "$h" 2>/dev/null)" ] || { trace "$pre : couche RAM vide"; return 0; }
    remonter_rw "$b" || { trace "$pre : remontage en ecriture de $b impossible"; return 1; }
    rm -rf "$j"
    besoin=$(( $(du -sk -x "$h" 2>/dev/null | cut -f1) + 102400 ))
    libre=$(df -k --output=avail "$b" | tail -1 | tr -d ' ')
    if [ "$libre" -lt "$besoin" ]; then
        trace "$pre : place insuffisante ($((besoin / 1024)) Mo requis, $((libre / 1024)) libres)"
        remonter_ro "$b"; return 1
    fi
    install -d -m 0700 "$j/files"
    : > "$j/suppr"; : > "$j/crees"; : > "$j/dirs"
    printf '%s\n' "$id" > "$j/id"
    # deletions: whiteouts over something that is on the disk; and for a
    # directory made opaque, what the disk has in it and the session has not
    ( cd "$h" && find . -mindepth 1 \( -type c -o -type d \) -print0 ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        case "$p" in *$'\n'*) continue ;; esac
        exclu "$(plein "$pre" "$p")" && continue
        if whiteout "$h$p"; then
            existe "$b$p" && printf '%s\n' "$p" >> "$j/suppr"
        elif [ -d "$h$p" ] && opaque "$h$p" && [ -d "$b$p" ] && [ ! -L "$b$p" ]; then
            ( cd "$b$p" && find . -mindepth 1 -print0 ) | while IFS= read -r -d '' q; do
                q="${q#.}"
                case "$q" in *$'\n'*) continue ;; esac
                existe "$h$p$q" || printf '%s\n' "$p$q" >> "$j/suppr"
            done
        fi
    done
    if [ "$ANNULE" = 1 ]; then
        trace "$pre : annule avant la copie - rien n est change"
        rm -rf "$j"; sync; remonter_ro "$b"; return 1
    fi
    # the staged copy: what differs from the disk - attributes, ACLs, xattrs
    # and hard links kept, except overlayfs' own xattrs (opaque, origin...):
    # no overlay mark may reach the real disk. --checksum: same size and same
    # second is not « unchanged ». rsync 24 = a file vanished
    # while it was read (a service still stopping): not an error.
    ( cd "$h" && find . -mindepth 1 -print0 ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        case "$p" in *$'\n'*) continue ;; esac
        exclu "$(plein "$pre" "$p")" && continue
        whiteout "$h$p" && continue
        printf '%s\0' "${p#/}"
    done | rsync -aHAX --checksum --filter='-x trusted.overlay.*' --compare-dest="$b/" --from0 --files-from=- \
               --info=progress2 "$h/" "$j/files/" 2>>"$TRACE" | tr '\r' '\n' | while IFS= read -r l; do
        # « 104,857,600  23%  95.37MB/s  0:00:01 » : the percentage of the whole copy
        pc="${l%%%*}"; pc="${pc##* }"
        case "$pc" in ''|*[!0-9]*) continue ;; esac
        progres $((de + (mi - de) * pc / 100)) "$pre : copie"
    done
    rc=${PIPESTATUS[2]}
    progres "$mi" "$pre : application"
    if { [ "$rc" != 0 ] && [ "$rc" != 24 ]; } || [ "$ANNULE" = 1 ]; then
        trace "$pre : copie $([ "$ANNULE" = 1 ] && echo "annulee (Ctrl-C)" || echo "incomplete") (rsync $rc) - rien n est change"
        rm -rf "$j"; sync; remonter_ro "$b"; return 1
    fi
    conclure_depot "$b" "$pre" "$id" "$mi" "$a"
}

# conclure_depot DISK PREFIX ID FROM TO : a deposit staged on the disk itself
# (DISK/.osmo-valider: files, suppr) becomes a commit - from a session's RAM
# layer (appliquer_couche) or from a session merged afterwards (fusionner).
conclure_depot() {
    local b="$1" pre="$2" id="$3" mi="${4:-0}" a="${5:-100}" j="$1/.osmo-valider" r p q rc nf ns
    # directories: the old attributes of those that change, and the ones that
    # are only there as parents (same on the disk, empty here) are dropped
    ( cd "$j/files" && find . -mindepth 1 -depth -type d -print0 ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        [ -d "$b$p" ] && [ ! -L "$b$p" ] || continue
        if [ "$(stat -c '%a %u:%g' "$b$p")" = "$(stat -c '%a %u:%g' "$j/files$p")" ]; then
            rmdir "$j/files$p" 2>/dev/null
        else
            printf '%s %s\n' "$(stat -c '%a %u:%g' "$b$p")" "$p" >> "$j/dirs"
        fi
    done
    # what did not exist before: removed again by an undo
    ( cd "$j/files" && find . -mindepth 1 -print0 ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        existe "$b$p" || printf '%s\n' "$p" >> "$j/crees"
    done
    nf=$(find "$j/files" -mindepth 1 ! -type d | wc -l); ns=$(wc -l < "$j/suppr")
    if [ "$nf" = 0 ] && [ "$ns" = 0 ] && [ ! -s "$j/crees" ] && [ ! -s "$j/dirs" ]; then
        rm -rf "$j"; sync; remonter_ro "$b"
        trace "$pre : rien de nouveau depuis la derniere ecriture"
        return 0
    fi
    sync
    if [ "$ANNULE" = 1 ]; then
        trace "$pre : annule avant l application - rien n est change"
        rm -rf "$j"; sync; remonter_ro "$b"; return 1
    fi
    : > "$j/PRET"
    sync
    # from here the layer is applied to its end, Ctrl-C or not (then undone)
    OSMO_PROGRES="$PROGRES" OSMO_PROGRES_DE="$mi" OSMO_PROGRES_A="$a" OSMO_PROGRES_TEXTE="$pre : application" \
        sans_int "$APPLIQUER" "$b" >> "$TRACE" 2>&1
    rc=$?
    progres "$a" "$pre : ecrit"
    # the session this commit belongs to (one boot): « remonter » goes back by
    # whole sessions
    [ "$rc" = 0 ] && [ -d "$b/.osmo-retour/$id" ] \
        && cat /proc/sys/kernel/random/boot_id > "$b/.osmo-retour/$id/session" 2>/dev/null
    # the way back is bounded: the oldest commits can no longer be undone
    if [ -d "$b/.osmo-retour" ]; then
        ls -1 "$b/.osmo-retour" | sort | head -n -"$RETOUR_MAX" | while IFS= read -r q; do
            rm -rf "$b/.osmo-retour/$q"
        done
    fi
    sync
    remonter_ro "$b"
    trace "$pre : $nf fichier(s) ecrit(s), $ns suppression(s) (commit $id, code $rc)"
    printf '%s\n' "$((nf + ns))" >> "$ETAT/nb"
    return $rc
}

EMPREINTE=/usr/local/sbin/osmo-empreinte
empreinte_prendre() {
    [ -x "$EMPREINTE" ] || return 0
    printf '%s\n' "$PHRASE" | sans_int "$EMPREINTE" prendre --phrase-stdin >> "$TRACE" 2>&1 \
        || trace "empreinte du disque NON prise : le prochain demarrage criera"
    # measured boot (option): the TPM's object, sealed again for this disk
    [ -x /usr/local/sbin/osmo-tpm ] && sans_int /usr/local/sbin/osmo-tpm commit >> "$TRACE" 2>&1
    return 0
}

# annuler_commit ID : « valider » cancelled by Ctrl-C - the layers this write
# has already applied are undone, the box gets its « defait » record.
annuler_commit() {
    local id="$1" h b pre arg=""
    progres 96 "annulation"
    while read -r h b pre; do
        [ -f "$b/.osmo-retour/$id/FAIT" ] && arg="$arg $pre=$b"
    done < <(couches)
    if [ -z "$arg" ]; then trace "annule (Ctrl-C) : rien n avait ete ecrit sur le disque"; return 0; fi
    trace "annule (Ctrl-C) : ce que cette ecriture a deja pose est defait (commit $id :$arg)"
    # shellcheck disable=SC2086
    [ -x /usr/local/sbin/osmo-diffs ] && sans_int /usr/local/sbin/osmo-diffs defait "$id" $arg >> "$TRACE" 2>&1
    while read -r h b pre; do
        [ -f "$b/.osmo-retour/$id/FAIT" ] || continue
        if remonter_rw "$b"; then
            if sans_int "$APPLIQUER" "$b" --defaire "$id" >> "$TRACE" 2>&1 < /dev/null; then
                trace "annule : $pre revenu a son etat d avant"
            else
                trace "annule : $pre N A PAS PU etre defait (osmo-racine-live defaire)"
            fi
            remonter_ro "$b"
        else
            trace "annule : remontage en ecriture de $b impossible - $pre reste ecrit"
        fi
    done < <(couches)
}

# appliquer : every layer. Each one is atomic on its own file system; / is
# written first, /home last. NB_ECRITS: what was really written.
appliquer() {
    local h b pre rc=0 id pris
    # the commit's name: its date, never one already taken (two writes in
    # the same second)
    while :; do
        id="$(date '+%Y%m%d-%H%M%S')"
        pris=0
        while read -r h b pre; do [ -e "$b/.osmo-retour/$id" ] && pris=1; done < <(couches)
        [ "$pris" = 0 ] && break
        sleep 1
    done
    install -d -m 0700 "$ETAT"; : > "$ETAT/nb"
    if couches_manquantes; then
        trace "/home : couche RAM hors d atteinte ($(option_montage /home upperdir)) - /home N EST PAS ecrit"
        rc=1
    fi
    # each layer's share of the bar: its number of files in RAM
    local tot=0 fait=0 t de a
    while read -r h b pre; do
        t=$(find "$h" -xdev 2>/dev/null | wc -l); tot=$((tot + ${t:-0} + 1))
    done < <(couches)
    while read -r h b pre; do
        [ "$ANNULE" = 1 ] && break
        t=$(find "$h" -xdev 2>/dev/null | wc -l); t=$(( ${t:-0} + 1 ))
        de=$((PROGRES_BOITE + (100 - PROGRES_BOITE) * fait / tot)); fait=$((fait + t))
        a=$((PROGRES_BOITE + (100 - PROGRES_BOITE) * fait / tot))
        appliquer_couche "$h" "$b" "$pre" "$id" "$de" "$a" < /dev/null || rc=1
    done < <(couches)
    # cancelled (Ctrl-C, « valider » only): back to the disk of before
    if [ "$ANNULE" = 1 ]; then annuler_commit "$id"; rc=2; fi
    poser_menu_sessions
    # the disk has changed, by a commit the box knows: its fingerprint again
    # (total SHA-256 of / and of /home on the box - what the next boot compares)
    progres 97 "empreinte du disque"
    empreinte_prendre
    progres 100 "termine"
    NB_ECRITS=$(awk '{s+=$1} END{print s+0}' "$ETAT/nb" 2>/dev/null); rm -f "$ETAT/nb"
    ID_ECRIT="$id"
    return $rc
}

# ── NOT VALIDATED: kept in the black box, to be merged afterwards ───────────
# A session that is wiped is not lost for ever: at shutdown its whole content
# (what it changed and deleted since the last write, / and /home) goes to the
# BLACK BOX, encrypted like its records (age, the box's own passphrase to read
# it back) - « en attente ». The box is always written; the disk is not.
# « osmo-racine-live fusionner » validates it AFTERWARDS, as a merge: for each
# path the box also holds what the disk had under it (its base). At the merge
#   disk still as the base     -> the session's version is written
#   disk already as the session -> nothing to do
#   disk changed since          -> CONFLICT: refused and listed, unless
#                                  --session (take the session's) or --disque
#                                  (keep the disk's) settles them all
# and the result is an ordinary commit: way back, GRUB menu, fingerprint.
ATTENTE_MAX_MO="${OSMO_ATTENTE_MAX_MO:-2048}"
identite_de() {   # what a path is: - absent, d directory, l:target, f:sha256, o other
    if [ -L "$1" ]; then printf 'l:%s' "$(readlink "$1")"
    elif [ -d "$1" ]; then printf 'd'
    elif [ -f "$1" ]; then printf 'f:%s' "$(sha256sum < "$1" 2>/dev/null | cut -d' ' -f1)"
    elif [ -e "$1" ]; then printf 'o'
    else printf '%s' '-'; fi
}
# mettre_en_attente [NAME] : with a NAME, a CHECKPOINT - the same stream,
# written under that name, replacing the one before, and nothing said.
mettre_en_attente() {
    local t h b pre k=0 d ref="" r p q mo libre nom point="${1:-}"
    [ -x /usr/local/sbin/osmo-diffs ] && command -v zstd >/dev/null 2>&1 || return 0
    [ -f "$ETAT/ecrit" ] && ref="$ETAT/ecrit"
    t="$(mktemp -d /run/osmo-attente.XXXXXX)" || return 0
    mkdir -p "$t/p"
    printf 'date=%s\nsession=%s\n' "$(date '+%F %T')" "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" > "$t/p/meta"
    while read -r h b pre; do
        k=$((k + 1)); d="$t/p/c$k"; mkdir -p "$d"
        printf '%s\n' "$h" > "$t/haut$k"
        printf '%s\n' "$pre" > "$d/prefixe"; : > "$d/suppr"; : > "$d/base"; : > "$t/liste$k"
        ( cd "$h" && find . -mindepth 1 ${ref:+-cnewer "$ref"} -print0 2>/dev/null ) | while IFS= read -r -d '' r; do
            p="${r#.}"
            case "$p" in *$'\n'*|*$'\t'*) continue ;; esac
            exclu "$(plein "$pre" "$p")" && continue
            if whiteout "$h$p"; then
                if existe "$b$p"; then
                    printf '%s\n' "$p" >> "$d/suppr"
                    printf '%s\t%s\n' "$(identite_de "$b$p")" "$p" >> "$d/base"
                fi
                continue
            fi
            printf '%s\0' ".$p" >> "$t/liste$k"
            if [ -d "$h$p" ] && [ ! -L "$h$p" ]; then
                # a directory made opaque: what the disk has in it and the session has not
                if opaque "$h$p" && [ -d "$b$p" ] && [ ! -L "$b$p" ]; then
                    ( cd "$b$p" && find . -mindepth 1 -print0 ) | while IFS= read -r -d '' q; do
                        q="${q#.}"
                        case "$q" in *$'\n'*|*$'\t'*) continue ;; esac
                        existe "$h$p$q" && continue
                        printf '%s\n' "$p$q" >> "$d/suppr"
                        printf '%s\t%s\n' "$(identite_de "$b$p$q")" "$p$q" >> "$d/base"
                    done
                fi
            else
                printf '%s\t%s\n' "$(identite_de "$b$p")" "$p" >> "$d/base"
            fi
        done
    done < <(couches)
    # too big for the box: said, and the session is then only its record
    mo=0; q=1
    while [ "$q" -le "$k" ]; do
        r="$( cd "$(cat "$t/haut$q")" && xargs -0 -r stat -c '%s %F' < "$t/liste$q" 2>/dev/null \
              | awk '$2 != "directory" { s += $1 } END { print int(s / 1048576) }' )"
        mo=$((mo + ${r:-0})); q=$((q + 1))
    done
    libre=$(( $(df -k --output=avail /var/lib/osmo-diffs 2>/dev/null | tail -1 | tr -d ' ') / 1024 ))
    if [ "$mo" -gt "$ATTENTE_MAX_MO" ] || [ $((mo + 512)) -gt "${libre:-0}" ]; then
        [ -n "$point" ] || trace "attente : session trop grosse pour la boite ($mo Mo, $libre Mo libres, limite $ATTENTE_MAX_MO) - NON rejouable, seul son enregistrement reste"
        rm -rf "$t"; return 1
    fi
    nom="$( { ( cd "$t/p" && tar -cf - meta c*/prefixe c*/suppr c*/base )
              q=1
              while [ "$q" -le "$k" ]; do
                  tar -cf - --no-recursion --xattrs --xattrs-exclude='trusted.overlay.*' --acls \
                      --transform "s|^\\.|c$q/files|S" -C "$(cat "$t/haut$q")" --null -T "$t/liste$q" 2>/dev/null
                  q=$((q + 1))
              done
            } | zstd -q -3 | /usr/local/sbin/osmo-diffs attente-poser ${point:+"$point"} 2>> "$TRACE" )"
    rm -rf "$t"
    if [ -n "$point" ]; then
        # RED in the logs until the session is validated (then: green, « ecrit »)
        [ -n "$nom" ] && trace "point de controle : session NON VALIDEE gardee dans la boite noire ($mo Mo)"
        [ -n "$nom" ]; return
    elif [ -n "$nom" ]; then trace "attente : session NON VALIDEE gardee dans la boite noire ($nom, $mo Mo) - osmo-racine-live fusionner"
    else trace "attente : la session n a PAS pu etre gardee dans la boite noire"; fi
}
# THE CHECKPOINT. The box used to be written only by a validation or a clean
# shutdown: a session cut short (power loss, crash, forced power-off) left
# nothing. Every ten minutes (osmo-point.timer) the session so far goes to the
# box as « point-<boot> », replacing the checkpoint before - encrypted to the
# box's public key, so NO PASSPHRASE is involved. A clean end removes it (the
# session's own record and content take over). One found at the next boot
# belongs to a session that never ended: it is kept, « interrompue », with a
# record in the chain, and can be merged like any session not validated.
nom_point() { echo "point-$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null)"; }
point_de_controle() {
    local h b pre neuf=0
    [ -x /usr/local/sbin/osmo-diffs ] || return 0
    [ -e "$PROGRES" ] && return 0            # a write is running: not now
    install -d -m 0700 "$ETAT"
    if [ -f "$ETAT/point" ]; then
        while read -r h b pre; do
            [ -n "$(find "$h" -mindepth 1 -cnewer "$ETAT/point" -print -quit 2>/dev/null)" ] && neuf=1
        done < <(couches)
        [ "$neuf" = 1 ] || return 0          # nothing since the last checkpoint
    fi
    : > "$ETAT/point.nouv"
    if mettre_en_attente "$(nom_point)"; then mv -f "$ETAT/point.nouv" "$ETAT/point"; else rm -f "$ETAT/point.nouv"; fi
    journal_disque                           # no passphrase here: the line goes to the box
}
# what the checkpoints held is now validated (on the disk): they have done their time
points_valides() {
    [ -x /usr/local/sbin/osmo-diffs ] && /usr/local/sbin/osmo-diffs attente-oter "$(nom_point)" >/dev/null 2>&1
    rm -f "$ETAT/point"
}

# fusionner NAME MODE : see above. The stream is decrypted ONCE (the box's
# passphrase) to the /home volume - encrypted at rest - then staged on each
# disk; nothing of /home ever touches the system disk.
fusionner() {
    local nom="$1" mode="$2" t f h b pre k d j base p cur leur id rc=0 nconf=0 n1=0
    t="$(mktemp -d /run/osmo-fusion.XXXXXX)" || return 1
    f="$HOME_BAS/.osmo-fusion.tar.zst"
    remonter_rw "$HOME_BAS" || { rouge "remontage en ecriture de $HOME_BAS impossible"; rm -rf "$t"; return 1; }
    rm -f "$f"
    if ! /usr/local/sbin/osmo-diffs attente-lire "$nom" > "$f" || [ ! -s "$f" ]; then
        rm -f "$f"; remonter_ro "$HOME_BAS"; rm -rf "$t"
        rouge "session $nom illisible (phrase de la boite ?) : rien n est ecrit"; return 1
    fi
    zstd -dc "$f" 2>/dev/null | tar -xif - -C "$t" --wildcards meta 'c*/prefixe' 'c*/suppr' 'c*/base' 2>/dev/null
    : > "$t/conflits"; : > "$t/faire"
    for d in "$t"/c*/; do
        [ -f "$d/prefixe" ] || continue
        k="$(basename "$d")"; pre="$(cat "$d/prefixe")"; b=""
        while read -r h cur leur; do [ "$leur" = "$pre" ] && b="$cur"; done < <(couches)
        if [ -z "$b" ]; then trace "fusionner : la couche $pre n existe pas ici - ignoree"; continue; fi
        j="$b/.osmo-valider"
        remonter_rw "$b" || { trace "fusionner : remontage en ecriture de $b impossible"; rc=1; break; }
        rm -rf "$j" "$j.x"; install -d -m 0700 "$j" "$j.x"
        zstd -dc "$f" | tar -xif - --xattrs --acls -C "$j.x" "$k/files" 2>>"$TRACE"
        if [ -d "$j.x/$k/files" ]; then mv "$j.x/$k/files" "$j/files"; else install -d -m 0700 "$j/files"; fi
        rm -rf "$j.x"
        cp "$d/suppr" "$j/suppr"
        while IFS=$'\t' read -r base p; do
            [ -n "$p" ] || continue
            cur="$(identite_de "$b$p")"
            if grep -qxF -- "$p" "$d/suppr"; then leur="-"; else leur="$(identite_de "$j/files$p")"; fi
            [ "$cur" = "$base" ] && { n1=$((n1 + 1)); continue; }
            if [ "$cur" != "$leur" ]; then
                nconf=$((nconf + 1))
                printf '%s\n' "$(plein "$pre" "$p")" >> "$t/conflits"
                [ "$mode" = session ] && continue
            fi
            # already as the session wants it, or the disk's version is kept
            [ "$leur" = "-" ] || rm -rf "$j/files$p"
            grep -vxF -- "$p" "$j/suppr" > "$j/suppr.n"; mv -f "$j/suppr.n" "$j/suppr"
        done < "$d/base"
        printf '%s %s\n' "$b" "$pre" >> "$t/faire"
    done
    rm -f "$f"; sync
    if [ "$rc" != 0 ] || { [ "$nconf" -gt 0 ] && [ -z "$mode" ]; }; then
        while read -r b pre; do rm -rf "$b/.osmo-valider"; done < "$t/faire"
        while read -r h b pre; do remonter_ro "$b"; done < <(couches)
        if [ "$nconf" -gt 0 ]; then
            rouge "CONFLIT : $nconf chemin(s) ont change sur le disque depuis cette session - rien n est ecrit :"
            head -n 40 "$t/conflits" | sed 's/^/    /'
            [ "$nconf" -gt 40 ] && echo "    ... et $((nconf - 40)) autre(s)"
            echo "Trancher pour tous : osmo-racine-live fusionner $nom --session   (la version de la session)"
            echo "                     osmo-racine-live fusionner $nom --disque    (garder celle du disque)"
            trace "fusionner $nom : $nconf conflit(s), rien n est ecrit"
        fi
        rm -rf "$t"; return 2
    fi
    id="$(date '+%Y%m%d-%H%M%S')"
    trace "fusionner $nom : commit $id ($n1 chemin(s) sans conflit, $nconf conflit(s)${mode:+ tranches cote $mode})"
    install -d -m 0700 "$ETAT"; : > "$ETAT/nb"
    while read -r b pre; do
        j="$b/.osmo-valider"
        : > "$j/crees"; : > "$j/dirs"; printf '%s\n' "$id" > "$j/id"
        conclure_depot "$b" "$pre" "$id" 40 95 < /dev/null || rc=1
    done < "$t/faire"
    while read -r h b pre; do remonter_ro "$b"; done < <(couches)
    NB_ECRITS=$(awk '{s+=$1} END{print s+0}' "$ETAT/nb" 2>/dev/null); rm -f "$ETAT/nb"
    ID_ECRIT="$id"
    if [ "$rc" = 0 ]; then
        printf 'session en attente %s fusionnee sur le disque : commit %s, %s chemin(s), %s conflit(s)%s\n' \
            "$nom" "$id" "$NB_ECRITS" "$nconf" "${mode:+ tranches cote $mode}" \
            | /usr/local/sbin/osmo-diffs noter fusionne >> "$TRACE" 2>&1
        /usr/local/sbin/osmo-diffs attente-clore "$nom" "$id" >> "$TRACE" 2>&1
    fi
    rm -rf "$t"
    poser_menu_sessions
    empreinte_prendre
    return $rc
}

# ── the way back: commits, undone from the last one upwards ─────────────────
# retours : ID LAYERS, oldest first
retours() {
    local h b pre d
    couches | while read -r h b pre; do
        for d in "$b"/.osmo-retour/*/FAIT; do
            [ -f "$d" ] || continue
            d="${d%/FAIT}"; printf '%s %s\n' "${d##*/}" "$pre"
        done
    done | sort | awk '{a[$1]=a[$1]" "$2} END{for(k in a) print k a[k]}' | sort
}

# session_de ID : the session (boot) a commit belongs to; a commit of before
# sessions were noted is a session on its own
session_de() {
    local h b pre s=""
    while read -r h b pre; do
        if [ -s "$b/.osmo-retour/$1/session" ]; then s="$(head -n1 "$b/.osmo-retour/$1/session")"; break; fi
    done < <(couches)
    echo "${s:-seul-$1}"
}
# sessions : one line per session that can be undone, NEWEST FIRST:
#   SESSION ID ID...   (its commits, newest first)
sessions() {
    local id reste
    retours | sort -r | while read -r id reste; do printf '%s %s\n' "$(session_de "$id")" "$id"; done \
        | awk '{ if (!($1 in vu)) { vu[$1] = 1; ordre[++n] = $1 } ids[$1] = ids[$1] " " $2 }
               END { for (i = 1; i <= n; i++) print ordre[i] ids[ordre[i]] }'
}
date_commit() {   # 20261126-124123 -> 2026-11-26 12:41:23
    echo "$1" | sed -n 's/^\(....\)\(..\)\(..\)-\(..\)\(..\)\(..\)$/\1-\2-\3 \4:\5:\6/p' | grep . || echo "$1"
}
# sessions_lisibles : « 1. session du ... : N ecriture(s) ... »
sessions_lisibles() {
    local i=0 s ids n premier dernier
    sessions | while read -r s ids; do
        i=$((i + 1))
        # shellcheck disable=SC2086
        set -- $ids
        n=$#; dernier="$1"; eval "premier=\${$#}"
        if [ "$n" = 1 ]; then
            printf '  %2d. session du %s : 1 ecriture\n' "$i" "$(date_commit "$dernier")"
        else
            printf '  %2d. session du %s : %d ecritures, de %s a %s\n' "$i" "$(date_commit "$dernier" | cut -d' ' -f1)" "$n" \
                "$(date_commit "$premier" | cut -d' ' -f2)" "$(date_commit "$dernier" | cut -d' ' -f2)"
        fi
    done
}
# poser_menu_sessions : the GRUB menu « remonter session » - one entry per
# session the disk can still undo, WITH ITS DATES, newest first. Entry N goes
# back to BEFORE that session (the N last sessions are undone). Written on the
# system disk after every commit and every undo, before the fingerprint is
# taken (it is part of the disk); the model comes from update-grub
# (43_osmo-boite).
titres_sessions() {   # N|TITLE, newest first: exactly what the GRUB menu shows
    local i=0 cumul=0 s ids n premier dernier titre
    sessions | while read -r s ids; do
        i=$((i + 1))
        # shellcheck disable=SC2086
        set -- $ids
        n=$#; dernier="$1"; eval "premier=\${$#}"; cumul=$((cumul + n))
        titre="avant la session du $(date_commit "$premier" | cut -c1-16)"
        [ "$n" -gt 1 ] && titre="$titre -> $(date_commit "$dernier" | cut -c12-16)"
        printf '%s|%s   (defait %s session(s), %s ecriture(s))\n' "$i" "$titre" "$i" "$cumul"
    done
}
poser_menu_sessions() {
    local m="$BAS/boot/grub/osmo-retour.modele" f="$BAS/boot/grub/osmo-sessions.cfg" i titre
    [ -s "$m" ] || return 0
    remonter_rw "$BAS" || return 0
    if [ "$(sessions | wc -l)" = 0 ]; then
        rm -f "$f"
    else
        {
            echo "# osmo-sessions.cfg - written by osmo-racine-live (poser_menu_sessions)"
            echo "set timeout=-1"
            echo "set default=0"
            titres_sessions | while IFS='|' read -r i titre; do
                sed -e "s|@TITRE@|$titre|" -e "s|@N@|$i|" "$m"
            done
        } > "$f.nouv" 2>/dev/null && mv -f "$f.nouv" "$f"
    fi
    sync
    remonter_ro "$BAS"
}
# confirmation ID : what a write leaves to read - its date and time, and the
# line of the GRUB menu « remonter session » that now undoes it. Also kept in
# /run/osmo-derniere-ecriture for the desktop dialog (osmo-valider-session).
CONFIRMATION=/run/osmo-derniere-ecriture
confirmation() {
    local t
    t="$(titres_sessions | head -n1 | cut -d'|' -f2-)"
    {
        echo "Ecriture du $(date_commit "$1") : sur le disque."
        if [ -s "$BAS/boot/grub/osmo-sessions.cfg" ] && grep -q "osmo-sessions.cfg" "$BAS/boot/grub/grub.cfg" 2>/dev/null; then
            echo "Dans GRUB, « remonter session » : $t"
        else
            echo "Retour possible : $t"
            echo "(menu GRUB « remonter session » pas encore pose : sudo osmo-racine-live actualiser)"
        fi
    } > "$CONFIRMATION.nouv" 2>/dev/null && chmod 644 "$CONFIRMATION.nouv" && mv -f "$CONFIRMATION.nouv" "$CONFIRMATION"
    cat "$CONFIRMATION" 2>/dev/null
}
# defaire_commit ID : one commit undone on every layer that has it; the box
# first, while what is about to be removed is still there
defaire_commit() {
    local id="$1" h b pre rc=0 arg=""
    trace "defaire : commit $id"
    while read -r h b pre; do
        [ -f "$b/.osmo-retour/$id/FAIT" ] && arg="$arg $pre=$b"
    done < <(couches)
    # shellcheck disable=SC2086
    [ -x /usr/local/sbin/osmo-diffs ] && sans_int /usr/local/sbin/osmo-diffs defait "$id" $arg
    while read -r h b pre; do
        [ -f "$b/.osmo-retour/$id/FAIT" ] || continue
        if remonter_rw "$b"; then
            sans_int "$APPLIQUER" "$b" --defaire "$id" >> "$TRACE" 2>&1 < /dev/null || rc=1
            remonter_ro "$b"
            trace "defaire : $pre fait"
        else
            trace "defaire : remontage en ecriture de $b impossible"; rc=1
        fi
    done < <(couches)
    return $rc
}

# ── black box: initramfs (read it instead of booting, finish a commit) ──────
poser_initramfs() {
    install -d "$(dirname "$HOOK")" "$(dirname "$SCRIPT")"
    cat > "$HOOK" <<'HOOK'
#!/bin/sh
# osmo-boite (initramfs hook) - written by osmo-racine-live: the commit
# finisher, and what reads the black box instead of booting.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
[ -x /usr/local/sbin/osmo-valider-appliquer ] && copy_file script /usr/local/sbin/osmo-valider-appliquer /bin/osmo-valider-appliquer
_b="$(findmnt -sno SOURCE /var/lib/osmo-diffs 2>/dev/null)"
if [ -n "$_b" ]; then
    echo "BOITE_SRC=\"$_b\"" > "${DESTDIR}/conf/osmo-boite"
    [ -x /usr/bin/age ] && copy_exec /usr/bin/age /bin
    copy_exec /usr/bin/openssl /bin
fi
# MEASURED BOOT (option, osmo-tpm poser): the initramfs measures the system
# disk and asks the TPM for the seed of the code. The real find, sort,
# sha256sum and cut (busybox's find has no -printf) go to /osmo-bin; the
# TPM's device library is loaded by name, hence copied by hand.
if [ -e /etc/osmo-tpm/actif ] && [ -x /usr/bin/tpm2 ] && [ -n "$_b" ]; then
    copy_exec /usr/bin/tpm2 /bin
    for _l in /usr/lib/*/libtss2-tcti-device.so.0*; do
        [ -e "$_l" ] && copy_file library "$_l"
    done
    for _x in find sort sha256sum cut od; do copy_exec "/usr/bin/$_x" /osmo-bin; done
    copy_file script /usr/local/sbin/osmo-total /osmo-bin/osmo-total
    echo "OSMO_TPM=1" >> "${DESTDIR}/conf/osmo-boite"
fi
exit 0
HOOK
    chmod 755 "$HOOK"

    cat > "$SCRIPT" <<'SCRIPT'
#!/bin/sh
# osmo-boite (initramfs, local-bottom) - written by osmo-racine-live. Runs
# once the root is mounted, BEFORE overlayroot covers it:
#   1. a session commit cut by a power loss is finished (or thrown away when
#      it never reached its commit point) - osmo-valider-appliquer;
#   2. GRUB entry « consulter la boite noire » (osmo.boite on the kernel
#      line): the box is read with its own passphrase, then the machine
#      restarts - nothing is booted.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

CONSOLE=/dev/console
TIMEOUT=120

if { [ -d "${rootmnt}/.osmo-valider" ] || ls "${rootmnt}"/.osmo-retour/*/DEFAIRE >/dev/null 2>&1; } \
        && [ -x /bin/osmo-valider-appliquer ]; then
    echo "osmo-valider : reprise d une ecriture interrompue..." > "$CONSOLE"
    if mount -o remount,rw "${rootmnt}"; then
        /bin/osmo-valider-appliquer "${rootmnt}" > "$CONSOLE" 2>&1
        mount -o remount,ro "${rootmnt}"
    fi
fi

# 1b. MEASURED BOOT (option): this initramfs was measured by GRUB (PCR 9), so
#     what it does can be trusted. It computes the total SHA-256 of the system
#     disk (the one the black box holds) and extends PCR 13 with it; the TPM
#     gives the seed back only if firmware, GRUB, kernel, initramfs AND disk
#     are the sealed ones; the codes of the next five minutes are computed
#     (unlock-home shows the current one next to its question), then PCR 13
#     is extended again: nothing can unseal any more during this boot. Any
#     failure: no code, the boot goes on - unlock-home says so in red.
OSMO_TPM=""; BOITE_SRC=""
[ -f /conf/osmo-boite ] && . /conf/osmo-boite
if [ "$OSMO_TPM" = 1 ] && [ -x /bin/tpm2 ] && [ -c /dev/tpmrm0 ]; then
    export TPM2TOOLS_TCTI=device:/dev/tpmrm0
    R=/run/osmo-tpm
    mkdir -p "$R/m"
    T="$(PATH=/osmo-bin:$PATH /osmo-bin/osmo-total "${rootmnt}" 2>/dev/null)"
    printf '%s\n' "$T" > "$R/total"
    [ "${#T}" = 64 ] && tpm2 pcrextend "13:sha256=$T" >/dev/null 2>&1
    case "$BOITE_SRC" in
        UUID=*) bd="/dev/disk/by-uuid/${BOITE_SRC#UUID=}" ;;
        PARTUUID=*) bd="/dev/disk/by-partuuid/${BOITE_SRC#PARTUUID=}" ;;
        *) bd="$BOITE_SRC" ;;
    esac
    i=0; while [ -n "$bd" ] && [ ! -e "$bd" ] && [ "$i" -lt 5 ]; do sleep 1; i=$((i + 1)); done
    G=""
    if [ -e "$bd" ] && mount -o ro "$bd" "$R/m" 2>/dev/null; then
        if [ -f "$R/m/tpm/obj.pub" ] \
                && tpm2 createprimary -Q -C e -c "$R/p.ctx" 2>/dev/null \
                && tpm2 load -Q -C "$R/p.ctx" -u "$R/m/tpm/obj.pub" -r "$R/m/tpm/obj.priv" -c "$R/o.ctx" 2>/dev/null; then
            G="$(tpm2 unseal -c "$R/o.ctx" -p pcr:sha256:0,2,4,7,8,9,13 2>/dev/null)"
        fi
        umount "$R/m" 2>/dev/null
    fi
    # the lock: whatever happened, PCR 13 moves on
    tpm2 pcrextend 13:sha256=c0c9d5d4f8a0b6f1e2d3c4b5a69788796a5b4c3d2e1f00112233445566778899 >/dev/null 2>&1
    rm -f "$R/p.ctx" "$R/o.ctx"; rmdir "$R/m" 2>/dev/null
    if [ "${#G}" = 40 ]; then
        now="$(date +%s)"; k=0
        : > "$R/codes"; chmod 600 "$R/codes"
        while [ "$k" -lt 10 ]; do
            c=$(( now / 30 + k ))
            mac="$(printf "$(printf '%016x' "$c" | sed 's/../\\x&/g')" | openssl dgst -sha1 -mac HMAC -macopt "hexkey:$G" -r | cut -d' ' -f1)"
            off=$(( 0x$(printf '%s' "$mac" | cut -c40) * 2 + 1 ))
            n=$(( (0x$(printf '%s' "$mac" | cut -c${off}-$((off + 7))) & 0x7fffffff) % 1000000 ))
            printf '%s %06d\n' "$(( c * 30 ))" "$n" >> "$R/codes"
            k=$((k + 1))
        done
        : > "$R/reconnu"
    fi
    G=""; mac=""
fi

grep -qw 'osmo.boite' /proc/cmdline || exit 0

lire() {
    s=""
    printf '%s' "$1" > "$CONSOLE"
    while :; do
        c=""
        IFS= read -r -s -n1 -t "$TIMEOUT" c < "$CONSOLE" || { s=""; break; }
        [ -z "$c" ] && break
        case "$c" in
            "$(printf '\177')"|"$(printf '\b')")
                [ -n "$s" ] && { s="${s%?}"; printf '\b \b' > "$CONSOLE"; }
                continue ;;
        esac
        s="$s$c"; printf '*' > "$CONSOLE"
    done
    echo > "$CONSOLE"
    printf '%s' "$s"
}

B=/run/osmo-boite
if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then plymouth quit 2>/dev/null; fi
clear > "$CONSOLE" 2>/dev/null
echo "=== osmo-operator : consultation de la boite noire (pas de demarrage) ===" > "$CONSOLE"
BOITE_SRC=""; [ -f /conf/osmo-boite ] && . /conf/osmo-boite
case "$BOITE_SRC" in
    UUID=*) bd="/dev/disk/by-uuid/${BOITE_SRC#UUID=}" ;;
    PARTUUID=*) bd="/dev/disk/by-partuuid/${BOITE_SRC#PARTUUID=}" ;;
    *) bd="$BOITE_SRC" ;;
esac
i=0; while [ -n "$bd" ] && [ ! -e "$bd" ] && [ "$i" -lt 5 ]; do sleep 1; i=$((i + 1)); done
if ! command -v age >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1; then
    echo "age / openssl absents de l initramfs" > "$CONSOLE"
elif [ -z "$bd" ] || [ ! -e "$bd" ] || ! { mkdir -p "$B" && mount -o ro "$bd" "$B"; }; then
    echo "boite noire : partition absente ou illisible" > "$CONSOLE"
elif [ ! -f "$B/cle.chiffree" ]; then
    echo "la boite n a pas encore de phrase (sudo osmo-diffs phrase) : illisible ici" > "$CONSOLE"
    umount "$B"
else
    essai=1; ok=0
    while [ "$essai" -le 3 ]; do
        pp="$(lire "phrase de la boite noire : ")"
        [ -n "$pp" ] || break
        ( umask 077
          printf '%s' "$pp" | openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -salt \
              -in "$B/cle.chiffree" -pass stdin 2>/dev/null | tr -d '\000' \
              | grep -a '^AGE-SECRET-KEY-' > /run/osmo-cle )
        if [ -s /run/osmo-cle ]; then ok=1; break; fi
        echo "phrase incorrecte" > "$CONSOLE"; essai=$((essai + 1))
    done
    pp=""
    if [ "$ok" = 1 ]; then
        echo "dechiffrement..." > "$CONSOLE"
        prec=""
        for f in $(ls -1 "$B/journal" | grep '\.diff\.age$' | sort); do
            t="$(age -d -i /run/osmo-cle "$B/journal/$f" 2>/dev/null)" \
                || { echo "=== $f : indechiffrable"; prec="$f"; continue; }
            attendu="origine"
            [ -n "$prec" ] && attendu="$(openssl dgst -sha256 -r "$B/journal/$prec" | cut -d' ' -f1) $prec"
            vu="$(printf '%s\n' "$t" | sed -n '2s/^# precedent : //p')"
            [ "$vu" = "$attendu" ] || echo "=== CHAINE ROMPUE avant $f"
            printf '%s\n' "$t"
            prec="$f"
        done > /run/osmo-boite.txt
        rm -f /run/osmo-cle
        more /run/osmo-boite.txt < "$CONSOLE" > "$CONSOLE" 2>&1
        rm -f /run/osmo-boite.txt
    fi
    rm -f /run/osmo-cle
    umount "$B"
fi
lire "Entree pour redemarrer : " > /dev/null
reboot -f
SCRIPT
    chmod 755 "$SCRIPT"
}

# GRUB entry « consulter la boite noire » : the same kernel and initramfs with
# osmo.boite - the initramfs reads the box and restarts, nothing is booted.
poser_grub_boite() {
    findmnt -sno SOURCE /var/lib/osmo-diffs >/dev/null 2>&1 || { rm -f "$GRUB_BOITE"; return 0; }
    cat > "$GRUB_BOITE" <<'GRUB'
#!/bin/sh
# 43_osmo-boite - written by osmo-racine-live: read the black box (osmo-diffs)
# from the initramfs, INSTEAD OF BOOTING; the machine restarts afterwards.
set -e
. "$pkgdatadir/grub-mkconfig_lib"
K=/boot/vmlinuz
I=/boot/initrd.img
[ -e "$K" ] && [ -e "$I" ] || exit 0
K="$(readlink -f "$K")"; I="$(readlink -f "$I")"
dev="$(${grub_probe} --target=device "$K")"
rk="$(make_system_path_relative_to_its_root "$K")"
ri="$(make_system_path_relative_to_its_root "$I")"
echo "osmo-operator : entree boite noire" >&2
cat <<EOF
menuentry 'osmo-operator - consulter la boite noire (sans demarrer)' --class ubuntu --class os {
	load_video
	insmod gzio
$(prepare_grub_to_access_device "$dev" | sed 's/^/\t/')
	linux	$rk root=UUID=${GRUB_DEVICE_UUID} ro ${GRUB_CMDLINE_LINUX} osmo.boite
	initrd	$ri
}
EOF
# « remonter session » : A MENU OF DATES. The sessions the disk can still undo
# are listed, newest first, in $rg/osmo-sessions.cfg - rewritten by
# osmo-racine-live after every commit and every undo, from the model written
# here (the same kernel line as a normal boot, plus osmo.retour=N). Choosing a
# date boots normally; once /home is open (its passphrase) unlock-home runs
# « osmo-racine-live remonter N --demarrage »: the sessions down to that one
# are undone on / and /home (confirmed on the console, recorded in the black
# box), then the machine restarts on the older disk.
rg="$(make_system_path_relative_to_its_root /boot/grub)"
cat > /boot/grub/osmo-retour.modele <<EOF
menuentry '@TITRE@' --class ubuntu --class os {
	load_video
	insmod gzio
$(prepare_grub_to_access_device "$dev" | sed 's/^/\t/')
	linux	$rk root=UUID=${GRUB_DEVICE_UUID} ro ${GRUB_CMDLINE_LINUX} ${GRUB_CMDLINE_LINUX_DEFAULT} osmo.retour=@N@
	initrd	$ri
}
EOF
cat <<EOF
menuentry 'osmo-operator - remonter session (boite noire : choisir la date)' --class ubuntu --class os {
$(prepare_grub_to_access_device "$dev" | sed 's/^/\t/')
	if [ -s $rg/osmo-sessions.cfg ]; then
		configfile $rg/osmo-sessions.cfg
	else
		echo 'osmo-operator : aucune session a remonter'
		sleep 4
	fi
}
EOF
GRUB
    chmod 755 "$GRUB_BOITE"
}

actualiser() {
    local rc=0
    update-initramfs -u -k all >/dev/null 2>&1 || { log "update-initramfs a echoue" >&2; rc=1; }
    update-grub >/dev/null 2>&1 || { log "update-grub a echoue" >&2; rc=1; }
    grub_sans_ecriture || rc=1
    return $rc
}
# NOTHING IS WRITTEN WITHOUT THE /home PASSPHRASE - THE BOOT LOADER INCLUDED.
# Ubuntu's grub.cfg makes GRUB itself write /boot/grub/grubenv at every boot
# (save_env recordfail, saved_entry...): a write to the system disk before
# anything is asked, in place, dates and inode untouched - which the complete
# control then reports, rightly, as content changed under intact dates (seen
# 2026-11-26). Every save_env is taken out of the generated grub.cfg; GRUB
# still reads its environment, it no longer writes it.
grub_sans_ecriture() {
    local g=/boot/grub/grub.cfg
    [ -f "$g" ] || return 0
    grep -q 'save_env' "$g" || return 0
    sed -E 's/save_env( +[A-Za-z_]+)+/true/g' "$g" > "$g.osmo" || { rm -f "$g.osmo"; return 1; }
    if command -v grub-script-check >/dev/null 2>&1 && ! grub-script-check "$g.osmo" >/dev/null 2>&1; then
        rm -f "$g.osmo"; log "grub.cfg : save_env non retire (syntaxe)" >&2; return 1
    fi
    chmod --reference="$g" "$g.osmo" 2>/dev/null
    mv -f "$g.osmo" "$g"
}

# ── the kept copy of the mounts (osmo-garde.service) ────────────────────────
# Seen on 2026-11-26: at shutdown the mounts under /home (/media/home-ro,
# /media/home-rw) were gone BEFORE « fin » ran - /home was not written. Who
# unmounts them is not known; osmo-garde.service therefore keeps, from boot, a
# process in its OWN mount namespace (private: an unmount on the system does
# not reach it). When the layers are out of reach here, the command is run
# again in that namespace, where they still are.
garde_pid() {
    local p
    p="$(systemctl show -p MainPID --value osmo-garde.service 2>/dev/null)"
    [ -n "$p" ] && [ "$p" != 0 ] && [ -d "/proc/$p" ] && echo "$p"
}
# WHO UNMOUNTS THEM? (diagnostic) A kernel trace, set at boot by
# osmo-garde.service (« tracer »): every umount call with its path, and every
# fork/exec to follow the caller up to its parent. When the layers are found
# gone, the calls that took them - and what systemd logged around - go to the
# session log.
TRACEUR=/sys/kernel/tracing/instances/osmo
poser_traceur() {
    [ -d /sys/kernel/tracing/instances ] || return 0
    mkdir -p "$TRACEUR" 2>/dev/null || return 0
    grep -q '^p:osmo/um ' /sys/kernel/tracing/kprobe_events 2>/dev/null \
        || echo 'p:osmo/um __x64_sys_umount name=+0(+112(%di)):ustring' >> /sys/kernel/tracing/kprobe_events 2>/dev/null
    echo 4096 > "$TRACEUR/buffer_size_kb" 2>/dev/null
    for e in osmo/um sched/sched_process_fork sched/sched_process_exec; do
        echo 1 > "$TRACEUR/events/$e/enable" 2>/dev/null
    done
    echo 1 > "$TRACEUR/tracing_on" 2>/dev/null
}
qui_demonte() {
    local t="$TRACEUR/trace" l pid p e n
    [ -r "$t" ] || { trace "demontage : pas de trace noyau (osmo-garde.service)"; return 0; }
    grep -a 'um: .*name="\(/media/home-r[ow]\|/home\)"' "$t" | tail -n 6 | while IFS= read -r l; do
        trace "demontage : $(printf '%s' "$l" | sed -E 's/^ +//; s/ +\[[0-9]+\] [^ ]+ +/ /; s/\(__x64_sys_umount[^)]*\) //' | cut -c1-150)"
        pid="$(printf '%s' "$l" | sed -E 's/^ *.*-([0-9]+) +\[.*/\1/')"; n=0
        while [ -n "$pid" ] && [ "$pid" != 1 ] && [ "$n" -lt 5 ]; do
            p="$(grep -a "child_pid=$pid\$" "$t" | tail -1)"
            e="$(grep -a "sched_process_exec: filename=[^ ]* pid=$pid " "$t" | tail -1 | sed -E 's/.*filename=([^ ]*).*/\1/')"
            [ -n "$p" ] || { trace "demontage :   pid $pid${e:+ ($e)} : parent inconnu"; break; }
            trace "demontage :   pid $pid${e:+ ($e)} lance par $(printf '%s' "$p" | sed -E 's/.*comm=([^ ]*) pid=([0-9]+) child.*/\1 (pid \2)/')"
            pid="$(printf '%s' "$p" | sed -E 's/.*comm=[^ ]* pid=([0-9]+) child.*/\1/')"; n=$((n + 1))
        done
    done
    # what systemd said of these units since the shutdown began
    journalctl -b --no-pager -o short-monotonic -n 4000 2>/dev/null \
        | grep -a 'home.x2dro\|home-ro\|luks\|cryptsetup\|home\.mount\|osmo-fin-session\|osmo-garde\|Reached target\|shutdown' \
        | tail -n 25 | while IFS= read -r l; do trace "systemd : $(printf '%s' "$l" | cut -c1-170)"; done
}
etat_montages() {   # one line: what is mounted of /home and its two layers
    local m o=""
    for m in /home "$HOME_BAS" "${HOME_HAUT%/overlay}"; do
        o="$o $m=$(findmnt -no FSTYPE "$m" 2>/dev/null | head -1 | grep . || echo ABSENT)"
    done
    echo "$o"
}
case "${1:-etat}" in
    fin|valider|ecrire|defaire|remonter|fusionner)
        if [ "$(id -u)" = 0 ] && live && couches_manquantes; then
            trace "${1} : couches de /home hors d atteinte ici :$(etat_montages)"
            [ -z "${OSMO_DANS_GARDE:-}" ] && qui_demonte
            _g="$(garde_pid)"
            if [ -z "${OSMO_DANS_GARDE:-}" ] && [ -n "$_g" ] \
                    && OSMO_DANS_GARDE=1 nsenter -t "$_g" -m "$0" couches-ok 2>/dev/null; then
                trace "${1} : reprise dans la copie gardee des montages (osmo-garde, pid $_g)"
                OSMO_DANS_GARDE=1 exec nsenter -t "$_g" -m "$0" "$@"
            fi
            trace "${1} : pas de copie gardee utilisable (osmo-garde.service : ${_g:-arrete})"
        fi
        ;;
esac

case "${1:-etat}" in
    tracer)
        # (osmo-garde.service) the kernel trace of umount calls: who takes the layers of /home
        root_requis
        poser_traceur
        ;;
    couches-ok)
        # (internal) are the layers of /home within reach in this namespace?
        live && ! couches_manquantes
        ;;
    poser)
        root_requis
        command -v overlayroot-chroot >/dev/null 2>&1 \
            || { log "paquet overlayroot absent - rien de pose" >&2; exit 1; }
        # Without the encrypted /home there is no passphrase to validate with:
        # every session would be wiped for ever. Left read-write, and said.
        if [ -z "$CRYPTHOME_UUID" ]; then
            rouge "osmo-racine-live : pas de /home chiffre (LUKS2) - / reste en lecture-ecriture, rien de pose" >&2
            exit 0
        fi
        cat > "$CONF" <<EOF
# /etc/overlayroot.conf - written by osmo-racine-live.
# / read-only, every write of a session in RAM (recurse=0: the other mounts
# are not covered here; /home gets its own RAM layer from unlock-home, /boot/efi
# and the black box are written directly). The session is written to the disk
# at shutdown only with the /home passphrase (osmo-fin-session.service).
overlayroot="$REGLAGE"
EOF
        # shellcheck disable=SC2086
        rm -f $ANCIENS
        poser_initramfs
        poser_grub_boite
        systemctl enable osmo-fin-session.service osmo-garde.service osmo-point.timer >/dev/null 2>&1 \
            || log "osmo-fin-session.service non active" >&2
        # the disk against its fingerprint at every boot (osmo-empreinte)
        systemctl enable osmo-empreinte.service osmo-empreinte-fond.service >/dev/null 2>&1 \
