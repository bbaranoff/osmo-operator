#!/bin/bash
# osmo-racine-live - who may write the system disk of an INSTALLED bench.
#
#   ROOT   : ALWAYS live. In a root session / is read-only, and every write to
#            it (root's files, /etc, /opt/GSM, /var...) goes to RAM and is gone
#            at the next boot. There is no persistent root: to keep a change,
#            switch to the session account.
#   THE SESSION ACCOUNT (the /home passphrase given at boot): writes
#            everywhere, persistently - its encrypted /home, and / (through
#            root's rights, sudo).
#
#   osmo-racine-live poser    enable (Calamares, shellprocess-osmo.conf: at
#                             installation, in the target)
#   osmo-racine-live etat     live (RAM) or written to the disk, this boot
#   osmo-racine-live retirer  disable for good (from the session account's
#                             boot, with sudo)
#
# THE MECHANISM: Ubuntu's overlayroot package. Its initramfs script mounts the
# real root read-only on /media/root-ro and an overlay with a tmpfs upper on /.
# recurse=0: only / is covered, every other fstab line (the encrypted /home,
# /boot/efi) is mounted as it is.
#
# THE ONLY QUESTION AT BOOT, asked by the initramfs (local-bottom, BEFORE the
# root is covered): « decrypt /home -passphrase- or Enter » - the question of
# unlock-home, moved here because its answer decides who writes. Right
# passphrase: the overlay is turned off for this boot (/ written to the disk)
# and the passphrase waits in /run/crypthome.key (RAM) for unlock-home, which
# does not ask again. Enter, timeout, three refusals: root session, live
# (/run/crypthome.skip). To make that possible, the overlayroot setting lives
# in the INITRAMFS config (/etc/initramfs-tools/conf.d/overlayroot ->
# /conf/conf.d/overlayroot, which the boot script may still rewrite), not in
# /etc/overlayroot.conf, which would override it.
#
# LIMITS (wiki/ISO.md, 6.7): a root of a live boot can still remount
# /media/root-ro read-write or write the block device; someone at the GRUB
# menu can add overlayroot=disabled. This keeps root's sessions from leaving
# anything behind; it is not a barrier against a hostile root with the
# machine in hand. The encrypted /home stays out of reach in every case as
# long as nobody types its passphrase into a system root has modified.
set -u
CONF=/etc/overlayroot.conf
CONF_INITRD=/etc/initramfs-tools/conf.d/overlayroot
HOOK=/etc/initramfs-tools/hooks/osmo-racine-rw
SCRIPT=/etc/initramfs-tools/scripts/local-bottom/osmo-racine-rw
REGLAGE='tmpfs:swap=1,recurse=0'
# left by the previous version of this script: removed by poser and retirer
ANCIENS="/etc/osmo-racine-rw.hash /etc/grub.d/42_osmo-maintenance"

live() {
    [ "$(findmnt -no FSTYPE / 2>/dev/null)" = overlay ] && mountpoint -q /media/root-ro 2>/dev/null
}

poser_initramfs() {
    install -d "$(dirname "$HOOK")" "$(dirname "$SCRIPT")" "$(dirname "$CONF_INITRD")"
    printf '# written by osmo-racine-live: / in RAM for root; %s lifts it\n# for the session account (right /home passphrase)\noverlayroot="%s"\n' \
        "$SCRIPT" "$REGLAGE" > "$CONF_INITRD"

    cat > "$HOOK" <<'HOOK'
#!/bin/sh
# osmo-racine-rw (initramfs hook) - written by osmo-racine-live: carries the
# crypthome settings and cryptsetup (the /home question is asked here).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
[ -f /etc/default/crypthome ] || exit 0
copy_exec /sbin/cryptsetup /sbin
mkdir -p "${DESTDIR}/etc/default"
cp /etc/default/crypthome "${DESTDIR}/etc/default/crypthome"
manual_add_modules dm_mod dm_crypt || true
HOOK
    chmod 755 "$HOOK"

    cat > "$SCRIPT" <<'SCRIPT'
#!/bin/sh
# osmo-racine-rw (initramfs, local-bottom) - written by osmo-racine-live.
# Runs once the root is mounted and BEFORE init-bottom/overlayroot covers it.
# « decrypt /home -passphrase- or Enter », on the text console:
#   right passphrase : the session account's boot - / written to the disk;
#                      the passphrase waits in /run/crypthome.key (RAM);
#   Enter / timeout / three refusals : root session, / in RAM
#                      (/run/crypthome.skip).
# unlock-home (systemd) then reads one of the two instead of asking again.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

C=/conf/conf.d/overlayroot
CONSOLE=/dev/console
CRYPTHOME_UUID=""; CRYPTHOME_TIMEOUT=60; CRYPTHOME_TRIES=3; CRYPTHOME_MOUNT=/home
[ -f /etc/default/crypthome ] && . /etc/default/crypthome
TIMEOUT="${CRYPTHOME_TIMEOUT:-60}"

console_texte() {   # questions go to the text console, like unlock-home
    if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then
        plymouth quit 2>/dev/null || true
    fi
}

lire() {   # lire PROMPT -> the answer on stdout, one * per key
    s=""
    printf '%s' "$1" > "$CONSOLE"
    while :; do
        c=""
        IFS= read -r -s -n1 -t "$TIMEOUT" c < "$CONSOLE" || { s=""; break; }   # timeout
        [ -z "$c" ] && break                                                    # Enter
        case "$c" in
            "$(printf '\177')"|"$(printf '\b')")
                [ -n "$s" ] && { s="${s%?}"; printf '\b \b' > "$CONSOLE"; }
                continue ;;
        esac
        s="$s$c"; printf '*' > "$CONSOLE"
    done
    echo > "$CONSOLE"
    printf '%s' "$s"
}

grep -q '^overlayroot="tmpfs' "$C" 2>/dev/null || exit 0
[ -n "$CRYPTHOME_UUID" ] && command -v cryptsetup >/dev/null 2>&1 || exit 0
dev="/dev/disk/by-uuid/$CRYPTHOME_UUID"
i=0; while [ ! -e "$dev" ] && [ "$i" -lt 5 ]; do sleep 1; i=$((i + 1)); done
[ -e "$dev" ] || exit 0          # no encrypted disk: root, live; unlock-home says why

console_texte

essai=1
while [ "$essai" -le "${CRYPTHOME_TRIES:-3}" ]; do
    inv="decrypt $CRYPTHOME_MOUNT -passphrase- or Enter"
    [ "$essai" -gt 1 ] && inv="$inv ($essai/${CRYPTHOME_TRIES:-3})"
    p="$(lire "$inv : ")"
    [ -n "$p" ] || break
    if printf '%s' "$p" | cryptsetup open --test-passphrase --key-file=- "$dev" 2>/dev/null; then
        ( umask 077; printf '%s' "$p" > /run/crypthome.key )
        p=""
        # the session account writes everywhere: / on the disk
        echo 'overlayroot="disabled"' > "$C"
        exit 0
    fi
    echo "phrase de passe refusee" > "$CONSOLE"
    essai=$((essai + 1))
done
p=""
: > /run/crypthome.skip
echo "osmo-racine-rw : session root, / en lecture seule (RAM)" > "$CONSOLE"
exit 0
SCRIPT
    chmod 755 "$SCRIPT"
}

actualiser() {
    update-initramfs -u >/dev/null 2>&1 || echo "osmo-racine-live : update-initramfs a echoue" >&2
    update-grub >/dev/null 2>&1 || echo "osmo-racine-live : update-grub a echoue" >&2
}

case "${1:-etat}" in
    poser)
        [ "$(id -u)" = 0 ] || { echo "osmo-racine-live : root requis" >&2; exit 1; }
        command -v overlayroot-chroot >/dev/null 2>&1 \
            || { echo "osmo-racine-live : paquet overlayroot absent - rien de pose" >&2; exit 1; }
        # Without an encrypted /home there is no session account to write: a
        # root-only, always-live disk could never be updated. Left as it is.
        _uuid="$(. /etc/default/crypthome 2>/dev/null; echo "${CRYPTHOME_UUID:-}")"
        if [ -z "$_uuid" ]; then
            echo "osmo-racine-live : pas de /home chiffre - / reste persistant (rien de pose)" >&2
            exit 0
        fi
        cat > "$CONF" <<'EOF'
# /etc/overlayroot.conf - written by osmo-racine-live.
# The setting is in the INITRAMFS config, /etc/initramfs-tools/conf.d/overlayroot
# (/ read-only for root, writes in RAM; recurse=0: the other mounts stay as
# they are): a value here would override it, and the session account's
# passphrase could no longer lift it.
overlayroot_cfgdisk="disabled"
EOF
        # shellcheck disable=SC2086
        rm -f $ANCIENS
        poser_initramfs
        actualiser
        echo "osmo-racine-live : root en lecture seule (RAM) ; le compte de session ecrit partout"
        ;;
    etat)
        if live; then
            echo "live : / en RAM, perdu au redemarrage (session root)"
        else
            echo "persistant : / ecrit sur le disque"
        fi
        if mountpoint -q /home 2>/dev/null; then
            echo "/home : $(findmnt -no SOURCE /home) (en ecriture, persistant)"
        else
            echo "/home : non monte (disque chiffre ferme)"
        fi
        ;;
    retirer)
        if live; then
            echo "osmo-racine-live : session root en lecture seule - a faire depuis le compte de session" >&2
            exit 1
        fi
        sed -i 's/^overlayroot=.*/overlayroot=""/' "$CONF" 2>/dev/null
        # shellcheck disable=SC2086
        rm -f "$CONF_INITRD" "$HOOK" "$SCRIPT" $ANCIENS
        actualiser
        echo "osmo-racine-live : / persistant pour tous a partir du prochain demarrage"
        ;;
    *)
        echo "usage : osmo-racine-live poser | etat | retirer" >&2
        exit 2
        ;;
esac
