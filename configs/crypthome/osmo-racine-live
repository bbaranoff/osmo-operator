#!/bin/bash
# osmo-racine-live - the system disk of an INSTALLED bench is read-only; a
# session's changes are written at shutdown only with the /home passphrase.
#
# THE DISK (installer/calamares/modules/partition.conf):
#   EFI          clear   Ubuntu's GRUB (Secure Boot: shim + grub signed)
#   /            clear   READ-ONLY: overlayroot puts a RAM layer over it
#   osmo-diffs   clear   the black box (each record encrypted, own passphrase)
#   /home        LUKS2   nirvana's home (unlock-home asks at boot)
#
# EVERY SESSION RUNS IN RAM. Everything written to / - /root, /opt/GSM, /etc,
# /var... - goes to the overlay's tmpfs. At SHUTDOWN (osmo-fin-session.service
# -> « fin »):
#   the /home passphrase given (now or during the session, « valider »):
#       the whole session is written to the disk, atomically (see « appliquer »);
#   no passphrase (Enter, timeout, wrong three times):
#       the RAM is dropped, NOTHING of the session survives - and a RED
#       warning says so on the console, held a few seconds.
# Either way the black box records what the session changed, marked
# « valide » or « efface ». /home goes through the same validation: unlock-home
# mounts the LUKS2 volume read-only on /media/home-ro and a RAM layer over it
# on /home (/media/home-rw), written back with the rest. TWO PASSPHRASES:
# the /home one opens /home AND validates; the black box has its own,
# different one (osmo-diffs phrase), only to read it back - never asked at
# shutdown.
#
#   osmo-racine-live poser        enable (Calamares, shellprocess-osmo.conf)
#   osmo-racine-live etat         this boot: RAM or disk, validated or not
#   osmo-racine-live changements  the session's changes (paths)
#   osmo-racine-live valider      give the /home passphrase now: the session
#                                 will be written at shutdown (--stdin: read
#                                 one line, for osmo-valider-session)
#   osmo-racine-live ecrire       write the session to the disk NOW, same
#                                 passphrase (--stdin too): a power cut then
#                                 loses only what came after
#   osmo-racine-live annuler      forget the validation: wiped at shutdown
#   osmo-racine-live oublier      « Tout oublier ? » Yes: wiped, white screen,
#                                 no question at shutdown
#   osmo-racine-live fin          at shutdown (osmo-fin-session.service)
#   osmo-racine-live retirer      back to an ordinary read-write / (from
#                                 « sudo overlayroot-chroot osmo-racine-live retirer »)
#
# ATOMIC WRITE. The RAM layer is first COPIED next to the root, on the same
# disk (/.osmo-valider/files), with the list of deletions; then a PRET mark
# is synced: that is the commit point. Only then are the files moved into
# place, one rename each (osmo-valider-appliquer). A cut before PRET leaves
# the disk as it was (the staging is thrown away at the next boot); a cut
# after PRET is finished by the initramfs at the next boot, before anything
# reads the root.
#
# LIMITS: root can always remount /media/root-ro read-write, or write the
# block device: this is about sessions leaving nothing behind without the
# passphrase, not a barrier against a hostile root with the machine in hand.
# The encrypted /home stays out of reach as long as nobody types its
# passphrase into a system root has modified.
set -u
CONF=/etc/overlayroot.conf
REGLAGE='tmpfs:swap=1,recurse=0'
HAUT=/media/root-rw/overlay
BAS=/media/root-ro
ETAT=/run/osmo-racine
MARQUE="$ETAT/valide"
APPLIQUER=/usr/local/sbin/osmo-valider-appliquer
HOOK=/etc/initramfs-tools/hooks/osmo-boite
SCRIPT=/etc/initramfs-tools/scripts/local-bottom/osmo-boite
GRUB_BOITE=/etc/grub.d/43_osmo-boite
# left by previous versions: removed by poser and retirer
ANCIENS="/etc/osmo-racine-rw.hash /etc/grub.d/42_osmo-maintenance
         /etc/initramfs-tools/conf.d/overlayroot
         /etc/initramfs-tools/hooks/osmo-racine-rw
         /etc/initramfs-tools/scripts/local-bottom/osmo-racine-rw
         /etc/apt/apt.conf.d/99osmo-grub-esp"
CONSOLE=/dev/console
[ -c "$CONSOLE" ] || CONSOLE=/dev/tty1

CRYPTHOME_UUID=""; CRYPTHOME_TRIES=3; CRYPTHOME_TIMEOUT=60; CRYPTHOME_ROOT_LINKS=".local/share/keyrings"
# shellcheck disable=SC1091
[ -r /etc/default/crypthome ] && . /etc/default/crypthome
TIMEOUT="${CRYPTHOME_TIMEOUT:-60}"

# Never written to the disk: the RAM itself, and what overlayroot or a root
# session rewrites on purpose (fstab of the overlay, root's keyring replaced
# by a directory in RAM when /home is closed - unlock-home).
EXCLUS="/tmp /var/tmp /etc/fstab"
for _l in $CRYPTHOME_ROOT_LINKS; do EXCLUS="$EXCLUS /root/$_l"; done

log()   { echo "osmo-racine-live : $*"; }
rouge() { printf '\033[1;31m%s\033[0m\n' "$*"; }
vert()  { printf '\033[1;32m%s\033[0m\n' "$*"; }

live() { [ "$(findmnt -no FSTYPE / 2>/dev/null)" = overlay ] && mountpoint -q "$BAS" 2>/dev/null; }
root_requis() { [ "$(id -u)" = 0 ] || { log "root requis" >&2; exit 1; }; }

# phrase_home_ok < passphrase : the /home LUKS2 volume accepts it
phrase_home_ok() {
    [ -n "$CRYPTHOME_UUID" ] && [ -e "/dev/disk/by-uuid/$CRYPTHOME_UUID" ] || return 1
    cryptsetup open --test-passphrase --key-file=- "/dev/disk/by-uuid/$CRYPTHOME_UUID" 2>/dev/null
}

exclu() {
    local e
    for e in $EXCLUS; do case "$1" in "$e"|"$e"/*) return 0 ;; esac; done
    return 1
}
whiteout() { [ -c "$1" ] && [ "$(stat -c '%t:%T' "$1")" = 0:0 ]; }
opaque() {
    command -v getfattr >/dev/null 2>&1 || return 1
    [ "$(getfattr --only-values -n trusted.overlay.opaque "$1" 2>/dev/null)" = y ]
}

# The RAM layers of this boot, one line each: UPPER LOWER PREFIX.
#   /     overlayroot (initramfs)
#   /home unlock-home: the LUKS2 volume read-only on /media/home-ro, a RAM
#         layer over it on /home - /home goes through the validation too
HOME_HAUT=/media/home-rw/overlay
HOME_BAS=/media/home-ro
couches() {
    echo "$HAUT $BAS /"
    mountpoint -q "$HOME_BAS" 2>/dev/null && [ -d "$HOME_HAUT" ] && echo "$HOME_HAUT $HOME_BAS /home"
}
plein() { [ "$1" = / ] && printf '%s' "$2" || printf '%s%s' "$1" "$2"; }

# changements_couche UPPER PREFIX : the paths of one layer, minus the exclusions
changements_couche() {
    local h="$1" pre="$2" r p
    [ -d "$h" ] || return 0
    ( cd "$h" && find . -mindepth 1 -print0 2>/dev/null ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        case "$p" in *$'\n'*) continue ;; esac
        exclu "$(plein "$pre" "$p")" || printf '%s\n' "$(plein "$pre" "$p")"
    done
}
changements() {
    local h b pre
    couches | while read -r h b pre; do changements_couche "$h" "$pre"; done
}

# ── at shutdown, on the text console ─────────────────────────────────────────
console_texte() {
    if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then
        plymouth quit 2>/dev/null || true
    fi
    command -v chvt >/dev/null 2>&1 && chvt 1 2>/dev/null
    printf '\033[2J\033[H' > "$CONSOLE" 2>/dev/null
}
# the console's « forget everything » flash: reverse video, three times
flash_console() {
    local i
    for i in 1 2 3; do
        printf '\033[?5h' > "$CONSOLE" 2>/dev/null; sleep 0.15
        printf '\033[?5l' > "$CONSOLE" 2>/dev/null; sleep 0.1
    done
}
dire() { printf '%s\n' "$*" > "$CONSOLE" 2>/dev/null; echo "$*"; }
dire_rouge() { rouge "$*" > "$CONSOLE" 2>/dev/null; echo "$*"; }
dire_vert()  { vert "$*" > "$CONSOLE" 2>/dev/null; echo "$*"; }

lire_console() {   # lire_console VAR PROMPT : one * per key, timeout = Enter
    local _v="$1" _c _s="" _rc
    printf '%s' "$2" > "$CONSOLE"
    while :; do
        IFS= read -r -s -n1 -t "$TIMEOUT" _c < "$CONSOLE"; _rc=$?
        [ "$_rc" -gt 128 ] && { _s=""; break; }
        [ "$_rc" -ne 0 ] && break
        [ -z "$_c" ] && break
        if [ "$_c" = $'\x7f' ] || [ "$_c" = $'\b' ]; then
            [ -n "$_s" ] && { _s="${_s%?}"; printf '\b \b' > "$CONSOLE"; }
            continue
        fi
        _s+="$_c"; printf '*' > "$CONSOLE"
    done
    echo > "$CONSOLE"
    printf -v "$_v" '%s' "$_s"
}

# ── the commit: stage, mark, apply ───────────────────────────────────────────
# appliquer_couche UPPER LOWER PREFIX : one layer onto its own file system.
# The journal lives on that file system, so the final moves are renames.
appliquer_couche() {
    local h="$1" b="$2" pre="$3" src libre besoin j="$2/.osmo-valider" r p
    [ -d "$h" ] && [ -n "$(ls -A "$h" 2>/dev/null)" ] || return 0
    src="$(findmnt -no SOURCE "$b")"
    [ -n "$src" ] && blockdev --setrw "$src" 2>/dev/null
    mount -o remount,rw "$b" || { log "remontage en ecriture de $b impossible"; return 1; }
    rm -rf "$j"
    besoin=$(( $(du -sk -x "$h" 2>/dev/null | cut -f1) + 102400 ))
    libre=$(df -k --output=avail "$b" | tail -1 | tr -d ' ')
    if [ "$libre" -lt "$besoin" ]; then
        log "$pre : place insuffisante ($((besoin / 1024)) Mo requis, $((libre / 1024)) libres)"
        mount -o remount,ro "$b"; return 1
    fi
    install -d -m 0700 "$j/files"
    : > "$j/suppr"
    # deletions: whiteouts, and opaque directories (replaced as a whole)
    ( cd "$h" && find . -mindepth 1 \( -type c -o -type d \) -print0 ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        case "$p" in *$'\n'*) continue ;; esac
        exclu "$(plein "$pre" "$p")" && continue
        if whiteout "$h$p" || { [ -d "$h$p" ] && opaque "$h$p"; }; then
            printf '%s\n' "$p" >> "$j/suppr"
        fi
    done
    # the staged copy: everything else, attributes, ACLs, xattrs and hard
    # links kept - except overlayfs' own xattrs (opaque, origin, impure...):
    # no overlay mark may reach the real disk
    ( cd "$h" && find . -mindepth 1 -print0 ) | while IFS= read -r -d '' r; do
        p="${r#.}"
        case "$p" in *$'\n'*) continue ;; esac
        exclu "$(plein "$pre" "$p")" && continue
        whiteout "$h$p" && continue
        printf '%s\0' "${p#/}"
    done | rsync -aHAX --filter='-x trusted.overlay.*' --from0 --files-from=- "$h/" "$j/files/" \
        || { log "$pre : copie incomplete - rien n est change"; rm -rf "$j"; sync; mount -o remount,ro "$b"; return 1; }
    sync
    : > "$j/PRET"
    sync
    "$APPLIQUER" "$b"
    local rc=$?
    mount -o remount,ro "$b" 2>/dev/null
    return $rc
}

# appliquer : every layer. Each one is atomic on its own file system; / is
# written first, /home last.
appliquer() {
    local h b pre rc=0
    while read -r h b pre; do
        appliquer_couche "$h" "$b" "$pre" || rc=1
    done < <(couches)
    return $rc
}

# ── black box: initramfs (read it instead of booting, finish a commit) ──────
poser_initramfs() {
    install -d "$(dirname "$HOOK")" "$(dirname "$SCRIPT")"
    cat > "$HOOK" <<'HOOK'
#!/bin/sh
# osmo-boite (initramfs hook) - written by osmo-racine-live: the commit
# finisher, and what reads the black box instead of booting.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
[ -x /usr/local/sbin/osmo-valider-appliquer ] && copy_file script /usr/local/sbin/osmo-valider-appliquer /bin/osmo-valider-appliquer
_b="$(findmnt -sno SOURCE /var/lib/osmo-diffs 2>/dev/null)"
if [ -n "$_b" ]; then
    echo "BOITE_SRC=\"$_b\"" > "${DESTDIR}/conf/osmo-boite"
    [ -x /usr/bin/age ] && copy_exec /usr/bin/age /bin
    copy_exec /usr/bin/openssl /bin
fi
exit 0
HOOK
    chmod 755 "$HOOK"

    cat > "$SCRIPT" <<'SCRIPT'
#!/bin/sh
# osmo-boite (initramfs, local-bottom) - written by osmo-racine-live. Runs
# once the root is mounted, BEFORE overlayroot covers it:
#   1. a session commit cut by a power loss is finished (or thrown away when
#      it never reached its commit point) - osmo-valider-appliquer;
#   2. GRUB entry « consulter la boite noire » (osmo.boite on the kernel
#      line): the box is read with its own passphrase, then the machine
#      restarts - nothing is booted.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0;; esac

CONSOLE=/dev/console
TIMEOUT=120

if [ -d "${rootmnt}/.osmo-valider" ] && [ -x /bin/osmo-valider-appliquer ]; then
    echo "osmo-valider : reprise d une validation interrompue..." > "$CONSOLE"
    if mount -o remount,rw "${rootmnt}"; then
        /bin/osmo-valider-appliquer "${rootmnt}" > "$CONSOLE" 2>&1
        mount -o remount,ro "${rootmnt}"
    fi
fi

grep -qw 'osmo.boite' /proc/cmdline || exit 0

lire() {
    s=""
    printf '%s' "$1" > "$CONSOLE"
    while :; do
        c=""
        IFS= read -r -s -n1 -t "$TIMEOUT" c < "$CONSOLE" || { s=""; break; }
        [ -z "$c" ] && break
        case "$c" in
            "$(printf '\177')"|"$(printf '\b')")
                [ -n "$s" ] && { s="${s%?}"; printf '\b \b' > "$CONSOLE"; }
                continue ;;
        esac
        s="$s$c"; printf '*' > "$CONSOLE"
    done
    echo > "$CONSOLE"
    printf '%s' "$s"
}

B=/run/osmo-boite
if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then plymouth quit 2>/dev/null; fi
clear > "$CONSOLE" 2>/dev/null
echo "=== osmo-operator : consultation de la boite noire (pas de demarrage) ===" > "$CONSOLE"
BOITE_SRC=""; [ -f /conf/osmo-boite ] && . /conf/osmo-boite
case "$BOITE_SRC" in
    UUID=*) bd="/dev/disk/by-uuid/${BOITE_SRC#UUID=}" ;;
    PARTUUID=*) bd="/dev/disk/by-partuuid/${BOITE_SRC#PARTUUID=}" ;;
    *) bd="$BOITE_SRC" ;;
esac
i=0; while [ -n "$bd" ] && [ ! -e "$bd" ] && [ "$i" -lt 5 ]; do sleep 1; i=$((i + 1)); done
if ! command -v age >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1; then
    echo "age / openssl absents de l initramfs" > "$CONSOLE"
elif [ -z "$bd" ] || [ ! -e "$bd" ] || ! { mkdir -p "$B" && mount -o ro "$bd" "$B"; }; then
    echo "boite noire : partition absente ou illisible" > "$CONSOLE"
elif [ ! -f "$B/cle.chiffree" ]; then
    echo "la boite n a pas encore de phrase (sudo osmo-diffs phrase) : illisible ici" > "$CONSOLE"
    umount "$B"
else
    essai=1; ok=0
    while [ "$essai" -le 3 ]; do
        pp="$(lire "phrase de la boite noire : ")"
        [ -n "$pp" ] || break
        ( umask 077
          printf '%s' "$pp" | openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -salt \
              -in "$B/cle.chiffree" -pass stdin 2>/dev/null | tr -d '\000' \
              | grep -a '^AGE-SECRET-KEY-' > /run/osmo-cle )
        if [ -s /run/osmo-cle ]; then ok=1; break; fi
        echo "phrase incorrecte" > "$CONSOLE"; essai=$((essai + 1))
    done
    pp=""
    if [ "$ok" = 1 ]; then
        echo "dechiffrement..." > "$CONSOLE"
        prec=""
        for f in $(ls -1 "$B/journal" | grep '\.diff\.age$' | sort); do
            t="$(age -d -i /run/osmo-cle "$B/journal/$f" 2>/dev/null)" \
                || { echo "=== $f : indechiffrable"; prec="$f"; continue; }
            attendu="origine"
            [ -n "$prec" ] && attendu="$(openssl dgst -sha256 -r "$B/journal/$prec" | cut -d' ' -f1) $prec"
            vu="$(printf '%s\n' "$t" | sed -n '2s/^# precedent : //p')"
            [ "$vu" = "$attendu" ] || echo "=== CHAINE ROMPUE avant $f"
            printf '%s\n' "$t"
            prec="$f"
        done > /run/osmo-boite.txt
        rm -f /run/osmo-cle
        more /run/osmo-boite.txt < "$CONSOLE" > "$CONSOLE" 2>&1
        rm -f /run/osmo-boite.txt
    fi
    rm -f /run/osmo-cle
    umount "$B"
fi
lire "Entree pour redemarrer : " > /dev/null
reboot -f
SCRIPT
    chmod 755 "$SCRIPT"
}

# GRUB entry « consulter la boite noire » : the same kernel and initramfs with
# osmo.boite - the initramfs reads the box and restarts, nothing is booted.
poser_grub_boite() {
    findmnt -sno SOURCE /var/lib/osmo-diffs >/dev/null 2>&1 || { rm -f "$GRUB_BOITE"; return 0; }
    cat > "$GRUB_BOITE" <<'GRUB'
#!/bin/sh
# 43_osmo-boite - written by osmo-racine-live: read the black box (osmo-diffs)
# from the initramfs, INSTEAD OF BOOTING; the machine restarts afterwards.
set -e
. "$pkgdatadir/grub-mkconfig_lib"
K=/boot/vmlinuz
I=/boot/initrd.img
[ -e "$K" ] && [ -e "$I" ] || exit 0
K="$(readlink -f "$K")"; I="$(readlink -f "$I")"
dev="$(${grub_probe} --target=device "$K")"
rk="$(make_system_path_relative_to_its_root "$K")"
ri="$(make_system_path_relative_to_its_root "$I")"
echo "osmo-operator : entree boite noire" >&2
cat <<EOF
menuentry 'osmo-operator - consulter la boite noire (sans demarrer)' --class ubuntu --class os {
	load_video
	insmod gzio
$(prepare_grub_to_access_device "$dev" | sed 's/^/\t/')
	linux	$rk root=UUID=${GRUB_DEVICE_UUID} ro ${GRUB_CMDLINE_LINUX} osmo.boite
	initrd	$ri
}
EOF
GRUB
    chmod 755 "$GRUB_BOITE"
}

actualiser() {
    update-initramfs -u -k all >/dev/null 2>&1 || log "update-initramfs a echoue" >&2
    update-grub >/dev/null 2>&1 || log "update-grub a echoue" >&2
}

case "${1:-etat}" in
    poser)
        root_requis
        command -v overlayroot-chroot >/dev/null 2>&1 \
            || { log "paquet overlayroot absent - rien de pose" >&2; exit 1; }
        # Without the encrypted /home there is no passphrase to validate with:
        # every session would be wiped for ever. Left read-write, and said.
        if [ -z "$CRYPTHOME_UUID" ]; then
            rouge "osmo-racine-live : pas de /home chiffre (LUKS2) - / reste en lecture-ecriture, rien de pose" >&2
            exit 0
        fi
        cat > "$CONF" <<EOF
# /etc/overlayroot.conf - written by osmo-racine-live.
# / read-only, every write of a session in RAM (recurse=0: the other mounts
# are not covered here; /home gets its own RAM layer from unlock-home, /boot/efi
# and the black box are written directly). The session is written to the disk
# at shutdown only with the /home passphrase (osmo-fin-session.service).
overlayroot="$REGLAGE"
EOF
        # shellcheck disable=SC2086
        rm -f $ANCIENS
        poser_initramfs
        poser_grub_boite
        systemctl enable osmo-fin-session.service >/dev/null 2>&1 \
            || log "osmo-fin-session.service non active" >&2
        actualiser
        log "/ en lecture seule (RAM) ; a l extinction, la phrase de /home ecrit la session, sinon tout est efface"
        ;;
    etat)
        if live; then
            echo "live : / en RAM ($(changements | wc -l) changement(s) dans la session)"
            if [ -f "$MARQUE" ]; then vert "session validee : elle sera ecrite sur le disque a l extinction"
            else rouge "session NON validee : tout sera efface a l extinction (osmo-racine-live valider)"; fi
        else
            echo "persistant : / ecrit directement sur le disque"
        fi
        if mountpoint -q "$HOME_BAS" 2>/dev/null; then
            echo "/home : $(findmnt -no SOURCE "$HOME_BAS") en lecture seule, ecritures en RAM (validees avec le reste)"
        elif mountpoint -q /home 2>/dev/null; then
            echo "/home : $(findmnt -no SOURCE /home) (ecrit directement)"
        else
            echo "/home : non monte (volume chiffre ferme)"
        fi
        ;;
    changements)
        live || { log "/ n est pas en RAM"; exit 0; }
        changements
        ;;
    valider|ecrire)
        # valider : the session will be written at shutdown.
        # ecrire  : written NOW (and the session goes on): a power cut or a
        #           forgotten passphrase then only loses what came after.
        #           Same passphrase, same atomic write, recorded in the box
        #           (« ecrit »). The RAM layer stays as it is: what was written
        #           is only hidden behind identical copies, and is written
        #           again (unchanged) if the session is validated later.
        root_requis
        live || { log "/ n est pas en RAM : rien a valider"; exit 0; }
        [ -n "$CRYPTHOME_UUID" ] || { rouge "pas de /home chiffre : validation impossible" >&2; exit 1; }
        if [ "${2:-}" = --stdin ]; then
            IFS= read -r p || p=""
        else
            read -r -s -p "phrase de /home : " p < /dev/tty; echo
        fi
        if [ -z "$p" ] || ! printf '%s' "$p" | phrase_home_ok; then
            p=""
            rouge "phrase de /home refusee : rien n est ecrit, la session sera EFFACEE a l extinction"
            exit 1
        fi
        p=""
        if [ "$1" = valider ]; then
            install -d -m 0700 "$ETAT"
            rm -f "$ETAT/oublier"
            date '+%F %T' > "$MARQUE"; chmod 600 "$MARQUE"
            vert "session validee : elle sera ecrite sur le disque a l extinction"
        else
            n="$(changements | wc -l)"
            [ "$n" -gt 0 ] || { log "aucun changement a ecrire"; exit 0; }
            [ -x /usr/local/sbin/osmo-diffs ] && /usr/local/sbin/osmo-diffs enregistrer ecrit
            if appliquer; then
                vert "session ecrite sur le disque ($n changement(s)) ; la suite sera validee ou effacee a l extinction"
            else
                rouge "ECHEC de l ecriture : le disque garde son etat precedent"
                exit 1
            fi
        fi
        ;;
    annuler)
        root_requis
        rm -f "$MARQUE"
        rouge "validation retiree : la session sera EFFACEE a l extinction"
        ;;
    oublier)
        # « Tout oublier ? » Yes (osmo-valider-session --fin): the session is
        # wiped, chosen - at shutdown no question and no banner, a white screen
        root_requis
        rm -f "$MARQUE"
        install -d -m 0700 "$ETAT"
        date '+%F %T' > "$ETAT/oublier"
        ;;
    fin)
        # osmo-fin-session.service, ExecStop: the display manager is already
        # stopped, /home and the black box are still mounted.
        live || exit 0
        n="$(changements | wc -l)"
        decision=efface
        if [ -f "$ETAT/oublier" ]; then
            decision=oublie
        elif [ -f "$MARQUE" ]; then
            decision=valide
        elif [ "$n" -gt 0 ] && [ -n "$CRYPTHOME_UUID" ] \
                && [ -e "/dev/disk/by-uuid/$CRYPTHOME_UUID" ] && command -v cryptsetup >/dev/null 2>&1; then
            console_texte
            dire "osmo-operator : fin de session - $n changement(s) en RAM"
            dire_rouge "!!! Sans la phrase de /home, TOUS les changements de la session seront EFFACES !!!"
            # « Tout oublier ? » yes: flash, white screen, wiped;
            # no: the passphrase is required (right: cmatrix « REC » while
            # the session is written); nothing / timeout: wiped, red banner
            printf 'Tout oublier ? (yes/no) : ' > "$CONSOLE"
            r=""; IFS= read -r -t "$TIMEOUT" r < "$CONSOLE" || r=""
            case "$r" in
                n|N|non|Non|NON|no|No|NO)
                    essai=1
                    while [ "$essai" -le "${CRYPTHOME_TRIES:-3}" ]; do
                        inv="phrase de /home (Entree : tout effacer)"
                        [ "$essai" -gt 1 ] && inv="$inv ($essai/${CRYPTHOME_TRIES:-3})"
                        lire_console p "$inv : "
                        [ -n "$p" ] || break
                        if printf '%s' "$p" | phrase_home_ok; then decision=valide; break; fi
                        dire_rouge "phrase refusee"
                        essai=$((essai + 1))
                    done
                    p=""
                    ;;
                y|Y|yes|Yes|YES|o|O|oui|Oui|OUI)
                    flash_console; decision=oublie ;;
            esac
        fi
        # the black box first: it reads the RAM layer against the disk (a
        # session forgotten on purpose is recorded as « efface » too)
        _b="$decision"; [ "$_b" = oublie ] && _b=efface
        [ -x /usr/local/sbin/osmo-diffs ] && /usr/local/sbin/osmo-diffs enregistrer "$_b"
        if [ "$decision" = oublie ]; then
            # white screen (reverse video on a cleared console), no banner:
            # the machine goes off on it
            console_texte
            printf '\033[?5h\033[2J' > "$CONSOLE" 2>/dev/null
            sleep 2
        elif [ "$decision" = valide ] && [ "$n" -gt 0 ]; then
            console_texte
            dire "osmo-operator : ecriture de la session sur le disque ($n changement(s))..."
            # cmatrix « REC » on the console while the session is written
            mpid=""
            if command -v cmatrix >/dev/null 2>&1; then
                TERM=linux cmatrix -b -u 4 -M REC < "$CONSOLE" > "$CONSOLE" 2>/dev/null &
                mpid=$!
            fi
            appliquer; rc=$?
            if [ -n "$mpid" ]; then sleep 2; kill "$mpid" 2>/dev/null; wait "$mpid" 2>/dev/null; fi
            printf '\033[0m\033[2J\033[H' > "$CONSOLE" 2>/dev/null
            if [ "$rc" = 0 ]; then
                dire_vert "REC : session ecrite sur le disque"
            else
                dire_rouge "!!! ECHEC de l ecriture : le disque garde son etat precedent, la session est PERDUE !!!"
                sleep 10
            fi
        elif [ "$decision" = efface ]; then
            # always shown, even with nothing lost: forced on tty1, plymouth
            # quit, held 10 s
            console_texte
            dire_rouge "############################################################"
            dire_rouge "  PHRASE DE /home NON DONNEE : SESSION EFFACEE"
            dire_rouge "  $n changement(s) perdus (/, /root, /opt/GSM, /home)"
            dire_rouge "############################################################"
            sleep 10
        fi
        rm -f "$MARQUE" "$ETAT/oublier"
        ;;
    retirer)
        root_requis
        if live; then
            log "a faire sur le disque lui-meme : sudo overlayroot-chroot osmo-racine-live retirer" >&2
            exit 1
        fi
        printf '# /etc/overlayroot.conf - osmo-racine-live retire : / en lecture-ecriture\noverlayroot=""\n' > "$CONF"
        systemctl disable osmo-fin-session.service >/dev/null 2>&1
        # shellcheck disable=SC2086
        rm -f "$HOOK" "$SCRIPT" "$GRUB_BOITE" $ANCIENS
        actualiser
        log "/ persistant pour tous a partir du prochain demarrage"
        ;;
    *)
        echo "usage : osmo-racine-live poser | etat | changements | valider [--stdin] | ecrire [--stdin] | annuler | oublier | fin | retirer" >&2
        exit 2
        ;;
esac
