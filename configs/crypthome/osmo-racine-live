            # 2026-11-26: grub.cfg never rebuilt since the installation)
            _dev=""
            if ! mountpoint -q "$BAS/dev"; then mount --bind /dev "$BAS/dev" && _dev=1; fi
            OSMO_PHRASE_DONNEE=1 overlayroot-chroot /usr/local/sbin/osmo-racine-live actualiser ${2:+"$2"}; rc=$?
            [ -n "$_dev" ] && umount "$BAS/dev" 2>/dev/null
            remonter_ro "$BAS"
            [ "$rc" = 0 ] || trace "actualiser : ECHEC (code $rc) - initramfs ou grub PAS reconstruit"
            if [ -x /usr/local/sbin/osmo-diffs ]; then
                echo "osmo-racine-live actualiser : initramfs et grub reconstruits sur le disque (code $rc)" \
                    | /usr/local/sbin/osmo-diffs alerte >/dev/null 2>&1
            fi
            poser_menu_sessions
            empreinte_prendre
            journal_disque
            exit $rc
        fi
        # on a bench that is set, this side only runs for the session that
        # gave the passphrase (never by hand from overlayroot-chroot)
        if grep -q '^overlayroot="tmpfs' "$CONF" 2>/dev/null && [ -z "${OSMO_PHRASE_DONNEE:-}" ]; then
            rouge "a lancer depuis la session, avec la phrase de /home : sudo osmo-racine-live actualiser" >&2; exit 1
        fi
        # the measured boot (osmo-tpm poser / oter): its mark on the disk
        case "${2:-}" in
            tpm=1) install -d -m 0755 /etc/osmo-tpm && : > /etc/osmo-tpm/actif ;;
            tpm=0) rm -rf /etc/osmo-tpm ;;
        esac
        poser_initramfs
        poser_grub_boite
        actualiser || { rouge "initramfs ou grub PAS reconstruit" >&2; exit 1; }
        log "initramfs et grub a jour"
        ;;
    retirer)
        root_requis
        if live; then
            # back to an ordinary read-write / : a write to the disk, hence the passphrase
            command -v overlayroot-chroot >/dev/null 2>&1 || { log "overlayroot-chroot absent" >&2; exit 1; }
            echo "retirer : / redevient en lecture-ecriture pour tous, au prochain demarrage"
            read -r -s -p "phrase de /home : " p < /dev/tty || p=""; echo
            if [ -z "$p" ] || ! printf '%s' "$p" | phrase_home_ok; then
                p=""; rouge "phrase de /home refusee : rien n est ecrit sur le disque"; exit 1
            fi
            PHRASE="$p"; p=""
            trace "retirer : / en lecture-ecriture, sur le disque"
            _dev=""
            if ! mountpoint -q "$BAS/dev"; then mount --bind /dev "$BAS/dev" && _dev=1; fi
            OSMO_PHRASE_DONNEE=1 overlayroot-chroot /usr/local/sbin/osmo-racine-live retirer; rc=$?
            [ -n "$_dev" ] && umount "$BAS/dev" 2>/dev/null
            remonter_ro "$BAS"
            echo "osmo-racine-live retirer : / en lecture-ecriture a partir du prochain demarrage (code $rc)" \
                | /usr/local/sbin/osmo-diffs alerte >/dev/null 2>&1
            empreinte_prendre
            journal_disque
            exit $rc
        fi
        if grep -q '^overlayroot="tmpfs' "$CONF" 2>/dev/null && [ -z "${OSMO_PHRASE_DONNEE:-}" ]; then
            rouge "a lancer depuis la session, avec la phrase de /home : sudo osmo-racine-live retirer" >&2; exit 1
        fi
        printf '# /etc/overlayroot.conf - osmo-racine-live retire : / en lecture-ecriture\noverlayroot=""\n' > "$CONF"
        systemctl disable osmo-fin-session.service osmo-garde.service osmo-point.timer osmo-empreinte.service osmo-empreinte-fond.service >/dev/null 2>&1
        # shellcheck disable=SC2086
        rm -f "$HOOK" "$SCRIPT" "$GRUB_BOITE" $ANCIENS
        actualiser
        log "/ persistant pour tous a partir du prochain demarrage"
        ;;
    *)
        echo "usage : osmo-racine-live poser | etat | changements | valider [--stdin] | valider-fin | retours | defaire [--stdin] | annuler | oublier | fin | actualiser | retirer" >&2
        exit 2
        ;;
esac
