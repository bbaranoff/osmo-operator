# crypthome-session.desktop - GNOME autostart entry (installed in ~/.config/autostart by
# iso_modules/89-home-chiffre.sh): runs crypthome-session-setup once /home is decrypted.
[Desktop Entry]
Type=Application
Name=Preparation du compte chiffre
Comment=Autorise le compte proprietaire sur l'affichage et demarre sa session utilisateur, quand /home est dechiffre
Exec=/usr/local/bin/crypthome-session-setup
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-Crypthome-Generated=true
