[Unit]
Description=Dechiffrement optionnel de /home (second disque, LUKS)
Documentation=file:/etc/default/crypthome
ConditionPathExists=/etc/default/crypthome
# unlock-home.service - optional decryption of /home at boot (runs unlock-home --boot).
# AFTER local file systems and udev (the /dev/disk/by-uuid link must exist),
# AFTER plymouth (unlock-home quits it before asking on the console, so it
# must already be up, not starting), and AFTER keyboard setup: the layout of
# /etc/default/keyboard must be the one loaded when the passphrase is typed.
After=local-fs.target systemd-udev-settle.service plymouth-start.service
After=keyboard-setup.service console-setup.service
Wants=systemd-udev-settle.service
# BEFORE anything that opens a session: GDM must not start on an empty /home
# when the operator has just answered "yes".
Before=systemd-user-sessions.service display-manager.service multi-user.target graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/unlock-home --boot
# The prompt and the input go through /dev/console (or, with CRYPTHOME_PROMPT=
# plymouth, through systemd-ask-password), never through stdin.
StandardInput=null
StandardOutput=journal+console
StandardError=journal+console
# Generous but bounded: unlock-home already applies its own timeout per prompt.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
