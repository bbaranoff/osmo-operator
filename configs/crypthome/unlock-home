#!/bin/bash
# unlock-home - decrypts and mounts /home from the second (LUKS) disk.
#
#   unlock-home --boot   asks the passphrase at boot, on the text console
#   unlock-home          the same from a terminal, afterwards
#
# Settings: /etc/default/crypthome (CRYPTHOME_UUID, _NAME, _MOUNT, _OWNER,
# _TRIES, _TIMEOUT, _PROMPT, _IMAGE, _RAM_DIRS, _ROOT_LINKS).
#
# THIS SCRIPT NEVER FAILS THE BOOT. On an empty Enter, a missing disk, a wrong
# passphrase $TRIES times or a failed mount, it exits 0 and the machine boots
# with an empty /home: the system stays usable as root, whose home (/root) is
# on the system disk in clear.
#
# THE DESKTOP THEN OPENS ON ROOT. On an installed disk the session account has
# its home ON the encrypted volume: without /home, GDM would open it on a
# non-existent home. When /home stays closed at boot (Enter, timeout, refused
# passphrase, missing disk), GDM opens a ROOT session for this boot only - see
# session_root below.
set -u

CONF=/etc/default/crypthome
[ -r "$CONF" ] || { echo "unlock-home: $CONF introuvable" >&2; exit 0; }
. "$CONF"

MAPPER="${CRYPTHOME_NAME:-crypthome}"
MOUNT="${CRYPTHOME_MOUNT:-/home}"
TRIES="${CRYPTHOME_TRIES:-3}"
TIMEOUT="${CRYPTHOME_TIMEOUT:-60}"
OWNER="${CRYPTHOME_OWNER:-}"

BOOT=0
[ "${1:-}" = "--boot" ] && BOOT=1

log() { echo "unlock-home: $*" >&2; }

# ── THE MOUNT MUST COME FROM THE ENCRYPTED VOLUME ───────────────────────────
# "mounted" is not enough: /home may be an ORDINARY partition (a machine
# installed with a separate /home where init-crypthome.sh never ran). Treating
# that mount as the encrypted disk would write the secrets IN CLEAR under the
# owner account while claiming otherwise. The mount source must therefore be
# the decrypted mapping itself.
crypthome_monte() {
    local _src
    mountpoint -q "$MOUNT" || return 1
    _src="$(findmnt -fno SOURCE "$MOUNT" 2>/dev/null)"
    [ -n "$_src" ] || return 1
    [ "$(readlink -f "$_src")" = "$(readlink -f "/dev/mapper/$MAPPER")" ]
}

# ── THE ROOT SESSION WHEN /home STAYS CLOSED ────────────────────────────────
# GDM has no "for this boot" configuration: it reads custom.conf. It is thus
# modified BEFORE GDM starts (unlock-home.service has Before=display-manager),
# the original files being saved in $ETAT_GDM. Every boot starts by restoring
# them (session_normale): the root session lasts one boot, and a power cut
# does not make it permanent.
#
# Two files: GDM refuses uid 0 not in custom.conf but in PAM, through the rule
# "pam_succeed_if.so user != root". It is neutralised ONLY in gdm-autologin:
# the password login screen keeps refusing root.
#
# No added risk: the root file system is in clear by construction
# (partition.conf); whoever holds the machine can already read it from a live
# key. What is protected is /home - precisely what is not mounted.
GDM_CONF=/etc/gdm3/custom.conf
GDM_PAM=/etc/pam.d/gdm-autologin
ETAT_GDM=/var/lib/crypthome/gdm-avant-session-root

session_normale() {
    [ -d "$ETAT_GDM" ] || return 0
    if [ -f "$ETAT_GDM/custom.conf" ]; then
        cp -p "$ETAT_GDM/custom.conf" "$GDM_CONF"
    elif [ -f "$ETAT_GDM/custom.conf.absent" ]; then
        rm -f "$GDM_CONF"
    fi
    [ -f "$ETAT_GDM/gdm-autologin" ] && cp -p "$ETAT_GDM/gdm-autologin" "$GDM_PAM"
    rm -rf "$ETAT_GDM"
    log "GDM : configuration du compte de session retablie."
}

session_root() {
    [ "$BOOT" = 1 ] || return 0
    [ -d /etc/gdm3 ] || return 0
    # Already done (two calls in the same boot): do not overwrite the saved
    # originals with the already modified version.
    if [ ! -d "$ETAT_GDM" ]; then
        install -d -m 0700 "$ETAT_GDM" || return 0
        if [ -f "$GDM_CONF" ]; then
            cp -p "$GDM_CONF" "$ETAT_GDM/custom.conf"
        else
            : > "$ETAT_GDM/custom.conf.absent"
        fi
        [ -f "$GDM_PAM" ] && cp -p "$GDM_PAM" "$ETAT_GDM/gdm-autologin"
    fi
    # Only these two keys in [daemon]: the rest (WaylandEnable, a possible
    # TimedLogin) is the machine's configuration.
    awk '
        /^[[:space:]]*AutomaticLogin(Enable)?[[:space:]]*=/ { next }
        { print }
        /^[[:space:]]*\[daemon\][[:space:]]*$/ && !fait {
            print "AutomaticLoginEnable=true"; print "AutomaticLogin=root"; fait = 1
        }
        END { if (!fait) { print "[daemon]"; print "AutomaticLoginEnable=true"; print "AutomaticLogin=root" } }
    ' "${GDM_CONF}" 2>/dev/null > "$GDM_CONF.crypthome" \
        && mv "$GDM_CONF.crypthome" "$GDM_CONF"
    [ -f "$GDM_PAM" ] && \
        sed -i '/^[[:space:]]*auth.*pam_succeed_if.so user != root quiet_success/s/^/#/' "$GDM_PAM"
    log "GDM : session root pour ce demarrage ($MOUNT ferme)."
    root_dans_tmp
}

# ── WHAT THE ROOT SESSION WRITES STAYS IN /tmp ──────────────────────────────
# Without /home, the root session must leave nothing on the disk: what it
# writes in its home (/root) - profiles, history, files - lives in $RAM_ROOT,
# a tmpfs under /tmp, and disappears at shutdown. /root is covered by an
# overlay: its content stays READABLE (launchers, bench scripts,
# init-crypthome.sh), only writes go to /tmp.
#
# /opt/GSM too: the whole bench lives there (repository, configs, hlr.db,
# logs, captures). In a root session it is "live", non persistent, and gets
# its on-disk state back at reboot. The list of directories covered this way
# is CRYPTHOME_RAM_DIRS (/etc/default/crypthome); /root is always part of it.
# A missing directory is ignored; a directory that is itself a mount point
# (second disk on /opt/GSM via fstab) is covered like any other: local-fs.target
# has already been reached.
#
# A tmpfs and not a plain directory in /tmp: on Ubuntu /tmp is on the root
# disk, in clear; in RAM nothing ever touches a disk.
#
# The keyring: the link /root/.local/share/keyrings points to the closed
# volume. It is replaced, IN the overlay only, by a real directory: the session
# has a working keyring that evaporates with it.
RAM_ROOT=/tmp/crypthome-root
RAM_DIRS="${CRYPTHOME_RAM_DIRS-/opt/GSM}"

# en_ram DIR: covers DIR with an overlay whose upper and work directories live
# in $RAM_ROOT. Mode and owner of the upper = those of DIR: an overlay root
# takes the attributes of its upper, and a /opt/GSM turned 0700 would cut
# asterisk (osmo-banc) and the session account off their working directory.
en_ram() {
    local dir="$1" nom
    [ -d "$dir" ] || return 1
    [ "$(findmnt -fno FSTYPE "$dir" 2>/dev/null)" = overlay ] && return 0   # already done this boot
    nom="$(printf '%s' "$dir" | sed 's#^/##; s#/#_#g')"
    install -d -m "$(stat -c %a "$dir")" -o "$(stat -c %u "$dir")" -g "$(stat -c %g "$dir")" \
            "$RAM_ROOT/$nom/upper" || return 1
    install -d -m 0700 "$RAM_ROOT/$nom/work" || return 1
    mount -t overlay overlay \
          -o "lowerdir=$dir,upperdir=$RAM_ROOT/$nom/upper,workdir=$RAM_ROOT/$nom/work" "$dir"
}

root_dans_tmp() {
    local lien d
    if ! mountpoint -q "$RAM_ROOT"; then
        install -d -m 0700 "$RAM_ROOT" || return 0
        if ! mount -t tmpfs -o mode=0700,size=50% tmpfs "$RAM_ROOT"; then
            log "ATTENTION : tmpfs $RAM_ROOT impossible - la session root ecrira sur le disque."
            return 0
        fi
        # systemd-tmpfiles-clean cleans /tmp by age: it must not empty the
        # home of a running session.
        install -d /run/tmpfiles.d
        echo "x $RAM_ROOT" > /run/tmpfiles.d/crypthome-root.conf
    fi
    if en_ram /root; then
        for lien in ${CRYPTHOME_ROOT_LINKS:-.local/share/keyrings}; do
            if [ -L "/root/$lien" ]; then
                rm -f "/root/$lien"
                install -d -m 0700 "/root/$lien"
            fi
        done
        log "session root : les ecritures dans /root restent dans $RAM_ROOT (RAM)."
    else
        log "ATTENTION : overlay sur /root impossible - la session root ecrira sur le disque."
    fi
    for d in $RAM_DIRS; do
        [ "$d" = /root ] && continue
        [ -d "$d" ] || continue
        if en_ram "$d"; then
            log "session root : les ecritures dans $d restent dans $RAM_ROOT (RAM)."
        else
            log "ATTENTION : overlay sur $d impossible - $d ecrira sur le disque."
        fi
    done
}

# Every boot starts from the session account's configuration.
[ "$BOOT" = 1 ] && session_normale

# Already mounted (2nd call, or manual decryption after a "no"): nothing to do.
#
# If it is ANOTHER mount - a separate /home in clear - exit too, without
# moving anything: the operator did not ask to encrypt that partition, and
# mounting over it is impossible. The message names the source, otherwise the
# symptom is "it never asks the passphrase" with no explanation.
if mountpoint -q "$MOUNT"; then
    if crypthome_monte; then
        log "$MOUNT est deja monte depuis le volume chiffre."
    else
        log "$MOUNT est deja monte, mais pas depuis /dev/mapper/$MAPPER" \
            "($(findmnt -fno SOURCE "$MOUNT" 2>/dev/null)) - rien n a ete touche."
    fi
    exit 0
fi

if [ -z "${CRYPTHOME_UUID:-}" ]; then
    log "aucun disque chiffre configure (CRYPTHOME_UUID vide dans $CONF)."
    exit 0
fi

# ── THE OLD /home IN CLEAR MUST GO ──────────────────────────────────────────
# What remains under the mount point becomes invisible once the disk is
# mounted - invisible, but still there: space on the system disk and, what
# matters here, OLD KEYRINGS IN CLEAR. It is moved aside BEFORE mounting.
#
# Done HERE and not by init-crypthome.sh because this is the only moment
# nobody holds /home: at boot, before the first session.
#
# Unconditional, not "only on yes": once an encrypted disk is configured, the
# /home in clear is no longer the right one. Answering no must leave an EMPTY
# /home, not the old one, otherwise "no" would hand back the very secrets
# being protected.
if [ -d "$MOUNT" ] && [ -n "$(ls -A "$MOUNT" 2>/dev/null)" ]; then
    _sauve="/var/backups/home-avant-chiffrement-$(date +%Y%m%d-%H%M%S)"
    if install -d -m 0700 "$_sauve" 2>/dev/null; then
        ( shopt -s dotglob nullglob
          _reste=("$MOUNT"/*)
          [ "${#_reste[@]}" -gt 0 ] && mv "${_reste[@]}" "$_sauve"/ ) 2>/dev/null
        log "ancien contenu de $MOUNT mis de cote dans $_sauve."
    else
        log "ATTENTION : $MOUNT n est pas vide et n a pas pu etre evacue."
    fi
fi

DEV="/dev/disk/by-uuid/$CRYPTHOME_UUID"
if [ ! -e "$DEV" ]; then
    log "disque chiffre absent (UUID=$CRYPTHOME_UUID) - $MOUNT reste vide."
    session_root
    exit 0
fi

# ── THE ONLY QUESTION: THE PASSPHRASE ───────────────────────────────────────
# A single input, which is both the answer AND the passphrase:
#   - empty ENTER (or the timeout expiring)  : boot as ROOT, without /home;
#   - a passphrase                           : open the volume; the session
#     is the owner account's.
# A refused passphrase asks again, $TRIES times; at any time an empty Enter
# exits to root. An expired timeout counts as Enter: a machine rebooting on
# its own finishes its boot instead of waiting forever.
#
# The prompt fits on one line, the same everywhere: "decrypt /home -passphrase-
# or Enter". Typed characters are shown as "*" (lire_masquee below; "read -s"
# would show nothing and the operator could not tell whether keys are taken).
#
# WHERE IT IS ASKED: ON THE TEXT CONSOLE, NOT IN PLYMOUTH. Plymouth reads the
# keyboard through its own path (the tty it holds, or evdev + xkb), which is
# dead on some hardware (Intel + NVIDIA laptops with the proprietary driver
# loaded after the initrd) when unlock-home runs. So if plymouth runs it is
# QUIT, the text console comes back, and the passphrase is read directly on
# /dev/console - no agent, no unit condition, no plymouth keyboard. GDM then
# starts as usual (its "plymouth quit --retain-splash" finds nobody).
#
# CRYPTHOME_PROMPT=plymouth in /etc/default/crypthome selects the other path
# (systemd-ask-password -> plymouth agent -> osmo-bts theme), for a machine
# where the plymouth keyboard works. --key-file=- in both cases: the passphrase
# goes neither through the command line (visible in ps) nor through the disk,
# only through a pipe.
lire_masquee() {
    # lire_masquee VAR PROMPT: reads a line from the keyboard, one "*" per
    # character, Backspace handled. Returns 1 if the timeout expires (the
    # variable is then empty).
    local _var="$1" _invite="$2" _c _s="" _rc
    printf '%s' "$_invite" >&2
    while :; do
        IFS= read -r -s -n1 -t "$TIMEOUT" _c; _rc=$?
        if [ "$_rc" -gt 128 ]; then
            echo >&2; printf -v "$_var" '%s' ""; return 1
        fi
        [ "$_rc" -ne 0 ] && break            # end of input
        [ -z "$_c" ] && break                # Enter
        if [ "$_c" = $'\x7f' ] || [ "$_c" = $'\b' ]; then
            if [ -n "$_s" ]; then _s="${_s%?}"; printf '\b \b' >&2; fi
            continue
        fi
        _s+="$_c"; printf '*' >&2
    done
    echo >&2
    printf -v "$_var" '%s' "$_s"
    return 0
}

# The console where the question is asked at boot. /dev/console follows the
# kernel's "console=" (tty0 = the active virtual console, or a serial port if
# requested); tty1 as a fallback.
CONSOLE=/dev/console
[ -c "$CONSOLE" ] || CONSOLE=/dev/tty1

demander_console() {
    # demander_console VAR PROMPT: the question on the text console, at boot.
    # plymouth, if running, is quit first: the screen goes back to text and
    # the keyboard returns to the tty.
    if command -v plymouth >/dev/null 2>&1 && plymouth --ping 2>/dev/null; then
        plymouth quit 2>/dev/null || true
        log "plymouth quitte - la question passe sur la console ($CONSOLE)."
    fi
    # An image behind the question: the text console is cleared (ESC[2J),
    # crypthome-fond paints CRYPTHOME_IMAGE on /dev/fb0 (darkened at the
    # bottom), and the prompt goes to the LAST line (ESC[999;1H): fbcon only
    # repaints the cells it writes. Input is unchanged (lire_masquee on the
    # tty). CRYPTHOME_IMAGE=none disables it.
    if [ "${CRYPTHOME_IMAGE:-}" != none ] && [ -x /usr/local/sbin/crypthome-fond ]; then
        printf '\033[2J' > "$CONSOLE" 2>/dev/null
        /usr/local/sbin/crypthome-fond ${CRYPTHOME_IMAGE:+"$CRYPTHOME_IMAGE"} 2>&1 | while read -r l; do log "$l"; done
        printf '\033[999;1H' > "$CONSOLE" 2>/dev/null
    fi
    lire_masquee "$1" "$2" < "$CONSOLE" 2> "$CONSOLE"
}

# ── THE KEYBOARD LAYOUT, LOGGED ─────────────────────────────────────────────
# A passphrase refused three times is most often a keyboard layout other than
# the expected one. The console at that moment has the layout of
# /etc/default/keyboard (written by build-iso, then by Calamares at
# installation): it is logged so that "passphrase refused" can be read next
# to the layout. Fallback: /etc/vconsole.conf, then "?".
clavier_console() {
    local _l _v
    _l="$(awk -F'"' '/^XKBLAYOUT=/{print $2}' /etc/default/keyboard 2>/dev/null)"
    _v="$(awk -F'"' '/^XKBVARIANT=/{print $2}' /etc/default/keyboard 2>/dev/null)"
    if [ -z "$_l" ]; then
        _l="$(awk -F= '/^KEYMAP=/{print $2}' /etc/vconsole.conf 2>/dev/null | tr -d '"')"
        _v=""
    fi
    [ -n "$_l" ] || { echo "?"; return 0; }
    _l="${_l%%,*}"; _v="${_v%%,*}"
    [ -n "$_v" ] && _l="$_l-$_v"
    echo "$_l"
}
log "clavier de la console : $(clavier_console)."

PROMPT_MODE="${CRYPTHOME_PROMPT:-console}"
ouvert=0
essai=0
while [ "$essai" -lt "$TRIES" ]; do
    essai=$((essai + 1))
    invite="decrypt $MOUNT -passphrase- or Enter"
    [ "$essai" -gt 1 ] && invite="$invite ($essai/$TRIES)"
    if [ "$BOOT" = 1 ] && [ "$PROMPT_MODE" = plymouth ]; then
        passe="$(systemd-ask-password --timeout="$TIMEOUT" \
                     --id="crypthome:passphrase" "$invite" 2>/dev/null)" || passe=""
    elif [ "$BOOT" = 1 ]; then
        demander_console passe "$invite : " || passe=""
    else
        lire_masquee passe "$invite : " || passe=""
    fi
    if [ -z "$passe" ]; then
        unset passe
        log "Entree sans phrase - demarrage en root sans $MOUNT (« unlock-home » pour le faire plus tard)."
        session_root
        exit 0
    fi
    if printf '%s' "$passe" | cryptsetup open --key-file=- "$DEV" "$MAPPER"; then
        passe=""; unset passe
        ouvert=1
        break
    fi
    passe=""; unset passe
    log "phrase de passe refusee."
done

if [ "$ouvert" != 1 ]; then
    log "abandon apres $TRIES essais - demarrage en root sans $MOUNT."
    session_root
    exit 0
fi

# ── THE MOUNT ───────────────────────────────────────────────────────────────
# The /home line of /etc/fstab has "noauto": this script mounts, and it alone.
# If the mount fails the mapping is CLOSED again - an open, unmounted decrypted
# volume would be the worst of both states.
if ! mount "$MOUNT" 2>/dev/null && ! mount "/dev/mapper/$MAPPER" "$MOUNT"; then
    log "montage de $MOUNT impossible - le volume est referme."
    cryptsetup close "$MAPPER" 2>/dev/null || true
    session_root
    exit 0
fi

# The owner account can now have a user session: its home exists. Without
# lingering, /run/user/<uid> and its bus are only created at first login - but
# run-as-owner starts its applications from root's session without ever
# logging that account in.
if [ -n "$OWNER" ] && id -u "$OWNER" >/dev/null 2>&1; then
    loginctl enable-linger "$OWNER" >/dev/null 2>&1 || true
fi

# /home open: the session is the account's, persistent on the encrypted
# volume. Also useful outside boot: "unlock-home" typed from the root session
# puts GDM back on the account for the next login.
session_normale

log "$MOUNT dechiffre et monte."
exit 0
