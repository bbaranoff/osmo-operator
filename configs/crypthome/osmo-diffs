            "$(date '+%F %T')" "$nb" "$fin_chaine" "$note" | sceller videe)"
        if [ -n "$nouveau" ] && home_chiffre_ouvert; then
            install -d -m 0700 "$PRIVE" 2>/dev/null
            printf '%s %s\n' "$(sha256sum "$nouveau" | cut -d' ' -f1)" "$(basename "$nouveau")" > "$PRIVE/.dernier-vu"
