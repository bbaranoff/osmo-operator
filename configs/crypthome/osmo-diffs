        # sauvegarder DIR : the whole box in ONE file, as it is - the records
        # stay encrypted, the copy is read back with the box passphrase only
        boite
        dest="${2:-}"
        [ -n "$dest" ] && [ -d "$dest" ] && [ -w "$dest" ] || { log "sauvegarder : donne un dossier ou l on peut ecrire (une cle USB, par exemple)"; exit 1; }
        besoin=$(( $(du -sk --exclude=lost+found "$BASE" 2>/dev/null | cut -f1) + 1024 ))
        libre="$(df -k --output=avail "$dest" | tail -1 | tr -d ' ')"
        [ "${libre:-0}" -gt "$besoin" ] || { log "sauvegarder : pas assez de place dans $dest ($((besoin / 1024)) Mo necessaires, $((libre / 1024)) libres)"; exit 1; }
