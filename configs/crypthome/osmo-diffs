        # (« plein ») to copy it elsewhere and empty it
        boite
        pc="$(df --output=pcent "$BASE" 2>/dev/null | tail -1 | tr -dc '0-9')"
        echo "boite noire : ${pc:-?} % occupee ($(df -h --output=used "$BASE" | tail -1 | tr -d ' ') sur $(df -h --output=size "$BASE" | tail -1 | tr -d ' '))"
