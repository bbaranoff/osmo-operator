#!/bin/bash
# osmo-diffs - the BLACK BOX: every change made to the system, one record per
# session, written at shutdown, encrypted with age (public key in clear on the
# box, private key under the box's OWN passphrase). Partition of 5 GiB,
# /var/lib/osmo-diffs (partition.conf).
#
#   osmo-diffs init          keys + reference (Calamares, shellprocess-osmo.conf)
#   osmo-diffs enregistrer [valide|efface|ecrit]  record this session (osmo-racine-live fin)
#   osmo-diffs phrase        set / change the box passphrase (session account,
#                            sudo, in a terminal)
#   osmo-diffs liste         the records (names, sizes): no passphrase
#   osmo-diffs voir [N]      decrypt the N last records (default: all), checks
#                            the chain, asks the passphrase
#   osmo-diffs copie-poser user@host   send every record to another machine
#   osmo-diffs envoyer       send the records not sent yet
#
# WRITE WITHOUT BEING ABLE TO READ. Each record is encrypted with age for a
# PUBLIC key (cle.pub, on the box): the machine fills the box without ever
# holding what opens it. The private key (age identity) is itself encrypted
# with the box passphrase (cle.chiffree: openssl, AES-256, PBKDF2 600 000
# rounds). Until « osmo-diffs phrase » has been run, the identity stays in the
# session account's encrypted /home (/home/.osmo-diffs/cle), readable by
# nobody else.
#
# WHAT: every change of the session under OSMO_DIFFS_DIRS (default: all of
# /, minus OSMO_DIFFS_EXCLUS: /tmp /var/tmp /var/cache /var/log/journal),
# .git, node_modules and caches pruned: text files as unified diffs (at most
# 1 MiB), binaries and big files as one line each. /home is NOT recorded by
# default (its diffs would be readable with the box passphrase): add it to
# OSMO_DIFFS_DIRS in /etc/default/osmo-diffs to change that.
#
# WHICH SESSIONS: EVERY one. On an installed bench / is always in RAM
# (osmo-racine-live): at shutdown « osmo-racine-live fin » runs
# « osmo-diffs enregistrer valide|efface » BEFORE writing or dropping the
# session - the RAM layer against the disk under it. A wiped session is
# recorded all the same. Without the RAM root (osmo-racine-live not set), the
# files changed since the last record are diffed against a reference copy
# kept in the encrypted /home (/home/.osmo-diffs/miroir).
#
# TWO DIFFERENT PASSPHRASES: the /home one opens /home and validates a
# session; the box's own (« osmo-diffs phrase », refused if it is the /home
# one) only reads the box back. It is never asked at shutdown: the machine
# writes with the public key. The partition is in clear, the records are not:
# only their names (number, date, valide/efface) and sizes can be read.
# « consulter » at boot: the GRUB entry « consulter la boite noire »
# (osmo-racine-live, initramfs).
#
# THE CHAIN: each record starts with the SHA-256 of the previous record file:
# « voir » reports a record removed or changed in the middle. A TRUNCATED end
# leaves a valid chain: « verifier », at each nirvana boot, compares the box
# with the last record nirvana saw (kept in its encrypted system) - records
# made AND removed between two nirvana boots are only caught by the remote
# copy. Root can destroy, never read.
set -u
BASE="${OSMO_DIFFS_BASE:-/var/lib/osmo-diffs}"
PRIVE="${OSMO_DIFFS_PRIVE:-/home/.osmo-diffs}"
MIROIR="$PRIVE/miroir"
TAMPON="$PRIVE/.dernier"
JOURNAL="$BASE/journal"
PUB="$BASE/cle.pub"
CLE_CHIFFREE="$BASE/cle.chiffree"
CLE_CLAIRE="$PRIVE/cle"
[ -f /etc/default/osmo-diffs ] && . /etc/default/osmo-diffs
# RAM root: the whole session (the RAM layer is small, the disk is not read).
DIRS="${OSMO_DIFFS_DIRS:-/}"
EXCLUS="${OSMO_DIFFS_EXCLUS:-/tmp /var/tmp /var/cache /var/log/journal /home}"
# Without the RAM root, a reference copy is needed: kept to these (copying
# every text file of / into /home would take gigabytes).
DIRS_MIROIR="${OSMO_DIFFS_DIRS:-/etc /root /opt /usr/local /var/spool/cron}"
MAX="${OSMO_DIFFS_MAX:-1024k}"
# the RAM layer and the disk under it: live-boot (the live key)
# or the installed bench (overlayroot)
if [ -d /run/live/overlay/rw ]; then
    HAUT="${OSMO_DIFFS_HAUT:-/run/live/overlay/rw}"; BAS="${OSMO_DIFFS_BAS:-/run/live/rootfs/filesystem.squashfs}"
else
    HAUT="${OSMO_DIFFS_HAUT:-/media/root-rw/overlay}"; BAS="${OSMO_DIFFS_BAS:-/media/root-ro}"
fi
TEST="${OSMO_DIFFS_SANS_MONTAGE:-0}"     # tests: no mount checks

log() { echo "osmo-diffs : $*"; }

live() {
    [ "$TEST" = 1 ] && { [ "${OSMO_DIFFS_LIVE:-0}" = 1 ]; return; }
    [ "$(findmnt -no FSTYPE / 2>/dev/null)" = overlay ]
}

# the encrypted /home is open: on dm-crypt, directly or under the RAM overlay
# of an installed bench (volume read-only on /media/home-ro)
home_chiffre_ouvert() {
    [ "$TEST" = 1 ] && { [ -d "$PRIVE" ]; return; }
    local m src
    for m in /home /media/home-ro; do
        mountpoint -q "$m" 2>/dev/null || continue
        src="$(findmnt -fno SOURCE "$m" 2>/dev/null)"
        case "$(readlink -f "$src")" in /dev/dm-*|/dev/mapper/*) return 0 ;; esac
    done
    return 1
}

boite() {
    [ "$TEST" = 1 ] || mountpoint -q "$BASE" \
        || { log "$BASE n est pas monte (partition osmo-diffs absente)"; exit 0; }
    mkdir -p "$JOURNAL"
}

trouver() {   # trouver DIR...: candidate files, null-separated, pruned
    find "$@" -xdev \( -name .git -o -name node_modules -o -name __pycache__ -o -name .cache \
                      -o -name .env -o -name .venv \) -prune -o -type f -size -"$MAX" -print0 2>/dev/null
}

dans_dirs() {
    local d
    for d in $EXCLUS; do case "$1" in "$d"|"$d"/*) return 1 ;; esac; done
    case "$1" in */.git/*|*/node_modules/*|*/__pycache__/*|*/.cache/*) return 1 ;; esac
    for d in $DIRS; do
        [ "$d" = / ] && return 0
        case "$1" in "$d"/*) return 0 ;; esac
    done
    return 1
}

est_texte() { [ -f "$1" ] && [ "$(stat -c %s "$1")" -le $(( ${MAX%k} * 1024 )) ] && grep -Iq '' "$1" 2>/dev/null; }

# trace_miroir FILE: diff against the reference copy, which is updated
trace_miroir() {
    local f="$1" m="$MIROIR$1"
    if est_texte "$f"; then
        cmp -s "$m" "$f" 2>/dev/null && return 0
        diff -uN --label "a$f" --label "b$f" "$m" "$f"
        mkdir -p "$(dirname "$m")"; cp -p "$f" "$m"
    elif [ -f "$m" ]; then
        if [ -e "$f" ]; then printf '=== %s : devenu binaire ou trop gros, plus suivi\n' "$f"
        else diff -uN --label "a$f" --label "b$f" "$m" /dev/null; fi
        rm -f "$m"
    fi
}

# trace_overlay FILE: what the live session changed, against the disk
trace_overlay() {
    local f="$1" b="$BAS$1"
    if [ -c "$HAUT$1" ] && [ "$(stat -c '%t:%T' "$HAUT$1")" = 0:0 ]; then   # whiteout: deleted
        if est_texte "$b"; then diff -uN --label "a$f" --label "b$f" "$b" /dev/null
        elif [ -e "$b" ] || [ -L "$b" ]; then printf '=== %s : supprime\n' "$f"; fi
    elif [ -L "$f" ]; then
        [ "$(readlink "$b" 2>/dev/null)" = "$(readlink "$f")" ] \
            || printf '=== %s : lien -> %s\n' "$f" "$(readlink "$f")"
    elif est_texte "$f"; then
        cmp -s "$b" "$f" 2>/dev/null || diff -uN --label "a$f" --label "b$f" "$b" "$f"
    elif [ -f "$f" ]; then
        cmp -s "$b" "$f" 2>/dev/null \
            || printf '=== %s : binaire ou > %s (%s octets, sha256 %s)\n' "$f" "$MAX" \
                   "$(stat -c %s "$f")" "$(sha256sum "$f" | cut -d' ' -f1)"
    fi
}

dernier() { find "$JOURNAL" -maxdepth 1 -name '*.age' 2>/dev/null | sort | tail -1; }

# sceller MODE < diff: one encrypted, chained record
sceller() {
    local mode="$1" prec n nom h
    prec="$(dernier)"
    if [ -n "$prec" ]; then h="$(sha256sum "$prec" | cut -d' ' -f1) $(basename "$prec")"; else h="origine"; fi
    n=$(( $(find "$JOURNAL" -maxdepth 1 -name '*.age' | wc -l) + 1 ))
    nom="$JOURNAL/$(printf '%06d' "$n")_$(date +%F_%H%M%S)_${mode}.diff.age"
    { printf '# osmo-diffs %s : %s, demarrage du %s, enregistre le %s\n# precedent : %s\n' \
          "$n" "$mode" "$(uptime -s 2>/dev/null)" "$(date '+%F %T')" "$h"
      cat; } | age -r "$(cat "$PUB")" -o "$nom" || return 1
    rm -f "$BASE/dernier.txt"     # left by an older version: nothing in clear
    echo "$nom"
}

# ── REMOTE COPY (optional) ───────────────────────────────────────────────────
# Each record is also sent to another machine, so that deleting the box here
# is not enough. Set up once from nirvana's system: « sudo osmo-diffs
# copie-poser user@host » (an ssh key ON THE BOX, so that root's sessions send
# too; the other end only accepts new files: osmo-diffs-recevoir as forced
# command). Sent records are listed in .envoyes; the others are retried at
# the next record (no network at shutdown, machine away...).
COPIE_CONF="$BASE/copie.conf"
COPIE_CLE="$BASE/copie.key"
envoyer() {
    [ -s "$COPIE_CONF" ] && [ -s "$COPIE_CLE" ] || return 0
    local dest poste j n=0 e=0
    dest="$(sed -n 's/^DEST=//p' "$COPIE_CONF")"; [ -n "$dest" ] || return 0
    poste="$(sed -n 's/^POSTE=//p' "$COPIE_CONF")"; [ -n "$poste" ] || poste="$(hostname)"
    touch "$BASE/.envoyes"
    for j in $(find "$JOURNAL" -maxdepth 1 -name '*.age' | sort); do
        grep -qxF "$(basename "$j")" "$BASE/.envoyes" && continue
        if ${OSMO_DIFFS_SSH:-ssh} -i "$COPIE_CLE" -o BatchMode=yes -o ConnectTimeout=5 \
               -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$BASE/copie.known_hosts" \
               "$dest" "$poste/$(basename "$j")" < "$j" 2>/dev/null; then
            basename "$j" >> "$BASE/.envoyes"; n=$((n + 1))
        else
            e=$((e + 1))
        fi
    done
    if [ "$e" -gt 0 ]; then log "copie vers $dest : $n envoye(s), $e en attente (nouvel essai au prochain enregistrement)"
    elif [ "$n" -gt 0 ]; then log "copie vers $dest : $n envoye(s)"; fi
}

identite() {   # the age identity on stdout (asks the passphrase if needed)
    if [ -f "$CLE_CHIFFREE" ]; then
        local pp
        read -r -s -p "phrase de la boite noire : " pp < /dev/tty; echo >&2
        # a wrong passphrase often « decrypts » to garbage: only a real age
        # identity is accepted
        printf '%s' "$pp" | openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -salt \
            -in "$CLE_CHIFFREE" -pass stdin 2>/dev/null | tr -d '\000' | grep -a '^AGE-SECRET-KEY-' \
            || { log "phrase incorrecte" >&2; return 1; }
    elif [ -f "$CLE_CLAIRE" ]; then
        cat "$CLE_CLAIRE"
    else
        log "aucune cle lisible (boite fermee sans sa phrase)" >&2; return 1
    fi
}

case "${1:-liste}" in
    init)
        boite
        command -v age >/dev/null || { log "age absent - pas de boite noire"; exit 0; }
        # (no « is it encrypted » check: in the installer's chroot findmnt sees
        # the live system; PRIVE is on nirvana's encrypted system anyway)
        install -d -m 0700 "$PRIVE"
        if [ ! -f "$PUB" ]; then
            ( umask 077; age-keygen -o "$CLE_CLAIRE" 2>/dev/null )
            age-keygen -y "$CLE_CLAIRE" > "$PUB"
        fi
        if [ -z "$(ls -A "$MIROIR" 2>/dev/null)" ]; then
            log "reference du systeme installe ($DIRS_MIROIR)..."
            mkdir -p "$MIROIR"; chmod 700 "$MIROIR"
            # shellcheck disable=SC2086
            trouver $DIRS_MIROIR | xargs -0 -r grep -IlZ '' 2>/dev/null | sed -z 's#^/##' \
                | tar -C / --null -T - -cf - 2>/dev/null | tar -C "$MIROIR" -xpf -
            touch "$TAMPON"
            printf 'reference : %s fichiers texte\n' "$(find "$MIROIR" -type f | wc -l)" | sceller installation >/dev/null
        fi
        log "boite noire prete ($(du -sh "$MIROIR" | cut -f1) de reference, dans $PRIVE)"
        ;;
    enregistrer)
        boite
        [ -f "$PUB" ] || { log "boite noire non initialisee"; exit 0; }
        # RAM root: recorded by « osmo-racine-live fin » with the decision
        # (enregistrer valide|efface), BEFORE the session is written or
        # dropped; the call without it (osmo-diffs.service) has nothing to do.
        if live && [ -z "${2:-}" ]; then
            log "racine en RAM : enregistrement fait par osmo-racine-live fin"; exit 0
        fi
        tmp="$(mktemp)"; debut="$(mktemp)"
        if home_chiffre_ouvert && ! live; then
            mode=session
            [ -f "$TAMPON" ] || { log "pas de reference dans $PRIVE"; rm -f "$tmp" "$debut"; exit 0; }
            {
                # shellcheck disable=SC2086
                find $DIRS_MIROIR -xdev \( -name .git -o -name node_modules -o -name __pycache__ -o -name .cache \
                     -o -name .env -o -name .venv \) -prune -o -type f -newer "$TAMPON" -print0 2>/dev/null
                ( cd "$MIROIR" && find . -type f -print0 ) | while IFS= read -r -d '' r; do
                    [ -e "${r#.}" ] || printf '%s\0' "${r#.}"
                done
            } | while IFS= read -r -d '' f; do trace_miroir "$f"; done > "$tmp"
            touch -r "$debut" "$TAMPON"
        elif live; then
            case "${2:-}" in valide|efface|ecrit) mode="$2" ;; *) mode=efface ;; esac
            ( cd "$HAUT" 2>/dev/null && find . \( -type f -o -type c -o -type l \) -print0 ) \
                | while IFS= read -r -d '' r; do p="${r#.}"; dans_dirs "$p" && trace_overlay "$p"; done > "$tmp"
        else
            log "ni session chiffree ni root live - rien"; rm -f "$tmp" "$debut"; exit 0
        fi
        if [ -s "$tmp" ]; then
            nom="$(sceller "$mode" < "$tmp")"
            log "$mode : $(grep -c '^+++ \|^=== ' "$tmp") changement(s) -> $nom"
        elif [ "$mode" != session ]; then
            # every session leaves a record, even an empty one
            nom="$(echo "aucun changement" | sceller "$mode")"
            log "$mode : aucun changement -> $nom"
        else
            log "$mode : aucun changement texte"
        fi
        rm -f "$tmp" "$debut"
        if [ "$mode" = session ]; then
            d="$(dernier)"
            [ -n "$d" ] && printf '%s %s\n' "$(sha256sum "$d" | cut -d' ' -f1)" "$(basename "$d")" > "$PRIVE/.dernier-vu"
        fi
        envoyer
        ;;
    phrase)
        boite
        [ "$(id -u)" = 0 ] || { log "root requis (sudo osmo-diffs phrase)"; exit 1; }
        cle="$(identite)" || exit 1
        read -r -s -p "nouvelle phrase de la boite noire : " a < /dev/tty; echo
        read -r -s -p "encore une fois : " b < /dev/tty; echo
        [ -n "$a" ] && [ "$a" = "$b" ] || { log "phrases vides ou differentes"; exit 1; }
        # never the /home (validation) passphrase: whoever validates sessions
        # must not be able to read the box
        _hu="$(. /etc/default/crypthome 2>/dev/null; echo "${CRYPTHOME_UUID:-}")"
        if [ -n "$_hu" ] && [ -e "/dev/disk/by-uuid/$_hu" ] \
                && printf '%s' "$a" | cryptsetup open --test-passphrase --key-file=- "/dev/disk/by-uuid/$_hu" 2>/dev/null; then
            a=""; b=""; cle=""
            log "refuse : c est la phrase de /home - la boite noire en veut une DIFFERENTE"; exit 1
        fi
        printf '%s' "$cle" | openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt \
            -out "$CLE_CHIFFREE.nouv" -pass fd:3 3< <(printf '%s' "$a") \
            && mv "$CLE_CHIFFREE.nouv" "$CLE_CHIFFREE"
        a=""; b=""; cle=""
        [ -f "$CLE_CLAIRE" ] && { shred -u "$CLE_CLAIRE" 2>/dev/null || rm -f "$CLE_CLAIRE"; }
        log "boite noire scellee : seule sa phrase la relit"
        ;;
    liste)
        boite
        for j in "$JOURNAL"/*.age; do
            [ -f "$j" ] && printf '%-55s %8s\n' "$(basename "$j")" "$(stat -c %s "$j")"
        done
        echo "occupe : $(du -sh "$BASE" | cut -f1) / $(df -h --output=size "$BASE" | tail -1 | tr -d ' ')"
        [ -f "$CLE_CHIFFREE" ] || echo "ATTENTION : pas encore de phrase - sudo osmo-diffs phrase"
        ;;
    voir)
        boite
        cle="$(identite)" || exit 1
        mapfile -t tous < <(find "$JOURNAL" -maxdepth 1 -name '*.age' | sort)
        n="${2:-0}"; debut=0
        [ "$n" -gt 0 ] 2>/dev/null && [ "${#tous[@]}" -gt "$n" ] && debut=$(( ${#tous[@]} - n ))
        prec=""
        for i in "${!tous[@]}"; do
            j="${tous[$i]}"
            if ! clair="$(age -d -i <(printf '%s\n' "$cle") "$j" 2>/dev/null)"; then
                echo "=== $(basename "$j") : indechiffrable"; prec="$j"; continue
            fi
            attendu="origine"
            [ -n "$prec" ] && attendu="$(sha256sum "$prec" | cut -d' ' -f1) $(basename "$prec")"
            vu="$(printf '%s\n' "$clair" | sed -n '2s/^# precedent : //p')"
            [ "$vu" = "$attendu" ] || echo "=== CHAINE ROMPUE avant $(basename "$j") (attendu : $attendu)"
            [ "$i" -ge "$debut" ] && printf '%s\n' "$clair"
            prec="$j"
        done | ${PAGER:-less -R}
        cle=""
        ;;
    verifier)
        # At nirvana's boot (osmo-diffs.service, ExecStart): the box must still
        # hold the last record nirvana saw (its name and SHA-256 kept in the
        # encrypted system, $PRIVE/.dernier-vu). The chain cannot show a
        # TRUNCATED end - this can, for everything nirvana has seen. Then the
        # mark moves to the newest record present (root sessions included).
        boite
        home_chiffre_ouvert || exit 0
        [ -f "$PUB" ] || exit 0
        vu="$PRIVE/.dernier-vu"
        if [ -s "$vu" ]; then
            read -r h nom < "$vu"
            if [ ! -f "$JOURNAL/$nom" ]; then
                alerte="TRONCATURE : $nom (le dernier enregistrement vu par nirvana) a disparu de la boite"
            elif [ "$(sha256sum "$JOURNAL/$nom" | cut -d' ' -f1)" != "$h" ]; then
                alerte="ALTERATION : $nom a change depuis que nirvana l a vu"
            else
                alerte=""
            fi
            if [ -n "$alerte" ]; then
                log "$alerte"
                printf '%s\n' "$alerte" | sceller alerte >/dev/null
                command -v wall >/dev/null && wall "osmo-diffs : $alerte" 2>/dev/null
            fi
        fi
        d="$(dernier)"
        [ -n "$d" ] && printf '%s %s\n' "$(sha256sum "$d" | cut -d' ' -f1)" "$(basename "$d")" > "$vu"
        ;;
    copie-poser)
        # copie-poser user@host [POSTE]: the ssh key on the box + the line for
        # the other machine's authorized_keys
        boite
        [ "$(id -u)" = 0 ] || { log "root requis (sudo osmo-diffs copie-poser user@host)"; exit 1; }
        dest="${2:?usage : osmo-diffs copie-poser user@host [POSTE]}"
        [ -s "$COPIE_CLE" ] || ssh-keygen -q -t ed25519 -N '' -C "osmo-diffs@$(hostname)" -f "$COPIE_CLE"
        printf 'DEST=%s\nPOSTE=%s\n' "$dest" "${3:-$(hostname)}" > "$COPIE_CONF"
        echo "Sur $dest, dans ~/.ssh/authorized_keys (et osmo-diffs-recevoir dans /usr/local/bin) :"
        echo "command=\"/usr/local/bin/osmo-diffs-recevoir\",restrict $(cat "$COPIE_CLE.pub")"
        echo "Puis : sudo osmo-diffs envoyer"
        ;;
    envoyer)
        boite
        [ -s "$COPIE_CONF" ] || { log "pas de copie distante (osmo-diffs copie-poser)"; exit 0; }
        envoyer
        ;;
    *)
        echo "usage : osmo-diffs init | enregistrer [valide|efface|ecrit] | verifier | phrase | liste | voir [N] | copie-poser user@host | envoyer" >&2
        exit 2
        ;;
esac
