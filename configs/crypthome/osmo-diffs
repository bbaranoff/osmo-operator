            [ -f "$j" ] || continue
            n=$((n + 1)); b="$(basename "$j")"
            case "$b" in
                point-*.session.age) printf '\033[1;31m%-22s NON VALIDEE  %6s Mo   session en cours, point de controle de %s\033[0m\n' \
