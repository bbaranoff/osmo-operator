        # THE DESTINATION ONLY CHANGES WITH THE BOX PASSPHRASE: whoever sits
        # at a session must not be able to send the copies elsewhere, or
        # nowhere. The change is itself a record of the box, the file is made
        # immutable and is part of what the seal covers (osmo-empreinte): a
        # destination changed by hand is denounced at the next boot.
        boite
        [ "$(id -u)" = 0 ] || { log "root requis (sudo osmo-diffs copie-poser user@host)"; exit 1; }
        dest="${2:?usage : osmo-diffs copie-poser user@host [POSTE]}"
        case "$dest" in *[!A-Za-z0-9@._:-]*|-*) log "destination refusee : $dest"; exit 1 ;; esac
        [ -f "$PUB" ] || { log "boite noire non initialisee"; exit 1; }
        cle="$(identite)" || { log "phrase de la boite requise pour changer la destination de la copie"; exit 1; }
        cle=""
        ouvrir || exit 1
        ancien="$(sed -n 's/^DEST=//p' "$COPIE_CONF" 2>/dev/null)"
        [ -s "$COPIE_CLE" ] || ssh-keygen -q -t ed25519 -N '' -C "osmo-diffs@$(hostname)" -f "$COPIE_CLE"
        [ "$TEST" = 1 ] || chattr -i "$COPIE_CONF" 2>/dev/null
        printf 'DEST=%s\nPOSTE=%s\n' "$dest" "${3:-$(hostname)}" > "$COPIE_CONF"
        chmod 0444 "$COPIE_CONF"
        [ "$TEST" = 1 ] || chattr +i "$COPIE_CONF" 2>/dev/null
        # the other machine has nothing yet: everything is to be sent again
        [ "$ancien" = "$dest" ] || : > "$BASE/.envoyes"
        printf 'copie de la boite : destination %s -> %s\n' "${ancien:-(aucune)}" "$dest" | sceller copie >/dev/null
        # the destination is part of what is signed: signed again, with the /home passphrase
        if [ -x /usr/local/sbin/osmo-empreinte ]; then
            echo "La destination de la copie fait partie de ce qui est signe :"
            /usr/local/sbin/osmo-empreinte resceller || log "empreinte NON signee de nouveau : le prochain demarrage le dira"
        fi
        echo "Sur $dest, dans ~/.ssh/authorized_keys (et osmo-diffs-recevoir dans /usr/local/bin) :"
        echo "command=\"/usr/local/bin/osmo-diffs-recevoir\",restrict $(cat "$COPIE_CLE.pub")"
        echo "Puis : sudo osmo-diffs envoyer"
        ;;
    copie-etat)
        # « DEST WAITING TOTAL » when a copy is set up (no network needed):
        # what the boot warns about
        boite
        [ -s "$COPIE_CONF" ] || exit 0
        tot=0; att=0
        for j in "$JOURNAL"/*.age; do
            [ -f "$j" ] || continue
            tot=$((tot + 1))
            grep -qxF "$(basename "$j")" "$BASE/.envoyes" 2>/dev/null || att=$((att + 1))
        done
        echo "$(sed -n 's/^DEST=//p' "$COPIE_CONF") $att $tot"
        ;;
    envoyer)
        boite
        [ -s "$COPIE_CONF" ] || { log "pas de copie distante (osmo-diffs copie-poser)"; exit 0; }
        envoyer
        ;;
    *)
        echo "usage : osmo-diffs init [--console] | enregistrer [valide|efface|ecrit] | defait ID PREFIXE=DISQUE... | verifier | fermer | phrase | liste | voir [N] | copie-poser user@host | copie-etat | envoyer | alerte" >&2
        exit 2
        ;;
esac
