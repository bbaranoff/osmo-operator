                    for i in "${!ou[@]}"; do echo "    $((i + 1))   ${ou[$i]}   ($(df -h --output=avail "${ou[$i]}" | tail -1 | tr -d ' ') libres)"; done
                    printf '  Un numero, ou un dossier (Entree : abandonner) : '
                else
                    echo "  Aucune cle USB n est branchee. Branche-en une et recommence, ou donne un dossier."
                    printf '  Dossier (Entree : abandonner) : '
                fi
