        echo "  Quand elle sera pleine, plus rien ne pourra y etre note."
        echo
        echo "    1   en faire une copie (cle USB, autre disque), puis la vider"
        echo "    2   la vider SANS copie : tout ce qu elle a note est perdu"
        echo "    Entree   plus tard (la question reviendra a la prochaine ouverture de session)"
        echo
        printf '  Ton choix : '
        IFS= read -r c || c=""
        note=""
        case "$c" in
            1)
                mapfile -t ou < <(findmnt -rno TARGET 2>/dev/null | grep -E '^(/media/[^/]+/[^/]+|/run/media/[^/]+/[^/]+|/mnt/[^/]+)$' | while IFS= read -r m; do
                    m="$(printf '%b' "$m")"; [ -w "$m" ] && [ "$m" != /media/root-ro ] && [ "$m" != /media/root-rw ] && printf '%s\n' "$m"; done)
