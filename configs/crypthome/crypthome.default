# /etc/default/crypthome - encrypted second disk carrying /home
#
# MODEL. The system disk is NOT encrypted: everything that is system is
# readable - the OS, /etc, and /root, the WORKING account of the bench. What
# is encrypted is the second disk, mounted on /home: profiles, personal data
# and everything that belongs to the keyring.
#
# WHO WRITES THIS FILE. Two writers, for two paths:
#   - crypthome-postinstall, at INSTALLATION time, when Calamares has just
#     encrypted the /home partition (the normal case);
#   - init-crypthome.sh, afterwards, when encrypting a SECOND disk added to an
#     already installed machine.
# CRYPTHOME_UUID stays empty until one of them has run; unlock-home then does
# nothing and the boot is not affected.

# UUID of the LUKS container (= UUID shown by blkid on the encrypted partition).
CRYPTHOME_UUID=""

# Mapping name in /dev/mapper and mount point.
#
# "crypthome" is the name chosen by init-crypthome.sh. A Calamares installation
# inherits the name forged by kpmcore - "luks-<uuid>" - and crypthome-postinstall
# writes THAT one here. Both are fine: every component reads this setting
# instead of assuming a name.
CRYPTHOME_NAME="crypthome"
CRYPTHOME_MOUNT="/home"

# The account whose home lives on the encrypted disk: it carries the keyring
# and runs the applications holding secrets (see run-as-owner).
#
# On the live key it is osmocom, and the session runs as root. On an installed
# disk, osmocom no longer exists (removed by shellprocess-osmo.conf) and
# crypthome-postinstall writes here the account chosen at installation - which
# is also the session account. run-as-owner then has nothing to switch and
# starts the application as is: the home of that account IS already on the
# encrypted volume.
#
# TWO SESSIONS, DEPENDING ON THE ANSWER AT BOOT (unlock-home):
#   yes -> the account above, PERSISTENT: its home is on the encrypted volume;
#   no  -> ROOT, EPHEMERAL: GDM opens on root for this boot only, and whatever
#          the session writes in /root - and in /opt/GSM, see
#          CRYPTHOME_RAM_DIRS - stays in /tmp/crypthome-root (tmpfs, in RAM):
#          nothing survives a shutdown.
CRYPTHOME_OWNER="__OWNER__"

# Boot: number of passphrase attempts, and delay (s) after which an unanswered
# prompt counts as "no". The boot is NEVER blocked: at worst the machine
# starts without /home.
CRYPTHOME_TRIES=3
CRYPTHOME_TIMEOUT=60

# Where the prompt "decrypt /home -passphrase- or Enter" is asked at boot:
#   console  (default) on the text console, read by unlock-home itself;
#            plymouth, if running, is quit just before. This path works
#            everywhere: it depends neither on a systemd agent nor on the
#            plymouth keyboard (dead on some machines, Intel + NVIDIA laptops
#            in particular).
#   plymouth in the boot theme (osmo-bts), through systemd-ask-password:
#            nicer, for a machine where keyboard input in plymouth has been
#            VERIFIED to work.
CRYPTHOME_PROMPT="console"

# Image painted behind the prompt (console mode, /dev/fb0) by crypthome-fond.
# "none": bare text console.
CRYPTHOME_IMAGE="/usr/share/backgrounds/gsm-lab-antenne.jpg"

# Directories covered by a RAM overlay during a ROOT session (/home closed),
# IN ADDITION to /root, which always is. The whole bench lives in /opt/GSM
# (repository, configs, hlr.db, logs): in a root session it is "live" -
# everything written there evaporates at shutdown, and the disk keeps its
# previous state. Content stays readable and executable; only writes go to
# RAM. Space separated; a missing directory is ignored. Empty = /root only.
CRYPTHOME_RAM_DIRS="/opt/GSM"

# Directories of root that must not exist in clear on the system disk:
# init-crypthome.sh replaces them with links to the encrypted disk. Disk not
# decrypted = dangling link = nothing is written in clear.
CRYPTHOME_ROOT_LINKS=".local/share/keyrings"

# Applications holding secrets: their launchers are redirected to run-as-owner
# by refresh-owner-apps. Names of .desktop files without the extension; those
# not installed are silently ignored. Run "refresh-owner-apps" again after
# adding some.
CRYPTHOME_OWNER_APPS="firefox firefox-esr thunderbird chromium chromium-browser google-chrome keepassxc seahorse org.gnome.seahorse.Application signal-desktop element-desktop telegramdesktop org.gnome.Geary org.gnome.Evolution evolution nextcloud org.keepassxc.KeePassXC"
