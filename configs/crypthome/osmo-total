#!/bin/sh
# osmo-total RACINE - ONE SHA-256 for a whole volume, from what the file
# system says of every entry: for a file its rights, owner, size, dates and
# inode; for a link its target; for anything else its nature, rights and
# owner - sorted, then hashed. About 4 s for 450 000 entries.
#
# The same text runs in the system (osmo-empreinte) and in the initramfs
# (measured boot, osmo-tpm): what the TPM is asked to recognise is exactly
# what the black box holds. It needs the real find, sort and sha256sum
# (busybox's find has no -printf): the initramfs hook copies them.
# OSMO_BIN: where they are, BY FULL PATH - the initramfs shell is busybox, and
# busybox runs its own find / sort / sha256sum whatever PATH says.
B="${OSMO_BIN:+$OSMO_BIN/}"
# osmo-total --contenu RACINE : ONE SHA-256 for the CONTENT of every regular
# file - « sha256  ./path » for each (sha256sum -z: NUL-ended, names as they
# are), sorted, hashed. It reads the whole volume: about 15 s for 18 GB on
# every core. What forged dates and inodes cannot hide. GRUB's environment
# block is left out (the boot loader rewrites it in place before anything runs).
if [ "$1" = --contenu ]; then
    cd "$2" 2>/dev/null || exit 1
    n="$(nproc 2>/dev/null || echo 4)"
    # one output file per worker: several sha256sum writing to ONE pipe cut
    # each other's lines (seen: thousands of records without their hash)
    t="$(mktemp -d /run/osmo-total.XXXXXX 2>/dev/null || mktemp -d)" || exit 1
    export OSMO_TOTAL_T="$t" OSMO_TOTAL_SHA="${B}sha256sum"
    "${B}find" . -xdev \
      \( -path ./.osmo-valider -o -path ./.osmo-retour -o -path ./lost+found \
         -o -path ./var/log/osmo-session.log -o -path ./var/log/osmo-session.log.nouv \
         -o -path ./boot/grub/grubenv \) -prune -o -type f -print0 2>/dev/null \
      | "${B}xargs" -0 -P "$n" -n 256 sh -c '"$OSMO_TOTAL_SHA" -z "$@" >> "$OSMO_TOTAL_T/$$" 2>/dev/null' _
    cat "$t"/* 2>/dev/null | LC_ALL=C "${B}sort" -z -S 256M | "${B}sha256sum" | "${B}cut" -d' ' -f1
    rm -rf "$t"
    exit 0
fi
cd "$1" 2>/dev/null || exit 1
"${B}find" . -xdev \
  \( -path ./.osmo-valider -o -path ./.osmo-retour -o -path ./lost+found \
     -o -path ./var/log/osmo-session.log -o -path ./var/log/osmo-session.log.nouv \) -prune -o \
  \( -type f -printf 'f %m %U %G %s %T@ %C@ %i %p\0' \) -o \
  \( -type l -printf 'l %m %U %G %l\t%p\0' \) -o \
  \( -printf '%y %m %U %G %p\0' \) 2>/dev/null | LC_ALL=C "${B}sort" -z --parallel=4 -S 256M | "${B}sha256sum" | "${B}cut" -d' ' -f1
