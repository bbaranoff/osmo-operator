#!/bin/bash
# osmo-valider-session - from the desktop: give the /home passphrase so that
# the session is written to the disk at shutdown (osmo-racine-live valider).
#
#   osmo-valider-session           ask the passphrase (zenity, or the terminal)
#                                  and write THE MOMENT to the disk: the session
#                                  as it is now, not what follows
#                                  (osmo-racine-live valider)
#   osmo-valider-session --maintenant  the same (its former name)
#   osmo-valider-session --defaire undo the LAST write on the disk
#                                  (osmo-racine-live defaire); again for the
#                                  one before
#   osmo-valider-session --fin [poweroff|reboot]  « Tout oublier ? » Yes: the
#                                  flash, the session is wiped; No: the session
#                                  is to be kept - then shutdown. NO passphrase
#                                  window here: the /home passphrase is asked on
#                                  the text console at shutdown, at the moment
#                                  of the write (osmo-racine-live fin)
#
# Without the passphrase at shutdown everything written during the session -
# /, /root, /opt/GSM, /home - is wiped (except what --maintenant already wrote).
set -u
RL=/usr/local/sbin/osmo-racine-live
ACTION=valider
TITRE="Garder la session : phrase de /home"
# valider = THE MOMENT: the session as it is now goes to the disk; what follows
# is not kept without a new validation (--maintenant: the former name)
OK_TXT="Valide : la session jusqu a maintenant est ecrite sur le disque. Ce qui suit n est PAS garde sans une nouvelle validation (ou la phrase a l extinction)."
KO_TXT="Phrase refusee (ou ecriture en echec) : rien n est ecrit."
if [ "${1:-}" = --defaire ]; then
    ACTION=defaire
    TITRE="Defaire la derniere ecriture : phrase de /home"
    OK_TXT="Derniere ecriture defaite sur le disque (visible au prochain demarrage). Recommencer pour la precedente. La boite noire garde tout."
    KO_TXT="Phrase refusee, ou rien a defaire : le disque n a pas change."
fi
live() { [ "$(findmnt -no FSTYPE / 2>/dev/null)" = overlay ] && mountpoint -q /media/root-ro 2>/dev/null; }
if ! live; then
    # / written directly: nothing to forget or validate, --fin just shuts down
    [ "${1:-}" = --fin ] && exec systemctl "${2:-poweroff}"
    echo "osmo-valider-session : / n est pas en RAM, rien a valider"
    exit 0
fi

graphique() { [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; }

# --fin [poweroff|reboot] : the end-of-session question, then shutdown.
#   Yes (« tout oublier ») : the pseudo-neuralyzer (osmo-flash --blanc), the
#        screen stays WHITE and the machine shuts down underneath; the session
#        is wiped (osmo-racine-live oublier: no question, no banner at shutdown);
#   No : the machine shuts down, and the console asks the /home passphrase at
#        the moment of the write (osmo-racine-live garder: not the yes/no
#        question again). No passphrase window on the desktop: it would be
#        asked twice.
en_root() { if [ "$(id -u)" = 0 ]; then "$@"; else pkexec "$@"; fi; }
if [ "${1:-}" = --fin ]; then
    quoi="${2:-poweroff}"
    graphique || { echo "osmo-valider-session --fin : pas d affichage" >&2; exit 1; }
    while :; do
        if zenity --question --no-wrap --title "osmo-operator : fin de session" \
                --ok-label "Yes" --cancel-label "No" \
                --text '<span weight="bold" size="large">Tout oublier ?</span>

<b>Yes</b> : flash - la session est effacee, plus aucun souvenir.
<b>No</b> : la session est gardee - la phrase de /home est demandee a l extinction.'; then
            en_root "$RL" oublier >/dev/null 2>&1 || continue
            if command -v osmo-flash >/dev/null 2>&1; then
                osmo-flash --blanc &
                sleep 2          # charge + flash: the screen is white now
            fi
            exec systemctl "$quoi"
        fi
        # (refused - the polkit window closed: the console asks yes/no itself)
        en_root "$RL" garder >/dev/null 2>&1
        exec systemctl "$quoi"
    done
fi

if graphique; then
    # (zenity's own Gtk warnings - no session bus under sudo - are not ours)
    p="$(zenity --password --title "$TITRE" 2>/dev/null)" || exit 0
    # the write runs behind a progress dialog fed by /run/osmo-progres
    # (what osmo-racine-live updates: black box, copy, application)
    rcf="$(mktemp)"
    # Ctrl-C in the terminal CANCELS the write (osmo-racine-live undoes what it
    # had already put on the disk): caught here, so that its outcome is read
    trap ':' INT
    ( trap ':' INT
      printf '%s\n' "$p" | en_root "$RL" "$ACTION" --stdin >/dev/null 2>&1; echo $? > "$rcf.fin"; mv -f "$rcf.fin" "$rcf" ) &
    p=""
    if [ "$ACTION" = valider ]; then
        # the progress: in the dialog, and in the terminal when there is one
        # (the same red REC bar as « osmo-racine-live valider »)
        [ -t 2 ] && echo "  ecriture de la session - Ctrl-C : annuler" >&2
        ( trap '' INT
          while [ ! -s "$rcf" ]; do
              pc=""; tx=""
              [ -r /run/osmo-progres ] && read -r pc tx 2>/dev/null < /run/osmo-progres
              case "$pc" in ''|*[!0-9]*) pc=0; tx="phrase de /home, compte des changements" ;; esac
              [ "$pc" -ge 100 ] && pc=99
              echo "$pc"; echo "# REC : $tx"
              if [ -t 2 ]; then
                  # one line, rewritten in place: never wider than the terminal
                  cols="$(stty size 2>/dev/null < /dev/tty | cut -d' ' -f2)"
                  case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
                  n=$((pc * 20 / 100))
                  l="$(printf '  REC [%s%s] %3d %%  %.24s' "$(printf '%*s' "$n" '' | tr ' ' '#')" \
                      "$(printf '%*s' "$((20 - n))" '' | tr ' ' '-')" "$pc" "$tx")"
                  printf '\r\033[1;31m%s\033[0m\033[K' "$(printf '%s' "$l" | cut -c1-$((cols - 1)))" >&2
              fi
              sleep 0.4
          done; echo 100; [ -t 2 ] && printf '\r\033[K' >&2 ) | zenity --progress --no-cancel --auto-close --width 420 \
              --title "osmo-operator : ecriture de la session" --text "REC : preparation" 2>/dev/null
    fi
    # (a zenity killed by the Ctrl-C leaves the loop without a reader: wait
    # for the write itself, which ends by its own cancel)
    while [ ! -s "$rcf" ] && kill -0 $! 2>/dev/null; do wait $! 2>/dev/null; done
    wait
    trap - INT
    rc="$(cat "$rcf" 2>/dev/null)"; rc="${rc:-1}"; rm -f "$rcf"
    if [ "$rc" = 130 ]; then
        echo "osmo-valider-session : ANNULE (Ctrl-C) - rien de cette ecriture n est garde, le disque est comme avant"
        zenity --warning --no-wrap --title "osmo-operator" \
            --text '<span foreground="red" weight="bold">Annule (Ctrl-C) : rien de cette ecriture n est garde, le disque est comme avant.</span>' 2>/dev/null
        exit 130
    fi
    if [ "$rc" = 0 ]; then
        # the confirmation: date and time of the write, and the line of the
        # GRUB menu « remonter session » that undoes it (osmo-racine-live)
        conf=""
        [ "$ACTION" = valider ] && [ -r /run/osmo-derniere-ecriture ] && conf="$(cat /run/osmo-derniere-ecriture)"
        printf '\033[1;32m%s\033[0m\n' "$OK_TXT" ${conf:+"$conf"}
        zenity --info --no-wrap --title "osmo-operator" \
            --text "<span foreground=\"green\" weight=\"bold\">$OK_TXT</span>${conf:+

$(printf '%s' "$conf" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g')}" 2>/dev/null
    else
        printf '\033[1;31m%s\033[0m\n' "$KO_TXT"
        zenity --error --no-wrap --title "osmo-operator" \
            --text "<span foreground=\"red\" weight=\"bold\">$KO_TXT</span>" 2>/dev/null
    fi
    exit "$rc"
fi

if [ "$(id -u)" = 0 ]; then exec "$RL" "$ACTION"; else exec sudo "$RL" "$ACTION"; fi
