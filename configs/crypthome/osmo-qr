#!/usr/bin/python3
# osmo-qr - a QR code encoder with no dependency (the bench carries no QR
# library, and an invitation must be shown without the network).
#
# Used by tools/osmo-inscription.py (--nouveau-qrcode: terminal and PNG) and
# by osmo-gtk (tab « Mobiles »: the invitation a phone scans).
#
#   import osmo_qr
#   m = osmo_qr.matrice("osmo://inscription?noeud=...")   # list of rows of bool
#   print(osmo_qr.texte(m))                                # for a terminal
#   osmo_qr.png(m, "/tmp/invitation.png")                  # a PNG file
#
#   python3 osmo_qr.py "some text" [file.png]
#
# What it does: byte mode (UTF-8), error correction level M, versions 1 to 10
# (213 bytes at most - an invitation link is about 80), the eight masks with
# the standard penalty rules. ISO/IEC 18004.
import struct
import sys
import zlib

# EC level M, per version: (EC codewords per block, [(blocks, data codewords each), ...])
_BLOCS = {
    1: (10, [(1, 16)]), 2: (16, [(1, 28)]), 3: (26, [(1, 44)]), 4: (18, [(2, 32)]),
    5: (24, [(2, 43)]), 6: (16, [(4, 27)]), 7: (18, [(4, 31)]), 8: (22, [(2, 38), (2, 39)]),
    9: (22, [(3, 36), (2, 37)]), 10: (26, [(4, 43), (1, 44)]),
}
_ALIGN = {1: [], 2: [6, 18], 3: [6, 22], 4: [6, 26], 5: [6, 30], 6: [6, 34],
          7: [6, 22, 38], 8: [6, 24, 42], 9: [6, 26, 46], 10: [6, 28, 50]}

# GF(256), polynomial 0x11D
_EXP = [0] * 512
_LOG = [0] * 256
_x = 1
for _i in range(255):
    _EXP[_i] = _x
    _LOG[_x] = _i
    _x <<= 1
    if _x & 0x100:
        _x ^= 0x11D
for _i in range(255, 512):
    _EXP[_i] = _EXP[_i - 255]


def _mul(a, b):
    return 0 if a == 0 or b == 0 else _EXP[_LOG[a] + _LOG[b]]


def _rs(data, n):
    """The n Reed-Solomon codewords of a block."""
    gen = [1]
    for i in range(n):
        gen = _poly_mul(gen, [1, _EXP[i]])
    reste = [0] * n
    for d in data:
        f = d ^ reste[0]
        reste = reste[1:] + [0]
        for k in range(n):
            reste[k] ^= _mul(gen[k + 1], f)
    return reste


def _poly_mul(a, b):
    r = [0] * (len(a) + len(b) - 1)
    for i, x in enumerate(a):
        for j, y in enumerate(b):
            r[i + j] ^= _mul(x, y)
    return r


def _capacite(v):
    ec, groupes = _BLOCS[v]
    return sum(n * d for n, d in groupes)


def _codewords(octets, v):
    """Data bits (byte mode), padded, split in blocks, EC added, interleaved."""
    ec, groupes = _BLOCS[v]
    cap = _capacite(v)
    bits = [0, 1, 0, 0]
    n = len(octets)
    for k in range((16 if v >= 10 else 8) - 1, -1, -1):
        bits.append((n >> k) & 1)
    for o in octets:
        for k in range(7, -1, -1):
            bits.append((o >> k) & 1)
    bits += [0] * min(4, cap * 8 - len(bits))
    bits += [0] * (-len(bits) % 8)
    data = [int("".join(map(str, bits[i:i + 8])), 2) for i in range(0, len(bits), 8)]
    pad = (0xEC, 0x11)
    k = 0
    while len(data) < cap:
        data.append(pad[k % 2])
        k += 1
    blocs, pos = [], 0
    for nb, taille in groupes:
        for _ in range(nb):
            blocs.append(data[pos:pos + taille])
            pos += taille
    ecs = [_rs(b, ec) for b in blocs]
    out = []
    for i in range(max(len(b) for b in blocs)):
        for b in blocs:
            if i < len(b):
                out.append(b[i])
    for i in range(ec):
        for e in ecs:
            out.append(e[i])
    return out


_MASQUES = (
    lambda x, y: (x + y) % 2 == 0,
    lambda x, y: y % 2 == 0,
    lambda x, y: x % 3 == 0,
    lambda x, y: (x + y) % 3 == 0,
    lambda x, y: (x // 3 + y // 2) % 2 == 0,
    lambda x, y: x * y % 2 + x * y % 3 == 0,
    lambda x, y: (x * y % 2 + x * y % 3) % 2 == 0,
    lambda x, y: ((x + y) % 2 + x * y % 3) % 2 == 0,
)


def _base(v):
    """The function patterns of a version: (modules, reserved)."""
    t = 17 + 4 * v
    m = [[False] * t for _ in range(t)]
    f = [[False] * t for _ in range(t)]

    def poser(x, y, noir):
        if 0 <= x < t and 0 <= y < t:
            m[y][x] = noir
            f[y][x] = True

    for i in range(t):                                     # timing
        poser(6, i, i % 2 == 0)
        poser(i, 6, i % 2 == 0)
    for cx, cy in ((3, 3), (t - 4, 3), (3, t - 4)):         # finders and their separators
        for dy in range(-4, 5):
            for dx in range(-4, 5):
                d = max(abs(dx), abs(dy))
                poser(cx + dx, cy + dy, d not in (2, 4))
    pos = _ALIGN[v]
    for i, ax in enumerate(pos):                           # alignment
        for j, ay in enumerate(pos):
            if (i == 0 and j == 0) or (i == 0 and j == len(pos) - 1) or (i == len(pos) - 1 and j == 0):
                continue
            for dy in range(-2, 3):
                for dx in range(-2, 3):
                    poser(ax + dx, ay + dy, max(abs(dx), abs(dy)) != 1)
    # format information: reserved here, written with the mask
    for i in range(9):
        poser(8, i, m[i][8] if f[i][8] else False)
        poser(i, 8, m[8][i] if f[8][i] else False)
    for i in range(8):
        poser(t - 1 - i, 8, False)
        poser(8, t - 1 - i, False)
    poser(8, t - 8, True)                                  # the dark module
    if v >= 7:                                             # version information
        r = v
        for _ in range(12):
            r = (r << 1) ^ ((r >> 11) * 0x1F25)
        bits = v << 12 | r
        for i in range(18):
            b = (bits >> i) & 1 == 1
            a, c = t - 11 + i % 3, i // 3
            poser(a, c, b)
            poser(c, a, b)
    return m, f


def _format(m, masque):
    """The 15 format bits (level M = 00, the mask), both copies."""
    t = len(m)
    data = (0 << 3) | masque
    r = data
    for _ in range(10):
        r = (r << 1) ^ ((r >> 9) * 0x537)
    bits = ((data << 10) | r) ^ 0x5412

    def b(i):
        return (bits >> i) & 1 == 1

    for i in range(6):
        m[i][8] = b(i)
    m[7][8] = b(6)
    m[8][8] = b(7)
    m[8][7] = b(8)
    for i in range(9, 15):
        m[8][14 - i] = b(i)
    for i in range(8):
        m[8][t - 1 - i] = b(i)
    for i in range(8, 15):
        m[t - 15 + i][8] = b(i)
    m[t - 8][8] = True


def _penalite(m):
    t = len(m)
    p = 0
    lignes = m + [list(c) for c in zip(*m)]
    motif = [True, False, True, True, True, False, True]
    for l in lignes:
        # runs of 5 or more
        n, prec = 0, None
        for c in l + [None]:
            if c == prec:
                n += 1
            else:
                if prec is not None and n >= 5:
                    p += 3 + (n - 5)
                n, prec = 1, c
        # finder-like patterns, with 4 light modules on one side
        for i in range(t - 6):
            if l[i:i + 7] == motif:
                avant = l[max(0, i - 4):i]
                apres = l[i + 7:i + 11]
                if (len(avant) == 4 and not any(avant)) or (len(apres) == 4 and not any(apres)) \
                        or (i < 4 and not any(avant)) or (i + 11 > t and not any(apres)):
                    p += 40
    for y in range(t - 1):                                 # 2x2 blocks
        for x in range(t - 1):
            if m[y][x] == m[y][x + 1] == m[y + 1][x] == m[y + 1][x + 1]:
                p += 3
    noirs = sum(sum(l) for l in m)                         # balance
    p += 10 * (abs(noirs * 20 - t * t * 10) // (t * t))
    return p


def matrice(texte, masque=None):
    """The QR code of a text: a list of rows, True = dark module (no quiet zone)."""
    octets = texte.encode("utf-8") if isinstance(texte, str) else bytes(texte)
    v = next((v for v in sorted(_BLOCS)
              if len(octets) * 8 + 4 + (16 if v >= 10 else 8) <= _capacite(v) * 8), None)
    if v is None:
        raise ValueError("texte trop long pour un QR code de ce module (%d octets)" % len(octets))
    cw = _codewords(octets, v)
    base, f = _base(v)
    t = len(base)
    i, total = 0, len(cw) * 8
    droite = t - 1
    while droite >= 1:                                     # the zigzag, two columns at a time
        if droite == 6:
            droite = 5
        for vert in range(t):
            for j in range(2):
                x = droite - j
                monte = ((droite + 1) & 2) == 0
                y = t - 1 - vert if monte else vert
                if not f[y][x] and i < total:
                    base[y][x] = (cw[i >> 3] >> (7 - (i & 7))) & 1 == 1
                    i += 1
        droite -= 2
    meilleur = None
    for k in (range(8) if masque is None else (masque,)):
        m = [l[:] for l in base]
        for y in range(t):
            for x in range(t):
                if not f[y][x] and _MASQUES[k](x, y):
                    m[y][x] = not m[y][x]
        _format(m, k)
        p = _penalite(m)
        if meilleur is None or p < meilleur[0]:
            meilleur = (p, m)
    return meilleur[1]


def texte(m, marge=2):
    """The code for a terminal: two rows per line of text (half blocks), dark
    modules drawn dark on a light background whatever the terminal's colours."""
    t = len(m)
    g = [[False] * (t + 2 * marge) for _ in range(marge)]
    g += [[False] * marge + l + [False] * marge for l in m]
    g += [[False] * (t + 2 * marge) for _ in range(marge)]
    if len(g) % 2:
        g.append([False] * (t + 2 * marge))
    out = []
    for y in range(0, len(g), 2):
        ligne = "".join(" " if a and b else "▄" if a else "▀" if b else "█" for a, b in zip(g[y], g[y + 1]))
        out.append("\033[97;40m" + ligne + "\033[0m")
    return "\n".join(out)


def png(m, fichier, module=10, marge=4):
    """The code as a PNG file (8-bit greyscale), `module` pixels per module."""
    t = len(m) + 2 * marge
    lignes = []
    for y in range(t):
        l = bytearray()
        for x in range(t):
            yy, xx = y - marge, x - marge
            noir = 0 <= yy < len(m) and 0 <= xx < len(m) and m[yy][xx]
            l += (b"\x00" if noir else b"\xff") * module
        lignes += [b"\x00" + bytes(l)] * module
    brut = b"".join(lignes)

    def bloc(typ, d):
        return struct.pack(">I", len(d)) + typ + d + struct.pack(">I", zlib.crc32(typ + d) & 0xFFFFFFFF)

    with open(fichier, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + bloc(b"IHDR", struct.pack(">IIBBBBB", t * module, t * module, 8, 0, 0, 0, 0))
                + bloc(b"IDAT", zlib.compress(brut, 9)) + bloc(b"IEND", b""))


if __name__ == "__main__":
    if len(sys.argv) < 2:
        sys.exit("usage : osmo_qr.py TEXTE [fichier.png]")
    _m = matrice(sys.argv[1])
    print(texte(_m))
    if len(sys.argv) > 2:
        png(_m, sys.argv[2])
        print(sys.argv[2])
