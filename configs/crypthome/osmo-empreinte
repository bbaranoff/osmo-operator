def prendre(phrase=None, premiere=False):
    """The fingerprint of every volume, after a commit: its two totals in
    empreinte.json (what the boot compares), its detail next to it (what
    explains a difference). Only what changed is read again.
    ONLY WITH THE /home PASSPHRASE: it unlocks the key that signs the totals.
    (premiere: the first boot of an installation, nothing to compare with yet -
    taken unsigned, signed at the first validated write.)"""
    if not TEST and not os.path.ismount(BOITE):
        dire("%s n est pas monte : pas d empreinte" % BOITE)
        return 0
    pem = None
    if not premiere:
        pem = cle_privee(phrase) if phrase else None
        if pem is None:
            dire("phrase de /home refusee ou absente : l empreinte n est PAS prise (rien ne benit le disque sans elle)")
            return 1
    t0 = time.monotonic()
    cle = cle_sceau(creer=True)            # before /home is walked: the key is one of its files
    tot, pris, relus = totaux(), {}, 0
    for nom, racine in couches().items():
        ancien = charger(nom)
        etat = parcourir(racine)
        a_lire = []
        for p, r in etat.items():
            if r[0] != "f":
                continue
            v = ancien.get(p) if ancien else None
            # unchanged since the last fingerprint (a commit is a trusted
            # moment): its hash is kept
            # (GRUB's environment block is rewritten in place by the boot
            # loader, dates and inode untouched: always read again)
            if v and v[0] == "f" and v[4:8] == r[4:8] and v[8] and not v[8].startswith("illisible") \
                    and p not in TOUJOURS_RELUS:
                r[8] = v[8]
            else:
                a_lire.append(p)
        for p, h in hacher(racine, a_lire).items():
            etat[p][8] = h
        relus += len(a_lire)
        pris[nom] = etat
        tot[nom] = {"meta": total_meta(racine), "contenu": total_contenu(etat), "entrees": len(etat),
                    "pris": time.strftime("%F %T"), "disque": racine}
    if not boite_rw(True):
        dire("boite en lecture seule : empreinte non ecrite")
        return 1
    signee = False
    try:
        for nom, etat in pris.items():
            if nom in CHIFFRES:
                # never in clear on the box; without the key, the total alone
                effacer_clair(nom)
                tmp = manifeste_chiffre(nom) + ".nouv"
                try:
                    if cle is None:
                        raise OSError("cle du sceau hors d atteinte")
                    clair = "\n".join([json.dumps(tot[nom])] + [json.dumps([p] + etat[p], ensure_ascii=True) for p in sorted(etat)]) + "\n"
                    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
                        f.write(chiffrer_detail(gzip.compress(clair.encode("utf-8", "surrogateescape"), 1), cle))
                    os.replace(tmp, manifeste_chiffre(nom))
                except OSError as e:
                    dire("detail de %s NON ecrit (%s) : son total seul est garde" % (nom, e))
                    for f in (tmp, manifeste_chiffre(nom)):
                        try:
                            os.unlink(f)
                        except OSError:
                            pass
                continue
            tmp = manifeste(nom) + ".nouv"
            with gzip.open(tmp, "wt", encoding="utf-8", errors="surrogateescape", compresslevel=1) as f:
                f.write(json.dumps(tot[nom]) + "\n")
                for p in sorted(etat):
                    f.write(json.dumps([p] + etat[p], ensure_ascii=True) + "\n")
            os.replace(tmp, manifeste(nom))
        with open(TOTAUX + ".nouv", "w") as f:
            json.dump(tot, f, indent=1, sort_keys=True)
            f.write("\n")
        os.replace(TOTAUX + ".nouv", TOTAUX)
        if pem is not None:
            signee = poser_signature(pem, phrase)
            if signee:
                try:
                    os.unlink(ALARME)             # the owner has seen it and blesses the disk again
                except OSError:
                    pass
        else:
            try:
                os.unlink(SIG)
            except OSError:
                pass
        os.sync()
    finally:
        boite_rw(False)
    if not signee and not premiere:
        dire("EMPREINTE NON SIGNEE : la signature a echoue - le prochain demarrage le dira")
    for nom in pris:
        dire("%-6s sha256 %s  (%d entrees)" % (nom, tot[nom]["meta"], tot[nom]["entrees"]))
    dire("empreinte prise : %d fichier(s) relu(s), %.0f s%s" % (
        relus, time.monotonic() - t0, ", signee" if signee else " (NON signee)"))
    return 0


def comparer(nom, racine, complet=False):
    """(reference, differences) between a volume and its fingerprint.
    FAST PATH: the volume's total is computed again from the 2-second walk and
    compared with the one on the box - equal, nothing more is read. Different
    (or complet): the detail is loaded and every difference listed.
    reference is None when the volume has no fingerprint."""
    ref = totaux().get(nom)
    if not ref:
        return None, None
    if not complet and total_meta(racine) == ref["meta"]:
        return ref, []
    etat = parcourir(racine)
    ancien = charger(nom)
    if ancien is None:
        return ref, [("MODIFIE", "", "empreinte totale differente, et le detail (%s) n est pas lisible sur la boite" % (
            manifeste_chiffre(nom) if nom in CHIFFRES else manifeste(nom)))]
    diffs = []
    for p in sorted(set(ancien) - set(etat)):
        diffs.append(("SUPPRIME", p, ""))
    for p in sorted(set(etat) - set(ancien)):
        diffs.append(("AJOUTE", p, {"d": "repertoire", "l": "lien -> " + str(etat[p][8]), "f": "%d octets" % etat[p][4]}.get(etat[p][0], "")))
    a_lire = []
    for p in sorted(set(etat) & set(ancien)):
        v, r = ancien[p], etat[p]
        quoi = []
        if v[0] != r[0]:
            quoi.append("nature")
        if v[1] != r[1]:
            quoi.append("droits %o -> %o" % (v[1], r[1]))
        if v[2:4] != r[2:4]:
            quoi.append("proprietaire %s:%s -> %s:%s" % (v[2], v[3], r[2], r[3]))
        if r[0] == "l" and v[8] != r[8]:
            quoi.append("lien -> %s" % r[8])
        if r[0] == "f" and v[0] == "f":
            if v[4] != r[4]:
                quoi.append("taille %d -> %d" % (v[4], r[4]))
            elif v[5] != r[5]:
                quoi.append("date de modification")
            elif v[6] != r[6] or v[7] != r[7]:
                quoi.append("fichier remplace ou reecrit (inode / date de changement)")
            # GRUB's environment block: written in place by the boot loader
            # itself, before anything runs - its content is not ours to judge
            # (its rights, owner, size and dates still are)
            if complet and not quoi and p not in TOUJOURS_RELUS:
                a_lire.append(p)
        if quoi:
            diffs.append(("MODIFIE", p, ", ".join(quoi)))
    if a_lire:
        for p, h in hacher(racine, a_lire).items():
            if h != ancien[p][8]:
                diffs.append(("MODIFIE", p, "CONTENU different, dates et inode intacts (maquillage)"))
    if not diffs and not complet:
        diffs.append(("MODIFIE", "", "empreinte totale differente de celle de la boite, sans difference dans le detail : c est l empreinte de la boite qui a ete changee"))
    return ref, diffs


def texte_alerte(titre, diffs, tete):
    l = [titre, "empreinte du %s, %d entrees ; disque : %s ; sha256 attendu %s" % (
        (tete or {}).get("pris", "?"), (tete or {}).get("entrees", 0), (tete or {}).get("disque", "?"),
        (tete or {}).get("meta", "?")), "%d difference(s) :" % len(diffs)]
    l += ["  %-8s /%s%s" % (k, p, ("  (%s)" % d) if d else "") for k, p, d in diffs]
    return "\n".join(l) + "\n"


def alerter(titre, diffs, tete):
