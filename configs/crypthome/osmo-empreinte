#!/usr/bin/python3
# osmo-empreinte - THE SYSTEM DISK AGAINST ITS FINGERPRINT: has / been written
# to OUTSIDE a session, i.e. without the black box knowing?
#
# The system disk of an installed bench is in clear and read-only: the only
# writes it ever receives are the commits of validated sessions
# (osmo-racine-live), each one recorded in the black box. After every commit
# THE TOTAL SHA-256 of / and of /home is taken and kept on the box partition
# (empreinte.json; each record of the box also carries the totals it found),
# with its detail - one line per file: type, mode, owner, size, dates, inode,
# SHA-256 of its content. The detail of /home is ENCRYPTED there (the box is
# in clear, what lives in /home is not to be read from it): only its totals
# are kept as they are. At EVERY BOOT, BEFORE the /home passphrase is asked,
# the total of / is computed again (a walk of the disk: 2 seconds) and
# compared; only when it differs is the detail read, to say what changed.
# /home is compared the same way as soon as it is opened. A difference means that somebody wrote to the disk with
# the machine off (a live key, the disk in another machine): a RED WARNING
# fills the console, the black box gets an « alerte » record, and the /home
# passphrase is only asked after « OUI » has been typed.
#
#   osmo-empreinte prendre            take the fingerprint (after a commit;
#                                     only what changed is hashed again) AND
#                                     SIGN it: the /home passphrase, asked on
#                                     the terminal or --phrase-stdin
#   osmo-empreinte signature          the signature and its TPM anchor, in words
#   osmo-empreinte ancrer             anchor the signature's public key in the
#                                     TPM (once; the /home passphrase becomes
#                                     the TPM owner's secret)
#   osmo-empreinte phrase-changee     after a change of the /home passphrase
#   osmo-empreinte controler [--complet]   compare; --complet also reads every
#                                     file again (about 30 s for 18 GB)
#   osmo-empreinte demarrage          at boot, before unlock-home: fast
#                                     control, the warning, the question
#   osmo-empreinte fond               after boot, in the background, at idle
#                                     priority: the complete control
#   osmo-empreinte home               unlock-home, the volume just opened:
#                                     /home against its total
#   osmo-empreinte sceau              unlock-home, the volume just opened: the
#                                     totals on the box are the ones that were
#                                     sealed (red on the console otherwise)
#   osmo-empreinte boite-ancrer       THE END OF THE BLACK BOX HELD BY THE TPM:
#                                     an extend-only index, started at the
#                                     box's last record (passphrase)
#   osmo-empreinte boite-tete         the box against that index: nothing
#                                     removed at its end (no passphrase)
#   osmo-empreinte etats-ancrer       the same for the chain of the states
#                                     (done by itself at the next write)
#   osmo-empreinte etats-tete         that chain against its index
#   osmo-empreinte etats-signer       the past states of the system (in the
#                                     /home volume) chained and signed -
#                                     osmo-racine-live, after each write
#   osmo-empreinte etats-verifier     their chain: signature, links, and every
#                                     state read again (no passphrase)
#   osmo-empreinte test-alarme        THE TEST BUTTON: TRIP the alarm for real
#                                     (the witness volume, a mini volume
#                                     controlled like the disk, is corrupted).
#                                     PARTIAL: now, 10 seconds, then the volume
#                                     back to its original state. FULL: the
#                                     shutdown held, no guest root at the next
#                                     boot - only the owner ends it
#   osmo-empreinte rappel             desktop: only what the complete control
#                                     found after boot (the rest is said at
#                                     boot, on the console, never at login)
#
# TWO CONTROLS. The fast one (2-3 s, every boot, blocking) compares what the
# file system says of each file: a file replaced or edited changes its inode
# or its change time, which no ordinary tool can set. The complete one reads
# every file: it catches a change made with the dates and inodes forged.
#
# THE SIGNATURE. The fingerprint is in clear on the box partition: whoever
# rewrites the disk can rewrite it too. It is therefore SIGNED (Ed25519) with
# a key that is encrypted with the /home passphrase: no session, not even
# root with /home open, can sign - only somebody typing the passphrase. The
# boot checks the signature BEFORE asking the passphrase; « sceau », once
# /home is open, checks that the public key is the one pinned in /home.
#
# LIMITS, plainly. This runs FROM the disk it checks: an attacker who also
# rewrites this program (or unlock-home) silences it - only a measured boot
# (TPM) closes that. It catches everything short of that: a file dropped or
# edited from a live key, a package or a unit added, an initramfs rebuilt.
# A change you make yourself to the disk outside a session (overlayroot-chroot)
# is, rightly, such a difference: « osmo-racine-live actualiser » records it;
# otherwise take the fingerprint again (sudo osmo-empreinte prendre).
import gzip
import hashlib
import hmac
import json
import os
import secrets
import select
import stat
import subprocess
import sys
import time
from multiprocessing import Pool

BOITE = os.environ.get("OSMO_DIFFS_BASE", "/var/lib/osmo-diffs")
TOTAUX = os.path.join(BOITE, "empreinte.json")        # the totals: what the boot compares
SCEAU = os.path.join(BOITE, "empreinte.hmac")
# left by « extinction » when the checksums differed at shutdown: the next
# boot is an alert whatever the disk looks like by then (no guest session);
# only a fingerprint taken with the /home passphrase removes it
ALARME = os.path.join(BOITE, "alarme")
# THE WITNESS VOLUME (« test-alarme »). A mini volume of its own - a 4 MiB
# ext4 image kept on the box partition, mounted read-only on /run/osmo-temoin -
# whose fingerprint is taken, signed and controlled EXACTLY like the system
# disk's. It holds nothing: it is there to be CORRUPTED by the test, so that
# the alarm trips for real without the system disk being touched.
TEMOIN_IMG = os.path.join(BOITE, "temoin.img")
TEMOIN_MNT = os.environ.get("OSMO_EMPREINTE_TEMOIN", "/run/osmo-temoin")
TEMOIN_ESSAI = os.path.join(BOITE, "temoin.essai")     # a test is in progress (when it was started)
TEMOIN_ORIGINE = os.path.join(BOITE, "temoin.origine")  # the volume as it was created: put back after a test
RACINE = os.environ.get("OSMO_EMPREINTE_RACINE") or ("/media/root-ro" if os.path.ismount("/media/root-ro") else "/")
HOME_DISQUE = os.environ.get("OSMO_EMPREINTE_HOME", "/media/home-ro")
CLE = ".osmo-diffs/sceau"
ALERTE = os.environ.get("OSMO_EMPREINTE_ALERTE", "/run/osmo-alerte")
SANS_HOME = os.environ.get("OSMO_EMPREINTE_SANS_HOME", "/run/osmo-sans-home")
FOND_FAIT = "/run/osmo-empreinte-complet"
# the seal's key, kept in RAM (root only) from the moment /home is open: at
# shutdown the mounts of /home may already be gone when the fingerprint is
# taken - without the key it would be left UNSEALED, and the next boot would
# cry that it is not the one this machine sealed
CLE_RAM = os.environ.get("OSMO_EMPREINTE_CLE_RAM", "/run/osmo-empreinte-cle")
# THE SIGNATURE. The totals are SIGNED (Ed25519). The private key is IN THE
# /home VOLUME, ENCRYPTED WITH THE /home PASSPHRASE (scrypt, 1 GiB of memory
# per try - the cost of the volume's own key slot): it only exists, in memory,
# while that passphrase is being typed for a write. It is NOT on the box any
# more: that partition is in clear, and a key encrypted there with PBKDF2 let
# whoever holds the disk try /home passphrases far cheaper than through LUKS
# (a key left on the box by an earlier version moves at the next signature). Nothing a session holds - not
# root, not an open /home - can sign: a disk written to without the
# passphrase cannot get a valid fingerprint, and the boot says so BEFORE the
# passphrase is asked. The public key is also pinned in the encrypted /home
# (and, option, in the TPM): a key pair swapped on the box is denounced.
SIG = os.path.join(BOITE, "empreinte.sig")
SIG_PUB = os.path.join(BOITE, "signature.pub")
SIG_CLE = os.path.join(BOITE, "signature.cle")        # earlier versions only: PBKDF2, in clear partition
SIG_CLE_HOME = ".osmo-diffs/signature.cle"            # in the /home volume
MAGIE = b"OSMOSIG2"
PUB_HOME = ".osmo-diffs/signature.pub"
# THE ANCHOR (TPM 2.0, « osmo-empreinte ancrer »). The SHA-256 of the public
# key is written in a TPM NV index anybody can READ but only the TPM's owner
# can write or remove - and the owner's secret is derived from the /home
# passphrase (PBKDF2, salt on the box): it is never stored. A session, even
# root with /home open, cannot swap the key pair on the box AND the anchor.
# The boot reads the anchor BEFORE the passphrase is asked. (The TPM can still
# be cleared from the firmware setup, with the machine in hand: the anchor
# then is gone, which the pin in /home denounces.)
NV = os.environ.get("OSMO_EMPREINTE_NV", "0x1800A50")
ANCRE_SEL = os.path.join(BOITE, "ancre.sel")
TPM_ENV = dict(os.environ, TPM2TOOLS_TCTI="device:/dev/tpmrm0")
TEST = os.environ.get("OSMO_DIFFS_SANS_MONTAGE") == "1"
# never part of the fingerprint: the journal of a commit, the way back, the
# session's own log (written to the disk outside a commit, on purpose)
EXCLUS = {".osmo-valider", ".osmo-retour", "lost+found", "var/log/osmo-session.log", "var/log/osmo-session.log.nouv"}
TOUJOURS_RELUS = {"boot/grub/grubenv"}
CONSOLE = "/dev/console"
ROUGE, FIN = "\033[1;31m", "\033[0m"


def dire(*a):
    print("osmo-empreinte :", *a, flush=True)


def parcourir(racine):
    """Every entry of the file system at racine (not what is mounted in it):
    {path: [type, mode, uid, gid, size, mtime_ns, ctime_ns, inode, hash]}."""
    dev = os.lstat(racine).st_dev
    out, pile = {}, [""]
    while pile:
        rel = pile.pop()
        try:
            entrees = list(os.scandir(os.path.join(racine, rel) if rel else racine))
        except OSError:
            continue
        for e in entrees:
            p = (rel + "/" + e.name) if rel else e.name
            if p in EXCLUS:
                continue
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            m = st.st_mode
            t = ("d" if stat.S_ISDIR(m) else "f" if stat.S_ISREG(m) else "l" if stat.S_ISLNK(m) else "o")
            h = ""
            if t == "l":
                try:
                    h = os.readlink(os.path.join(racine, p))
                except OSError:
                    h = "?"
            out[p] = [t, stat.S_IMODE(m), st.st_uid, st.st_gid, st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_ino, h]
            if t == "d" and st.st_dev == dev:
                pile.append(p)
    return out


def _sha(chemin):
    h = hashlib.sha256()
    try:
        with open(chemin, "rb", buffering=0) as f:
            while True:
                b = f.read(1 << 20)
                if not b:
                    break
                h.update(b)
        return h.hexdigest()
    except OSError as e:
        return "illisible:%s" % e.errno


def hacher(racine, chemins):
    """{path: sha256} of the regular files given, four at a time."""
    if not chemins:
        return {}
    with Pool(min(4, os.cpu_count() or 1)) as pool:
        return dict(zip(chemins, pool.imap(_sha, [os.path.join(racine, p) for p in chemins], chunksize=64)))


def manifeste(nom):
    return os.path.join(BOITE, "empreinte-%s.json.gz" % nom)


# THE DETAIL OF /home IS CONFIDENTIAL: the paths, sizes and SHA-256 of what
# lives in the encrypted volume. The box partition is in clear: only the
# TOTALS of /home are kept there as they are; its detail is ENCRYPTED
# (AES-256, then HMAC-SHA-256) with the seal's key, which lives in /home.
# Without /home open it cannot be read - and it is not needed: /home is only
# compared once it is open. No key: no detail is written, the total alone.
CHIFFRES = {"home"}


def manifeste_chiffre(nom):
    return os.path.join(BOITE, "empreinte-%s.detail" % nom)


def _cles_detail(cle):
    return (hashlib.sha256(b"osmo-empreinte detail chiffrement\0" + cle).hexdigest(),
            hashlib.sha256(b"osmo-empreinte detail sceau\0" + cle).digest())


def _openssl(sens, donnees, passe):
    r = subprocess.run(["openssl", "enc", sens, "-aes-256-ctr", "-pbkdf2", "-iter", "1000", "-pass", "env:OSMO_DETAIL"],
                       input=donnees, capture_output=True, env=dict(os.environ, OSMO_DETAIL=passe))
    if r.returncode != 0:
        raise OSError("openssl enc %s : %s" % (sens, r.stderr.decode(errors="replace").strip()[:200]))
    return r.stdout


def chiffrer_detail(clair, cle):
    passe, mac = _cles_detail(cle)
    c = _openssl("-e", clair, passe)
    return hmac.new(mac, c, hashlib.sha256).digest() + c


def dechiffrer_detail(brut, cle):
    passe, mac = _cles_detail(cle)
    if len(brut) < 48 or not hmac.compare_digest(brut[:32], hmac.new(mac, brut[32:], hashlib.sha256).digest()):
        raise ValueError("detail chiffre : sceau faux")
    return _openssl("-d", brut[32:], passe)


def effacer_clair(nom):
    """A detail left in clear by an earlier version: overwritten, then removed
    (on an SSD the old blocks may outlive this - said in the documentation)."""
    for f in (manifeste(nom), manifeste(nom) + ".nouv"):
        if os.path.exists(f):
            try:
                subprocess.run(["shred", "-u", "-n", "1", f], capture_output=True, timeout=300)
            except (OSError, subprocess.TimeoutExpired):
                pass
            try:
                os.unlink(f)
            except OSError:
                pass


def couches():
    """The volumes that have a fingerprint: the system disk, and /home when it is open."""
    c = {"racine": RACINE}
    if TEST or os.path.ismount(HOME_DISQUE):
        c["home"] = HOME_DISQUE
    if os.path.ismount(TEMOIN_MNT) or (TEST and os.path.isdir(TEMOIN_MNT)):
        c["temoin"] = TEMOIN_MNT              # the witness volume of the alarm's test
    return c


def temoin_monter():
    """The witness volume, read-only, as soon as anything of this program runs
    (the boot's control is the first)."""
    if TEST or os.geteuid() != 0 or not os.path.exists(TEMOIN_IMG) or os.path.ismount(TEMOIN_MNT):
        return
    try:
        os.makedirs(TEMOIN_MNT, mode=0o755, exist_ok=True)
        subprocess.run(["mount", "-o", "loop,ro,noatime", TEMOIN_IMG, TEMOIN_MNT], capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        pass


def temoin_ecrire(faire):
    """The witness volume remounted read-write for the time of faire(dir).
    True when it went through."""
    if TEST:
        os.makedirs(TEMOIN_MNT, exist_ok=True)
        faire(TEMOIN_MNT)
        return True
    subprocess.run(["umount", TEMOIN_MNT], capture_output=True)
    if not boite_rw(True):
        temoin_monter()
        return False
    ok = False
    try:
        os.makedirs(TEMOIN_MNT, mode=0o755, exist_ok=True)
        if subprocess.run(["mount", "-o", "loop,rw,noatime", TEMOIN_IMG, TEMOIN_MNT], capture_output=True).returncode == 0:
            try:
                faire(TEMOIN_MNT)
                ok = True
            finally:
                os.sync()
                subprocess.run(["umount", TEMOIN_MNT], capture_output=True)
    finally:
        boite_rw(False)
    temoin_monter()
    return ok and (TEST or os.path.ismount(TEMOIN_MNT))


def temoin_creer():
    """A fresh witness volume (the old one, corrupted by a test, is thrown
    away). Its fingerprint is taken by the caller, with the passphrase."""
    if not TEST:
        subprocess.run(["umount", TEMOIN_MNT], capture_output=True)
        if not boite_rw(True):
            return False
        try:
            with open(TEMOIN_IMG + ".nouv", "wb") as f:
                f.truncate(4 << 20)
            if subprocess.run(["mkfs.ext4", "-q", "-F", "-L", "osmo-temoin", "-m", "0", TEMOIN_IMG + ".nouv"],
                              capture_output=True).returncode != 0:
                os.unlink(TEMOIN_IMG + ".nouv")
                return False
            os.replace(TEMOIN_IMG + ".nouv", TEMOIN_IMG)
            os.sync()
        finally:
            boite_rw(False)
    else:
        import shutil
        shutil.rmtree(TEMOIN_MNT, ignore_errors=True)

    def remplir(d):
        with open(os.path.join(d, "LISEZ-MOI"), "w") as f:
            f.write("Volume temoin du poste securise osmo-operator.\n"
                    "Il ne contient rien d utile : le test de l alarme le corrompt expres,\n"
                    "pour verifier que l alarme se declenche. Cree le %s.\n" % time.strftime("%F %T"))
        with open(os.path.join(d, "temoin.bin"), "wb") as f:
            f.write(secrets.token_bytes(65536))
    if not temoin_ecrire(remplir):
        return False
    return temoin_copier(TEMOIN_IMG, TEMOIN_ORIGINE)


def temoin_copier(de, vers):
    """One image over the other, on the box (TEST: the directory itself)."""
    import shutil
    if TEST:
        shutil.rmtree(vers if vers != TEMOIN_IMG else TEMOIN_MNT, ignore_errors=True)
        shutil.copytree(de if de != TEMOIN_IMG else TEMOIN_MNT, vers if vers != TEMOIN_IMG else TEMOIN_MNT, symlinks=True)
        return True                           # (a directory copy: new inodes and dates, unlike the image)
    monte = vers == TEMOIN_IMG
    if monte:
        subprocess.run(["umount", TEMOIN_MNT], capture_output=True)
    if not boite_rw(True):
        temoin_monter()
        return False
    try:
        shutil.copyfile(de, vers + ".nouv")
        os.replace(vers + ".nouv", vers)
        os.sync()
        ok = True
    except OSError:
        ok = False
    finally:
        boite_rw(False)
    temoin_monter()
    return ok


def temoin_restaurer():
    """AFTER A TEST: the witness volume back to its ORIGINAL STATE - the image
    kept when it was created, byte for byte. It then matches the fingerprint
    it had before the test, without anything being taken again."""
    if not (TEST or os.path.exists(TEMOIN_ORIGINE)):
        return False
    return temoin_copier(TEMOIN_ORIGINE, TEMOIN_IMG)


# The total of a volume: osmo-total (find, sort, sha256sum - 4 seconds for
# 450 000 entries; the same walk in Python takes 8). ONE text for it, which
# the initramfs runs too when the boot is measured (osmo-tpm).
TOTAL = os.environ.get("OSMO_TOTAL", "/usr/local/sbin/osmo-total")


def total_meta(racine):
    """ONE SHA-256 for a whole volume, from what the file system says of every entry."""
    r = subprocess.run([TOTAL, racine], capture_output=True, text=True)
    return r.stdout.strip()


def total_contenu(etat):
    """ONE SHA-256 for the CONTENT of a whole volume: every file's own SHA-256."""
    h = hashlib.sha256()
    for p in sorted(etat):
        if etat[p][0] == "f":
            h.update(json.dumps([p, etat[p][8]], ensure_ascii=True).encode() + b"\n")
    return h.hexdigest()


def totaux():
    try:
        with open(TOTAUX) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def charger(nom):
    try:
        if nom in CHIFFRES:
            cle = cle_sceau()
            if cle is None:
                return None
            with open(manifeste_chiffre(nom), "rb") as f:
                lignes = gzip.decompress(dechiffrer_detail(f.read(), cle)).decode("utf-8", "surrogateescape").split("\n")
            return {r[0]: r[1:] for r in (json.loads(l) for l in lignes[1:] if l)}
        with gzip.open(manifeste(nom), "rt", encoding="utf-8", errors="surrogateescape") as f:
            json.loads(f.readline())
            return {r[0]: r[1:] for r in (json.loads(l) for l in f)}
    except (OSError, ValueError, EOFError):
        return None


def boite_rw(oui):
    if TEST:
        return True
    return subprocess.run(["mount", "-o", "remount,%s" % ("rw" if oui else "ro"), BOITE],
                          capture_output=True).returncode == 0


def cle_sceau(creer=False):
    """The seal's key, from the encrypted /home (None when /home is closed)."""
    for chemin in (os.path.join(HOME_DISQUE, CLE), CLE_RAM if TEST else os.path.join("/home", CLE), CLE_RAM):
        try:
            with open(chemin, "rb") as f:
                k = f.read().strip()
            if len(k) >= 32:
                if chemin != CLE_RAM:
                    garder_cle(k)
                return k
        except OSError:
            pass
    if not creer or not (TEST or os.path.ismount(HOME_DISQUE)):
        return None
    # written on the volume itself (not in the RAM layer of /home, which a
    # wiped session would take with it)
    k = secrets.token_hex(32).encode()
    rw = TEST or subprocess.run(["mount", "-o", "remount,rw", HOME_DISQUE], capture_output=True).returncode == 0
    try:
        d = os.path.join(HOME_DISQUE, os.path.dirname(CLE))
        os.makedirs(d, mode=0o700, exist_ok=True)
        with open(os.open(os.path.join(HOME_DISQUE, CLE), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            f.write(k + b"\n")
            f.flush()
            os.fsync(f.fileno())
        garder_cle(k)
    except OSError:
        k = None
    finally:
        if rw and not TEST:
            subprocess.run(["mount", "-o", "remount,ro", HOME_DISQUE], capture_output=True)
    return k


def garder_cle(k):
    try:
        with open(os.open(CLE_RAM, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            f.write(k + b"\n")
    except OSError:
        pass


def message():
    """What is signed: the totals, and where the box is copied (osmo-diffs
    copie-poser) - a destination changed by hand breaks the signature."""
    with open(TOTAUX, "rb") as f:
        m = f.read()
    try:
        with open(os.path.join(BOITE, "copie.conf"), "rb") as f:
            m += b"\0copie\0" + f.read()
    except OSError:
        pass
    return m


def _memfd(donnees):
    fd = os.memfd_create("osmo-empreinte")
    os.write(fd, donnees)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def _ossl(args, entree=None, fds=()):
    return subprocess.run(["openssl"] + args, input=entree, capture_output=True, pass_fds=fds)


def phrase_luks(phrase):
    """The /home LUKS2 volume accepts this passphrase."""
    if TEST:
        return True
    uuid = ""
    try:
        with open("/etc/default/crypthome") as f:
            for l in f:
                if l.startswith("CRYPTHOME_UUID="):
                    uuid = l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    dev = "/dev/disk/by-uuid/" + uuid
    if not uuid or not os.path.exists(dev):
        return False
    return subprocess.run(["cryptsetup", "open", "--test-passphrase", "--key-file=-", dev],
                          input=phrase, capture_output=True).returncode == 0


def _crypthome(nom):
    try:
        with open("/etc/default/crypthome") as f:
            for l in f:
                if l.startswith(nom + "="):
                    return l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def _volume(ecrire=False):
    """(directory, done()) : the /home VOLUME itself (never its RAM layer),
    read-only or read-write. Its usual mount; when that one is already gone
    (a shutdown) the open LUKS mapping is mounted aside for the time needed.
    (None, done) when the volume cannot be reached."""
    rien = (None, lambda: None)
    if TEST:
        return HOME_DISQUE, (lambda: None)
    if os.path.ismount(HOME_DISQUE):
        if not ecrire:
            return HOME_DISQUE, (lambda: None)
        if subprocess.run(["mount", "-o", "remount,rw", HOME_DISQUE], capture_output=True).returncode != 0:
            return rien

        def ro():
            os.sync()
            for _ in range(5):
                if subprocess.run(["mount", "-o", "remount,ro", HOME_DISQUE], capture_output=True).returncode == 0:
                    break
                time.sleep(1)
        return HOME_DISQUE, ro
    nom = _crypthome("CRYPTHOME_NAME")
    dev = "/dev/mapper/" + nom
    if not nom or not os.path.exists(dev):
        return rien
    # the normal opening: /home IS the volume, mounted read-write
    monte = _crypthome("CRYPTHOME_MOUNT") or "/home"
    r = subprocess.run(["findmnt", "-fno", "SOURCE", monte], capture_output=True, text=True)
    if r.returncode == 0 and r.stdout.strip() and os.path.realpath(r.stdout.strip()) == os.path.realpath(dev):
        return monte, (lambda: os.sync())
    import tempfile
    d = tempfile.mkdtemp(prefix="osmo-empreinte-", dir="/run")
    # read-only when reading; but a volume still mounted read-write somewhere
    # (the kept copy of the mounts, at shutdown) only accepts the same way
    for opt in (("rw",) if ecrire else ("ro", "rw")):
        if subprocess.run(["mount", "-o", opt, dev, d], capture_output=True).returncode == 0:
            break
    else:
        os.rmdir(d)
        return rien

    def demonter():
        os.sync()
        subprocess.run(["umount", d], capture_output=True)
        try:
            os.rmdir(d)
        except OSError:
            pass
    return d, demonter


def cle_volume_lire():
    """The encrypted signing key as the /home volume holds it; None when there
    is none there, or no volume at hand."""
    d, fin = _volume()
    if d is None:
        return None
    try:
        with open(os.path.join(d, SIG_CLE_HOME), "rb") as f:
            return f.read()
    except OSError:
        return None
    finally:
        fin()


def cle_volume_ecrire(blob):
    d, fin = _volume(ecrire=True)
    if d is None:
        return False
    try:
        cible = os.path.join(d, SIG_CLE_HOME)
        os.makedirs(os.path.dirname(cible), mode=0o700, exist_ok=True)
        with open(os.open(cible + ".nouv", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400), "wb") as f:
            f.write(blob)
            f.flush()
            os.fsync(f.fileno())
        os.replace(cible + ".nouv", cible)
        return True
    except OSError:
        return False
    finally:
        fin()


def _kek(phrase, sel):
    """The key that encrypts the signing key: scrypt, 1 GiB of memory a try
    (what the LUKS2 key slot of /home costs with argon2id)."""
    return hashlib.scrypt(phrase, salt=b"osmo-empreinte signature\0" + sel,
                          n=2 ** (14 if TEST else 20), r=8, p=1, maxmem=2 ** 31 - 1, dklen=32)


def sceller_cle(pem, phrase):
    sel = os.urandom(16)
    return MAGIE + sel + chiffrer_detail(pem, _kek(phrase, sel))


def desceller(blob, phrase):
    """Anything sealed by sceller_cle; None for a wrong passphrase or a file
    that was altered."""
    if not blob.startswith(MAGIE) or len(blob) < 72:
        return None
    try:
        return dechiffrer_detail(blob[24:], _kek(phrase, blob[8:24]))
    except (ValueError, OSError, MemoryError):
        return None


def desceller_cle(blob, phrase):
    pem = desceller(blob, phrase)
    return pem if pem is not None and pem.startswith(b"-----BEGIN PRIVATE KEY-----") else None


def coffre(sens, fichier=None):
    """« coffre-sceller » / « coffre-desceller FILE » (osmo-tpm): what the
    measured boot keeps for sealing again - seed or sentence, PIN, reference
    PCRs - under the /home passphrase, like the signing key. Standard input:
    the passphrase on the first line, then (sceller) the content."""
    phrase = sys.stdin.buffer.readline().rstrip(b"\n")
    if not phrase:
        return 1
    if sens == "sceller":
        sys.stdout.buffer.write(sceller_cle(sys.stdin.buffer.read(), phrase))
        return 0
    try:
        with open(fichier, "rb") as f:
            clair = desceller(f.read(), phrase)
    except OSError:
        clair = None
    if clair is None:
        return 1
    sys.stdout.buffer.write(clair)
    return 0


def oter_cle_boite():
    """The key an earlier version left on the box (box read-write): written
    over, then removed. On an SSD the old blocks may outlive this - changing
    the /home passphrase is what really closes it."""
    try:
        n = os.path.getsize(SIG_CLE)
        os.chmod(SIG_CLE, 0o600)
        with open(SIG_CLE, "r+b") as f:
            f.write(os.urandom(n))
            f.flush()
            os.fsync(f.fileno())
        os.unlink(SIG_CLE)
    except OSError:
        pass


def cle_privee(phrase):
    """The signing key (PEM), from the /home passphrase; None when it is wrong
    or the key cannot be reached. No key pair yet: made now - only for a
    passphrase /home accepts."""
    blob = cle_volume_lire()
    if blob and blob.startswith(MAGIE):
        return desceller_cle(blob, phrase)
    if os.path.exists(SIG_CLE):
        r = _ossl(["enc", "-d", "-aes-256-cbc", "-pbkdf2", "-iter", "600000", "-in", SIG_CLE, "-pass", "stdin"], phrase + b"\n")
        return r.stdout if r.returncode == 0 and r.stdout.startswith(b"-----BEGIN PRIVATE KEY-----") else None
    if os.path.exists(SIG_PUB):
        return None                           # a key pair exists and its private half is out of reach: never a new one
    if not phrase_luks(phrase):
        return None
    r = _ossl(["genpkey", "-algorithm", "ed25519"])
    return r.stdout if r.returncode == 0 and r.stdout.startswith(b"-----BEGIN PRIVATE KEY-----") else None


def poser_signature(pem, phrase):
    """Box read-write: the signature of the totals; a new key pair is written
    with it (private key encrypted with the passphrase), its public key pinned
    in the /home volume."""
    k = _memfd(pem)
    m = _memfd(message())
    try:
        r = _ossl(["pkeyutl", "-sign", "-inkey", "/proc/self/fd/%d" % k, "-rawin", "-in", "/proc/self/fd/%d" % m], fds=(k, m))
        if r.returncode != 0 or len(r.stdout) != 64:
            return False
        with open(SIG + ".nouv", "wb") as f:
            f.write(r.stdout)
        os.replace(SIG + ".nouv", SIG)
        nouvelle = not os.path.exists(SIG_PUB)
        blob = cle_volume_lire()
        if not (blob and blob.startswith(MAGIE)):
            # the private key goes INTO the /home volume (a new pair, or one an
            # earlier version kept on the box, which then leaves it)
            if cle_volume_ecrire(sceller_cle(pem, phrase)):
                if os.path.exists(SIG_CLE):
                    oter_cle_boite()
            elif nouvelle:
                return False                  # nowhere to keep the key
        if nouvelle:
            os.lseek(k, 0, os.SEEK_SET)
            pub = _ossl(["pkey", "-in", "/proc/self/fd/%d" % k, "-pubout"], fds=(k,))
            if pub.returncode != 0:
                return False
            with open(SIG_PUB + ".nouv", "wb") as f:
                f.write(pub.stdout)
            os.replace(SIG_PUB + ".nouv", SIG_PUB)
            epingler(pub.stdout)
        try:
            os.unlink(SCEAU)                  # the HMAC seal of earlier versions
        except OSError:
            pass
        return True
    finally:
        os.close(k)
        os.close(m)


def epingler(pub):
    """The public key, pinned in the /home volume (not in its RAM layer)."""
    if not (TEST or os.path.ismount(HOME_DISQUE)):
        return
    cible = os.path.join(HOME_DISQUE, PUB_HOME)
    if os.path.exists(cible):
        return                                # never replaced here: a difference is an alert
    rw = TEST or subprocess.run(["mount", "-o", "remount,rw", HOME_DISQUE], capture_output=True).returncode == 0
    try:
        os.makedirs(os.path.dirname(cible), mode=0o700, exist_ok=True)
        with open(os.open(cible, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            f.write(pub)
            f.flush()
            os.fsync(f.fileno())
    except OSError:
        pass
    finally:
        if rw and not TEST:
            subprocess.run(["mount", "-o", "remount,ro", HOME_DISQUE], capture_output=True)


def signature_ok():
    """True / False: the totals carry a valid signature. None: never signed yet."""
    if not os.path.exists(SIG_PUB):
        return None
    if not os.path.exists(SIG) or not os.path.exists(TOTAUX):
        return False
    m = _memfd(message())
    try:
        r = _ossl(["pkeyutl", "-verify", "-pubin", "-inkey", SIG_PUB, "-rawin", "-in", "/proc/self/fd/%d" % m, "-sigfile", SIG], fds=(m,))
        return r.returncode == 0
    finally:
        os.close(m)


# ── THE STATES OF THE SYSTEM, CHAINED AND SIGNED ────────────────────────────
# What each write replaced (the past states, put away in the /home volume by
# osmo-racine-live: .osmo-retour/systeme/ID) is a history anybody with /home
# open and root could rewrite. So each state gets an identifier computed on
# its CONTENT and on the state BEFORE it, like a git commit:
#     empreinte = SHA-256 of the state's manifest (every path: nature, rights,
#                 owner, size or target, SHA-256 of its content)
#     maillon   = SHA-256( maillon of the previous state, ID, empreinte )
# in the file CHAINE (one line per state: ID empreinte maillon), and the whole
# file is SIGNED (CHAINE.sig) with the key of the fingerprint - the one only
# the /home passphrase unlocks. A state is hashed ONCE, when the write that
# made it is being validated; afterwards only read again and compared. A state
# changed, replaced or slipped in afterwards no longer matches its line, and
# the lines cannot be redone without the passphrase.
# NOT covered: going back to an OLDER chain with its own valid signature, and
# removing the newest states with it (nothing outside /home holds the head).
ETATS = os.path.join(".osmo-retour", "systeme")


def etats_rep():
    force = os.environ.get("OSMO_EMPREINTE_ETATS")
    if force:
        return force
    for base in (HOME_DISQUE, "/home"):
        if os.path.ismount(base) and os.path.isdir(os.path.join(base, ".osmo-retour")):
            return os.path.join(base, ETATS)
    return None


def etat_empreinte(d):
    """SHA-256 of the manifest of one state (its whole directory)."""
    lignes = []
    for rep, dirs, fichiers in os.walk(d):
        dirs.sort()
        for n in sorted(dirs + fichiers):
            p = os.path.join(rep, n)
            rel = p[len(d):]
            try:
                s = os.lstat(p)
            except OSError:
                continue
            if stat.S_ISLNK(s.st_mode):
                quoi = "l %s" % os.readlink(p)
            elif stat.S_ISDIR(s.st_mode):
                quoi = "d"
            elif stat.S_ISREG(s.st_mode):
                quoi = "f %d %s" % (s.st_size, _sha(p))
            else:
                quoi = "o %o" % stat.S_IFMT(s.st_mode)
            lignes.append("%o %d:%d %s\0%s" % (stat.S_IMODE(s.st_mode), s.st_uid, s.st_gid, quoi, rel))
    return hashlib.sha256("\n".join(lignes).encode("utf-8", "surrogateescape")).hexdigest()


def maillon(prec, ident, emp):
    return hashlib.sha256(("%s %s %s" % (prec, ident, emp)).encode()).hexdigest()


def chaine_lire(g):
    """[(ID, empreinte, maillon)] and the raw bytes; ([], b'') when there is none."""
    try:
        with open(os.path.join(g, "CHAINE"), "rb") as f:
            brut = f.read()
    except OSError:
        return [], b""
    return [tuple(l.split()) for l in brut.decode("ascii", "replace").splitlines() if len(l.split()) == 3], brut


def chaine_signee(g, brut):
    """True / False: CHAINE carries a valid signature of the fingerprint's key."""
    sig = os.path.join(g, "CHAINE.sig")
    if not os.path.exists(SIG_PUB) or not os.path.exists(sig):
        return False
    m = _memfd(brut)
    try:
        return _ossl(["pkeyutl", "-verify", "-pubin", "-inkey", SIG_PUB, "-rawin", "-in", "/proc/self/fd/%d" % m,
                      "-sigfile", sig], fds=(m,)).returncode == 0
    finally:
        os.close(m)


def chaine_liens(lignes):
    """The first line whose link does not follow from the one before, or None."""
    prec = "origine"
    for ident, emp, m in lignes:
        if maillon(prec, ident, emp) != m:
            return ident
        prec = m
    return None


def etats_signer(phrase, ceux=()):
    """osmo-racine-live ranger, the volume writable: the states NAMED (those
    this very write has just put away) are hashed and added, and the chain is
    signed again. A state found there that nobody named stays out of the
    chain: slipped in without the passphrase, it must not get blessed by the
    next signature."""
    g = etats_rep()
    if not g or not os.path.isdir(g):
        return 0
    pem = cle_privee(phrase) if phrase else None
    if pem is None:
        dire("etats du systeme : phrase de /home refusee ou absente - la chaine n est PAS signee")
        return 1
    lignes, brut = chaine_lire(g)
    if lignes and (not chaine_signee(g, brut) or chaine_liens(lignes)):
        dire("etats du systeme : LA CHAINE EXISTANTE N EST PAS VALIDE (signature ou maillon) - rien n y est ajoute ; "
             "osmo-empreinte etats-verifier")
        return 3
    connus = {l[0] for l in lignes}
    prec = lignes[-1][2] if lignes else "origine"
    neufs = 0
    for ident in sorted(os.listdir(g)):
        d = os.path.join(g, ident)
        if ident.startswith(".") or ident in connus or ident not in ceux or not os.path.exists(os.path.join(d, "FAIT")):
            continue
        emp = etat_empreinte(d)
        prec = maillon(prec, ident, emp)
        lignes.append((ident, emp, prec))
        neufs += 1
    brut = "".join("%s %s %s\n" % l for l in lignes).encode()
    k, m = _memfd(pem), _memfd(brut)
    try:
        r = _ossl(["pkeyutl", "-sign", "-inkey", "/proc/self/fd/%d" % k, "-rawin", "-in", "/proc/self/fd/%d" % m], fds=(k, m))
    finally:
        os.close(k)
        os.close(m)
    if r.returncode != 0 or len(r.stdout) != 64:
        dire("etats du systeme : signature en echec - la chaine n est PAS mise a jour")
        return 1
    try:
        for nom, donnees in (("CHAINE", brut), ("CHAINE.sig", r.stdout)):
            with open(os.open(os.path.join(g, "." + nom + ".nouv"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
                f.write(donnees)
                f.flush()
                os.fsync(f.fileno())
        # the signature first: a cut between the two leaves an old chain with
        # a newer signature - said « not signed », never silently accepted
        os.replace(os.path.join(g, ".CHAINE.sig.nouv"), os.path.join(g, "CHAINE.sig"))
        os.replace(os.path.join(g, ".CHAINE.nouv"), os.path.join(g, "CHAINE"))
        os.sync()
    except OSError as e:
        dire("etats du systeme : chaine non ecrite (%s)" % e)
        return 1
    dire("etats du systeme : %d etat(s) ajoute(s) a la chaine, %d en tout, signee ; tete %s" % (
        neufs, len(lignes), (lignes[-1][2][:16] if lignes else "-")))
    etats_tete_suivre(g, lignes, lignes[len(lignes) - neufs:] if neufs else [], phrase)
    return 0


def etats_verifier():
    """No passphrase: the signature of the chain, its links, and every state
    still present read again and compared with its line. 0: intact."""
    g = etats_rep()
    if not g or not os.path.isdir(g):
        dire("etats du systeme : aucun dans le volume de /home (ou /home ferme)")
        return 0
    lignes, brut = chaine_lire(g)
    presents = sorted(i for i in os.listdir(g) if not i.startswith(".") and os.path.exists(os.path.join(g, i, "FAIT")))
    if not lignes:
        dire("etats du systeme : %d etat(s), PAS ENCORE de chaine (elle est faite a la prochaine ecriture validee)" % len(presents))
        return 2 if presents else 0
    rc = 0
    if not chaine_signee(g, brut):
        sys.stdout.write(ROUGE + "CHAINE NON SIGNEE par la phrase de /home (ou signature fausse)\n" + FIN)
        rc = 3
    casse = chaine_liens(lignes)
    if casse:
        sys.stdout.write(ROUGE + "MAILLON ROMPU a l etat %s\n" % casse + FIN)
        rc = 3
    connus = {l[0] for l in lignes}
    for ident, emp, m in lignes:
        d = os.path.join(g, ident)
        if not os.path.isdir(d):
            print("%s  %s  retire (defait, ou plus ancien que ce qui est garde)" % (ident, m[:12]))
        elif etat_empreinte(d) == emp:
            print("%s  %s  intact" % (ident, m[:12]))
        else:
            sys.stdout.write(ROUGE + "%s  %s  MODIFIE APRES COUP\n" % (ident, m[:12]) + FIN)
            rc = 3
    for ident in presents:
        if ident not in connus:
            sys.stdout.write(ROUGE + "%s  %s  HORS CHAINE (ajoute sans la phrase, ou pas encore signe)\n" % (ident, "-" * 12) + FIN)
            rc = rc or 2
    t = etats_tete(g, lignes)
    if t == 3:
        rc = 3
    if rc == 0:
        dire("etats du systeme : chaine signee et intacte, %d etat(s), tete %s%s" % (
            len(lignes), lignes[-1][2][:16], "" if t == 0 else " (fin non tenue par le TPM)"))
    return rc


def tpm(args, secrets=()):
    """A tpm2-tools command; secrets are handed over as file descriptors,
    never on the command line."""
    fds = [_memfd(x) for x in secrets]
    try:
        # « @N » : secret N as an authorisation (file:...) ; « =N » : as a plain input file
        a = [("file:/proc/self/fd/%d" % fds[int(x[1:])]) if x[:1] == "@" and x[1:].isdigit()
             else ("/proc/self/fd/%d" % fds[int(x[1:])]) if x[:1] == "=" and x[1:].isdigit() else x for x in args]
        return subprocess.run(a, capture_output=True, env=TPM_ENV, pass_fds=tuple(fds))
    except OSError:
        return None
    finally:
        for fd in fds:
            os.close(fd)


def tpm_present():
    return os.path.exists("/dev/tpmrm0") and subprocess.run(["sh", "-c", "command -v tpm2_nvread"], capture_output=True).returncode == 0


def ancre_lue():
    """The 32 bytes of the anchor; None when this machine has none."""
    if not tpm_present():
        return None
    r = tpm(["tpm2_nvread", NV, "-C", NV, "-s", "32"])
    return r.stdout if r is not None and r.returncode == 0 and len(r.stdout) == 32 else None


# ── THE HEAD OF THE BLACK BOX, IN THE TPM ───────────────────────────────────
# The chain of the box shows a record changed or removed in the middle, never
# a TRUNCATED END: the last records deleted leave a valid chain. Nothing on a
# disk can hold the head against root - root rewrites it. The TPM can: an NV
# index of type EXTEND behaves like a PCR that survives the reboots. Every
# record written extends it with the SHA-256 of the record file
#     valeur = SHA-256( valeur || SHA-256(enregistrement) )
# Anybody may extend it (no secret: the machine records without one), nobody
# can set it back or to a chosen value - only its owner can remove it, and
# the owner's secret is the /home passphrase. Replaying the records of the
# box from the one the index started at must give the value the TPM holds:
# a record removed at the end, replaced, or written without passing by here
# no longer does. Root can still DESTROY records - it can no longer hide it.
NV_BOITE = os.environ.get("OSMO_EMPREINTE_NV_BOITE", "0x1800A51")
TETE_DEPUIS = os.path.join(BOITE, "tete.depuis")        # the first record the index was extended with
JOURNAL_BOITE = os.path.join(BOITE, "journal")


# THE SAME FOR THE CHAIN OF THE STATES (index 0x1800A52): each link added to
# CHAINE extends it. Going back to an OLDER chain, with its own valid
# signature, no longer gives the value the TPM holds.
NV_ETATS = os.environ.get("OSMO_EMPREINTE_NV_ETATS", "0x1800A52")


def nv_lire(nv, simul):
    """32 bytes; b'' when the index was never extended; None when there is none."""
    if TEST:
        try:
            with open(simul, "rb") as f:
                return f.read()
        except OSError:
            return None
    if not tpm_present():
        return None
    r = tpm(["tpm2_nvreadpublic", nv])
    if r is None or r.returncode != 0:
        return None
    r = tpm(["tpm2_nvread", nv, "-C", nv, "-s", "32"])
    return r.stdout if r is not None and r.returncode == 0 and len(r.stdout) == 32 else b""


def nv_etendre(nv, simul, h):
    if TEST:
        with open(simul, "rb") as f:
            v = f.read() or bytes(32)
        with open(simul, "wb") as f:
            f.write(hashlib.sha256(v + h).digest())
        return True
    r = tpm(["tpm2_nvextend", "-C", nv, nv, "-i", "=0"], (h,))
    return r is not None and r.returncode == 0


def nv_definir(nv, simul, phrase):
    """The index (re)made, empty: the owner's secret is the passphrase. '' or the reason."""
    if TEST:
        if not phrase:
            return "pas de phrase"
        open(simul, "wb").close()
        return ""
    if not tpm_present():
        return "pas de TPM utilisable"
    secret = secret_tpm(phrase)
    if secret is None or not proprietaire_pose():
        return "le TPM n a pas encore de proprietaire lie a ta phrase (sudo osmo-empreinte ancrer)"
    r = tpm(["tpm2_changeauth", "-c", "owner", "-p", "@0", "@1"], (secret, secret))
    if r is None or r.returncode != 0:
        return "phrase de /home refusee par le TPM (ce n est pas le secret de son proprietaire)"
    if tpm(["tpm2_nvreadpublic", nv]).returncode == 0:
        r = tpm(["tpm2_nvundefine", nv, "-C", "o", "-P", "@0"], (secret,))
        if r.returncode != 0:
            return "ancien index non retire : " + r.stderr.decode(errors="replace").strip()[-120:]
    # type EXTEND (nt=0x4): written by anybody, read by anybody, only ever
    # extended; removed by the owner alone
    r = tpm(["tpm2_nvdefine", nv, "-C", "o", "-s", "32", "-g", "sha256",
             "-a", "nt=0x4|authwrite|authread|ownerread|no_da", "-P", "@0"], (secret,))
    return "" if r.returncode == 0 else "index du TPM non cree : " + r.stderr.decode(errors="replace").strip()[-160:]


def nv_retirer(nv, simul, phrase):
    if TEST:
        try:
            os.unlink(simul)
        except OSError:
            pass
        return
    secret = secret_tpm(phrase)
    if secret is not None:
        tpm(["tpm2_nvundefine", nv, "-C", "o", "-P", "@0"], (secret,))


def rejouer(empreintes):
    v = bytes(32)
    for h in empreintes:
        v = hashlib.sha256(v + h).digest()
    return v


def etats_tete(g, lignes, parle=True):
    """The chain of the states against its index. 0 conform; 2 no index; 3 DIFFERENT."""
    nv = nv_lire(NV_ETATS, os.path.join(BOITE, "etats.nv"))
    if nv is None:
        if parle:
            dire("tete des etats : pas encore tenue par le TPM (elle le sera a la prochaine ecriture validee)")
        return 2
    try:
        with open(os.path.join(g, "CHAINE.depuis")) as f:
            depuis = f.readline().strip()
    except OSError:
        depuis = ""
    ids = [l[0] for l in lignes]
    suite = lignes[ids.index(depuis):] if depuis in ids else []
