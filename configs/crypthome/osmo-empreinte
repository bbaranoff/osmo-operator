def temoin_poser(phrase, fin):
    """A fresh witness volume and its fingerprint (the passphrase signs it).
    fin: the end of a test - its marks are removed."""
    if cle_privee(phrase) is None:
        print(ROUGE + "  Phrase refusee : rien n est change." + FIN)
        return 1
    if fin and temoin_restaurer():
        # back to its original state: it must match its fingerprint of before
        # the test again, as it is - said, because it is the proof
        tete, diffs = comparer("temoin", TEMOIN_MNT)
        if diffs == [] or TEST:
            print("  Le volume temoin est revenu a son etat d origine : il correspond de nouveau a son empreinte.")
        else:
            print(ROUGE + "  Le volume temoin remis ne correspond pas a son empreinte : je le refais a neuf." + FIN)
            if not temoin_creer():
                return 1
    elif not temoin_creer():
        print(ROUGE + "  Le volume temoin n a pas pu etre (re)cree : rien n est change." + FIN)
        return 1
    rc = prendre(phrase)
    if rc != 0:
        print(ROUGE + "  Volume temoin refait, mais l empreinte n a pas pu etre reprise : sudo osmo-empreinte prendre" + FIN)
        return rc
    if fin:
        marque_essai(False)
        for f in (ALERTE, SANS_HOME):
            try:
                os.unlink(f)
            except OSError:
                pass
        print("\033[1;32m  Test termine : volume temoin dans son etat d origine, empreinte signee, alarme levee." + FIN)
        if os.path.exists("/etc/osmo-tpm/actif") and not os.path.exists("/run/osmo-tpm/reconnu"):
            print("  La puce de securite n a pas reconnu ce demarrage : icone « Reenroler », choix 1.")
    else:
        print("\033[1;32m  Le volume temoin est en place et surveille. Relance cette icone pour faire le test." + FIN)
    return 0


def lire_court(chemin):
    try:
        with open(chemin, errors="replace") as f:
            return f.readline().strip()[:80]
    except OSError:
        return "?"


def extinction():
    """osmo-racine-live fin, BEFORE the session is written or dropped: the
    disks against their fingerprint. Nothing at boot and a difference now:
    something wrote to the disk DURING this session without the passphrase
    (a validated write takes and signs the fingerprint again - that one finds
    nothing here). Red on the console, a record in the box, the beep."""
    if not TEST and not os.path.ismount(BOITE):
        return 0
    if os.path.exists(ALERTE):
        return 0                              # already said at boot: not twice
    trouve = []
    for nom, racine in couches().items():
        tete, diffs = comparer(nom, racine)
        if diffs:
            trouve.append((racine, tete, diffs))
    if not trouve and signature_ok() is False:
        trouve.append((BOITE, {}, [("MODIFIE", TOTAUX.lstrip("/"), "l empreinte n est plus signee par la phrase de /home")]))
    if not trouve:
        dire("extinction : sommes de controle conformes, comme au demarrage")
        return 0
    titre = "LE DISQUE A CHANGE PENDANT LA SESSION, SANS LA PHRASE"
    for cmd in () if TEST else (["plymouth", "quit"], ["chvt", "1"]):
        try:
            subprocess.run(cmd, capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass
    l = ["!!!  " + titre + "  !!!", "",
         "Propre au demarrage, different a l extinction : quelque chose a ecrit sur le",
         "disque pendant cette session sans passer par une validation.", ""]
    if boite_rw(True):
        try:
            with open(ALARME, "w") as f:
                f.write(time.strftime("%F %T") + "\n")
                for racine, tete, diffs in trouve:
                    f.write(texte_alerte(racine, diffs, tete))
            os.sync()
        except OSError:
            pass
        finally:
            boite_rw(False)
    if trouve and all(r == TEMOIN_MNT for r, _t, _d in trouve):
        l += ["(%s est le volume temoin : c est le TEST COMPLET DE L ALARME, lance le %s." % (
              TEMOIN_MNT, lire_court(TEMOIN_ESSAI)),
              " L alarme marche ; le disque systeme est conforme. Tout le reste est reel, et seul le",
              " proprietaire l arrete : OUI et sa phrase au demarrage, puis l icone « Test de l alarme ».)", ""]
    for racine, tete, diffs in trouve:
        alerter("%s : %s" % (titre, racine), diffs, tete)
        dire("%s : %s, %d difference(s)" % (titre, racine, len(diffs)))
        for k, p, d in diffs[:10]:
            l.append(("  %-8s %s/%s%s" % (k, racine.rstrip("/"), p, ("  (%s)" % d) if d else ""))[:112])
        if len(diffs) > 10:
            l.append("  ... et %d autre(s)" % (len(diffs) - 10))
    l += ["", "C est note dans la boite noire. Le prochain demarrage le redira, et seul le",
          "proprietaire (phrase de /home) pourra ouvrir une session.", "",
          "LA MACHINE NE S ETEINT PAS. Pour l eteindre : maintiens le bouton d alimentation."]
    if TEST:
        sys.stdout.write("\n".join(l) + "\n")
        return 3
    verrouiller()
    ecran_alarme(l)
    bip(10, console=True)
    time.sleep(4)
    return 3


