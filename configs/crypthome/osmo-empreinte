#!/usr/bin/python3
# osmo-empreinte - THE SYSTEM DISK AGAINST ITS FINGERPRINT: has / been written
# to OUTSIDE a session, i.e. without the black box knowing?
#
# The system disk of an installed bench is in clear and read-only: the only
# writes it ever receives are the commits of validated sessions
# (osmo-racine-live), each one recorded in the black box. After every commit
# THE TOTAL SHA-256 of / and of /home is taken and kept on the box partition
# (empreinte.json; each record of the box also carries the totals it found),
# with its detail - one line per file: type, mode, owner, size, dates, inode,
# SHA-256 of its content. The detail of /home is ENCRYPTED there (the box is
# in clear, what lives in /home is not to be read from it): only its totals
# are kept as they are. At EVERY BOOT, BEFORE the /home passphrase is asked,
# the total of / is computed again (a walk of the disk: 2 seconds) and
# compared; only when it differs is the detail read, to say what changed.
# /home is compared the same way as soon as it is opened. A difference means that somebody wrote to the disk with
# the machine off (a live key, the disk in another machine): a RED WARNING
# fills the console, the black box gets an « alerte » record, and the /home
# passphrase is only asked after « OUI » has been typed.
#
#   osmo-empreinte prendre            take the fingerprint (after a commit;
#                                     only what changed is hashed again) AND
#                                     SIGN it: the /home passphrase, asked on
#                                     the terminal or --phrase-stdin
#   osmo-empreinte controler [--complet]   compare; --complet also reads every
#                                     file again (about 30 s for 18 GB)
#   osmo-empreinte demarrage          at boot, before unlock-home: fast
#                                     control, the warning, the question
#   osmo-empreinte fond               after boot, in the background, at idle
#                                     priority: the complete control
#   osmo-empreinte home               unlock-home, the volume just opened:
#                                     /home against its total
#   osmo-empreinte sceau              unlock-home, the volume just opened: the
#                                     totals on the box are the ones that were
#                                     sealed (red on the console otherwise)
#   osmo-empreinte rappel             desktop: only what the complete control
#                                     found after boot (the rest is said at
#                                     boot, on the console, never at login)
#
# TWO CONTROLS. The fast one (2-3 s, every boot, blocking) compares what the
# file system says of each file: a file replaced or edited changes its inode
# or its change time, which no ordinary tool can set. The complete one reads
# every file: it catches a change made with the dates and inodes forged.
#
# THE SIGNATURE. The fingerprint is in clear on the box partition: whoever
# rewrites the disk can rewrite it too. It is therefore SIGNED (Ed25519) with
# a key that is encrypted with the /home passphrase: no session, not even
# root with /home open, can sign - only somebody typing the passphrase. The
# boot checks the signature BEFORE asking the passphrase; « sceau », once
# /home is open, checks that the public key is the one pinned in /home.
#
# LIMITS, plainly. This runs FROM the disk it checks: an attacker who also
# rewrites this program (or unlock-home) silences it - only a measured boot
# (TPM) closes that. It catches everything short of that: a file dropped or
# edited from a live key, a package or a unit added, an initramfs rebuilt.
# A change you make yourself to the disk outside a session (overlayroot-chroot)
# is, rightly, such a difference: « osmo-racine-live actualiser » records it;
# otherwise take the fingerprint again (sudo osmo-empreinte prendre).
import gzip
import hashlib
import hmac
import json
import os
import secrets
import select
import stat
import subprocess
import sys
import time
from multiprocessing import Pool

BOITE = os.environ.get("OSMO_DIFFS_BASE", "/var/lib/osmo-diffs")
TOTAUX = os.path.join(BOITE, "empreinte.json")        # the totals: what the boot compares
SCEAU = os.path.join(BOITE, "empreinte.hmac")
RACINE = os.environ.get("OSMO_EMPREINTE_RACINE") or ("/media/root-ro" if os.path.ismount("/media/root-ro") else "/")
HOME_DISQUE = os.environ.get("OSMO_EMPREINTE_HOME", "/media/home-ro")
CLE = ".osmo-diffs/sceau"
ALERTE = os.environ.get("OSMO_EMPREINTE_ALERTE", "/run/osmo-alerte")
SANS_HOME = os.environ.get("OSMO_EMPREINTE_SANS_HOME", "/run/osmo-sans-home")
FOND_FAIT = "/run/osmo-empreinte-complet"
# the seal's key, kept in RAM (root only) from the moment /home is open: at
# shutdown the mounts of /home may already be gone when the fingerprint is
# taken - without the key it would be left UNSEALED, and the next boot would
# cry that it is not the one this machine sealed
CLE_RAM = os.environ.get("OSMO_EMPREINTE_CLE_RAM", "/run/osmo-empreinte-cle")
# THE SIGNATURE. The totals are SIGNED (Ed25519). The private key is on the
# box, ENCRYPTED WITH THE /home PASSPHRASE: it only exists, in memory, while
# that passphrase is being typed for a write. Nothing a session holds - not
# root, not an open /home - can sign: a disk written to without the
# passphrase cannot get a valid fingerprint, and the boot says so BEFORE the
# passphrase is asked. The public key is also pinned in the encrypted /home
# (and, option, in the TPM): a key pair swapped on the box is denounced.
SIG = os.path.join(BOITE, "empreinte.sig")
SIG_PUB = os.path.join(BOITE, "signature.pub")
SIG_CLE = os.path.join(BOITE, "signature.cle")
PUB_HOME = ".osmo-diffs/signature.pub"
TEST = os.environ.get("OSMO_DIFFS_SANS_MONTAGE") == "1"
# never part of the fingerprint: the journal of a commit, the way back, the
# session's own log (written to the disk outside a commit, on purpose)
EXCLUS = {".osmo-valider", ".osmo-retour", "lost+found", "var/log/osmo-session.log", "var/log/osmo-session.log.nouv"}
TOUJOURS_RELUS = {"boot/grub/grubenv"}
CONSOLE = "/dev/console"
ROUGE, FIN = "\033[1;31m", "\033[0m"


def dire(*a):
    print("osmo-empreinte :", *a, flush=True)


def parcourir(racine):
    """Every entry of the file system at racine (not what is mounted in it):
    {path: [type, mode, uid, gid, size, mtime_ns, ctime_ns, inode, hash]}."""
    dev = os.lstat(racine).st_dev
    out, pile = {}, [""]
    while pile:
        rel = pile.pop()
        try:
            entrees = list(os.scandir(os.path.join(racine, rel) if rel else racine))
        except OSError:
            continue
        for e in entrees:
            p = (rel + "/" + e.name) if rel else e.name
            if p in EXCLUS:
                continue
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            m = st.st_mode
            t = ("d" if stat.S_ISDIR(m) else "f" if stat.S_ISREG(m) else "l" if stat.S_ISLNK(m) else "o")
            h = ""
            if t == "l":
                try:
                    h = os.readlink(os.path.join(racine, p))
                except OSError:
                    h = "?"
            out[p] = [t, stat.S_IMODE(m), st.st_uid, st.st_gid, st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_ino, h]
            if t == "d" and st.st_dev == dev:
                pile.append(p)
    return out


def _sha(chemin):
    h = hashlib.sha256()
    try:
        with open(chemin, "rb", buffering=0) as f:
            while True:
                b = f.read(1 << 20)
                if not b:
                    break
                h.update(b)
        return h.hexdigest()
    except OSError as e:
        return "illisible:%s" % e.errno


def hacher(racine, chemins):
    """{path: sha256} of the regular files given, four at a time."""
    if not chemins:
        return {}
    with Pool(min(4, os.cpu_count() or 1)) as pool:
        return dict(zip(chemins, pool.imap(_sha, [os.path.join(racine, p) for p in chemins], chunksize=64)))


def manifeste(nom):
    return os.path.join(BOITE, "empreinte-%s.json.gz" % nom)


# THE DETAIL OF /home IS CONFIDENTIAL: the paths, sizes and SHA-256 of what
# lives in the encrypted volume. The box partition is in clear: only the
# TOTALS of /home are kept there as they are; its detail is ENCRYPTED
# (AES-256, then HMAC-SHA-256) with the seal's key, which lives in /home.
# Without /home open it cannot be read - and it is not needed: /home is only
# compared once it is open. No key: no detail is written, the total alone.
CHIFFRES = {"home"}


def manifeste_chiffre(nom):
    return os.path.join(BOITE, "empreinte-%s.detail" % nom)


def _cles_detail(cle):
    return (hashlib.sha256(b"osmo-empreinte detail chiffrement\0" + cle).hexdigest(),
            hashlib.sha256(b"osmo-empreinte detail sceau\0" + cle).digest())


def _openssl(sens, donnees, passe):
    r = subprocess.run(["openssl", "enc", sens, "-aes-256-ctr", "-pbkdf2", "-iter", "1000", "-pass", "env:OSMO_DETAIL"],
                       input=donnees, capture_output=True, env=dict(os.environ, OSMO_DETAIL=passe))
    if r.returncode != 0:
        raise OSError("openssl enc %s : %s" % (sens, r.stderr.decode(errors="replace").strip()[:200]))
    return r.stdout


def chiffrer_detail(clair, cle):
    passe, mac = _cles_detail(cle)
    c = _openssl("-e", clair, passe)
    return hmac.new(mac, c, hashlib.sha256).digest() + c


def dechiffrer_detail(brut, cle):
    passe, mac = _cles_detail(cle)
    if len(brut) < 48 or not hmac.compare_digest(brut[:32], hmac.new(mac, brut[32:], hashlib.sha256).digest()):
        raise ValueError("detail chiffre : sceau faux")
    return _openssl("-d", brut[32:], passe)


def effacer_clair(nom):
    """A detail left in clear by an earlier version: overwritten, then removed
    (on an SSD the old blocks may outlive this - said in the documentation)."""
    for f in (manifeste(nom), manifeste(nom) + ".nouv"):
        if os.path.exists(f):
            try:
                subprocess.run(["shred", "-u", "-n", "1", f], capture_output=True, timeout=300)
            except (OSError, subprocess.TimeoutExpired):
                pass
            try:
                os.unlink(f)
            except OSError:
                pass


def couches():
    """The volumes that have a fingerprint: the system disk, and /home when it is open."""
    c = {"racine": RACINE}
    if TEST or os.path.ismount(HOME_DISQUE):
        c["home"] = HOME_DISQUE
    return c


# The total of a volume: osmo-total (find, sort, sha256sum - 4 seconds for
# 450 000 entries; the same walk in Python takes 8). ONE text for it, which
# the initramfs runs too when the boot is measured (osmo-tpm).
TOTAL = os.environ.get("OSMO_TOTAL", "/usr/local/sbin/osmo-total")


def total_meta(racine):
    """ONE SHA-256 for a whole volume, from what the file system says of every entry."""
    r = subprocess.run([TOTAL, racine], capture_output=True, text=True)
    return r.stdout.strip()


def total_contenu(etat):
    """ONE SHA-256 for the CONTENT of a whole volume: every file's own SHA-256."""
    h = hashlib.sha256()
    for p in sorted(etat):
        if etat[p][0] == "f":
            h.update(json.dumps([p, etat[p][8]], ensure_ascii=True).encode() + b"\n")
    return h.hexdigest()


def totaux():
    try:
        with open(TOTAUX) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def charger(nom):
    try:
        if nom in CHIFFRES:
            cle = cle_sceau()
            if cle is None:
                return None
            with open(manifeste_chiffre(nom), "rb") as f:
                lignes = gzip.decompress(dechiffrer_detail(f.read(), cle)).decode("utf-8", "surrogateescape").split("\n")
            return {r[0]: r[1:] for r in (json.loads(l) for l in lignes[1:] if l)}
        with gzip.open(manifeste(nom), "rt", encoding="utf-8", errors="surrogateescape") as f:
            json.loads(f.readline())
            return {r[0]: r[1:] for r in (json.loads(l) for l in f)}
    except (OSError, ValueError, EOFError):
        return None


def boite_rw(oui):
    if TEST:
        return True
    return subprocess.run(["mount", "-o", "remount,%s" % ("rw" if oui else "ro"), BOITE],
                          capture_output=True).returncode == 0


def cle_sceau(creer=False):
    """The seal's key, from the encrypted /home (None when /home is closed)."""
    for chemin in (os.path.join(HOME_DISQUE, CLE), CLE_RAM if TEST else os.path.join("/home", CLE), CLE_RAM):
        try:
            with open(chemin, "rb") as f:
                k = f.read().strip()
            if len(k) >= 32:
                if chemin != CLE_RAM:
                    garder_cle(k)
                return k
        except OSError:
            pass
    if not creer or not (TEST or os.path.ismount(HOME_DISQUE)):
        return None
    # written on the volume itself (not in the RAM layer of /home, which a
    # wiped session would take with it)
    k = secrets.token_hex(32).encode()
    rw = TEST or subprocess.run(["mount", "-o", "remount,rw", HOME_DISQUE], capture_output=True).returncode == 0
    try:
        d = os.path.join(HOME_DISQUE, os.path.dirname(CLE))
        os.makedirs(d, mode=0o700, exist_ok=True)
        with open(os.open(os.path.join(HOME_DISQUE, CLE), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            f.write(k + b"\n")
            f.flush()
            os.fsync(f.fileno())
        garder_cle(k)
    except OSError:
        k = None
    finally:
        if rw and not TEST:
            subprocess.run(["mount", "-o", "remount,ro", HOME_DISQUE], capture_output=True)
    return k


def garder_cle(k):
    try:
        with open(os.open(CLE_RAM, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            f.write(k + b"\n")
    except OSError:
        pass


def message():
    """What is signed: the totals, and where the box is copied (osmo-diffs
    copie-poser) - a destination changed by hand breaks the signature."""
    with open(TOTAUX, "rb") as f:
        m = f.read()
    try:
        with open(os.path.join(BOITE, "copie.conf"), "rb") as f:
            m += b"\0copie\0" + f.read()
    except OSError:
        pass
    return m


def _memfd(donnees):
    fd = os.memfd_create("osmo-empreinte")
    os.write(fd, donnees)
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def _ossl(args, entree=None, fds=()):
    return subprocess.run(["openssl"] + args, input=entree, capture_output=True, pass_fds=fds)


def phrase_luks(phrase):
    """The /home LUKS2 volume accepts this passphrase."""
    if TEST:
        return True
    uuid = ""
    try:
        with open("/etc/default/crypthome") as f:
            for l in f:
                if l.startswith("CRYPTHOME_UUID="):
                    uuid = l.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    dev = "/dev/disk/by-uuid/" + uuid
    if not uuid or not os.path.exists(dev):
        return False
    return subprocess.run(["cryptsetup", "open", "--test-passphrase", "--key-file=-", dev],
                          input=phrase, capture_output=True).returncode == 0


def cle_privee(phrase):
    """The signing key (PEM), from the /home passphrase; None when it is wrong.
    No key pair yet: made now - only for a passphrase /home accepts."""
    if os.path.exists(SIG_CLE):
        r = _ossl(["enc", "-d", "-aes-256-cbc", "-pbkdf2", "-iter", "600000", "-in", SIG_CLE, "-pass", "stdin"], phrase + b"\n")
        return r.stdout if r.returncode == 0 and r.stdout.startswith(b"-----BEGIN PRIVATE KEY-----") else None
    if not phrase_luks(phrase):
        return None
    r = _ossl(["genpkey", "-algorithm", "ed25519"])
    return r.stdout if r.returncode == 0 and r.stdout.startswith(b"-----BEGIN PRIVATE KEY-----") else None


def poser_signature(pem, phrase):
    """Box read-write: the signature of the totals; a new key pair is written
    with it (private key encrypted with the passphrase), its public key pinned
    in the /home volume."""
    k = _memfd(pem)
    m = _memfd(message())
    try:
        r = _ossl(["pkeyutl", "-sign", "-inkey", "/proc/self/fd/%d" % k, "-rawin", "-in", "/proc/self/fd/%d" % m], fds=(k, m))
        if r.returncode != 0 or len(r.stdout) != 64:
            return False
        with open(SIG + ".nouv", "wb") as f:
            f.write(r.stdout)
        os.replace(SIG + ".nouv", SIG)
        if not os.path.exists(SIG_CLE):
            os.lseek(k, 0, os.SEEK_SET)
            pub = _ossl(["pkey", "-in", "/proc/self/fd/%d" % k, "-pubout"], fds=(k,))
            os.lseek(k, 0, os.SEEK_SET)
            enc = _ossl(["enc", "-aes-256-cbc", "-pbkdf2", "-iter", "600000", "-salt", "-in", "/proc/self/fd/%d" % k,
                         "-pass", "stdin"], phrase + b"\n", fds=(k,))
            if pub.returncode != 0 or enc.returncode != 0:
                return False
            with open(os.open(SIG_CLE + ".nouv", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o400), "wb") as f:
                f.write(enc.stdout)
            with open(SIG_PUB + ".nouv", "wb") as f:
                f.write(pub.stdout)
            os.replace(SIG_PUB + ".nouv", SIG_PUB)
            os.replace(SIG_CLE + ".nouv", SIG_CLE)
            epingler(pub.stdout)
        try:
            os.unlink(SCEAU)                  # the HMAC seal of earlier versions
        except OSError:
            pass
        return True
    finally:
        os.close(k)
        os.close(m)


def epingler(pub):
    """The public key, pinned in the /home volume (not in its RAM layer)."""
    if not (TEST or os.path.ismount(HOME_DISQUE)):
        return
    cible = os.path.join(HOME_DISQUE, PUB_HOME)
    if os.path.exists(cible):
        return                                # never replaced here: a difference is an alert
    rw = TEST or subprocess.run(["mount", "-o", "remount,rw", HOME_DISQUE], capture_output=True).returncode == 0
    try:
        os.makedirs(os.path.dirname(cible), mode=0o700, exist_ok=True)
        with open(os.open(cible, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
            f.write(pub)
            f.flush()
            os.fsync(f.fileno())
    except OSError:
        pass
    finally:
        if rw and not TEST:
            subprocess.run(["mount", "-o", "remount,ro", HOME_DISQUE], capture_output=True)


def signature_ok():
    """True / False: the totals carry a valid signature. None: never signed yet."""
    if not os.path.exists(SIG_PUB):
        return None
    if not os.path.exists(SIG) or not os.path.exists(TOTAUX):
        return False
    m = _memfd(message())
    try:
        r = _ossl(["pkeyutl", "-verify", "-pubin", "-inkey", SIG_PUB, "-rawin", "-in", "/proc/self/fd/%d" % m, "-sigfile", SIG], fds=(m,))
        return r.returncode == 0
    finally:
        os.close(m)


def lire_phrase():
    """The /home passphrase: one line of stdin (--phrase-stdin), else asked on the terminal."""
    if "--phrase-stdin" in sys.argv[2:]:
        return sys.stdin.buffer.readline().rstrip(b"\r\n")
    import getpass
    try:
        return getpass.getpass("phrase de /home : ").encode()
    except (EOFError, OSError):
        return b""


def resceller(phrase):
    """The signature again, after a change the box knows of (osmo-diffs copie-poser)."""
    if not os.path.exists(TOTAUX):
        return 0
    pem = cle_privee(phrase) if phrase else None
    if pem is None:
        dire("phrase de /home refusee : l empreinte n est PAS signee de nouveau")
        return 1
    if not boite_rw(True):
        return 1
    try:
        ok = poser_signature(pem, phrase)
        os.sync()
    finally:
        boite_rw(False)
    return 0 if ok else 1


def copie_demarrage():
    """At boot: records of the box that were NOT copied to the other machine
    (no network at shutdown, machine away, destination wrong). Never
    blocking - but said, in red, before anything else."""
    try:
        r = subprocess.run(["/usr/local/sbin/osmo-diffs", "copie-etat"], capture_output=True, text=True, timeout=20).stdout.split()
        dest, att, tot = r[0], int(r[1]), int(r[2])
    except (OSError, subprocess.TimeoutExpired, IndexError, ValueError):
        return
    if att <= 0:
        return
    txt = "%d enregistrement(s) de la boite noire sur %d NE SONT PAS COPIES sur %s" % (att, tot, dest)
    try:
        with open(os.open("/run/osmo-alerte-copie", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644), "w") as f:
            f.write(txt + "\n")
    except OSError:
        pass
    dire(txt)
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
        b = "#" * 76
        os.write(c, ("\r\n".join(["", "\a\033[5;1;31m" + b + FIN, ROUGE + "   !!!  LA BOITE NOIRE N EST PAS COPIEE AILLEURS  !!!",
                                    "   " + txt + ".", "   La copie par ssh n a pas abouti (reseau absent a l extinction ?) :",
                                    "   tant qu elle n est pas faite, effacer la boite ici ne laisse aucune trace.",
                                    "   Nouvel essai des que le reseau repond ; a la main : sudo osmo-diffs envoyer",
                                    b + FIN, ""])).encode())
        os.close(c)
        time.sleep(6)
    except OSError:
        pass


def prendre(phrase=None, premiere=False):
    """The fingerprint of every volume, after a commit: its two totals in
    empreinte.json (what the boot compares), its detail next to it (what
    explains a difference). Only what changed is read again.
    ONLY WITH THE /home PASSPHRASE: it unlocks the key that signs the totals.
    (premiere: the first boot of an installation, nothing to compare with yet -
    taken unsigned, signed at the first validated write.)"""
    if not TEST and not os.path.ismount(BOITE):
        dire("%s n est pas monte : pas d empreinte" % BOITE)
        return 0
    pem = None
    if not premiere:
        pem = cle_privee(phrase) if phrase else None
        if pem is None:
            dire("phrase de /home refusee ou absente : l empreinte n est PAS prise (rien ne benit le disque sans elle)")
            return 1
    t0 = time.monotonic()
    cle = cle_sceau(creer=True)            # before /home is walked: the key is one of its files
    tot, pris, relus = totaux(), {}, 0
    for nom, racine in couches().items():
        ancien = charger(nom)
        etat = parcourir(racine)
        a_lire = []
        for p, r in etat.items():
            if r[0] != "f":
                continue
            v = ancien.get(p) if ancien else None
            # unchanged since the last fingerprint (a commit is a trusted
            # moment): its hash is kept
            # (GRUB's environment block is rewritten in place by the boot
            # loader, dates and inode untouched: always read again)
            if v and v[0] == "f" and v[4:8] == r[4:8] and v[8] and not v[8].startswith("illisible") \
                    and p not in TOUJOURS_RELUS:
                r[8] = v[8]
            else:
                a_lire.append(p)
        for p, h in hacher(racine, a_lire).items():
            etat[p][8] = h
        relus += len(a_lire)
        pris[nom] = etat
        tot[nom] = {"meta": total_meta(racine), "contenu": total_contenu(etat), "entrees": len(etat),
                    "pris": time.strftime("%F %T"), "disque": racine}
    if not boite_rw(True):
        dire("boite en lecture seule : empreinte non ecrite")
        return 1
    signee = False
    try:
        for nom, etat in pris.items():
            if nom in CHIFFRES:
                # never in clear on the box; without the key, the total alone
                effacer_clair(nom)
                tmp = manifeste_chiffre(nom) + ".nouv"
                try:
                    if cle is None:
                        raise OSError("cle du sceau hors d atteinte")
                    clair = "\n".join([json.dumps(tot[nom])] + [json.dumps([p] + etat[p], ensure_ascii=True) for p in sorted(etat)]) + "\n"
                    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
                        f.write(chiffrer_detail(gzip.compress(clair.encode("utf-8", "surrogateescape"), 1), cle))
                    os.replace(tmp, manifeste_chiffre(nom))
                except OSError as e:
                    dire("detail de %s NON ecrit (%s) : son total seul est garde" % (nom, e))
                    for f in (tmp, manifeste_chiffre(nom)):
                        try:
                            os.unlink(f)
                        except OSError:
                            pass
                continue
            tmp = manifeste(nom) + ".nouv"
            with gzip.open(tmp, "wt", encoding="utf-8", errors="surrogateescape", compresslevel=1) as f:
                f.write(json.dumps(tot[nom]) + "\n")
                for p in sorted(etat):
                    f.write(json.dumps([p] + etat[p], ensure_ascii=True) + "\n")
            os.replace(tmp, manifeste(nom))
        with open(TOTAUX + ".nouv", "w") as f:
            json.dump(tot, f, indent=1, sort_keys=True)
            f.write("\n")
        os.replace(TOTAUX + ".nouv", TOTAUX)
        if pem is not None:
            signee = poser_signature(pem, phrase)
        else:
            try:
                os.unlink(SIG)
            except OSError:
                pass
        os.sync()
    finally:
        boite_rw(False)
    if not signee and not premiere:
        dire("EMPREINTE NON SIGNEE : la signature a echoue - le prochain demarrage le dira")
    for nom in pris:
        dire("%-6s sha256 %s  (%d entrees)" % (nom, tot[nom]["meta"], tot[nom]["entrees"]))
    dire("empreinte prise : %d fichier(s) relu(s), %.0f s%s" % (
        relus, time.monotonic() - t0, ", signee" if signee else " (NON signee)"))
    return 0


def comparer(nom, racine, complet=False):
    """(reference, differences) between a volume and its fingerprint.
    FAST PATH: the volume's total is computed again from the 2-second walk and
    compared with the one on the box - equal, nothing more is read. Different
    (or complet): the detail is loaded and every difference listed.
    reference is None when the volume has no fingerprint."""
    ref = totaux().get(nom)
    if not ref:
        return None, None
    if not complet and total_meta(racine) == ref["meta"]:
        return ref, []
    etat = parcourir(racine)
    ancien = charger(nom)
    if ancien is None:
        return ref, [("MODIFIE", "", "empreinte totale differente, et le detail (%s) n est pas lisible sur la boite" % (
            manifeste_chiffre(nom) if nom in CHIFFRES else manifeste(nom)))]
    diffs = []
    for p in sorted(set(ancien) - set(etat)):
        diffs.append(("SUPPRIME", p, ""))
    for p in sorted(set(etat) - set(ancien)):
        diffs.append(("AJOUTE", p, {"d": "repertoire", "l": "lien -> " + str(etat[p][8]), "f": "%d octets" % etat[p][4]}.get(etat[p][0], "")))
    a_lire = []
    for p in sorted(set(etat) & set(ancien)):
        v, r = ancien[p], etat[p]
        quoi = []
        if v[0] != r[0]:
            quoi.append("nature")
        if v[1] != r[1]:
            quoi.append("droits %o -> %o" % (v[1], r[1]))
        if v[2:4] != r[2:4]:
            quoi.append("proprietaire %s:%s -> %s:%s" % (v[2], v[3], r[2], r[3]))
        if r[0] == "l" and v[8] != r[8]:
            quoi.append("lien -> %s" % r[8])
        if r[0] == "f" and v[0] == "f":
            if v[4] != r[4]:
                quoi.append("taille %d -> %d" % (v[4], r[4]))
            elif v[5] != r[5]:
                quoi.append("date de modification")
            elif v[6] != r[6] or v[7] != r[7]:
                quoi.append("fichier remplace ou reecrit (inode / date de changement)")
            # GRUB's environment block: written in place by the boot loader
            # itself, before anything runs - its content is not ours to judge
            # (its rights, owner, size and dates still are)
            if complet and not quoi and p not in TOUJOURS_RELUS:
                a_lire.append(p)
        if quoi:
            diffs.append(("MODIFIE", p, ", ".join(quoi)))
    if a_lire:
        for p, h in hacher(racine, a_lire).items():
            if h != ancien[p][8]:
                diffs.append(("MODIFIE", p, "CONTENU different, dates et inode intacts (maquillage)"))
    if not diffs and not complet:
        diffs.append(("MODIFIE", "", "empreinte totale differente de celle de la boite, sans difference dans le detail : c est l empreinte de la boite qui a ete changee"))
    return ref, diffs


def texte_alerte(titre, diffs, tete):
    l = [titre, "empreinte du %s, %d entrees ; disque : %s ; sha256 attendu %s" % (
        (tete or {}).get("pris", "?"), (tete or {}).get("entrees", 0), (tete or {}).get("disque", "?"),
        (tete or {}).get("meta", "?")), "%d difference(s) :" % len(diffs)]
    l += ["  %-8s /%s%s" % (k, p, ("  (%s)" % d) if d else "") for k, p, d in diffs]
    return "\n".join(l) + "\n"


def alerter(titre, diffs, tete):
    """The flag every warning reads, and the record in the black box."""
    txt = texte_alerte(titre, diffs, tete)
    try:
        with open(os.open(ALERTE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644), "a") as f:
            f.write(txt + "\n")
    except OSError:
        pass
    try:
        subprocess.run(["/usr/local/sbin/osmo-diffs", "alerte"], input=txt, text=True, timeout=120,
                       capture_output=True)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return txt


def console_alerte(titre, diffs):
    """The red screen, and the one question. True: the /home passphrase may be asked."""
    for cmd in (["plymouth", "quit"], ["chvt", "1"]):
        try:
            subprocess.run(cmd, capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass
    try:
        c = os.open(CONSOLE, os.O_RDWR | os.O_NOCTTY)
    except OSError:
        return False
    barre = "#" * 76
    l = ["\033[2J\033[H\a", "\033[5;1;31m" + barre + FIN, ROUGE + barre,
         "", "   !!!  " + titre + "  !!!", "",
         "   Le disque systeme n est PAS celui que la derniere session a laisse :",
         "   %d difference(s) avec son empreinte (boite noire)." % len(diffs), ""]
    for k, p, d in diffs[:14]:
        l.append(("     %-8s /%s%s" % (k, p, ("  (%s)" % d) if d else ""))[:118])
    if len(diffs) > 14:
        l.append("     ... et %d autre(s) : %s, ou osmo-empreinte controler" % (len(diffs) - 14, ALERTE))
    l += ["", "   Quelqu un a ecrit sur ce disque MACHINE ETEINTE (cle live, disque sorti),",
          "   ou tu l as fait toi-meme hors session sans reprendre l empreinte,",
          "   ou une ecriture coupee par une panne de courant vient d etre terminee.",
          "   NE DONNE PAS la phrase de /home a ce systeme sans savoir d ou cela vient :",
          "   un systeme modifie peut la retenir.",
          "", barre + FIN, "\033[5;1;31m" + barre + FIN, "",
          ROUGE + "   Taper OUI (en majuscules) pour demander quand meme la phrase de /home." + FIN,
          "   Entree seule : demarrer SANS /home (session root, rien de chiffre n est ouvert).",
          "   (2 minutes : sans reponse, sans /home)", "", "   > "]
    os.write(c, ("\r\n".join(l)).encode())
    rep = b""
    fin = time.monotonic() + 120
    while time.monotonic() < fin and not rep.endswith(b"\n"):
        r, _w, _e = select.select([c], [], [], 1.0)
        if r:
            try:
                d = os.read(c, 64)
            except OSError:
                break
            if not d:
                break
            rep += d
    ok = rep.strip() == b"OUI"
    os.write(c, ("\r\n   %s\r\n" % ("la phrase de /home va etre demandee - a tes risques." if ok
                                    else "demarrage SANS /home.")).encode())
    os.close(c)
    return ok


def demarrage():
    """At boot, BEFORE the /home passphrase: the system disk."""
    if not TEST and not os.path.ismount(BOITE):
        return 0
    tete, diffs = comparer("racine", RACINE)
    if diffs is None:
        # no fingerprint. A fresh installation: taken now, quietly. A box that
        # already holds session records: it was there, and it is gone
        try:
            n = len([f for f in os.listdir(os.path.join(BOITE, "journal"))
                     if f.endswith(".age") and "_installation." not in f])
        except OSError:
            n = 0
        if n == 0:
            return prendre(premiere=True)
        titre, tete = "L EMPREINTE DU SYSTEME A DISPARU DE LA BOITE NOIRE", {}
        diffs = [("SUPPRIME", TOTAUX.lstrip("/"), "plus rien ne prouve l etat du disque")]
    elif not diffs:
        sig = signature_ok()
        if sig is not False:
            dire("disque systeme conforme : sha256 %s (%s)%s" % (
                tete["meta"], tete.get("pris"), ", empreinte signee" if sig else ", empreinte pas encore signee"))
            return 0
        titre = "L EMPREINTE DU DISQUE N EST PAS SIGNEE PAR LA PHRASE DE /home"
        diffs = [("MODIFIE", TOTAUX.lstrip("/"), "refaite sans la phrase : le disque lui est conforme, mais rien ne prouve que c est celui que tu as valide")]
    else:
        titre = "LE DISQUE SYSTEME A ETE MODIFIE HORS SESSION"
    alerter(titre, diffs, tete)
    dire("%s : %d difference(s)" % (titre, len(diffs)))
    if not console_alerte(titre, diffs):
        try:
            open(SANS_HOME, "w").close()
        except OSError:
            pass
    return 0


def tpm_demarrage():
    """Measured boot (option, osmo-tpm): posed, and the TPM gave no code -
    firmware, GRUB, kernel, initramfs or the disk are not the sealed ones."""
    if not os.path.exists("/etc/osmo-tpm/actif") or os.path.exists("/run/osmo-tpm/reconnu"):
        return
    if os.path.exists(SANS_HOME):
        return                                # already refused at the disk's warning
    titre = "LE TPM NE RECONNAIT PAS CE DEMARRAGE"
    diffs = [("TPM", "", "pas de code : micrologiciel, GRUB, noyau, initramfs ou disque systeme ne sont pas ceux qui ont ete scelles"),
             ("TPM", "", "attendu UNE fois apres « osmo-tpm poser », ou apres une mise a jour du noyau / de GRUB dans la derniere session : alors OUI, puis sudo osmo-tpm sceller")]
    alerter(titre, diffs, {})
    dire(titre)
    if not console_alerte(titre, diffs):
        try:
            open(SANS_HOME, "w").close()
        except OSError:
            pass


def home():
    """unlock-home, the volume just opened and still read-only, before /home
    is put over it: the /home volume against its fingerprint. The passphrase
    has been typed by then - this says, it cannot prevent."""
    if not (TEST or os.path.ismount(HOME_DISQUE)) or not (TEST or os.path.ismount(BOITE)):
        return 0
    tete, diffs = comparer("home", HOME_DISQUE)
    if diffs is None:
        return 0                          # never taken yet: it is at the next commit
    if not diffs:
        dire("volume /home conforme : sha256 %s (%s)" % (tete["meta"], tete.get("pris")))
        return 0
    titre = "LE VOLUME /home A ETE MODIFIE HORS SESSION"
    alerter(titre, [(k, "home/" + p, d) for k, p, d in diffs], tete)
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
        l = ["", ROUGE + "#" * 76, "   !!!  " + titre + "  !!!",
             "   %d difference(s) avec son empreinte (boite noire) :" % len(diffs)]
        l += [("     %-8s /home/%s%s" % (k, p, ("  (%s)" % d) if d else ""))[:118] for k, p, d in diffs[:12]]
        l += ["   Detail : %s" % ALERTE, "#" * 76 + FIN, ""]
        os.write(c, "\r\n".join(l).encode())
        os.close(c)
        time.sleep(12)
    except OSError:
        pass
    return 3


def fond():
    """The complete control, after boot: the CONTENT of every volume, read
    again. Says so on every terminal and on the desktop."""
    tout = []
    for nom, racine in couches().items():
        tete, diffs = comparer(nom, racine, complet=True)
        if diffs:
            pre = "" if nom == "racine" else "home/"
            tout += [(k, pre + p, d) for k, p, d in diffs]
            ref = tete
    try:
        open(FOND_FAIT, "w").close()
    except OSError:
        pass
    if not tout:
        return 0
    # what the boot control already reported is not reported twice
    deja = ""
    try:
        with open(ALERTE) as f:
            deja = f.read()
    except OSError:
        pass
    nouveaux = [d for d in tout if ("/%s" % d[1]) not in deja]
    if nouveaux:
        txt = alerter("CONTENU DU DISQUE MODIFIE HORS SESSION (controle complet)", nouveaux, ref)
        try:
            subprocess.run(["wall"], input="osmo-empreinte : " + txt[:3000], text=True, timeout=10, capture_output=True)
        except (OSError, subprocess.TimeoutExpired):
            pass
    return 0


def sceau():
    """unlock-home, the /home volume just opened: the signing key of the box
    is the one /home knows, and the totals carry its signature."""
    if not os.path.exists(TOTAUX):
        return 0
    try:
        with open(os.path.join(HOME_DISQUE, PUB_HOME), "rb") as f:
            connue = f.read()
    except OSError:
        connue = None
    try:
        with open(SIG_PUB, "rb") as f:
            boite = f.read()
    except OSError:
        boite = None
    if connue is None and boite is None:
        return 0                              # never signed yet
    if connue is None:
        epingler(boite)                       # signed before the pin existed: pinned now
        connue = boite
    if connue == boite and signature_ok():
        return 0
    try:
        with open(ALERTE) as f:
            if "CLE DE SIGNATURE" in f.read():
                return 3                      # already said at this boot
    except OSError:
        pass
    titre = "LA CLE DE SIGNATURE DE LA BOITE N EST PAS CELLE QUE /home CONNAIT"
    txt = alerter(titre, [("MODIFIE", SIG_PUB.lstrip("/"), "cle ou signature changee sur la boite : l empreinte du disque ne prouve plus rien")], {})
    dire(txt.splitlines()[0])
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
        l = ["", "\a" + ROUGE + "#" * 76, "   !!!  " + titre + "  !!!",
             "   La cle qui signe l empreinte du disque, ou la signature, a ete changee sur la",
             "   boite noire : le controle de ce demarrage ne prouve rien.",
             "   Si c est toi (phrase de /home) : sudo osmo-empreinte prendre   -   Detail : %s" % ALERTE,
             "#" * 76 + FIN, ""]
        os.write(c, "\r\n".join(l).encode())
        os.close(c)
        time.sleep(12)
    except OSError:
        pass
    return 3


def rappel():
    """Desktop: the warning as a dialog (waits for the background control)."""
    for _ in range(90):
        if os.path.exists(FOND_FAIT) or os.path.exists(ALERTE):
            break
        time.sleep(2)
    time.sleep(1)
    try:
        with open("/run/osmo-alerte-copie") as f:
            subprocess.run(["zenity", "--warning", "--no-wrap", "--title", "osmo-operator : boite noire",
                            "--text", '<span foreground="red" weight="bold" size="large">LA BOITE NOIRE N EST PAS COPIEE AILLEURS</span>\n\n'
                            + f.read().strip() + "\n\nNouvel essai des que le reseau repond ; a la main : sudo osmo-diffs envoyer"])
    except OSError:
        pass
    # what the boot found was said at boot, on the console, before /home was
    # opened: the desktop only shows what the complete control found since
    try:
        with open(ALERTE) as f:
            txt = f.read()
    except OSError:
        return 0
    blocs = [b for b in txt.split("\n\n") if "(controle complet)" in b]
    if not blocs:
        return 0
    txt = "\n\n".join(blocs)
    corps = ('<span foreground="red" weight="bold" size="x-large">DISQUE SYSTEME MODIFIE HORS SESSION</span>\n\n'
             '<span foreground="red">Le systeme n est pas celui que la derniere session a laisse.\n'
             'Quelqu un a pu ecrire sur le disque machine eteinte.</span>\n\n<tt>%s</tt>\n\n'
             'Detail : %s   -   sudo osmo-empreinte controler --complet') % (
                 txt[:1500].replace("&", "&amp;").replace("<", "&lt;"), ALERTE)
    try:
        subprocess.run(["zenity", "--error", "--no-wrap", "--title", "osmo-operator : ALERTE", "--text", corps])
    except OSError:
        pass
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "controler"
    if cmd == "rappel":
        return rappel()
    if os.geteuid() != 0 and not TEST:
        sys.exit("osmo-empreinte : root requis")
    if cmd == "prendre":
        return prendre(lire_phrase())
    if cmd == "demarrage":
        copie_demarrage()
        rc = demarrage()
        tpm_demarrage()
        return rc
    if cmd == "resceller":
        return resceller(lire_phrase())
    if cmd == "fond":
        return fond()
    if cmd == "sceau":
        return sceau()
    if cmd == "home":
        return home()
    if cmd == "controler":
        complet, rc = "--complet" in sys.argv[2:], 0
        for nom, racine in couches().items():
            tete, diffs = comparer(nom, racine, complet=complet)
            if diffs is None:
                dire("%-6s pas d empreinte : osmo-empreinte prendre" % nom)
                rc = rc or 2
            elif not diffs:
                dire("%-6s conforme : sha256 %s  (%s, %d entrees%s)" % (
                    nom, tete["meta"], tete.get("pris"), tete.get("entrees", 0), ", contenu relu" if complet else ""))
            else:
                sys.stdout.write(ROUGE + texte_alerte("%s DIFFERE DE SON EMPREINTE" % racine, diffs, tete) + FIN)
                rc = 3
        return rc
    sys.exit("usage : osmo-empreinte prendre | controler [--complet] | demarrage | home | fond | sceau | rappel")


if __name__ == "__main__":
    sys.exit(main())
