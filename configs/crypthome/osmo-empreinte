def ecran_alarme(lignes=()):
    """« YOU HAVE DONE SOMETHING NASTY !!!! », white on a red screen, then
    the lines given (what changed, what to do)."""
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        return
    try:
        larg, haut = os.get_terminal_size(c)
    except OSError:
        larg, haut = 80, 25
    l = []
    for mot in ("YOU HAVE DONE", "SOMETHING", "NASTY !!!!"):
        for r in range(5):
            t = " ".join(GROS[ch][r] for ch in mot)
            # white cells on the red: no glyph needed, whatever the console font
            l.append(" " * max(0, (larg - len(t)) // 2) + t.replace("#", "\033[47m \033[41m"))
        l.append("")
    # CENTRED, both ways: every line of text in the middle of the width, the
    # whole of it in the middle of the height
    l += [" " * max(0, (larg - len(x[:larg - 2])) // 2) + x[:larg - 2] for x in lignes]
    l = [""] * max(0, (haut - len(l)) // 2) + l
    try:
        os.write(c, ("\033[0m\033[41;1;37m\033[2J\033[H\033[?25l" + "\r\n".join(l[:haut - 1])).encode())
    except OSError:
        pass
    os.close(c)


def verrouiller():
    """THE ALARM CANNOT BE LEFT: no signal stops it (Ctrl-C, Ctrl-\\, Ctrl-Z, a
    closed terminal), the console cannot be switched (VT_LOCKSWITCH), the
    magic SysRq keys are off. What remains is the power button, held."""
    import fcntl
    import signal
    for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTSTP, signal.SIGHUP, signal.SIGTERM):
        try:
            signal.signal(s, signal.SIG_IGN)
        except (OSError, ValueError):
            pass
    if TEST:
        return
    try:
        with open("/proc/sys/kernel/sysrq", "w") as f:
            f.write("0\n")
    except OSError:
        pass
    try:
        c = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
        fcntl.ioctl(c, 0x560B)                # VT_LOCKSWITCH
        os.close(c)
    except OSError:
        pass


def temoin_corrompre():
    """What an intruder leaves on a volume: a file altered, another slipped in,
