            titre = "ALARME A LA DERNIERE EXTINCTION : LE DISQUE AVAIT CHANGE SANS LA PHRASE"
            diffs = [("MODIFIE", ALARME.lstrip("/"), "extinction du %s - le disque est de nouveau conforme, ce qui ne prouve rien : sudo osmo-empreinte prendre, apres avoir regarde la boite noire" % quand)]
        else:
            dire("disque systeme conforme : sha256 %s (%s)%s%s" % (
                tete["meta"], tete.get("pris"), ", empreinte signee" if sig else ", empreinte pas encore signee",
                ", cle ancree dans le TPM" if anc is not None else ""))
