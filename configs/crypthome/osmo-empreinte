def bip(secondes=6, console=False):
    """console=True - the alarm AT SHUTDOWN, on the text console: no desktop is
    left to hear it through. The sound servers of the accounts (pipewire,
    pulseaudio) are still there when the account lingers, HOLDING the card and
    playing nothing: they are killed, and the tone goes straight to every
    analog output of every card (ALSA). Seen on 2026-11-26: without this the
    full test of the alarm was silent.
    THE NASTY BEEP: the PC speaker in two alternating tones (pcspkr, console
    ioctl), the console bell, and the sound card when ALSA answers (at
    shutdown the sound server is gone, the card is free). THE VOLUME IS NOT
    THE LISTENER'S: every output of every card is unmuted and put to its
    maximum first - a beep nobody hears, or turned down, is no warning."""
    import fcntl
    son = None
    try:
        for carte in sorted(os.listdir("/proc/asound")):
            if not (carte.startswith("card") and carte[4:].isdigit()):
                continue
            for ctl in ("Master", "Speaker", "Headphone", "PCM", "Front", "Beep"):
                subprocess.run(["amixer", "-q", "-c", carte[4:], "sset", ctl, "100%", "unmute"],
                               capture_output=True, timeout=5)
            # the speakers even with a headphone plugged in
            subprocess.run(["amixer", "-q", "-c", carte[4:], "sset", "Auto-Mute Mode", "Disabled"],
                           capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass
    directs = []
    if console and not TEST:
        try:
            # the bench's own system-wide PulseAudio (osmo-pulse.service, the
            # GSM audio) holds the analog card too: stopped as a unit (killed,
            # it would be restarted), then whatever sound server is left
            subprocess.run(["systemctl", "stop", "--no-block", "osmo-pulse.service"], capture_output=True, timeout=8)
            for nom in ("wireplumber", "pipewire-pulse", "pipewire", "pulseaudio"):
                subprocess.run(["pkill", "-KILL", "-x", nom], capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass
        # every playback device that is not HDMI: « 01-00: ALC255 Analog : ... : playback 1 ».
        # A device still held (« busy ») for a moment is tried again.
        try:
            with open("/proc/asound/pcm") as f:
                sorties = [l.split(":")[0].strip().split("-") for l in f if "playback" in l and "HDMI" not in l.upper()]
        except OSError:
            sorties = []
        for c_, d_ in sorties:
            for _essai in range(8):
                try:
                    j = subprocess.Popen(["timeout", str(secondes), "speaker-test", "-D", "plughw:%d,%d" % (int(c_), int(d_)),
                                          "-t", "sine", "-f", "1900", "-c", "2"],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except (OSError, ValueError):
                    break
                time.sleep(0.5)
                if j.poll() is None:              # still playing: it has the card
                    directs.append(j)
                    break
    # a desktop session still open holds the card through its sound server
    # (pipewire / pulseaudio): the same there, as its user - every sink
    # unmuted, at 100 %, and the tone played through it
    bureau = []
    try:
        import glob
        import pwd
        for prise in ([] if console else glob.glob("/run/user/*/pulse/native")):
            uid = int(prise.split("/")[3])
            env = dict(os.environ, XDG_RUNTIME_DIR="/run/user/%d" % uid, PULSE_SERVER="unix:" + prise)
            pre = [] if uid == os.geteuid() else ["runuser", "-u", pwd.getpwuid(uid).pw_name, "--"]
            r = subprocess.run(pre + ["pactl", "list", "short", "sinks"], env=env, capture_output=True, text=True, timeout=5)
            for ligne in r.stdout.splitlines():
                nom = ligne.split("\t")[1] if "\t" in ligne else ""
                if nom:
                    subprocess.run(pre + ["pactl", "set-sink-mute", nom, "0"], env=env, capture_output=True, timeout=5)
                    subprocess.run(pre + ["pactl", "set-sink-volume", nom, "100%"], env=env, capture_output=True, timeout=5)
            bureau.append(subprocess.Popen(pre + ["timeout", str(secondes), "speaker-test", "-D", "pulse", "-t", "sine",
                                                  "-f", "1900", "-c", "2"], env=env,
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        pass
    try:
        subprocess.run(["modprobe", "pcspkr"], capture_output=True, timeout=10)
        if not bureau and not directs:
            son = subprocess.Popen(["timeout", str(secondes), "speaker-test", "-t", "sine", "-f", "1900", "-c", "2"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        c = None
    fin = time.monotonic() + secondes
    k = 0
    while time.monotonic() < fin:
        if c is not None:
            try:
                fcntl.ioctl(c, 0x4B2F, 1193180 // (2600 if k % 2 else 1300))   # KIOCSOUND
            except OSError:
                pass
            if k % 4 == 0:
                try:
                    os.write(c, b"\a")
                except OSError:
                    pass
        k += 1
        time.sleep(0.18)
    if c is not None:
        try:
            fcntl.ioctl(c, 0x4B2F, 0)
        except OSError:
            pass
        os.close(c)
    for s in bureau + directs + ([son] if son is not None else []):
        try:
            s.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            s.kill()
    return 0


