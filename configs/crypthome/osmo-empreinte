        titre, tete = "L EMPREINTE DU SYSTEME A DISPARU DE LA BOITE NOIRE", {}
        diffs = [("SUPPRIME", TOTAUX.lstrip("/"), "plus rien ne prouve l etat du disque")]
    elif not diffs:
        sig, anc = signature_ok(), ancre_lue()
        if anc is not None and pub_empreinte() != anc:
            titre = "LA CLE DE SIGNATURE N EST PAS CELLE ANCREE DANS LE TPM"
            diffs = [("MODIFIE", SIG_PUB.lstrip("/"), "cle de signature remplacee ou retiree sur la boite : l empreinte du disque ne prouve plus rien")]
        elif sig is False or (anc is not None and sig is not True):
            titre = "L EMPREINTE DU DISQUE N EST PAS SIGNEE PAR LA PHRASE DE /home"
            diffs = [("MODIFIE", TOTAUX.lstrip("/"), "refaite sans la phrase : le disque lui est conforme, mais rien ne prouve que c est celui que tu as valide")]
        elif os.path.exists(ALARME):
            try:
                with open(ALARME) as f:
