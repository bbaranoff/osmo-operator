def tpm_demarrage():
    """Measured boot (option, osmo-tpm): posed, and the TPM gave no code -
    firmware, GRUB, kernel, initramfs or the disk are not the sealed ones."""
    if not os.path.exists("/etc/osmo-tpm/actif") or os.path.exists("/run/osmo-tpm/reconnu"):
        return
    if os.path.exists(SANS_HOME):
        return                                # already refused at the disk's warning
    titre = "LE TPM NE RECONNAIT PAS CE DEMARRAGE"
    diffs = [("TPM", "", "ni code ni phrase (ou PIN faux) : micrologiciel, GRUB, noyau, initramfs ou disque systeme ne sont pas ceux qui ont ete scelles"),
             ("TPM", "", "attendu UNE fois apres « osmo-tpm poser », ou apres une mise a jour du noyau / de GRUB dans la derniere session : alors OUI, puis sudo osmo-tpm sceller")]
    alerter(titre, diffs, {})
    dire(titre)
    if not console_alerte(titre, diffs):
        try:
            open(SANS_HOME, "w").close()
        except OSError:
            pass


def home():
    """unlock-home, the volume just opened and still read-only, before /home
    is put over it: the /home volume against its fingerprint. The passphrase
    has been typed by then - this says, it cannot prevent."""
    if not (TEST or os.path.ismount(HOME_DISQUE)) or not (TEST or os.path.ismount(BOITE)):
        return 0
    tete, diffs = comparer("home", HOME_DISQUE)
    if diffs is None:
        return 0                          # never taken yet: it is at the next commit
    if not diffs:
        dire("volume /home conforme : sha256 %s (%s)" % (tete["meta"], tete.get("pris")))
        return 0
    titre = "LE VOLUME /home A ETE MODIFIE HORS SESSION"
    alerter(titre, [(k, "home/" + p, d) for k, p, d in diffs], tete)
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
        l = ["", ROUGE + "#" * 76, "   !!!  " + titre + "  !!!",
             "   %d difference(s) avec son empreinte (boite noire) :" % len(diffs)]
        l += [("     %-8s /home/%s%s" % (k, p, ("  (%s)" % d) if d else ""))[:118] for k, p, d in diffs[:12]]
        l += ["   Detail : %s" % ALERTE, "#" * 76 + FIN, ""]
        os.write(c, "\r\n".join(l).encode())
        os.close(c)
        time.sleep(12)
    except OSError:
        pass
    return 3


def fond():
    """The complete control, after boot: the CONTENT of every volume, read
    again. Says so on every terminal and on the desktop."""
    tout = []
    for nom, racine in couches().items():
        tete, diffs = comparer(nom, racine, complet=True)
        if diffs:
            pre = "" if nom == "racine" else "home/"
            tout += [(k, pre + p, d) for k, p, d in diffs]
            ref = tete
    try:
        open(FOND_FAIT, "w").close()
    except OSError:
        pass
    if not tout:
        return 0
    # what the boot control already reported is not reported twice
    deja = ""
    try:
        with open(ALERTE) as f:
            deja = f.read()
    except OSError:
        pass
    nouveaux = [d for d in tout if ("/%s" % d[1]) not in deja]
    if nouveaux:
        txt = alerter("CONTENU DU DISQUE MODIFIE HORS SESSION (controle complet)", nouveaux, ref)
        try:
            subprocess.run(["wall"], input="osmo-empreinte : " + txt[:3000], text=True, timeout=10, capture_output=True)
        except (OSError, subprocess.TimeoutExpired):
            pass
    return 0


def sceau():
    """unlock-home, the /home volume just opened: the signing key of the box
    is the one /home knows, and the totals carry its signature."""
    if not os.path.exists(TOTAUX):
        return 0
    connue = None
    for base in (HOME_DISQUE,) if TEST else (HOME_DISQUE, "/home"):   # (/home: the direct mode)
        try:
            with open(os.path.join(base, PUB_HOME), "rb") as f:
                connue = f.read()
            break
        except OSError:
            pass
    try:
        with open(SIG_PUB, "rb") as f:
            boite = f.read()
    except OSError:
        boite = None
    if connue is None and boite is None:
        return 0                              # never signed yet
    if connue is None:
        epingler(boite)                       # signed before the pin existed: pinned now
        connue = boite
    if connue == boite and signature_ok():
        return 0
    try:
        with open(ALERTE) as f:
            if "CLE DE SIGNATURE" in f.read():
                return 3                      # already said at this boot
    except OSError:
        pass
    titre = "LA CLE DE SIGNATURE DE LA BOITE N EST PAS CELLE QUE /home CONNAIT"
    txt = alerter(titre, [("MODIFIE", SIG_PUB.lstrip("/"), "cle ou signature changee sur la boite : l empreinte du disque ne prouve plus rien")], {})
    dire(txt.splitlines()[0])
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
        l = ["", "\a" + ROUGE + "#" * 76, "   !!!  " + titre + "  !!!",
             "   La cle qui signe l empreinte du disque, ou la signature, a ete changee sur la",
             "   boite noire : le controle de ce demarrage ne prouve rien.",
             "   Si c est toi (phrase de /home) : sudo osmo-empreinte prendre   -   Detail : %s" % ALERTE,
             "#" * 76 + FIN, ""]
        os.write(c, "\r\n".join(l).encode())
        os.close(c)
        time.sleep(12)
    except OSError:
        pass
    return 3


def bip(secondes=6):
    """THE NASTY BEEP: the PC speaker in two alternating tones (pcspkr, console
    ioctl), the console bell, and the sound card when ALSA answers (at
    shutdown the sound server is gone, the card is free). THE VOLUME IS NOT
    THE LISTENER'S: every output of every card is unmuted and put to its
    maximum first - a beep nobody hears, or turned down, is no warning."""
    import fcntl
    son = None
    try:
        for carte in sorted(os.listdir("/proc/asound")):
            if not (carte.startswith("card") and carte[4:].isdigit()):
                continue
            for ctl in ("Master", "Speaker", "Headphone", "PCM", "Front", "Beep"):
                subprocess.run(["amixer", "-q", "-c", carte[4:], "sset", ctl, "100%", "unmute"],
                               capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        subprocess.run(["modprobe", "pcspkr"], capture_output=True, timeout=10)
        son = subprocess.Popen(["timeout", str(secondes), "speaker-test", "-t", "sine", "-f", "1900", "-c", "2"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        c = None
    fin = time.monotonic() + secondes
    k = 0
    while time.monotonic() < fin:
        if c is not None:
            try:
                fcntl.ioctl(c, 0x4B2F, 1193180 // (2600 if k % 2 else 1300))   # KIOCSOUND
            except OSError:
                pass
            if k % 4 == 0:
                try:
                    os.write(c, b"\a")
                except OSError:
                    pass
        k += 1
        time.sleep(0.18)
    if c is not None:
        try:
            fcntl.ioctl(c, 0x4B2F, 0)
        except OSError:
            pass
        os.close(c)
    if son is not None:
        try:
            son.wait(timeout=3)
        except (OSError, subprocess.TimeoutExpired):
            son.kill()
    return 0


# THE BIG RED SCREEN of the alarm: the whole console red, and in block letters
GROS = {
    "A": (" ### ", "#   #", "#####", "#   #", "#   #"), "D": ("#### ", "#   #", "#   #", "#   #", "#### "),
    "E": ("#####", "#    ", "#### ", "#    ", "#####"), "G": (" ####", "#    ", "#  ##", "#   #", " ####"),
    "H": ("#   #", "#   #", "#####", "#   #", "#   #"), "I": ("#####", "  #  ", "  #  ", "  #  ", "#####"),
    "M": ("#   #", "## ##", "# # #", "#   #", "#   #"), "N": ("#   #", "##  #", "# # #", "#  ##", "#   #"),
    "O": (" ### ", "#   #", "#   #", "#   #", " ### "), "S": (" ####", "#    ", " ### ", "    #", "#### "),
    "T": ("#####", "  #  ", "  #  ", "  #  ", "  #  "), "U": ("#   #", "#   #", "#   #", "#   #", " ### "),
    "V": ("#   #", "#   #", "#   #", " # # ", "  #  "), "Y": ("#   #", " # # ", "  #  ", "  #  ", "  #  "),
    "!": ("  #  ", "  #  ", "  #  ", "     ", "  #  "), " ": ("     ",) * 5,
}


def ecran_alarme(lignes=()):
    """« YOU HAVE DONE SOMETHING NASTY !!!! », white on a red screen, then
    the lines given (what changed, what to do)."""
    try:
        c = os.open(CONSOLE, os.O_WRONLY | os.O_NOCTTY)
    except OSError:
        return
    try:
        larg = os.get_terminal_size(c).columns
    except OSError:
        larg = 80
    l = ["\033[0m\033[41;1;37m\033[2J\033[H", ""]
    for mot in ("YOU HAVE DONE", "SOMETHING", "NASTY !!!!"):
        for r in range(5):
            t = " ".join(GROS[ch][r] for ch in mot)
            # white cells on the red: no glyph needed, whatever the console font
            l.append(" " * max(0, (larg - len(t)) // 2) + t.replace("#", "\033[47m \033[41m"))
        l.append("")
    l += ["   " + x for x in lignes]
    try:
        os.write(c, ("\r\n".join(l) + "\r\n").encode())
    except OSError:
        pass
    os.close(c)


def extinction():
    """osmo-racine-live fin, BEFORE the session is written or dropped: the
    disks against their fingerprint. Nothing at boot and a difference now:
    something wrote to the disk DURING this session without the passphrase
    (a validated write takes and signs the fingerprint again - that one finds
    nothing here). Red on the console, a record in the box, the beep."""
    if not TEST and not os.path.ismount(BOITE):
        return 0
    if os.path.exists(ALERTE):
        return 0                              # already said at boot: not twice
    trouve = []
    for nom, racine in couches().items():
        tete, diffs = comparer(nom, racine)
        if diffs:
            trouve.append((racine, tete, diffs))
    if not trouve and signature_ok() is False:
        trouve.append((BOITE, {}, [("MODIFIE", TOTAUX.lstrip("/"), "l empreinte n est plus signee par la phrase de /home")]))
    if not trouve:
        dire("extinction : sommes de controle conformes, comme au demarrage")
        return 0
    titre = "LE DISQUE A CHANGE PENDANT LA SESSION, SANS LA PHRASE"
    for cmd in () if TEST else (["plymouth", "quit"], ["chvt", "1"]):
        try:
            subprocess.run(cmd, capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass
    l = ["!!!  " + titre + "  !!!", "",
         "Propre au demarrage, different a l extinction : quelque chose a ecrit sur le",
         "disque pendant cette session sans passer par une validation.", ""]
    if boite_rw(True):
        try:
            with open(ALARME, "w") as f:
                f.write(time.strftime("%F %T") + "\n")
                for racine, tete, diffs in trouve:
                    f.write(texte_alerte(racine, diffs, tete))
            os.sync()
        except OSError:
            pass
        finally:
            boite_rw(False)
    for racine, tete, diffs in trouve:
        alerter("%s : %s" % (titre, racine), diffs, tete)
        dire("%s : %s, %d difference(s)" % (titre, racine, len(diffs)))
        for k, p, d in diffs[:10]:
            l.append(("  %-8s %s/%s%s" % (k, racine.rstrip("/"), p, ("  (%s)" % d) if d else ""))[:112])
        if len(diffs) > 10:
            l.append("  ... et %d autre(s)" % (len(diffs) - 10))
    l += ["", "C est note dans la boite noire. Le prochain demarrage le redira, et seul le",
          "proprietaire (phrase de /home) pourra ouvrir une session.", "",
          "LA MACHINE NE S ETEINT PAS. Pour l eteindre : maintiens le bouton d alimentation."]
    if TEST:
        sys.stdout.write("\n".join(l) + "\n")
        return 3
    ecran_alarme(l)
    bip()
    time.sleep(6)
    return 3


def rappel():
    """Desktop: the INTEGRITY warning as a dialog, the only one at login, and
    only when the complete control found something (it waits for it). The
    box not copied elsewhere is said in red in every terminal, not here."""
    for _ in range(90):
        if os.path.exists(FOND_FAIT) or os.path.exists(ALERTE):
            break
        time.sleep(2)
    time.sleep(1)
    # what the boot found was said at boot, on the console, before /home was
    # opened: the desktop only shows what the complete control found since
    try:
        with open(ALERTE) as f:
            txt = f.read()
    except OSError:
        return 0
    blocs = [b for b in txt.split("\n\n") if "(controle complet)" in b]
    if not blocs:
        return 0
    txt = "\n\n".join(blocs)
    corps = ('<span foreground="red" weight="bold" size="x-large">DISQUE SYSTEME MODIFIE HORS SESSION</span>\n\n'
             '<span foreground="red">Le systeme n est pas celui que la derniere session a laisse.\n'
             'Quelqu un a pu ecrire sur le disque machine eteinte.</span>\n\n<tt>%s</tt>\n\n'
             'Detail : %s   -   sudo osmo-empreinte controler --complet') % (
                 txt[:1500].replace("&", "&amp;").replace("<", "&lt;"), ALERTE)
    try:
        subprocess.run(["zenity", "--error", "--no-wrap", "--title", "osmo-operator : ALERTE", "--text", corps])
    except OSError:
        pass
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "controler"
    if cmd == "rappel":
        return rappel()
    if os.geteuid() != 0 and not TEST:
        sys.exit("osmo-empreinte : root requis")
    if cmd in ("prendre", "ancrer", "phrase-changee", "resceller", "coffre-sceller") and not TEST:
        # what these leave in /home (signature key, pin, vault) must not come
        # back in time: the session can no longer be « remise a zero »
        try:
            subprocess.run(["/usr/local/sbin/osmo-reset", "interdire",
                            "des secrets ou l empreinte ont ete refaits pendant cette session"],
                           capture_output=True, timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            pass
    if cmd == "prendre":
        return prendre(lire_phrase())
    if cmd == "coffre-sceller":
        return coffre("sceller")
    if cmd == "coffre-desceller" and len(sys.argv) > 2:
        return coffre("desceller", sys.argv[2])
    if cmd == "demarrage":
        copie_demarrage()
        rc = demarrage()
        tpm_demarrage()
        return rc
    if cmd == "resceller":
        return resceller(lire_phrase())
    if cmd == "home-direct":
        return home_direct(lire_phrase())
    if cmd == "ancrer":
        return ancrer(lire_phrase())
    if cmd == "phrase-changee" and "--stdin" in sys.argv[2:]:
        # two lines: the old passphrase, the new one (osmo-secrets)
        return phrase_changee(sys.stdin.buffer.readline().rstrip(b"\r\n"), sys.stdin.buffer.readline().rstrip(b"\r\n"))
    if cmd == "phrase-changee":
        import getpass
        return phrase_changee(getpass.getpass("ANCIENNE phrase de /home : ").encode(),
                              getpass.getpass("NOUVELLE phrase de /home : ").encode())
    if cmd == "signature":
        sig, anc = signature_ok(), ancre_lue()
        dire("signature de l empreinte : %s" % {True: "valide", False: "FAUSSE OU ABSENTE", None: "pas encore de signature"}[sig])
        if anc is None:
            dire("ancre TPM : aucune (sudo osmo-empreinte ancrer)")
        else:
            dire("ancre TPM : %s" % ("la cle de la boite est celle du TPM" if pub_empreinte() == anc else "LA CLE DE LA BOITE N EST PAS CELLE DU TPM"))
        return 0 if sig and (anc is None or pub_empreinte() == anc) else 3
    if cmd == "bip":
        # the alarm itself: it sets every volume to its maximum - not a toy
        return bip() if "--alarme" in sys.argv[2:] else 0
    if cmd == "alarme":
        # the same red screen and beep again, while the shutdown is held
        ecran_alarme(["!!!  LE DISQUE A CHANGE PENDANT LA SESSION, SANS LA PHRASE  !!!", "",
                      "Rien n a ete ecrit ; la boite noire a tout note (detail : %s)." % ALERTE, "",
                      "LA MACHINE NE S ETEINT PAS. Pour l eteindre : maintiens le bouton d alimentation."])
        return bip()
    if cmd == "extinction":
        return extinction()
    if cmd == "fond":
        return fond()
    if cmd == "sceau":
        return sceau()
    if cmd == "home":
        return home()
    if cmd == "controler":
        complet, rc = "--complet" in sys.argv[2:], 0
        for nom, racine in couches().items():
            tete, diffs = comparer(nom, racine, complet=complet)
            if diffs is None:
                dire("%-6s pas d empreinte : osmo-empreinte prendre" % nom)
                rc = rc or 2
            elif not diffs:
                dire("%-6s conforme : sha256 %s  (%s, %d entrees%s)" % (
                    nom, tete["meta"], tete.get("pris"), tete.get("entrees", 0), ", contenu relu" if complet else ""))
            else:
                sys.stdout.write(ROUGE + texte_alerte("%s DIFFERE DE SON EMPREINTE" % racine, diffs, tete) + FIN)
                rc = 3
        return rc
    sys.exit("usage : osmo-empreinte prendre | controler [--complet] | signature | ancrer | phrase-changee | demarrage | home | fond | sceau | rappel")


if __name__ == "__main__":
    sys.exit(main())
