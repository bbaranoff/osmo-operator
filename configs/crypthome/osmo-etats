#!/usr/bin/python3
# osmo-etats - BROWSE THE STATES OF THE SYSTEM LIKE CODE ON GitHub.
#
# Every validated write to the system disk is a commit (osmo-racine-live):
# what it replaced or removed is kept next to the root, in
# /.osmo-retour/<commit>/files, with the list of what it created (crees). That
# is enough to rebuild ANY of those states without touching the disk:
#
#   the content of a path AFTER commit C = what the first LATER commit that
#   touched it has put aside; none did: what the disk holds now. (A later
#   commit that CREATED it: it did not exist.)
#
# This serves it as pages, read-only, on this machine only:
#
#   /                 the commits, newest first, grouped by session - and, at
#                     the top, the session in progress (the RAM layer)
#   /commit/ID        what that commit changed: every file, with its diff
#   /tree/ID/PATH     the directories of the system AS THEY WERE after ID
#   /blob/ID/PATH     a file as it was after ID
#
#   osmo-etats [--port N] [--sans-navigateur]
#
# PERIMETER. The past states are kept IN THE /home VOLUME
# (.osmo-retour/systeme, put there by osmo-racine-live after each write): they
# can only be read with /home open, i.e. by the owner. A guest root session
# gets nothing - this refuses to start when /home is closed. It runs as root,
# listens on 127.0.0.1 only, and every URL carries a random key printed at
# start: no other account of the machine and no web page can ask it anything.
# It writes nothing. The owner's own files in /home are not shown.
import difflib
import html
import http.server
import os
import secrets
import stat
import subprocess
import sys
import urllib.parse

BAS = os.environ.get("OSMO_ETATS_BAS", "/media/root-ro")
HAUT = os.environ.get("OSMO_ETATS_HAUT", "/media/root-rw/overlay")
RET_DISQUE = os.path.join(BAS, ".osmo-retour")


def volume_home():
    """The /home VOLUME, where the past states of the system are kept
    (osmo-racine-live ranger): read-only under the RAM layer, or /home itself
    when it is written to directly. None: /home is closed - a guest session."""
    force = os.environ.get("OSMO_ETATS_VOLUME")
    if force:
        return force
    for m in ("/media/home-ro", "/home"):
        if not os.path.ismount(m):
            continue
        try:
            src = subprocess.run(["findmnt", "-fno", "SOURCE", m], capture_output=True, text=True, timeout=5).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            continue
        if os.path.realpath(src).startswith("/dev/dm-"):
            return m
    return None


VOLUME = volume_home()
GARAGE = os.path.join(VOLUME, ".osmo-retour", "systeme") if VOLUME else None


def rep(c):
    """Where commit c keeps what it replaced: the /home volume, or still the
    disk (a commit not put away yet)."""
    if GARAGE and os.path.exists(os.path.join(GARAGE, c, "FAIT")):
        return os.path.join(GARAGE, c)
    return os.path.join(RET_DISQUE, c)
CACHES = (".osmo-retour", ".osmo-valider")
MAX_TEXTE = 400 * 1024
MAX_DIFFS = 300
EN_COURS = "en-cours"                       # the session in progress, as a pseudo-commit
CLE = secrets.token_urlsafe(18)


def commits():
    """Finished commits, oldest first."""
    t = set()
    for d in (GARAGE, RET_DISQUE):
        try:
            t.update(c for c in os.listdir(d) if not c.startswith(".") and os.path.exists(os.path.join(d, c, "FAIT")))
        except (OSError, TypeError):
            pass
    return sorted(t)


def lire(chemin, n=4096):
    try:
        with open(chemin, errors="replace") as f:
            return f.read(n)
    except OSError:
        return ""


def date_de(c):
    if len(c) == 15 and c[8] == "-":
        return "%s-%s-%s %s:%s:%s" % (c[:4], c[4:6], c[6:8], c[9:11], c[11:13], c[13:15])
    return c


def crees(c):
    return [p for p in lire(os.path.join(rep(c), "crees"), 1 << 24).split("\n") if p]


def mis_de_cote(c):
    """Paths (files and links) that commit c replaced or removed."""
    base = os.path.join(rep(c), "files")
    for d, _dirs, fichiers in os.walk(base):
        for f in fichiers:
            yield os.path.join(d, f)[len(base):]


def existe(p):
    return os.path.lexists(p)


def whiteout(p):
    try:
        s = os.lstat(p)
    except OSError:
        return False
    return stat.S_ISCHR(s.st_mode) and s.st_rdev == 0


def source(c, chemin):
    """Where the content of `chemin` AFTER commit c is to be read: a real path,
    or None when it did not exist. c == EN_COURS: the running session."""
    if c == EN_COURS:
        h = HAUT + chemin
        if whiteout(h):
            return None
        return h if existe(h) else (BAS + chemin if existe(BAS + chemin) else None)
    tous = commits()
    try:
        apres = tous[tous.index(c) + 1:]
    except ValueError:
        apres = tous
    for d in apres:
        v = os.path.join(rep(d), "files") + chemin
        if existe(v) and not os.path.isdir(v):
            return v
        if chemin in _crees_cache(d):
            return None
    r = BAS + chemin
    return r if existe(r) else None


_cc = {}


def _crees_cache(c):
    if c not in _cc:
        _cc[c] = set(crees(c))
    return _cc[c]


def avant(c):
    """The state BEFORE commit c: the commit before it, or '' (the oldest known)."""
    if c == EN_COURS:
        t = commits()
        return t[-1] if t else ""
    t = commits()
    i = t.index(c)
    return t[i - 1] if i > 0 else ""


def source_avant(c, chemin):
    """Content of `chemin` BEFORE commit c."""
    if c == EN_COURS:
        r = BAS + chemin
        return r if existe(r) else None
    v = os.path.join(rep(c), "files") + chemin
    if existe(v) and not os.path.isdir(v):
        return v
    if chemin in _crees_cache(c):
        return None
    return source(c, chemin)                 # untouched by c


def changes(c):
    """[(kind, path)] for commit c: A added, M modified, D deleted."""
    out = []
    if c == EN_COURS:
        for d, dirs, fichiers in os.walk(HAUT):
            for f in fichiers + [x for x in dirs if os.path.islink(os.path.join(d, x))]:
                p = os.path.join(d, f)[len(HAUT):]
                if p.startswith(("/tmp/", "/var/tmp/", "/run/")):
                    continue
                if whiteout(HAUT + p):
                    if existe(BAS + p):
                        out.append(("D", p))
                elif existe(BAS + p):
                    out.append(("M", p))
                else:
                    out.append(("A", p))
        return sorted(out, key=lambda x: x[1])
    cr = _crees_cache(c)
    for p in mis_de_cote(c):
        out.append(("M" if source(c, p) is not None else "D", p))
    vus = {p for _k, p in out}
    for p in cr:
        if p not in vus:
            s = source(c, p)
            if s is None or not os.path.isdir(s) or os.path.islink(s):
                out.append(("A", p))
    return sorted(out, key=lambda x: x[1])


def contenu(p):
    """('texte', lines) | ('lien', target) | ('binaire', size) | ('absent', 0) | ('rep', 0)"""
    if p is None:
        return "absent", 0
    try:
        s = os.lstat(p)
    except OSError:
        return "absent", 0
    if stat.S_ISLNK(s.st_mode):
        return "lien", os.readlink(p)
    if stat.S_ISDIR(s.st_mode):
        return "rep", 0
    if not stat.S_ISREG(s.st_mode):
        return "binaire", 0
    if s.st_size > MAX_TEXTE:
        return "binaire", s.st_size
    try:
        with open(p, "rb") as f:
            b = f.read()
    except OSError:
        return "absent", 0
    if b"\0" in b:
        return "binaire", s.st_size
    return "texte", b.decode("utf-8", "replace").splitlines()


def octets(n):
    for u in ("o", "Ko", "Mo", "Go"):
        if n < 1024 or u == "Go":
            return ("%d %s" % (n, u)) if u == "o" else ("%.1f %s" % (n, u))
        n /= 1024.0


def lister(c, chemin):
    """Directory `chemin` as it was after commit c: {name: is_dir}."""
    chemin = chemin.rstrip("/")
    noms = {}
    for racine in ([BAS] if c != EN_COURS else [BAS, HAUT]):
        try:
            for e in os.scandir(racine + (chemin or "/")):
                if racine == BAS and not chemin and e.name in CACHES:
                    continue
                if whiteout(e.path):
                    noms.pop(e.name, None)
                else:
                    noms[e.name] = e.is_dir(follow_symlinks=False)
        except OSError:
            pass
    if c == EN_COURS:
        return noms
    tous = commits()
    try:
        apres = tous[tous.index(c) + 1:]
    except ValueError:
        apres = tous
    for d in reversed(apres):                # undo the later commits, newest first
        for p in _crees_cache(d):
            if os.path.dirname(p) == (chemin or "/"):
                noms.pop(os.path.basename(p), None)
        v = os.path.join(rep(d), "files") + (chemin or "/")
        try:
            for e in os.scandir(v):
                noms[e.name] = e.is_dir(follow_symlinks=False)
        except OSError:
            pass
    return noms


