def page(titre, corps, sous=""):
    return ("<!doctype html><html lang=fr><meta charset=utf-8><title>%s - osmo-operator</title><style>%s</style>"
            "<header><a href='%s'><b>osmo-operator</b> / états du système</a><span>%s</span></header><main>%s</main></html>"
            % (html.escape(titre), CSS, url(""), html.escape(sous), corps)).encode()


def url(reste):
    return "/" + CLE + "/" + reste


def q(p):
    return urllib.parse.quote(p.lstrip("/"))


def nom_etat(c):
    return "session en cours" if c == EN_COURS else date_de(c)


def page_accueil():
    tous = commits()
    o = []
    try:
        n = len(changes(EN_COURS))
    except OSError:
        n = 0
    o.append("<div class='boite cours'><div class=ligne><div class=titre><a href='%s'>Session en cours</a> "
             "<span class=gris>- pas encore enregistrée : %d fichier(s) changé(s), en mémoire</span></div>"
             "<a class=id href='%s'>parcourir</a></div></div>"
             % (url("commit/" + EN_COURS), n, url("tree/" + EN_COURS + "/")))
    session, bloc = None, []

    def vider():
        if bloc:
            o.append("<div class=boite>" + "".join(bloc) + "</div>")
            del bloc[:]
    for c in reversed(tous):
        s = lire(os.path.join(rep(c), "session")).strip()
        if s != session:
            vider()
            session = s
            o.append("<h2>Session %s &nbsp;·&nbsp; démarrage %s</h2>" % (date_de(c)[:10], html.escape(s[:8] or "?")))
        nf = sum(1 for _ in mis_de_cote(c))
        nc = len(_crees_cache(c))
        bloc.append("<div class=ligne><div class=titre><a href='%s'>Écriture du %s</a> "
                    "<span class=gris>- %d remplacé(s) ou supprimé(s), %d créé(s)</span></div>"
                    "<a class=id href='%s'>%s</a><a class=id href='%s'>parcourir</a></div>"
                    % (url("commit/" + c), date_de(c), nf, nc, url("commit/" + c), c, url("tree/" + c + "/")))
    vider()
    if not tous:
        o.append("<div class=note>Aucune écriture validée n'est gardée sur ce disque.</div>")
    return page("États", "".join(o), "%d écriture(s) validée(s) que le disque peut encore montrer" % len(tous))


def bloc_diff(c, k, p):
    a, b = source_avant(c, p), source(c, p)
    ta, va = contenu(a)
    tb, vb = contenu(b)
    tete = ("<div class=tete><span class='b %s'>%s</span><a href='%s'>%s</a></div>"
            % (k, {"A": "ajouté", "M": "modifié", "D": "supprimé"}[k], url("blob/%s/%s" % (c, q(p))), html.escape(p)))
    if "rep" in (ta, tb):
        return ""
    if ta == "texte" and tb == "texte" or (ta == "absent" and tb == "texte") or (ta == "texte" and tb == "absent"):
        la = va if ta == "texte" else []
        lb = vb if tb == "texte" else []
        lignes = []
        for l in difflib.unified_diff(la, lb, "a" + p, "b" + p, lineterm="", n=3):
            if l.startswith(("---", "+++")):
                continue
            cl = "h" if l.startswith("@@") else "p" if l.startswith("+") else "m" if l.startswith("-") else ""
            lignes.append("<span class='%s'>%s</span>" % (cl, html.escape(l) or " "))
            if len(lignes) > 1500:
                lignes.append("<span class=h>... diff coupé (trop long)</span>")
                break
        corps = "<pre>%s</pre>" % "".join(lignes) if lignes else "<div class=note>contenu identique (droits ou dates seulement)</div>"
    else:
        def dit(t, v):
            return {"absent": "absent", "lien": "lien → %s" % v, "binaire": "binaire, %s" % octets(v or 0),
                    "texte": "texte, %d ligne(s)" % (len(v) if isinstance(v, list) else 0)}.get(t, t)
        corps = "<div class=note>avant : %s &nbsp;→&nbsp; après : %s</div>" % (html.escape(dit(ta, va)), html.escape(dit(tb, vb)))
    return "<div class=fichier>%s%s</div>" % (tete, corps)


def page_commit(c):
    ch = changes(c)
    o = ["<div class=chemin><span class=sel>%s</span> &nbsp; <a href='%s'>parcourir le système à cet état</a>"
         % (html.escape(nom_etat(c)), url("tree/" + c + "/"))]
    av = avant(c)
    if av:
        o.append(" &nbsp;·&nbsp; état d'avant : <a href='%s'>%s</a>" % (url("commit/" + av), date_de(av)))
    o.append("</div><div class=boite>")
    for k, p in ch[:2000]:
        o.append("<div class=ligne><span class='b %s'>%s</span><a href='%s'>%s</a></div>"
                 % (k, k, url("blob/%s/%s" % (c, q(p))), html.escape(p)))
    if not ch:
        o.append("<div class=note>aucun fichier changé</div>")
    o.append("</div>")
    for k, p in ch[:MAX_DIFFS]:
        o.append(bloc_diff(c, k, p))
    if len(ch) > MAX_DIFFS:
        o.append("<div class=note>%d autres fichiers : ouvre-les depuis la liste.</div>" % (len(ch) - MAX_DIFFS))
    return page(nom_etat(c), "".join(o), "%d fichier(s) changé(s)" % len(ch))


def fil(c, chemin, genre):
    parts = [x for x in chemin.split("/") if x]
    o = ["<span class=sel>%s</span> &nbsp; <a href='%s'>/</a>" % (html.escape(nom_etat(c)), url("tree/%s/" % c))]
    for i, x in enumerate(parts):
        dernier = i == len(parts) - 1
        cible = url("%s/%s/%s" % ("blob" if dernier and genre == "blob" else "tree", c, q("/".join(parts[:i + 1]))))
        o.append(" <a href='%s'>%s</a>%s" % (cible, html.escape(x), "" if dernier and genre == "blob" else " /"))
    return "<div class=chemin>%s</div>" % "".join(o)


def page_tree(c, chemin):
    noms = lister(c, chemin)
    o = [fil(c, chemin, "tree"), "<div class=boite><table>"]
    if chemin.strip("/"):
        o.append("<tr><td><a href='%s'>..</a></td><td class=n></td></tr>" % url("tree/%s/%s" % (c, q(os.path.dirname(chemin.rstrip("/"))))))
    for n in sorted(noms, key=lambda x: (not noms[x], x.lower())):
        p = chemin.rstrip("/") + "/" + n
        if noms[n]:
            o.append("<tr><td>📁 <a href='%s'>%s</a></td><td class=n></td></tr>" % (url("tree/%s/%s" % (c, q(p))), html.escape(n)))
        else:
            s = source(c, p)
            t = ""
            try:
                st = os.lstat(s) if s else None
                t = "lien" if st and stat.S_ISLNK(st.st_mode) else octets(st.st_size) if st else ""
            except OSError:
                pass
            o.append("<tr><td>📄 <a href='%s'>%s</a></td><td class=n>%s</td></tr>" % (url("blob/%s/%s" % (c, q(p))), html.escape(n), t))
    o.append("</table></div>")
    return page(chemin or "/", "".join(o), "le système tel qu'il était : " + nom_etat(c))


def page_blob(c, chemin):
    s = source(c, chemin)
    t, v = contenu(s)
    if t == "rep":
        return page_tree(c, chemin)
    o = [fil(c, chemin, "blob"), "<div class=fichier><div class=tete>%s</div>" % html.escape(chemin)]
    if t == "texte":
        o.append("<pre>%s</pre>" % "".join("<span><i class=num>%d</i>%s</span>" % (i + 1, html.escape(l)) for i, l in enumerate(v)))
    elif t == "lien":
        o.append("<div class=note>lien symbolique → %s</div>" % html.escape(str(v)))
    elif t == "binaire":
        o.append("<div class=note>fichier binaire ou trop gros pour être affiché (%s)</div>" % octets(v or 0))
    else:
        o.append("<div class=note>ce fichier n'existait pas à cet état</div>")
    o.append("</div>")
    # its history: every state that changed it
    h = []
    for d in [EN_COURS] + list(reversed(commits())):
        try:
            if d == EN_COURS:
                touche = existe(HAUT + chemin)
            else:
                touche = existe(os.path.join(rep(d), "files") + chemin) or chemin in _crees_cache(d)
        except OSError:
            touche = False
        if touche:
            h.append("<div class=ligne><div class=titre><a href='%s'>%s</a></div><a class=id href='%s'>voir à cet état</a></div>"
                     % (url("commit/" + d), html.escape(nom_etat(d)), url("blob/%s/%s" % (d, q(chemin)))))
    if h:
        o.append("<h2>Historique de ce fichier</h2><div class=boite>%s</div>" % "".join(h))
    return page(chemin, "".join(o), nom_etat(c))


class Page(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        chemin = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
        hote = (self.headers.get("Host") or "").split(":")[0]
        if hote not in ("127.0.0.1", "localhost") or not chemin.startswith("/" + CLE + "/"):
            self.send_error(403)
            return
        reste = chemin[len(CLE) + 2:]
        try:
            genre, _, suite = reste.partition("/")
            c, _, p = suite.partition("/")
            p = os.path.normpath("/" + p)
            if p == "/":
                p = ""
            if p.startswith("/.osmo-retour") or p.startswith("/.osmo-valider"):
                raise KeyError
            if genre == "":
                corps = page_accueil()
            elif c != EN_COURS and c not in commits():
                raise KeyError
            elif genre == "commit":
                corps = page_commit(c)
            elif genre == "tree":
                corps = page_tree(c, p)
            elif genre == "blob":
                corps = page_blob(c, p)
            else:
                raise KeyError
        except (KeyError, ValueError):
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(corps)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()
        self.wfile.write(corps)


def main():
    if os.geteuid() != 0 and not os.environ.get("OSMO_ETATS_BAS"):
        sys.exit("osmo-etats : root requis (sudo osmo-etats)")
    if VOLUME is None:
        # A GUEST SESSION HAS NO HISTORY TO BROWSE: the past states of the
        # system are in the encrypted volume, and it is closed
        sys.exit("osmo-etats : /home est ferme - les etats du systeme sont dans le volume chiffre, "
                 "seul le proprietaire (phrase de /home) peut les parcourir")
    port = 0
    if "--port" in sys.argv:
        port = int(sys.argv[sys.argv.index("--port") + 1])
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Page)
    adresse = "http://127.0.0.1:%d%s" % (srv.server_address[1], url(""))
    print("Les etats du systeme : %d ecriture(s) validee(s), et la session en cours." % len(commits()))
    print("Ouvre cette adresse dans le navigateur de cette machine :\n\n  %s\n" % adresse)
    print("(lecture seule, cette machine seulement ; Ctrl-C pour arreter)", flush=True)
    if "--sans-navigateur" not in sys.argv:
        qui = os.environ.get("SUDO_USER") or os.environ.get("PKEXEC_UID")
        try:
            if qui and os.environ.get("DISPLAY"):
                if qui.isdigit():
                    import pwd
                    qui = pwd.getpwuid(int(qui)).pw_name
                subprocess.Popen(["runuser", "-u", qui, "--", "xdg-open", adresse],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, KeyError):
            pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
