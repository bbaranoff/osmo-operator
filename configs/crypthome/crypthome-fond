#!/usr/bin/python3
# crypthome-fond - paints an image on the framebuffer during the LUKS prompt at boot.
#
#   crypthome-fond [IMAGE]     (default: CRYPTHOME_IMAGE from /etc/default/crypthome)
#
# unlock-home quits plymouth and reads the passphrase on the text console, i.e. fbcon: a framebuffer
# (/dev/fb0) on which the kernel draws the characters. The image is painted there, darkened at the
# bottom; the prompt is then placed on the LAST line, where fbcon repaints only the cells it writes.
# Input stays on the tty: the image is only decoration, and if it fails (no /dev/fb0, no Pillow,
# unknown pixel format) the script exits 0 with a single line on stderr.
import os
import sys


def lire(chemin, defaut=""):
    try:
        with open(chemin) as f:
            return f.read().strip()
    except OSError:
        return defaut


def image_conf():
    for ligne in lire("/etc/default/crypthome").splitlines():
        if ligne.startswith("CRYPTHOME_IMAGE="):
            return ligne.split("=", 1)[1].strip().strip('"')
    return "/usr/share/backgrounds/gsm-lab-antenne.jpg"


def main():
    chemin = sys.argv[1] if len(sys.argv) > 1 else image_conf()
    try:
        from PIL import Image, ImageDraw
    except ImportError:
        return "Pillow absent"
    sysfb = "/sys/class/graphics/fb0"
    try:
        w, h = (int(v) for v in lire(sysfb + "/virtual_size").split(","))
        bpp = int(lire(sysfb + "/bits_per_pixel"))
        stride = int(lire(sysfb + "/stride") or w * bpp // 8)
    except ValueError:
        return "pas de framebuffer"
    if bpp != 32:
        return "framebuffer %d bits par point, seul 32 est gere" % bpp
    try:
        img = Image.open(chemin).convert("RGB")
    except OSError as e:
        return "image illisible (%s)" % e
    # cover the screen without distortion: scale, then crop at the centre
    k = max(w / img.width, h / img.height)
    img = img.resize((round(img.width * k), round(img.height * k)), Image.LANCZOS)
    x0, y0 = (img.width - w) // 2, (img.height - h) // 2
    img = img.crop((x0, y0, x0 + w, y0 + h))
    # dark band at the bottom: the white console prompt stays readable on it
    bande = Image.new("L", (w, h), 0)
    ImageDraw.Draw(bande).rectangle((0, h - h // 7, w, h), fill=200)
    img = Image.composite(Image.new("RGB", (w, h), (0, 0, 0)), img, bande)
    # little-endian XRGB8888 (B, G, R, X): the fbcon format on simpledrm / nvidia-drm / i915
    brut = img.tobytes("raw", "BGRX")
    try:
        with open("/dev/fb0", "r+b") as fb:
            if stride == w * 4:
                fb.write(brut)
            else:
                for y in range(h):
                    fb.seek(y * stride)
                    fb.write(brut[y * w * 4:(y + 1) * w * 4])
    except OSError as e:
        return "ecriture /dev/fb0 impossible (%s)" % e
    return None


if __name__ == "__main__":
    err = main()
    if err:
        print("crypthome-fond: %s - question sans image." % err, file=sys.stderr)
    sys.exit(0)
