# osmo-bts.script - Plymouth boot animation of the "osmo-bts" theme.
#
# Plymouth calls the refresh function ~50 times per second; the script only
# advances a counter and swaps the image of two sprites: the wave strip
# (24 frames of rings opening from the tower and from the phone) and the
# knob of the progress bar. Tower, phone and title are painted once in
# background.png so the initrd does not carry 24 copies of the scenery.
# Animated preview: wiki/plymouth-osmo-bts.gif (tools/plymouth-render.py --gif).
#
# All positions are FRACTIONS of the real screen size (Window.GetWidth()/
# GetHeight()), so the layout holds on 1366x768 as on 4K. THIS FILE IS A
# TEMPLATE: the @@...@@ placeholders are filled in by tools/plymouth-render.py,
# which draws the background and therefore knows its geometry.

sw = Window.GetWidth();
sh = Window.GetHeight();

# ── BACKGROUND ──────────────────────────────────────────────────────────────
bg_image = Image("background.png");
bg = Sprite(bg_image.Scale(sw, sh));
bg.SetX(0);
bg.SetY(0);
bg.SetZ(-100);

# ── WAVES BETWEEN THE TWO ANTENNAS ──────────────────────────────────────────
# 24 frames played at ~12 fps (one frame every 4 refreshes), files burst-NN.png.
n_frames = 24;
for (i = 0; i < n_frames; i++) {
    if (i < 10) {
        burst_image[i] = Image("burst-0" + i + ".png");
    } else {
        burst_image[i] = Image("burst-" + i + ".png");
    }
    burst_scaled[i] = burst_image[i].Scale(sw * @@BW@@, sh * @@BH@@);
}
# @@BX@@ / @@BY@@ / @@BW@@ / @@BH@@: the strip between the two antennas, as
# screen FRACTIONS injected by tools/plymouth-render.py (it places the tower
# and the phone in background.png, so moving them in the drawing moves the waves).
burst = Sprite();
burst.SetX(sw * @@BX@@);
burst.SetY(sh * @@BY@@);
burst.SetZ(10);

# ── PROGRESS BAR ───────────────────────────────────────────────────────────
box_image = Image("progress-box.png");
bar_image = Image("progress-bar.png");
box_w = sw * 0.27;
box_h = sh * 0.008;
box = Sprite(box_image.Scale(box_w, box_h));
box.SetX((sw - box_w) / 2);
box.SetY(sh * 0.90);
box.SetZ(10);
bar_w = box_w * 0.16;
bar = Sprite(bar_image.Scale(bar_w, box_h));
bar.SetY(sh * 0.90);
bar.SetZ(11);

tick = 0;

# ── PASSWORD ENTRY: THE LUKS PASSPHRASE OF /home ────────────────────────────
# Single prompt ("decrypt /home -passphrase- or Enter"): the passphrase opens
# /home, an empty Enter boots as root without /home. A blinking cursor shows
# in the field while the question is pending and each typed character is
# echoed as "*".
#
# This entry is NOT the default path: unlock-home asks on the text console
# after leaving plymouth. It is used only when /etc/default/crypthome sets
# CRYPTHOME_PROMPT=plymouth; unlock-home then goes through
# systemd-ask-password, whose plymouth agent calls the callbacks below.
# Known limitation: on some Intel + NVIDIA laptops the plymouth keyboard
# input does not work (cursor blinks, no key accepted, timeout).
#
# Everything is declared HERE, before refresh_callback: it blinks the cursor
# and runs from the first frame.
entry_image = Image("entry.png");
entry = Sprite();
entry.SetZ(20);
prompt_sprite = Sprite();
prompt_sprite.SetZ(20);
stars_sprite = Sprite();
stars_sprite.SetZ(21);
# Cursor: a terminal-style underscore (Ubuntu Mono is in the initrd; otherwise
# fontconfig falls back to the default font).
cursor_image = Image.Text("_", 0.95, 0.96, 0.98, 1, "Ubuntu Mono 16");
cursor_sprite = Sprite(cursor_image);
cursor_sprite.SetZ(22);
cursor_sprite.SetOpacity(0);
saisie_visible = 0;

fun refresh_callback() {
    tick++;
    # Waves: one frame every 4 refreshes (~12 fps).
    frame = Math.Int(tick / 4) % n_frames;
    burst.SetImage(burst_scaled[frame]);
    # Knob: a steady back-and-forth in the bar (no boot progress is available
    # to a script theme without a progress plugin, so no fake percentage).
    u = (tick % 200) / 200;
    if (u > 0.5) {
        u = 1 - u;
    }
    bar.SetX((sw - box_w) / 2 + u * 2 * (box_w - bar_w));
    # Cursor: half a second on, half a second off (~50 Hz refresh).
    if (saisie_visible == 1) {
        if (Math.Int(tick / 25) % 2 == 0) {
            cursor_sprite.SetOpacity(1);
        } else {
            cursor_sprite.SetOpacity(0);
        }
    } else {
        cursor_sprite.SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun display_password_callback(prompt, bullets) {
    ew = sw * 0.32;
    eh = sh * 0.052;
    entry.SetImage(entry_image.Scale(ew, eh));
    entry.SetX((sw - ew) / 2);
    entry.SetY(sh * 0.72);
    entry.SetOpacity(1);
    text = Image.Text(prompt, 0.90, 0.93, 0.95, 1, "Ubuntu 15");
    prompt_sprite.SetImage(text);
    prompt_sprite.SetX((sw - text.GetWidth()) / 2);
    prompt_sprite.SetY(sh * 0.66);
    prompt_sprite.SetOpacity(1);
    # Stars: one "*" per typed character, left-aligned in the field.
    marge = sh * 0.016;
    stars_w = 0;
    if (bullets > 0) {
        stars = "";
        for (i = 0; i < bullets; i++) {
            stars = stars + "*";
        }
        simg = Image.Text(stars, 0.95, 0.96, 0.98, 1, "Ubuntu Mono 16");
        stars_sprite.SetImage(simg);
        stars_sprite.SetX((sw - ew) / 2 + marge);
        stars_sprite.SetY(sh * 0.72 + (eh - simg.GetHeight()) / 2);
        stars_sprite.SetOpacity(1);
        stars_w = simg.GetWidth();
    } else {
        stars_sprite.SetOpacity(0);
    }
    # The cursor follows the last "*"; refresh_callback blinks it.
    cursor_sprite.SetX((sw - ew) / 2 + marge + stars_w);
    cursor_sprite.SetY(sh * 0.72 + (eh - cursor_image.GetHeight()) / 2);
    saisie_visible = 1;
}

fun display_normal_callback() {
    entry.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    stars_sprite.SetOpacity(0);
    cursor_sprite.SetOpacity(0);
    saisie_visible = 0;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ── NO MESSAGES ─────────────────────────────────────────────────────────────
# No message callback: what systemd and fsck send to plymouth is not shown
# (it stays in journalctl -b). Anything that really needs to talk during boot
# uses the text console, as unlock-home does for the passphrase.
