# scripts/osmo-porte - the PORTE of an installed bench (initramfs-tools,
# « boot=osmo-porte »). Sourced by /init, which calls mountroot(); it never
# returns: it kexecs nirvana's kernel or root's live system.
#
# Kernel line (written by osmo-grub-esp, measured by GRUB into PCR 8):
#   boot=osmo-porte osmo.luks=<LUKS UUID> osmo.a=<osmo-racine FS UUID>
#   osmo.diffs=<black box FS UUID> panic=10
#
# 1. THE TPM CODE. The TOTP key is an HMAC-SHA256 key INSIDE the TPM
#    (persistent handle 0x81000420, imported by « osmo-porte sceller »), usable
#    only if PCR 0,2,4,7,8,9 - firmware, Secure Boot state, shim/GRUB, GRUB's
#    commands, the files GRUB loaded (this kernel, this initrd, the menu) -
#    are those of the sealing. The TPM computes the HMAC of the 30 s counter;
#    only that one-use value enters RAM, never the key: nothing durable is
#    left behind for the next kernel. Wrong or missing code: something on the
#    way changed. At the decision (Enter, Esc, 60 s), PCR 9 is extended:
#    nothing can use the key again during this boot.
# 2. The black box's last record date - INDICATIVE: read from a clear
#    partition, not measured; root could change it.
#
# Nothing else is read before the decision. The next kernel (nirvana's or
# root's) gets init_on_alloc=1 init_on_free=1: the porte's pages (refused
# passphrases) are zeroed before anyone can be handed them.
# 3. Nirvana's passphrase. Right: the volume is opened, the PCR values of
#    this boot are written in it (for the next sealing), and nirvana's kernel
#    - INSIDE the volume - is kexec'ed. Enter, Esc, 60 s or three refusals:
#    root's live system (osmo-racine partition) is kexec'ed.

HANDLE=0x81000420
PCRS=sha256:0,2,4,7,8,9
EFFACE="init_on_alloc=1 init_on_free=1"
# the « cap »: any value, as long as it changes PCR 9 once the decision is taken
CAP=6f736d6f2d706f7274652d636170202d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d
export TPM2TOOLS_TCTI=device:/dev/tpmrm0
CONSOLE=/dev/console

parametre() { for x in $(cat /proc/cmdline); do case "$x" in "$1"=*) echo "${x#*=}"; return;; esac; done; }

dire() { printf '%s\n' "$*" > "$CONSOLE"; }

lire_masque() {   # lire_masque PROMPT -> the line on stdout, * per key; empty on Esc/60 s
    s=""
    printf '%s' "$1" > "$CONSOLE"
    while :; do
        c=""
        IFS= read -r -s -n1 -t 60 c < "$CONSOLE" || { s=""; break; }
        [ -z "$c" ] && break
        case "$c" in
            "$(printf '\033')") s=""; break ;;
            "$(printf '\177')"|"$(printf '\b')")
                [ -n "$s" ] && { s="${s%?}"; printf '\b \b' > "$CONSOLE"; }
                continue ;;
        esac
        s="$s$c"; printf '*' > "$CONSOLE"
    done
    echo > "$CONSOLE"
    printf '%s' "$s"
}

attendre_dev() { i=0; while [ ! -e "$1" ] && [ "$i" -lt 10 ]; do sleep 1; i=$((i + 1)); done; [ -e "$1" ]; }

lancer() {   # lancer KERNEL INITRD CMDLINE: kexec, signed kernel (Secure Boot)
    kexec -s -l "$1" --initrd="$2" --command-line="$3" 2>/dev/null \
        || kexec -l "$1" --initrd="$2" --command-line="$3" \
        || { dire "osmo-porte : kexec impossible"; return 1; }
    sync
    kexec -e
}

racine_live() {
    dire "" "osmo-porte : root, lecture seule"
    mkdir -p /run/osmo-a
    attendre_dev "/dev/disk/by-uuid/$A" && mount -o ro "/dev/disk/by-uuid/$A" /run/osmo-a \
        && lancer /run/osmo-a/vmlinuz /run/osmo-a/initrd.img \
            "boot=live live-media=/dev/disk/by-uuid/$A live-media-path=/live osmo.racine $EFFACE quiet splash"
    panic "osmo-porte : systeme root introuvable (osmo-racine, $A)"
}

nirvana() {   # nirvana PASSPHRASE: open, record the PCRs, kexec its kernel
    dev="/dev/disk/by-uuid/$LUKS"
    printf '%s' "$1" | cryptsetup open --key-file=- "$dev" osmo-porte 2>/dev/null || return 1
    mkdir -p /run/osmo-b
    if ! mount /dev/mapper/osmo-porte /run/osmo-b; then cryptsetup close osmo-porte; return 1; fi
    # the PCR values of THIS porte boot, read before the cap: what
    # « osmo-porte sceller » seals against
    if [ -s /run/osmo-pcr.bin ]; then
        mkdir -p /run/osmo-b/var/lib/osmo-porte
        cp /run/osmo-pcr.bin /run/osmo-b/var/lib/osmo-porte/pcr-porte.bin
        date '+%F %T' > /run/osmo-b/var/lib/osmo-porte/pcr-porte.date
    fi
    k="$(readlink -f /run/osmo-b/boot/vmlinuz)"; i="$(readlink -f /run/osmo-b/boot/initrd.img)"
    [ -f "$k" ] || k="$(ls -1 /run/osmo-b/boot/vmlinuz-* | sort -V | tail -1)"
    [ -f "$i" ] || i="/run/osmo-b/boot/initrd.img-${k#*/boot/vmlinuz-}"
    cl="$(cat /run/osmo-b/etc/osmo-porte/cmdline 2>/dev/null)"
    [ -n "$cl" ] || cl="root=UUID=$(blkid -s UUID -o value /dev/mapper/osmo-porte) ro quiet splash"
    cl="$cl $EFFACE"
    cp "$k" /run/osmo-k; cp "$i" /run/osmo-i
    sync; umount /run/osmo-b; cryptsetup close osmo-porte
    # nirvana's initramfs opens the volume again with /crypto_keyfile.bin
    lancer /run/osmo-k /run/osmo-i "$cl"
    panic "osmo-porte : noyau de nirvana illancable"
}

# code_tpm: the TOTP of the current 30 s window, computed by the TPM
# (HMAC-SHA256 of the 8-byte big-endian counter, RFC 6238 truncation); empty
# if the TPM refuses (not sealed, or the boot path changed)
code_tpm() {
    x=$(printf '%016x' $(( $(date +%s) / 30 )))
    oct=""; i=1
    while [ $i -le 16 ]; do
        oct="$oct\\$(printf '%03o' $(( 0x$(echo "$x" | cut -c$i-$((i+1))) )))"
        i=$((i + 2))
    done
    printf "$oct" > /run/osmo-ctr
    h="$(tpm2_hmac -c "$HANDLE" -p "pcr:$PCRS" -g sha256 --hex /run/osmo-ctr 2>/dev/null)"
    [ ${#h} -eq 64 ] || return 0
    o=$(( 0x${h#${h%?}} ))
    b=$(( 0x$(echo "$h" | cut -c$((o * 2 + 1))-$((o * 2 + 8))) & 0x7fffffff ))
    printf '%06d' $(( b % 1000000 ))
}

cap() { tpm2_pcrextend "9:sha256=$CAP" >/dev/null 2>&1; rm -f /run/osmo-ctr; }

mountroot() {
    LUKS="$(parametre osmo.luks)"; A="$(parametre osmo.a)"; DIFFS="$(parametre osmo.diffs)"
    clear > "$CONSOLE" 2>/dev/null

    # ── 1. the TPM ──
    tpm=0
    attendre_dev /dev/tpmrm0 && tpm=1
    # some firmware leave the platform hierarchy enabled: with it, any root
    # could clear the TPM (nirvana's code gone). Off until the next reset.
    [ "$tpm" = 1 ] && tpm2_hierarchycontrol -C p phEnable clear >/dev/null 2>&1
    [ "$tpm" = 1 ] && tpm2_pcrread -o /run/osmo-pcr.bin "$PCRS" >/dev/null 2>&1

    # ── 2. the black box (indicative) ──
    boite="boite noire : partition absente"
    if [ -n "$DIFFS" ] && attendre_dev "/dev/disk/by-uuid/$DIFFS"; then
        mkdir -p /run/osmo-d
        if mount -o ro "/dev/disk/by-uuid/$DIFFS" /run/osmo-d 2>/dev/null; then
            boite="$(cat /run/osmo-d/dernier.txt 2>/dev/null || echo 'boite noire : vide')"
            umount /run/osmo-d
        fi
    fi

    # the screen: the code, recomputed by the TPM at each 30 s window, until
    # Enter (or Esc / 60 s)
    n=0; choix=""; fen=""; code=""
    while :; do
        f=$(( $(date +%s) / 30 ))
        if [ "$tpm" = 1 ] && [ "$f" != "$fen" ]; then code="$(code_tpm)"; fen="$f"; fi
        printf '\033[H\033[2J' > "$CONSOLE"
        dire "osmo-operator - porte" ""
        if [ -n "$code" ]; then
            dire "  code TPM : $code   (compare avec ton telephone - $(date '+%H:%M:%S'))"
        else
            dire "  code TPM : AUCUN - pas de scellement (osmo-porte sceller)," \
                 "             ou le demarrage a change (firmware, GRUB, menu, noyau, porte)"
        fi
        dire "  $boite (indicatif)" "" "  Entree : phrase de nirvana     Echap : root (lecture seule)"
        c=""
        if IFS= read -r -s -n1 -t 1 c < "$CONSOLE"; then
            [ -z "$c" ] && { choix=nirvana; break; }
            [ "$c" = "$(printf '\033')" ] && { choix=root; break; }
        fi
        n=$((n + 1)); [ "$n" -ge 60 ] && { choix=root; break; }
    done
    # the decision is taken: the key becomes unusable for the rest of this boot
    cap; code=""

    if [ "$choix" = nirvana ] && [ -n "$LUKS" ] && attendre_dev "/dev/disk/by-uuid/$LUKS"; then
        essai=1
        while [ "$essai" -le 3 ]; do
            p="$(lire_masque "  phrase de nirvana (Entree = root) : ")"
            [ -n "$p" ] || break
            nirvana "$p"; p=""
            dire "  phrase refusee"
            essai=$((essai + 1))
        done
    fi
    racine_live
}
