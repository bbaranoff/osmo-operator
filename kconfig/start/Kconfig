comment "--- Modules du plan run.sh (run_modules) ---"
	depends on LAUNCH_NATIVE

if LAUNCH_NATIVE

source "kconfig/start/generated/Kconfig.runmods"

endif

# ── 7. Voix ──────────────────────────────────────────────────────────────────
config HR
	bool "Voix half-rate TCH/H (--hr, transcodeur HR <-> FR)"
	depends on LAUNCH_NATIVE && BUILT_GAPK && HAVE_GAPK
	help
	  Le transcodeur (tools/osmo-hr-transcodeur.py) utilise osmo-gapk
	  compile avec --enable-gsmhr : composant gapk du build.

# ── 8. LoRa ──────────────────────────────────────────────────────────────────
config LORA
	bool "LoRa : la voix inter-noeuds en RF (--lora)"
	depends on LAUNCH_NATIVE && (BUILT_RNS || BUILT_TNCATTACH)
	help
	  RNode Heltec V3. Ajoute --wan, --node N, --no-sidecar et la table
	  1:10.99.0.1 / 2:10.99.0.2 ; la signalisation reste sur wg0.
	  wiki/LoRa.md.

if LORA

choice
	prompt "Noeud LoRa"
	default LORA_NODE_1
config LORA_NODE_1
	bool "1 (prioritaire)"
config LORA_NODE_2
	bool "2"
endchoice

config LORA_PORT
	string "Port serie du RNode (vide = auto)"

choice
	prompt "Plan LoRa"
	default LORA_MODE_VOICE
config LORA_MODE_VOICE
	bool "voix en RF : trames GSM brutes dans les trames du RNode"
	depends on BUILT_RNS
config LORA_MODE_IP
	bool "ancien plan : RTP + SMS en IP sur tnc0 (LORA_MODE=ip)"
	depends on BUILT_TNCATTACH && HAVE_TNCATTACH
endchoice

choice
	prompt "Talkie"
	depends on LORA_MODE_VOICE
	default LORA_PTT_MANUAL
config LORA_PTT_MANUAL
	bool "manuel : take / release dans le VTY du mobile"
config LORA_PTT_AUTO
	bool "auto (VOX)"
endchoice

endif

# ── 9. Noeud et WAN ──────────────────────────────────────────────────────────
comment "--- Noeud, inter-STP et WAN ---"

config NODE
	int "Numero de CE noeud (0 = deduit)"
	range 0 9
	default 0
	depends on !LORA

config OP
	int "Operateur porte par ce noeud (--op)"
	range 1 9
	default 1
	depends on LAUNCH_NATIVE

config HUB_IP
	string "Inter-STP a joindre (--hub-ip, vide = defaut)"

choice
	prompt "Inter-STP sur ce noeud"
	depends on LAUNCH_NATIVE
	default INTERSTP_AUTO
config INTERSTP_AUTO
	bool "auto (avec --wan)"
config INTERSTP_FORCE
	bool "toujours (--interstp)"
config INTERSTP_NO
	bool "jamais (--no-interstp)"
endchoice

config WAN
	bool "WAN entre noeuds (--wan)"
	depends on !LORA

if WAN

choice
	prompt "Table WAN"
	default WAN_ASK
config WAN_ASK
	bool "questions au demarrage (--wan)"
config WAN_TABLE
	bool "donnee ici (--wan-nodes)"
config WAN_FILES
	bool "fiches des autres noeuds (--wan mynodeN.conf ...)"
	depends on LAUNCH_NATIVE
endchoice

config WAN_NODES
	string "Noeuds \"N:IP:IND ...\""
	depends on WAN_TABLE

config WAN_FILE_LIST
	string "Fiches, separees par des espaces"
	depends on WAN_FILES

config WAN_ID
	int "Numero du noeud local (0 = deduit des IP)"
	range 0 9
	default 0

config WAN_CONF
	string "Table a lire/ecrire (vide = /etc/osmo-wan.conf)"

config WAN_REGEN
	bool "Reconstruire la table de zero (--regen-conf)"
	depends on LAUNCH_NATIVE

choice
	prompt "Texte des SMS par radio ISM (--payload-ism)"
	depends on LAUNCH_NATIVE
	default ISM_NONE
config ISM_NONE
	bool "non"
config ISM_SECTION
	bool "oui, section [payload] deja ecrite"
config ISM_SERIAL
	bool "serial"
config ISM_EXEC
	bool "exec"
config ISM_FIFO
	bool "fifo"
config ISM_LOOPBACK
	bool "loopback"
endchoice

config AIR_MESH
	bool "Maillage des bursts entre noeuds (--air-mesh)"
	depends on LAUNCH_NATIVE

config AIR_MESH_PORT
	int "Port (0 = defaut)"
	default 0
	depends on AIR_MESH

endif

config VIRTUALBOX
	int "VM VirtualBox reliees en WAN (--virtualbox=N, 0 = non)"
	range 0 9
	default 0
	depends on HAVE_VBOX && !LORA

config VBOX_NODE
	int "Noeud porte par cette machine (--vbox-node)"
	range 1 9
	default 1
	depends on VIRTUALBOX != 0

config OPERATORS
	int "Operateurs en conteneurs (--operators, 0 = defaut)"
	range 0 9
	default 0
	depends on LAUNCH_DOCKER


# ── Les parametres du banc (globals.conf) ───────────────────────────────────
# Defauts : ceux du build (build.config), sinon le globals.conf de cette
# machine. A l'enregistrement de --configure, ils sont ecrits dans
# globals.conf (tools/osmo-db.py globals-depuis-config) ; un start.sh normal
# ne fait que le lire. osmo-egprs-web les modifie aussi (meme fichier).
source "kconfig/start/generated/Kconfig.params"

# ── 10. Divers ───────────────────────────────────────────────────────────────
comment "--- Divers ---"
	depends on LAUNCH_NATIVE

if LAUNCH_NATIVE

config REGEN
	bool "Regenerer les configs depuis les gabarits (--regen)"
config FORCE
	bool "Relancer meme les modules deja demarres (--force)"
config VERBOSE
	bool "Sortie des modules (--verbose)"
config NO_ATTACH
	bool "Ne pas s'attacher a tmux (--no-attach)"
config DRY_RUN
	bool "Derouler sans effet de bord (--dry-run)"

endif
