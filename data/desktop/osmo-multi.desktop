# osmo-multi.desktop - launcher: the multi-operator bench (SS7 between the
# native operator, two docker operators and the inter-STP hub).
# Single click runs `launch.sh --multi-suivi` in the bench progress window:
# launch.sh checks the ConditionPathExists of osmo-multi.service itself
# (/etc/osmocom/osmo-multi.conf, written by addition.sh), names what is
# missing, starts the unit and reports by notification; the unit's journal
# scrolls in the window. The bench runs as a systemd unit (osmo-multi.service,
# like osmo-banc.service for the mono-operator): one journal, one status, a
# clean stop. Its ExecStop only stops the containers and the hub; the native
# operator stays with osmo-banc.
[Desktop Entry]
Type=Application
Name=multi-operator
Name[fr]=multi-operator
Comment=SS7 entre l operateur natif, deux operateurs docker et l inter-STP
Comment[fr]=SS7 entre l operateur natif, deux operateurs docker et l inter-STP
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --progress --root --title "Multi-operateur" --icon /usr/share/osmo-operator/icons/osmo-multi.svg -- /opt/GSM/osmo-operator/launch.sh --multi-suivi
Icon=/usr/share/osmo-operator/icons/osmo-multi.svg
Terminal=false
Categories=System;Network;
Keywords=ss7;m3ua;multi;operateur;interstp;

Actions=Stop;Journal;

[Desktop Action Stop]
Name=Arreter le multi-operateur
Name[fr]=Arreter le multi-operateur
Exec=/opt/GSM/osmo-operator/launch.sh --multi-stop

# Startup can take minutes (images, containers, HLR): this action follows the
# unit's journal in a bench GTK window (tools/osmo-gtk-run.py), not a terminal.
[Desktop Action Journal]
Name=Voir le journal (journalctl -u osmo-multi)
Name[fr]=Voir le journal (journalctl -u osmo-multi)
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --root --title "journal osmo-multi" -- journalctl -u osmo-multi -f -n 200 --no-pager -o cat
