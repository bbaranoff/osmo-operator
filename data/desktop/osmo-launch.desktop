# osmo-launch.desktop - launcher: start the GSM bench (osmo-bts-trx +
# pont_dsp.py DSP chain, osmocom-bb mobile, Wireshark, Linphone, web console).
# Every action is one launch.sh command line; launch.sh passes "$@" to start.sh.
[Desktop Entry]
Type=Application
Name=Lancer le banc GSM
Name[fr]=Lancer le banc GSM
Comment=Demarre le banc, Wireshark, Linphone et la console web
Comment[fr]=Demarre le banc, Wireshark, Linphone et la console web
# Single click: the classic BTS (osmo-bts-trx <-> pont_dsp.py) and the osmocom-bb mobile.
Exec=/opt/GSM/osmo-operator/launch.sh --bts-classique --ms
Icon=/usr/share/osmo-operator/icons/osmo-launch.svg
Terminal=false
Categories=System;Network;
Keywords=gsm;osmocom;banc;lancer;

# ── RIGHT-CLICK ACTIONS ──────────────────────────────────────────────────────
# GNOME/DING reads `Actions=` and adds one context-menu entry per action
# (desktop AND dock). Group names must match the `Actions=` tokens EXACTLY,
# case included: an entry that matches nothing is silently ignored.
Actions=Service;Dashboard;Console;Vty;Grgsm;Stop;

# "As a service": systemctl, no terminal, the bench survives the end of the
# session (launch.sh --service-suivi talks to systemd).
[Desktop Action Service]
Name=Demarrer le banc en service
Name[fr]=Demarrer le banc en service (sans terminal)

Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --progress --root --title "Banc GSM 2G" --icon /usr/share/osmo-operator/icons/osmo-launch.svg -- /opt/GSM/osmo-operator/launch.sh --service-suivi --bts-classique --ms

[Desktop Action Dashboard]
Name=Tableau de bord (127.0.0.1:8080)
Name[fr]=Tableau de bord (127.0.0.1:8080)

Exec=/opt/GSM/osmo-operator/launch.sh --dashboard

# The only action that opens a terminal: a tmux session is interactive.
[Desktop Action Console]
Name=Console du banc (tmux attach)
Name[fr]=Console du banc (tmux attach)

Exec=/opt/GSM/osmo-operator/launch.sh --console

[Desktop Action Vty]
Name=Console du mobile (VTY 4247)
Name[fr]=Console du mobile (VTY 4247)

Exec=/opt/GSM/osmo-operator/launch.sh --vty

# The DSP (C54x) chain is the start.sh default (single click); this action
# starts the OTHER chain, gr-gsm.
[Desktop Action Grgsm]
Name=Lancer en mode gr-gsm (sans DSP)
Name[fr]=Lancer en mode gr-gsm (sans DSP)
Exec=/opt/GSM/osmo-operator/launch.sh --grgsm

[Desktop Action Stop]
Name=Arreter le banc
Name[fr]=Arreter le banc
Exec=/opt/GSM/osmo-operator/launch.sh --stop
