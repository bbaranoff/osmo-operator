[Desktop Entry]
Type=Application
Name=Lancer le banc GSM
Name[fr]=Lancer le banc GSM
Comment=Demarre le banc, Wireshark, Linphone et la console web
Comment[fr]=Demarre le banc, Wireshark, Linphone et la console web
Exec=/opt/GSM/osmo-operator/launch.sh
Icon=/usr/share/osmo-operator/icons/osmo-launch.svg
Terminal=false
Categories=System;Network;
Keywords=gsm;osmocom;banc;lancer;

# ── ACTIONS DU CLIC DROIT ────────────────────────────────────────────────────
# GNOME/DING lit `Actions=` et ajoute une entree par action au menu contextuel
# de l icone (bureau ET dock). launch.sh passe tout son "$@" a start-direct.sh :
# les deux actions ci-dessous sont donc exactement les deux lignes de commande,
# sans duplication de logique.
#
# Les noms des groupes doivent correspondre EXACTEMENT aux jetons de `Actions=`,
# a la casse pres inclus : une entree qui ne correspond a rien est ignoree en
# silence, et le clic droit affiche simplement une action de moins.
Actions=Service;Dashboard;Console;Vty;Dsp;Stop;

# « Comme un service » : systemctl, pas de terminal, et le banc survit a la
# fermeture de la session. C est launch.sh --service qui parle a systemd -
# l icone ne connait toujours qu une seule ligne de commande.
[Desktop Action Service]
Name=Demarrer le banc en service
Name[fr]=Demarrer le banc en service (sans terminal)

Exec=/opt/GSM/osmo-operator/launch.sh --service

[Desktop Action Dashboard]
Name=Tableau de bord (127.0.0.1:8080)
Name[fr]=Tableau de bord (127.0.0.1:8080)

Exec=/opt/GSM/osmo-operator/launch.sh --dashboard

# La seule action qui ouvre un terminal, et pour cause : une session tmux est
# interactive, elle n a nulle part ailleurs ou s afficher.
[Desktop Action Console]
Name=Console du banc (tmux attach)
Name[fr]=Console du banc (tmux attach)

Exec=/opt/GSM/osmo-operator/launch.sh --console

[Desktop Action Vty]
Name=Console du mobile (telnet 4247)
Name[fr]=Console du mobile (telnet 4247)

Exec=/opt/GSM/osmo-operator/launch.sh --vty

[Desktop Action Dsp]
Name=Lancer en mode DSP (C54x)
Name[fr]=Lancer en mode DSP (C54x)
Exec=/opt/GSM/osmo-operator/launch.sh --dsp

[Desktop Action Stop]
Name=Arreter le banc
Name[fr]=Arreter le banc
Exec=/opt/GSM/osmo-operator/launch.sh --stop
