[Desktop Entry]
Type=Application
Name=Nouveaux secrets
Name[fr]=Nouveaux secrets
Comment=Changer la phrase secrete et le PIN du TPM, la phrase de /home, celle de la boite noire
Exec=python3 /opt/GSM/osmo-operator/tools/osmo-gtk-run.py --root --tty --keep-open --title "Nouveaux secrets" -- /usr/local/sbin/osmo-secrets
Icon=dialog-password
Terminal=false
Categories=System;
Keywords=secret;phrase;pin;tpm;mot de passe;
