# osmo-info.desktop - launcher: bench help page (every module, its icon,
# launcher bar entry and CLI). Runs /usr/local/bin/osmo-info.
[Desktop Entry]
Type=Application
Name=Help - how to run the bench
Comment=Every bench module: icon, launcher bar and CLI, with the code behind it
Exec=/usr/local/bin/osmo-info
Icon=/usr/share/osmo-operator/icons/osmo-info.svg
Terminal=false
Categories=Utility;
