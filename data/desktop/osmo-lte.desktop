# osmo-lte.desktop - launcher: the bench 4G (Open5GS core, srsRAN eNB and UE).
# Single click toggles the 4G through `osmo-lte toggle` (tools/osmo-lte.sh,
# service services/osmo-lte.service, root via pkexec). Everything runs in the
# bench progress window (osmo-gtk-run.py --progress): step bar, folded console,
# no shell. Right-click actions: start, start with srsGUI traces, traces only,
# stop, status, journal.
[Desktop Entry]
Type=Application
Name=4G du banc (srsRAN + Open5GS)
Name[fr]=4G du banc (srsRAN + Open5GS)
Comment=Un clic demarre la 4G (coeur Open5GS, eNB, UE), un second l arrete - osmo-lte toggle
Comment[fr]=Un clic demarre la 4G (coeur Open5GS, eNB, UE), un second l arrete - osmo-lte toggle
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --progress --title "4G du banc" --icon /usr/share/osmo-operator/icons/osmo-lte.svg -- /usr/local/bin/osmo-lte toggle
Icon=/usr/share/osmo-operator/icons/osmo-lte.svg
Terminal=false
Categories=System;Network;
Keywords=4g;lte;srsran;open5gs;epc;enb;ue;

Actions=Start;StartGui;Traces;Stop;Status;Journal;

[Desktop Action Start]
Name=Demarrer la 4G
Name[fr]=Demarrer la 4G
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --progress --title "4G du banc" --icon /usr/share/osmo-operator/icons/osmo-lte.svg -- /usr/local/bin/osmo-lte up

# 4G with its traces: srsRAN is built with srsGUI; `osmo-lte start-gui` adds
# --gui.enable on the eNB and the UE and gives them a DISPLAY (pkexec env
# DISPLAY=... XAUTHORITY=...). This is NOT the systemd service (a system unit
# has no display).
[Desktop Action StartGui]
Name=Demarrer la 4G avec les traces (srsGUI)
Name[fr]=Demarrer la 4G avec les traces (srsGUI)
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --progress --title "4G du banc (srsGUI)" -- /usr/local/bin/osmo-lte start-gui

# Traces only: srsGUI lives in srsenb/srsue (--gui.enable), so the radio is
# restarted, but the Open5GS core is kept.
[Desktop Action Traces]
Name=Traces srsGUI seules (relance eNB et UE, garde le coeur)
Name[fr]=Traces srsGUI seules (relance eNB et UE, garde le coeur)
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --progress --title "Traces srsGUI" -- /usr/local/bin/osmo-lte traces

[Desktop Action Stop]
Name=Arreter la 4G
Name[fr]=Arreter la 4G
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --progress --close-on-exit --title "Arret de la 4G" --icon /usr/share/osmo-operator/icons/osmo-lte.svg -- /usr/local/bin/osmo-lte down

[Desktop Action Status]
Name=Etat (osmo-lte status, osmo-epc status)
Name[fr]=Etat (osmo-lte status, osmo-epc status)
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --root --keep-open --title "Etat 4G" -- bash -c "/usr/local/bin/osmo-lte status; /usr/local/bin/osmo-epc status"

[Desktop Action Journal]
Name=Voir le journal (journalctl -u osmo-lte)
Name[fr]=Voir le journal (journalctl -u osmo-lte)
Exec=/opt/GSM/osmo-operator/tools/osmo-gtk-run.py --root --title "journal osmo-lte" -- journalctl -u osmo-lte -f -n 200 --no-pager -o cat
