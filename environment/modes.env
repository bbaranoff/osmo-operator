# =============================================================================
#  environment/modes.env — profils prets a l'emploi
# =============================================================================
#  Reprend les modes historiques de start-direct.sh, convertis en profils du
#  moteur. Choisissez-en UN :
#      CALYPSO_PROFILE=faketrx ./run.sh
#  ou, par compatibilite avec l'ancienne interface :
#      MODE=faketrx ./start-direct.sh
# -----------------------------------------------------------------------------

# MODE (historique) a la priorite s'il est pose ; sinon CALYPSO_PROFILE.
: "${CALYPSO_PROFILE:=${MODE:-core}}"

case "$CALYPSO_PROFILE" in

  # Coeur seul : STP + HLR + MSC + MGW + BSC (+ Asterisk). Aucune radio.
  core|noproc)      CALYPSO_PROFILE=core ;;

  # Coeur + osmo-bts + fake_trx + trxcon + mobile. Pas de QEMU.
  faketrx)          CALYPSO_PROFILE=faketrx ;;

  # Coeur + osmo-bts-virtual + virtphy + mobile.
  virtphy)          CALYPSO_PROFILE=virtphy ;;

  # Coeur en no-process + l'emulation Calypso (deleguee a OQC_ROOT).
  qemu|calypso)     CALYPSO_PROFILE=calypso ;;

  # Coeur + fake_trx vivant + Calypso attache.
  faketrx-qemu|hybrid) CALYPSO_PROFILE=hybrid ;;

  # SDR physique.
  hw)               CALYPSO_PROFILE=hw ;;

  # Multi-operateurs SS7 par ip netns.
  virtual)          CALYPSO_PROFILE=virtual ;;

  *)
      echo "[environment/modes.env] profil inconnu : '$CALYPSO_PROFILE'" >&2
      echo "   core | faketrx | virtphy | calypso | hybrid | hw | virtual" >&2
      ;;
esac

# Nombre d'operateurs (profil « virtual » uniquement).
: "${N_OPERATORS:=1}"
