# =============================================================================
#  environment/modes.env - ready-made profiles
# =============================================================================
#  The start-native.sh modes, as profiles of the engine (run.sh). Pick ONE:
#      CALYPSO_PROFILE=faketrx ./start.sh
#  or, through the legacy interface:
#      MODE=faketrx ./start-native.sh
# -----------------------------------------------------------------------------

# MODE (legacy) has priority when set; otherwise CALYPSO_PROFILE.
: "${CALYPSO_PROFILE:=${MODE:-core}}"

case "$CALYPSO_PROFILE" in

  # Core only: STP + HLR + MSC + MGW + BSC (+ Asterisk). No radio.
  core|noproc)      CALYPSO_PROFILE=core ;;

  # Core + osmo-bts + fake_trx + trxcon + mobile. No QEMU.
  faketrx)          CALYPSO_PROFILE=faketrx ;;

  # Core + osmo-bts-virtual + virtphy + mobile.
  virtphy)          CALYPSO_PROFILE=virtphy ;;

  # Core in no-process mode + the Calypso emulation (delegated to OQC_ROOT).
  qemu|calypso)     CALYPSO_PROFILE=calypso ;;

  # Core + live fake_trx + attached Calypso.
  faketrx-qemu|hybrid) CALYPSO_PROFILE=hybrid ;;

  # Physical SDR.
  hw)               CALYPSO_PROFILE=hw ;;

  # SS7 multi-operator through ip netns.
  virtual)          CALYPSO_PROFILE=virtual ;;

  *)
      echo "[environment/modes.env] profil inconnu : '$CALYPSO_PROFILE'" >&2
      echo "   core | faketrx | virtphy | calypso | hybrid | hw | virtual" >&2
      ;;
esac

# Number of operators ("virtual" profile only).
: "${N_OPERATORS:=1}"
