# =============================================================================
#  environment/paths.env - where the dependencies are (INSTALLATION settings)
# =============================================================================
#  Answers one question: WHERE things are on THIS machine.
#  Every value can be overridden from the environment (`:=` idiom):
#      GSM_ROOT=/home/me/gsm ./start.sh
#  Check:   ./start.sh --check-paths
# -----------------------------------------------------------------------------

# --- Installation root --------------------------------------------------------
: "${GSM_ROOT:=/opt/GSM}"

# --- This repository ----------------------------------------------------------
: "${NITB_TREE:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
: "${NITB_SCRIPTS:=$NITB_TREE/scripts}"
: "${NITB_CONFIGS:=$NITB_TREE/configs}"
: "${NITB_HELPERS:=$NITB_TREE/helpers}"

# --- The Calypso emulation (neighbour repository) -----------------------------
# The "qemu" mode delegates to it. A single QEMU tree, /opt/GSM/qosmo (run.sh,
# run_modules, cfgs, environnement), and two layer-1 chains:
#
#   grgsm_exe    DEFAULT. gr-gsm layer 1 inside QEMU (qosmo --enable-l1-grgsm)
#                and the grgsm_exe bridge: the mobile camps, does its LU,
#                authenticates (COMP128v1), ciphers (A5/1), exchanges SMS and
#                holds a voice call.
#   c54x_exe     The TMS320C54x DSP runs OUTSIDE QEMU (/opt/GSM/c54x_exe) on
#                the real TI mask ROM (ROM: /opt/GSM/calypso_dsp.*.bin, copied
#                into c54x_exe/rom); QEMU runs with CALYPSO_DSP_EXTERN=1.
#
# Select:  ./start-native.sh --dsp        (c54x_exe; --grgsm for the default)
# Or point directly at a tree:  OQC_ROOT=/path/to/qosmo ./start-native.sh
: "${CALYPSO_FORK:=qosmo}"

# Looked up next to this repository first, then at the installation location.
if [ -x "$NITB_TREE/../$CALYPSO_FORK/run.sh" ]; then
    : "${OQC_ROOT:=$(cd "$NITB_TREE/../$CALYPSO_FORK" && pwd)}"
else
    : "${OQC_ROOT:=$GSM_ROOT/$CALYPSO_FORK}"
fi

# --- Osmocom binaries ---------------------------------------------------------
# Bare names = looked up in PATH, which is the case of a package installation.
: "${OSMO_STP:=osmo-stp}"
: "${OSMO_HLR:=osmo-hlr}"
: "${OSMO_MSC:=osmo-msc}"
: "${OSMO_MGW:=osmo-mgw}"
: "${OSMO_BSC:=osmo-bsc}"
: "${OSMO_SGSN:=osmo-sgsn}"
: "${OSMO_GGSN:=osmo-ggsn}"
: "${OSMO_PCU:=osmo-pcu}"
: "${OSMO_BTS_TRX:=osmo-bts-trx}"
: "${OSMO_BTS_VIRTUAL:=osmo-bts-virtual}"
: "${OSMO_TRX_IPC:=osmo-trx-ipc}"
: "${ASTERISK_BIN:=asterisk}"

# --- osmocom-bb (mobile, trxcon, virtphy, fake_trx) ---------------------------
: "${OSMOCOM_BB:=$GSM_ROOT/osmocom-bb}"
: "${MOBILE_BIN:=$OSMOCOM_BB/src/host/layer23/src/mobile/mobile}"
: "${TRXCON_BIN:=$OSMOCOM_BB/src/host/trxcon/trxcon}"
: "${VIRTPHY_BIN:=$OSMOCOM_BB/src/host/virt_phy/src/virtphy}"
: "${FAKE_TRX:=$OSMOCOM_BB/src/target/trx_toolkit/fake_trx.py}"

# --- Osmocom configuration ----------------------------------------------------
: "${OSMOCOM_CFG:=/etc/osmocom}"
: "${OSMOCOM_HOME:=$HOME/.osmocom}"

# --- Outputs ------------------------------------------------------------------
# RUN_DIR holds the monitor socket and the *.pid files: it is the bench's only
# memory of what already runs, so every way of launching MUST resolve the same
# directory. It is derived from the REAL uid (which survives sudo), not from
# XDG_RUNTIME_DIR alone (sudo's env_reset clears it, which would give two
# bench identities and stacked duplicate processes fighting over the global
# resources: /tmp/osmocom_l2, UDP 5720/6720, gdb 1234). Falls back to /tmp
# only when /run/user/<uid> does not exist. A RUN_DIR set by the caller wins.
if [ -z "${RUN_DIR:-}" ]; then
    _oq_rt="${XDG_RUNTIME_DIR:-}"
    { [ -n "$_oq_rt" ] && [ -d "$_oq_rt" ]; } || _oq_rt="/run/user/$(id -u)"
    [ -d "$_oq_rt" ] || _oq_rt="/tmp"
    RUN_DIR="${_oq_rt}/osmo-nitb"
    unset _oq_rt
fi

# Logs stay on the tmpfs: tmux follows them live (tail -F) and the tmpfs is the
# only filesystem here where inotify works (on the overlay root, tail falls
# back to 1 s polling and the tmux panes stutter). If volume becomes a problem,
# reduce the SOURCE instead of moving the target:
#   CALYPSO_INTM_TRANS=0   removes ~56 % of the qemu.log flow
#   CALYPSO_MAILBOX=0      removes mailbox.log (~230 kB/s, ~800 MB/h)
# Overridable like everything else: LOG_DIR=/elsewhere ./start-native.sh
: "${LOG_DIR:=$RUN_DIR/logs}"

# --- Naming bridge with the Calypso repository --------------------------------
# Modules shared between the two repositories call the Calypso emulation
# QEMU_TREE (its name seen from inside). Here that repository is the NEIGHBOUR,
# OQC_ROOT. Both names are exposed so the same modules work on both sides.
: "${QEMU_TREE:=$OQC_ROOT}"
: "${QEMU_BIN:=$OQC_ROOT/build/qemu-system-arm}"
# C launcher of the fork (qosmo/tools/qosmo-launch -> /usr/local/bin/<fork>).
# 40-qemu.sh calls it instead of qemu-system-arm and falls back to QEMU_BIN
# when it is absent. See start-native.sh "Lanceur QEMU" and `qosmo --help`.
: "${QOSMO_LAUNCHER:=/usr/local/bin/$CALYPSO_FORK}"

# --- Calypso emulation paths (firmware, DSP ROM, osmocon...) ------------------
# The "qemu" mode modules are shared with the neighbour repository and expect
# FIRMWARE_ELF, DSP_PROM0..3, OSMOCON, QEMU_CFGS... Those paths are described
# by the neighbour's own paths.env (optional): it is sourced rather than
# duplicated here. LAST on purpose: everything above has already set its
# value and `:=` lets the first one win, so RUN_DIR/LOG_DIR stay ours.
if [ -r "$OQC_ROOT/environnement/paths.env" ]; then
    . "$OQC_ROOT/environnement/paths.env"
fi
