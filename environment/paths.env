# =============================================================================
#  environment/paths.env — ou sont les dependances (configuration d'INSTALLATION)
# =============================================================================
#  Repond a une seule question : OU sont les choses sur CETTE machine.
#  Surchargeable depuis l'environnement (idiome `:=`) :
#      GSM_ROOT=/home/moi/gsm ./run.sh
#  Verifier :   ./run.sh --check-paths
# -----------------------------------------------------------------------------

# --- Racine de l'installation -------------------------------------------------
: "${GSM_ROOT:=/opt/GSM}"

# --- Ce depot -----------------------------------------------------------------
: "${NITB_TREE:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
: "${NITB_SCRIPTS:=$NITB_TREE/scripts}"
: "${NITB_CONFIGS:=$NITB_TREE/configs}"
: "${NITB_HELPERS:=$NITB_TREE/helpers}"

# --- L'emulation Calypso (depot voisin) ---------------------------------------
# Le mode « qemu » lui delegue. Cherche a cote, puis a l'emplacement habituel.
if [ -x "$NITB_TREE/../qosmo-grgsm/run.sh" ]; then
    : "${OQC_ROOT:=$(cd "$NITB_TREE/../qosmo-grgsm" && pwd)}"
else
    : "${OQC_ROOT:=$GSM_ROOT/qosmo-grgsm}"
fi

# --- Binaires Osmocom ---------------------------------------------------------
# Vides = cherches dans le PATH, ce qui est le cas d'une installation par paquets.
: "${OSMO_STP:=osmo-stp}"
: "${OSMO_HLR:=osmo-hlr}"
: "${OSMO_MSC:=osmo-msc}"
: "${OSMO_MGW:=osmo-mgw}"
: "${OSMO_BSC:=osmo-bsc}"
: "${OSMO_SGSN:=osmo-sgsn}"
: "${OSMO_GGSN:=osmo-ggsn}"
: "${OSMO_PCU:=osmo-pcu}"
: "${OSMO_BTS_TRX:=osmo-bts-trx}"
: "${OSMO_BTS_VIRTUAL:=osmo-bts-virtual}"
: "${OSMO_TRX_IPC:=osmo-trx-ipc}"
: "${ASTERISK_BIN:=asterisk}"

# --- osmocom-bb (mobile, trxcon, virtphy, fake_trx) ---------------------------
: "${OSMOCOM_BB:=$GSM_ROOT/osmocom-bb}"
: "${MOBILE_BIN:=$OSMOCOM_BB/src/host/layer23/src/mobile/mobile}"
: "${TRXCON_BIN:=$OSMOCOM_BB/src/host/trxcon/trxcon}"
: "${VIRTPHY_BIN:=$OSMOCOM_BB/src/host/virt_phy/src/virtphy}"
: "${FAKE_TRX:=$OSMOCOM_BB/src/target/trx_toolkit/fake_trx.py}"

# --- Configuration Osmocom ----------------------------------------------------
: "${OSMOCOM_CFG:=/etc/osmocom}"
: "${OSMOCOM_HOME:=$HOME/.osmocom}"

# --- Sorties ------------------------------------------------------------------
# Un tiers n'a aucune raison d'ecrire dans /root : RUN_DIR (socket du moniteur,
# fichiers PID — quelques octets, et plusieurs outils les cherchent la) reste
# sous /tmp.
#
# [2026-08-31] RUN_DIR NE DOIT PAS DEPENDRE D'UNE VARIABLE QUE sudo EFFACE.
# L'ecriture precedente, `${XDG_RUNTIME_DIR:-/tmp}/osmo-nitb`, a l'air anodine.
# En pratique elle donne DEUX identites de banc selon la facon de lancer :
#
#   sudo -i puis ./start-direct.sh    XDG_RUNTIME_DIR=/run/user/0
#                                     -> RUN_DIR=/run/user/0/osmo-nitb
#   sudo ./start-multi.sh  (l'icone)  sudo/env_reset EFFACE XDG_RUNTIME_DIR
#                                     -> RUN_DIR=/tmp/osmo-nitb
#
# Or RUN_DIR est l'endroit ou vivent les *.pid, donc la SEULE memoire qu'a le
# banc de ce qui tourne deja. Un second lancement qui ne regarde pas le meme
# repertoire ne VOIT PAS la pile en place, la croit absente, et en empile une
# seconde par-dessus. Les deux se disputent alors les ressources GLOBALES, qui
# elles ne bougent pas avec RUN_DIR : /tmp/osmocom_l2, /tmp/ms2_l2, l'UDP
# 5720/6720, le gdb 1234. Mesure sur le banc, quatre generations vivantes en
# meme temps (18:38, 18:40, 18:43, 18:50) et deux serveurs en LISTEN sur
# /tmp/osmocom_l2 - de la venaient les "Layer2 socket failed" en boucle.
#
# On resout donc le repertoire depuis l'UID REEL, qui lui survit a sudo, et on
# ne retombe sur /tmp que si /run/user/<uid> n'existe pas. Le `:=` d'origine est
# conserve : un RUN_DIR impose par l'appelant reste prioritaire.
if [ -z "${RUN_DIR:-}" ]; then
    _oq_rt="${XDG_RUNTIME_DIR:-}"
    { [ -n "$_oq_rt" ] && [ -d "$_oq_rt" ]; } || _oq_rt="/run/user/$(id -u)"
    [ -d "$_oq_rt" ] || _oq_rt="/tmp"
    RUN_DIR="${_oq_rt}/osmo-nitb"
    unset _oq_rt
fi

# [2026-08-03] LES JOURNAUX RESTENT SUR LE TMPFS. Arbitrage entre DEUX pannes
# réelles, pas une préférence — les deux ont été vécues le même jour.
#
#   Panne A — /tmp saturé (30/07 deux fois, puis 03/08). Le tmpfs faisait 512 Mo,
#   partagés avec le /tmp système. Plein, il fait échouer les compilations
#   (« No space left on device » sur le .s du compilateur) et perdre des journaux.
#   CORRIGÉE À LA SOURCE : start.sh crée désormais le conteneur avec un /tmp de
#   2 Go (--tmpfs /tmp:…size=2g), au lieu de déplacer les journaux.
#
#   Panne B — défilement tmux saccadé. Provoquée par la tentative de contournement
#   de la panne A : mettre LOG_DIR sous /root. Identifiée par bissect (commit
#   1d241a0) puis confirmée par retour arrière. Mécanisme probable : / est un
#   overlay à 16 couches, où la propagation inotify vers la couche supérieure est
#   défaillante ; `tail -F` retombe alors sur du sondage à 1 s et le flux
#   (~490 ko/s) arrive en paquets d'une seconde. tmux avale un gros bloc d'un
#   coup, à intervalle régulier — d'où la sensation de rame.
#
# MORALE : les journaux vivent sur le tmpfs, parce que tmux les suit en direct et
# que le tmpfs est le seul système de fichiers ici où inotify fonctionne. Si le
# volume redevient un problème, on tarit la SOURCE, on ne déplace pas la cible :
#   CALYPSO_INTM_TRANS=0   retire ~56 % du flux qemu.log
#   CALYPSO_MAILBOX=0      retire mailbox.log (~230 ko/s, soit ~800 Mo/h — c'est
#                          lui qui remplissait les 512 Mo à lui seul)
#
# Surchargeable comme tout le reste : LOG_DIR=/ailleurs ./start-direct.sh
: "${LOG_DIR:=$RUN_DIR/logs}"

# --- Pont de nommage avec le depot Calypso ------------------------------------
# Les modules partages entre les deux depots designent l emulation Calypso par
# QEMU_TREE (son nom vu de l interieur). Ici, ce depot est le VOISIN : OQC_ROOT.
# On expose les deux noms pour que les memes modules fonctionnent des deux cotes
# sans etre dupliques.
: "${QEMU_TREE:=$OQC_ROOT}"
: "${QEMU_BIN:=$OQC_ROOT/build/qemu-system-arm}"

# --- Chemins de l emulation Calypso (firmware, ROM DSP, osmocon...) -----------
# Les modules du mode « qemu » sont partages avec le depot voisin et exigent
# FIRMWARE_ELF, DSP_PROM0..3, OSMOCON, QEMU_CFGS... Ces chemins sont decrits par
# le paths.env de ce voisin : on le source plutot que de les redupliquer ici.
# En DERNIER, a dessein : tout ce qui precede a deja pose sa valeur, et l idiome
# `:=` fait que le premier gagne — RUN_DIR/LOG_DIR restent donc ceux du reseau.
if [ -r "$OQC_ROOT/environnement/paths.env" ]; then
    . "$OQC_ROOT/environnement/paths.env"
fi
