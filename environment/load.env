# =============================================================================
#  environment/load.env — chargeur de configuration
# =============================================================================
#  Point d'entree unique. Source par run.sh avec `set -a`, donc tout est exporte.
#
#  ORDRE — il compte. Tous les fichiers utilisent `:=` (« si pas deja defini »),
#  donc LE PREMIER QUI POSE UNE VALEUR GAGNE :
#      1. la ligne de commande     VAR=x ./run.sh     <- gagne toujours
#      2. modes.env                le profil choisi
#      3. paths.env                ou sont les dependances
#      4. les fichiers par domaine
# -----------------------------------------------------------------------------

_ENVDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$_ENVDIR/modes.env"
. "$_ENVDIR/paths.env"

for _f in coeur radio reseau debug; do
    [ -f "$_ENVDIR/$_f.env" ] && . "$_ENVDIR/$_f.env"
done

unset _f _ENVDIR
