# =============================================================================
#  environment/load.env - configuration loader
# =============================================================================
#  Single entry point. Sourced by startup_scripts/04-environnement.sh with
#  `set -a`, so everything is exported.
#
#  ORDER matters. Every file uses `:=` ("unless already set"), so THE FIRST
#  ONE TO SET A VALUE WINS:
#      1. the command line       VAR=x ./start.sh     <- always wins
#      2. modes.env              the chosen profile
#      3. paths.env              where the dependencies are
#      4. the per-domain files   coeur / radio / reseau / debug (optional)
# -----------------------------------------------------------------------------

_ENVDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$_ENVDIR/modes.env"
. "$_ENVDIR/paths.env"

for _f in coeur radio reseau debug; do
    [ -f "$_ENVDIR/$_f.env" ] && . "$_ENVDIR/$_f.env"
done

unset _f _ENVDIR
