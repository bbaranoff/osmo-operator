+; dongle.conf - chan_dongle: a Huawei voice dongle as the bench's door onto
+; the public network (tools/osmo-dongle-install.sh builds the module).
+;
+; The dongle is ONE device with two serial ports: AT (data) and PCM voice
+; (audio). chan_dongle holds both: tools/osmo-dongle-passerelle.py must then
+; run with OSMO_DONGLE_BACKEND=asterisk (SMS through the AMI), never with
+; the default direct-AT backend.
+;
+; Calls and SMS arrive in [dongle_in] (extensions.conf); outbound calls leave
+; through [sub-sortie-ext] when TRUNK_EXT=dongle.
+
+[general]
+interval=15                 ; seconds between two attempts to reopen the device
+
+[defaults]
+context=dongle_in
+group=0
+rxgain=0
+txgain=0
+autodeletesms=yes           ; the SIM is a mailbox, not an archive
+resetdongle=yes
+u2diag=-1                   ; leave the dongle's port layout alone
+usecallingpres=yes
+callingpres=allowed_passed_screen
+disablesms=no
+language=fr
+smsaspdu=yes
+mindtmfgap=45
+mindtmfduration=80
+mindtmfinterval=200
+callwaiting=auto
+disable=no
+initstate=start
+exten=+1234567890           ; unused: [dongle_in] routes on s / the called number
+dtmf=relax
+
+; Ports as seen on an E1550/E173: check with
+;   ls -l /dev/serial/by-id/   (the voice port is the one that does not answer AT)
+; Matching by imei= instead of data=/audio= survives a USB renumbering.
+[dongle0]
+audio=/dev/ttyUSB1
+data=/dev/ttyUSB2
+;imei=000000000000000
