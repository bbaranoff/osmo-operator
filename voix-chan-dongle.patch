+; =============================================================================
+; [dongle_in] - calls and SMS FROM the public network through the dongle
+;
+; Same rules as [zadarma_in]: the call is carried by the local MSISDN so the
+; DestExten seen by osmo-phonesim-banc.py is its own number (otherwise the
+; postmarketOS phone never rings). "sms" and "ussd" are the extensions
+; chan_dongle uses for those events. ${SMS_BASE64} only holds base64
+; characters: safe to pass to System().
+; =============================================================================
+[dongle_in]
+exten => sms,1,NoOp(=== DONGLE SMS de ${CALLERID(num)} ===)
+ same => n,System(python3 ${SMS_NOTIFY} --b64 "" "${FILTER(+0-9,${CALLERID(num)})}" "${SMS_BASE64}")
+ same => n,Hangup()
+exten => ussd,1,NoOp(=== DONGLE USSD : ${USSD} ===)
+ same => n,Hangup()
+exten => _[+0-9].,1,Goto(${DEST_DONGLE_IN},1)
+exten => s,1,Goto(${DEST_DONGLE_IN},1)
+exten => i,1,Goto(${DEST_DONGLE_IN},1)
+exten => ___MSISDN_PFX____OPERATOR_ID__XX,1,NoOp(=== DONGLE IN: appelé=${EXTEN} - CallerID: ${CALLERID(all)} ===)
+ same => n,Set(CALLERID(num)=${FILTER(0-9,${CALLERID(num)})})
+ same => n,Set(CALLERID(name)=${CALLERID(num)})
+ same => n,Gosub(sub-record,s,1(dongle_in_${CALLERID(num)}))
+ same => n,Dial(PJSIP/${EXTEN}@gsm_msc,45,rT)
+ same => n,NoOp(=== DONGLE IN: échec ${DIALSTATUS} vers ${EXTEN} ===)
+ same => n,Hangup()
+
